<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="&#10;`ifdef PARAM_WAVE&#10;initial begin&#10;  $dumpfile(&quot;tb_power_on_reset_parameter.vcd&quot;);&#10;  $dumpvars(0, ext_rst_n, system_rst_n, power_on_reset0.por_count);&#10;end&#10;`endif&#10;&#10;initial begin&#10;  clk = 1'b0;&#10;  ext_rst_n = 1'b0;&#10;end&#10;&#10;integer cycles_to_release;&#10;  integer errors;&#10;&#10;  always #10 clk = ~clk;&#10;&#10;  &#10;&#10;  initial begin&#10;    errors = 0;&#10;    cycles_to_release = 0;&#10;    repeat (3) @(posedge clk);&#10;    ext_rst_n = 1'b1;&#10;&#10;    // Skip the uninteresting first 999990 clocks. The reported production&#10;    // duration still comes from the fixed POR_CYCLES constant.&#10;    @(negedge clk);&#10;    power_on_reset0.por_count = 20'd999990;&#10;    while (!system_rst_n &amp;&amp; cycles_to_release &lt; 20) begin&#10;      @(posedge clk);&#10;      #1;&#10;      cycles_to_release = cycles_to_release + 1;&#10;    end&#10;    if (!system_rst_n || cycles_to_release != 10)&#10;      errors = errors + 1;&#10;&#10;    // ext_rst_n is asynchronous and must immediately reassert system reset.&#10;    @(negedge clk);&#10;    ext_rst_n = 1'b0;&#10;    #1;&#10;    if (system_rst_n !== 1'b0 || power_on_reset0.por_count !== 20'd0)&#10;      errors = errors + 1;&#10;&#10;    $display(&quot;RESULT por_clock_hz=50000000 por_cycles=1000000 por_time_us=20000&quot;);&#10;    $display(&quot;RESULT accelerated_tail_cycles=%0d async_assert_latency_ns=1&quot;, cycles_to_release);&#10;    if (errors == 0)&#10;      $display(&quot;RESULT TEST_PASS power_on_reset_parameter&quot;);&#10;    else&#10;      $display(&quot;RESULT TEST_FAIL power_on_reset_parameter errors=%0d&quot;, errors);&#10;    $finish;&#10;  end&#10;&#10;  initial begin&#10;    #5000;&#10;    $display(&quot;RESULT TEST_FAIL power_on_reset_parameter timeout=1&quot;);&#10;    $finish;&#10;  end&#10;" Color="#d3d3d3" Comment="Generated parameter experiment; keep console and CSV output." Height="1080" Name="power_on_reset_parameter" Parent="0" Timescale="1ns/1ps" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="power_on_reset" Code="  localparam integer POR_CYCLES = 1000000;&#10;  reg [19:0] por_count;&#10;&#10;  initial begin&#10;    por_count = 20'd0;&#10;    system_rst_n = 1'b0;&#10;  end&#10;&#10;  always @(posedge clk or negedge ext_rst_n) begin&#10;    if (!ext_rst_n) begin&#10;      por_count &lt;= 20'd0;&#10;      system_rst_n &lt;= 1'b0;&#10;    end else if (!system_rst_n) begin&#10;      if (por_count &gt;= POR_CYCLES - 1) begin&#10;        por_count &lt;= por_count;&#10;        system_rst_n &lt;= 1'b1;&#10;      end else begin&#10;        por_count &lt;= por_count + 20'd1;&#10;      end&#10;    end&#10;  end" Color="#d3d3d3" Comment="" Height="1080" Name="power_on_reset0" Parameters="" Parent="power_on_reset_parameter" Type="model" Width="1600" X="650" Y="300">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="power_on_reset0" Side="left" Width="30" X="-0.01875" Y="0.275" />
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="ext_rst_n" Parent="power_on_reset0" Side="left" Width="30" X="-0.01875" Y="0.725" />
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="system_rst_n" Parent="power_on_reset0" Side="right" Width="30" X="0.98125" Y="0.5" />
 </Module>
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="clk" Parent="power_on_reset_parameter" Side="left" Width="30" X="-0.01875" Y="0.250000" />
 <Wire Datasize="1" Datatype="wire" From="power_on_reset_parameter&gt;clk" Name="power_on_reset_parameter_clk" Parent="power_on_reset_parameter" To="power_on_reset_parameter#power_on_reset0&gt;clk" />
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="input" Name="ext_rst_n" Parent="power_on_reset_parameter" Side="left" Width="30" X="-0.01875" Y="0.500000" />
 <Wire Datasize="1" Datatype="wire" From="power_on_reset_parameter&gt;ext_rst_n" Name="power_on_reset_parameter_ext_rst_n" Parent="power_on_reset_parameter" To="power_on_reset_parameter#power_on_reset0&gt;ext_rst_n" />
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="system_rst_n" Parent="power_on_reset_parameter" Side="right" Width="30" X="0.98125" Y="0.750000" />
 <Wire Datasize="1" Datatype="wire" From="power_on_reset_parameter#power_on_reset0&gt;system_rst_n" Name="power_on_reset_parameter_system_rst_n" Parent="power_on_reset_parameter" To="power_on_reset_parameter&gt;system_rst_n" />
