  <Port Color="#fff8dc" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="rx_framing_error_count" Parent="linkpg_tag_position_uart33" Side="right" Width="30" X="0.98125" Y="0.8176471"/>
  <Port Color="#dc143c" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="start_request_count" Parent="linkpg_tag_position_uart33" Side="right" Width="30" X="0.98125" Y="0.8705882"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="start_ack_seen" Parent="linkpg_tag_position_uart33" Side="right" Width="30" X="0.98125" Y="0.9235294"/>
 </Module>
 <Module Category="Current" Class="vehicle_debug_uart" Code="`ifdef VEHICLE_DEBUG_SIM_FAST&#xa;  localparam integer REPORT_PERIOD_CYCLES = 80;&#xa;  localparam integer CLKS_PER_BIT = 4;&#xa;`else&#xa;  localparam integer REPORT_PERIOD_CYCLES = 25000000; &#xa;  localparam integer CLKS_PER_BIT = 434;              &#xa;`endif&#xa;  localparam [4:0] LAST_BYTE = 5&#x27;d21;&#xa;  wire [7:0] motion_status = motion_telemetry_data[7:0];&#xa;&#xa;  reg [7:0] snapshot_flags;&#xa;  reg signed [15:0] snapshot_uwb_x_cm;&#xa;  reg signed [15:0] snapshot_uwb_y_cm;&#xa;  reg [15:0] snapshot_packet_count;&#xa;  reg [15:0] snapshot_crc_error_count;&#xa;  reg [15:0] snapshot_start_request_count;&#xa;  reg [15:0] snapshot_pose_x_mm;&#xa;  reg [15:0] snapshot_pose_y_mm;&#xa;  reg [9:0] snapshot_pose_heading;&#xa;  reg [7:0] snapshot_motion_status;&#xa;&#xa;  &#xa;  &#xa;  &#xa;  &#xa;  function [7:0] report_byte;&#xa;    input [4:0] index;&#xa;    begin&#xa;      case (index)&#xa;        5&#x27;d0: report_byte = 8&#x27;hA5;&#xa;        5&#x27;d1: report_byte = 8&#x27;h5A;&#xa;        5&#x27;d2: report_byte = 8&#x27;h02;&#xa;        5&#x27;d3: report_byte = snapshot_flags;&#xa;        5&#x27;d4: report_byte = snapshot_uwb_x_cm[7:0];&#xa;        5&#x27;d5: report_byte = snapshot_uwb_x_cm[15:8];&#xa;        5&#x27;d6: report_byte = snapshot_uwb_y_cm[7:0];&#xa;        5&#x27;d7: report_byte = snapshot_uwb_y_cm[15:8];&#xa;        5&#x27;d8: report_byte = snapshot_packet_count[7:0];&#xa;        5&#x27;d9: report_byte = snapshot_packet_count[15:8];&#xa;        5&#x27;d10: report_byte = snapshot_crc_error_count[7:0];&#xa;        5&#x27;d11: report_byte = snapshot_crc_error_count[15:8];&#xa;        5&#x27;d12: report_byte = snapshot_start_request_count[7:0];&#xa;        5&#x27;d13: report_byte = snapshot_start_request_count[15:8];&#xa;        5&#x27;d14: report_byte = snapshot_pose_x_mm[7:0];&#xa;        5&#x27;d15: report_byte = snapshot_pose_x_mm[15:8];&#xa;        5&#x27;d16: report_byte = snapshot_pose_y_mm[7:0];&#xa;        5&#x27;d17: report_byte = snapshot_pose_y_mm[15:8];&#xa;        5&#x27;d18: report_byte = snapshot_pose_heading[7:0];&#xa;        5&#x27;d19: report_byte = {6&#x27;d0, snapshot_pose_heading[9:8]};&#xa;        5&#x27;d20: report_byte = snapshot_motion_status;&#xa;        default: report_byte = 8&#x27;h0A;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  reg [24:0] report_period_count;&#xa;  reg report_sending;&#xa;  reg [4:0] report_index;&#xa;  reg [7:0] tx_data;&#xa;  reg tx_start;&#xa;  reg tx_busy;&#xa;  reg tx_busy_d;&#xa;  reg [1:0] tx_state;&#xa;  reg [15:0] tx_clock_count;&#xa;  reg [2:0] tx_bit_index;&#xa;  reg [7:0] tx_shift;&#xa;  wire tx_done = tx_busy_d &amp;&amp; !tx_busy;&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      debug_uart_tx &lt;= 1&#x27;b1;&#xa;      tx_busy &lt;= 1&#x27;b0;&#xa;      tx_busy_d &lt;= 1&#x27;b0;&#xa;      tx_state &lt;= 2&#x27;d0;&#xa;      tx_clock_count &lt;= 16&#x27;d0;&#xa;      tx_bit_index &lt;= 3&#x27;d0;&#xa;      tx_shift &lt;= 8&#x27;d0;&#xa;    end else begin&#xa;      tx_busy_d &lt;= tx_busy;&#xa;      case (tx_state)&#xa;        2&#x27;d0: begin&#xa;          debug_uart_tx &lt;= 1&#x27;b1;&#xa;          tx_busy &lt;= 1&#x27;b0;&#xa;          tx_clock_count &lt;= 16&#x27;d0;&#xa;          tx_bit_index &lt;= 3&#x27;d0;&#xa;          if (tx_start) begin&#xa;            tx_shift &lt;= tx_data;&#xa;            debug_uart_tx &lt;= 1&#x27;b0;&#xa;            tx_busy &lt;= 1&#x27;b1;&#xa;            tx_state &lt;= 2&#x27;d1;&#xa;          end&#xa;        end&#xa;        2&#x27;d1: begin&#xa;          debug_uart_tx &lt;= 1&#x27;b0;&#xa;          tx_busy &lt;= 1&#x27;b1;&#xa;          if (tx_clock_count &gt;= CLKS_PER_BIT - 1) begin&#xa;            tx_clock_count &lt;= 16&#x27;d0;&#xa;            debug_uart_tx &lt;= tx_shift[0];&#xa;            tx_state &lt;= 2&#x27;d2;&#xa;          end else tx_clock_count &lt;= tx_clock_count + 16&#x27;d1;&#xa;        end&#xa;        2&#x27;d2: begin&#xa;          debug_uart_tx &lt;= tx_shift[tx_bit_index];&#xa;          tx_busy &lt;= 1&#x27;b1;&#xa;          if (tx_clock_count &gt;= CLKS_PER_BIT - 1) begin&#xa;            tx_clock_count &lt;= 16&#x27;d0;&#xa;            if (tx_bit_index == 3&#x27;d7) begin&#xa;              tx_bit_index &lt;= 3&#x27;d0;&#xa;              debug_uart_tx &lt;= 1&#x27;b1;&#xa;              tx_state &lt;= 2&#x27;d3;&#xa;            end else begin&#xa;              tx_bit_index &lt;= tx_bit_index + 3&#x27;d1;&#xa;              debug_uart_tx &lt;= tx_shift[tx_bit_index + 3&#x27;d1];&#xa;            end&#xa;          end else tx_clock_count &lt;= tx_clock_count + 16&#x27;d1;&#xa;        end&#xa;        default: begin&#xa;          debug_uart_tx &lt;= 1&#x27;b1;&#xa;          tx_busy &lt;= 1&#x27;b1;&#xa;          if (tx_clock_count &gt;= CLKS_PER_BIT - 1) begin&#xa;            tx_clock_count &lt;= 16&#x27;d0;&#xa;            tx_busy &lt;= 1&#x27;b0;&#xa;            tx_state &lt;= 2&#x27;d0;&#xa;          end else tx_clock_count &lt;= tx_clock_count + 16&#x27;d1;&#xa;        end&#xa;      endcase&#xa;    end&#xa;  end&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      snapshot_flags &lt;= 8&#x27;d0;&#xa;      snapshot_uwb_x_cm &lt;= 16&#x27;sd0;&#xa;      snapshot_uwb_y_cm &lt;= 16&#x27;sd0;&#xa;      snapshot_packet_count &lt;= 16&#x27;d0;&#xa;      snapshot_crc_error_count &lt;= 16&#x27;d0;&#xa;      snapshot_start_request_count &lt;= 16&#x27;d0;&#xa;      snapshot_pose_x_mm &lt;= 16&#x27;d0;&#xa;      snapshot_pose_y_mm &lt;= 16&#x27;d0;&#xa;      snapshot_pose_heading &lt;= 10&#x27;d0;&#xa;      snapshot_motion_status &lt;= 8&#x27;d0;&#xa;      report_period_count &lt;= 25&#x27;d0;&#xa;      report_sending &lt;= 1&#x27;b0;&#xa;      report_index &lt;= 5&#x27;d0;&#xa;      tx_data &lt;= 8&#x27;d0;&#xa;      tx_start &lt;= 1&#x27;b0;&#xa;    end else begin&#xa;      tx_start &lt;= 1&#x27;b0;&#xa;      if (!report_sending) begin&#xa;        if (report_period_count &gt;= REPORT_PERIOD_CYCLES - 1) begin&#xa;          report_period_count &lt;= 25&#x27;d0;&#xa;          report_sending &lt;= 1&#x27;b1;&#xa;          report_index &lt;= 5&#x27;d0;&#xa;          snapshot_flags &lt;= {&#xa;              bt_connected, lidar_enable, lidar_scan_active, lidar_online,&#xa;              uwb_position_online, uwb_position_good, uwb_start_ack_seen,&#xa;              motion_status[0]&#xa;          };&#xa;          snapshot_uwb_x_cm &lt;= uwb_position_x_cm;&#xa;          snapshot_uwb_y_cm &lt;= uwb_position_y_cm;&#xa;          snapshot_packet_count &lt;= uwb_packet_count;&#xa;          snapshot_crc_error_count &lt;= uwb_crc_error_count;&#xa;          snapshot_start_request_count &lt;= uwb_start_request_count;&#xa;          snapshot_pose_x_mm &lt;= map_pose_x_mm;&#xa;          snapshot_pose_y_mm &lt;= map_pose_y_mm;&#xa;          snapshot_pose_heading &lt;= map_pose_heading;&#xa;          snapshot_motion_status &lt;= motion_status;&#xa;          tx_data &lt;= 8&#x27;hA5;&#xa;          tx_start &lt;= 1&#x27;b1;&#xa;        end else report_period_count &lt;= report_period_count + 25&#x27;d1;&#xa;      end else if (tx_done) begin&#xa;        if (report_index &gt;= LAST_BYTE) begin&#xa;          report_sending &lt;= 1&#x27;b0;&#xa;          report_index &lt;= 5&#x27;d0;&#xa;        end else begin&#xa;          report_index &lt;= report_index + 5&#x27;d1;&#xa;          tx_data &lt;= report_byte(report_index + 5&#x27;d1);&#xa;          tx_start &lt;= 1&#x27;b1;&#xa;        end&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="vehicle_debug_uart34" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="1600" X="7250" Y="1750">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.0725"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.1175"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_connected" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.1625"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="lidar_enable" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.2075"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="lidar_scan_active" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.2525"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="lidar_online" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.2975"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_position_online" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.3425"/>
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_position_good" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.3875"/>
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_start_ack_seen" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.4325"/>
  <Port Color="#8a2be2" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_position_x_cm" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.4775"/>
  <Port Color="#a52a2a" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_position_y_cm" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.5225"/>
  <Port Color="#deb887" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_packet_count" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.5675"/>
  <Port Color="#5f9ea0" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_crc_error_count" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.6125"/>
  <Port Color="#7fff00" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_start_request_count" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.6575"/>
  <Port Color="#d2691e" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="map_pose_x_mm" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.7025"/>
  <Port Color="#ff7f50" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="map_pose_y_mm" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.7475"/>
  <Port Color="#6495ed" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="map_pose_heading" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.7925"/>
  <Port Color="#fff8dc" Connect="" Datasize="11" Datatype="wire" Description="" Height="30" Inout="input" Name="flow_correction" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.8375"/>
  <Port Color="#dc143c" Connect="" Datasize="11" Datatype="wire" Description="" Height="30" Inout="input" Name="yaw_correction" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.8825"/>
  <Port Color="#00ffff" Connect="" Datasize="320" Datatype="wire" Description="" Height="30" Inout="input" Name="motion_telemetry_data" Parent="vehicle_debug_uart34" Side="left" Width="30" X="-0.01875" Y="0.9275"/>
  <Port Color="#00008b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="debug_uart_tx" Parent="vehicle_debug_uart34" Side="right" Width="30" X="0.98125" Y="0.5"/>
 </Module>
 <Module Category="Current" Class="onboard_exploration_controller" Code="parameter integer CLK_HZ = 50000000;&#xa;&#xa;  localparam [2:0] CMD_STOP    = 3&#x27;d0;&#xa;  localparam [2:0] CMD_FORWARD = 3&#x27;d1;&#xa;  localparam [2:0] CMD_REVERSE = 3&#x27;d2;&#xa;  localparam [2:0] CMD_LEFT    = 3&#x27;d3;&#xa;  localparam [2:0] CMD_RIGHT   = 3&#x27;d4;&#xa;&#xa;  localparam [3:0] EXP_STOP    = 4&#x27;d0;&#xa;  localparam [3:0] EXP_DECIDE  = 4&#x27;d1;&#xa;  localparam [3:0] EXP_FORWARD = 4&#x27;d2;&#xa;  localparam [3:0] EXP_REVERSE = 4&#x27;d3;&#xa;  localparam [3:0] EXP_LEFT    = 4&#x27;d4;&#xa;  localparam [3:0] EXP_RIGHT   = 4&#x27;d5;&#xa;  localparam [3:0] EXP_SETTLE  = 4&#x27;d6;&#xa;&#xa;  localparam [3:0] STOP_NONE       = 4&#x27;d0;&#xa;  localparam [3:0] STOP_NOT_ARMED  = 4&#x27;d1;&#xa;  localparam [3:0] STOP_CALIBRATION = 4&#x27;d2;&#xa;  localparam [3:0] STOP_LIDAR      = 4&#x27;d3;&#xa;  localparam [3:0] STOP_SCAN_STALE = 4&#x27;d4;&#xa;&#xa;`ifdef ONBOARD_EXPLORATION_SIM_FAST&#xa;  localparam integer MS_DIVISOR = 4;&#xa;  localparam [15:0] FORWARD_MS = 16&#x27;d12;&#xa;  localparam [15:0] REVERSE_MS = 16&#x27;d8;&#xa;  localparam [15:0] TURN_MS = 16&#x27;d10;&#xa;  localparam [15:0] SETTLE_MS = 16&#x27;d4;&#xa;  localparam [15:0] SCAN_TIMEOUT_MS = 16&#x27;d25;&#xa;`else&#xa;  localparam integer MS_DIVISOR = CLK_HZ / 1000;&#xa;  // Bound blind travel to one short lease. EXP_SETTLE still requires a scan&#xa;  // captured after the stop before the next movement is selected.&#xa;  localparam [15:0] FORWARD_MS = 16&#x27;d90;&#xa;  localparam [15:0] REVERSE_MS = 16&#x27;d120;&#xa;  localparam [15:0] TURN_MS = 16&#x27;d300;&#xa;  localparam [15:0] SETTLE_MS = 16&#x27;d650;&#xa;  localparam [15:0] SCAN_TIMEOUT_MS = 16&#x27;d1000;&#xa;`endif&#xa;&#xa;  localparam [15:0] MAP_LOW_LIMIT_MM = 16&#x27;d450;&#xa;  localparam [15:0] MAP_HIGH_LIMIT_MM = 16&#x27;d5950;&#xa;&#xa;  reg [31:0] ms_divider;&#xa;  reg [15:0] action_ms;&#xa;  reg [15:0] scan_age_ms;&#xa;  reg turn_right_preferred;&#xa;  reg settle_scan_seen;&#xa;&#xa;  wire request_active = map_active &amp;&amp; !map_paused &amp;&amp; !manual_mode;&#xa;  wire sensors_ready = sensor_calibration_done &amp;&amp; gyro_polarity_valid;&#xa;  wire lidar_ready = lidar_online &amp;&amp; scan_active;&#xa;  wire scan_fresh = scan_age_ms &lt; SCAN_TIMEOUT_MS;&#xa;  assign auto_mode = request_active;&#xa;&#xa;  function distance_below;&#xa;    input [15:0] distance;&#xa;    input [15:0] threshold;&#xa;    begin&#xa;      distance_below = (distance != 16&#x27;hffff) &amp;&amp;&#xa;                       (distance &gt;= 16&#x27;d50) &amp;&amp;&#xa;                       (distance &lt; threshold);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [15:0] clearance_value;&#xa;    input [15:0] distance;&#xa;    begin&#xa;      clearance_value = (distance == 16&#x27;hffff) ? 16&#x27;hfffe : distance;&#xa;    end&#xa;  endfunction&#xa;&#xa;  wire [15:0] front_threshold = safe_distance_mm + 16&#x27;d120;&#xa;  wire front_data_valid = (sector_front_mm != 16&#x27;hffff) ||&#xa;      (sector_front_left_mm != 16&#x27;hffff) ||&#xa;      (sector_front_right_mm != 16&#x27;hffff);&#xa;  wire front_blocked = !front_data_valid || obstacle_stop ||&#xa;      distance_below(sector_front_mm, front_threshold) ||&#xa;      distance_below(sector_front_left_mm, safe_distance_mm) ||&#xa;      distance_below(sector_front_right_mm, safe_distance_mm);&#xa;  wire rear_blocked = distance_below(sector_rear_mm, safe_distance_mm) ||&#xa;      distance_below(sector_rear_left_mm, safe_distance_mm) ||&#xa;      distance_below(sector_rear_right_mm, safe_distance_mm);&#xa;  wire [15:0] left_clearance =&#xa;      (clearance_value(sector_left_mm) &lt; clearance_value(sector_front_left_mm)) ?&#xa;      clearance_value(sector_left_mm) : clearance_value(sector_front_left_mm);&#xa;  wire [15:0] right_clearance =&#xa;      (clearance_value(sector_right_mm) &lt; clearance_value(sector_front_right_mm)) ?&#xa;      clearance_value(sector_right_mm) : clearance_value(sector_front_right_mm);&#xa;  &#xa;  &#xa;  &#xa;  wire left_turn_blocked =&#xa;      distance_below(sector_front_left_mm, front_threshold) ||&#xa;      distance_below(sector_left_mm, safe_distance_mm) ||&#xa;      distance_below(sector_rear_right_mm, safe_distance_mm);&#xa;  wire right_turn_blocked =&#xa;      distance_below(sector_front_right_mm, front_threshold) ||&#xa;      distance_below(sector_right_mm, safe_distance_mm) ||&#xa;      distance_below(sector_rear_left_mm, safe_distance_mm);&#xa;&#xa;  &#xa;  &#xa;  &#xa;  &#xa;  wire [15:0] field_low_x_ext = {8&#x27;d0, field_low_x_cell};&#xa;  wire [15:0] field_high_x_ext = {8&#x27;d0, field_high_x_cell};&#xa;  wire [15:0] field_low_y_ext = {8&#x27;d0, field_low_y_cell};&#xa;  wire [15:0] field_high_y_ext = {8&#x27;d0, field_high_y_cell};&#xa;  wire [15:0] field_low_x_mm = (field_low_x_ext &lt;&lt; 5) +&#xa;      (field_low_x_ext &lt;&lt; 4) + (field_low_x_ext &lt;&lt; 1);&#xa;  wire [15:0] field_high_x_mm = (field_high_x_ext &lt;&lt; 5) +&#xa;      (field_high_x_ext &lt;&lt; 4) + (field_high_x_ext &lt;&lt; 1);&#xa;  wire [15:0] field_low_y_mm = (field_low_y_ext &lt;&lt; 5) +&#xa;      (field_low_y_ext &lt;&lt; 4) + (field_low_y_ext &lt;&lt; 1);&#xa;  wire [15:0] field_high_y_mm = (field_high_y_ext &lt;&lt; 5) +&#xa;      (field_high_y_ext &lt;&lt; 4) + (field_high_y_ext &lt;&lt; 1);&#xa;  wire local_map_boundary_ahead =&#xa;      ((pose_heading &lt; 10&#x27;d128 || pose_heading &gt;= 10&#x27;d896) &amp;&amp;&#xa;       pose_x_mm &gt;= MAP_HIGH_LIMIT_MM) ||&#xa;      ((pose_heading &gt;= 10&#x27;d128 &amp;&amp; pose_heading &lt; 10&#x27;d384) &amp;&amp;&#xa;       pose_y_mm &gt;= MAP_HIGH_LIMIT_MM) ||&#xa;      ((pose_heading &gt;= 10&#x27;d384 &amp;&amp; pose_heading &lt; 10&#x27;d640) &amp;&amp;&#xa;       pose_x_mm &lt;= MAP_LOW_LIMIT_MM) ||&#xa;      ((pose_heading &gt;= 10&#x27;d640 &amp;&amp; pose_heading &lt; 10&#x27;d896) &amp;&amp;&#xa;       pose_y_mm &lt;= MAP_LOW_LIMIT_MM);&#xa;  wire configured_boundary_ahead =&#xa;      ((pose_heading &lt; 10&#x27;d128 || pose_heading &gt;= 10&#x27;d896) &amp;&amp;&#xa;       pose_x_mm &gt;= field_high_x_mm) ||&#xa;      ((pose_heading &gt;= 10&#x27;d128 &amp;&amp; pose_heading &lt; 10&#x27;d384) &amp;&amp;&#xa;       pose_y_mm &gt;= field_high_y_mm) ||&#xa;      ((pose_heading &gt;= 10&#x27;d384 &amp;&amp; pose_heading &lt; 10&#x27;d640) &amp;&amp;&#xa;       pose_x_mm &lt;= field_low_x_mm) ||&#xa;      ((pose_heading &gt;= 10&#x27;d640 &amp;&amp; pose_heading &lt; 10&#x27;d896) &amp;&amp;&#xa;       pose_y_mm &lt;= field_low_y_mm);&#xa;  wire boundary_ahead = field_config_valid ?&#xa;      configured_boundary_ahead : local_map_boundary_ahead;&#xa;&#xa;  wire millisecond_tick = (ms_divider &gt;= MS_DIVISOR - 1);&#xa;&#xa;  always @* begin&#xa;    case (exploration_state)&#xa;      EXP_FORWARD: auto_cmd = CMD_FORWARD;&#xa;      EXP_REVERSE: auto_cmd = CMD_REVERSE;&#xa;      EXP_LEFT: auto_cmd = CMD_LEFT;&#xa;      EXP_RIGHT: auto_cmd = CMD_RIGHT;&#xa;      default: auto_cmd = CMD_STOP;&#xa;    endcase&#xa;  end&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      ms_divider &lt;= 32&#x27;d0;&#xa;      action_ms &lt;= 16&#x27;d0;&#xa;      scan_age_ms &lt;= SCAN_TIMEOUT_MS;&#xa;      turn_right_preferred &lt;= 1&#x27;b0;&#xa;      settle_scan_seen &lt;= 1&#x27;b0;&#xa;      exploration_state &lt;= EXP_STOP;&#xa;      stop_reason &lt;= STOP_NOT_ARMED;&#xa;    end else begin&#xa;      if (lidar_new_scan) begin&#xa;        scan_age_ms &lt;= 16&#x27;d0;&#xa;        if (exploration_state == EXP_SETTLE)&#xa;          settle_scan_seen &lt;= 1&#x27;b1;&#xa;      end&#xa;&#xa;      if (millisecond_tick) begin&#xa;        ms_divider &lt;= 32&#x27;d0;&#xa;        if (!lidar_new_scan &amp;&amp; scan_age_ms != 16&#x27;hffff)&#xa;          scan_age_ms &lt;= scan_age_ms + 16&#x27;d1;&#xa;        if (action_ms != 16&#x27;d0)&#xa;          action_ms &lt;= action_ms - 16&#x27;d1;&#xa;&#xa;        if (!request_active) begin&#xa;          exploration_state &lt;= EXP_STOP;&#xa;          action_ms &lt;= 16&#x27;d0;&#xa;          stop_reason &lt;= STOP_NOT_ARMED;&#xa;        end else if (!sensors_ready) begin&#xa;          exploration_state &lt;= EXP_STOP;&#xa;          action_ms &lt;= 16&#x27;d0;&#xa;          stop_reason &lt;= STOP_CALIBRATION;&#xa;        end else if (!lidar_ready) begin&#xa;          exploration_state &lt;= EXP_STOP;&#xa;          action_ms &lt;= 16&#x27;d0;&#xa;          stop_reason &lt;= STOP_LIDAR;&#xa;        end else if (!scan_fresh) begin&#xa;          exploration_state &lt;= EXP_STOP;&#xa;          action_ms &lt;= 16&#x27;d0;&#xa;          stop_reason &lt;= STOP_SCAN_STALE;&#xa;        end else begin&#xa;          stop_reason &lt;= STOP_NONE;&#xa;          case (exploration_state)&#xa;            EXP_STOP, EXP_DECIDE: begin&#xa;              if (front_blocked || boundary_ahead) begin&#xa;                turn_right_preferred &lt;= right_clearance &gt; left_clearance;&#xa;                if (!rear_blocked) begin&#xa;                  exploration_state &lt;= EXP_REVERSE;&#xa;                  action_ms &lt;= REVERSE_MS;&#xa;                end else if (!right_turn_blocked &amp;&amp;&#xa;                             (left_turn_blocked || right_clearance &gt; left_clearance)) begin&#xa;                  exploration_state &lt;= EXP_RIGHT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else if (!left_turn_blocked) begin&#xa;                  exploration_state &lt;= EXP_LEFT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else begin&#xa;                  exploration_state &lt;= EXP_SETTLE;&#xa;                  action_ms &lt;= SETTLE_MS;&#xa;                end&#xa;              end else begin&#xa;                exploration_state &lt;= EXP_FORWARD;&#xa;                action_ms &lt;= FORWARD_MS;&#xa;              end&#xa;            end&#xa;&#xa;            EXP_FORWARD: begin&#xa;              if (front_blocked || boundary_ahead) begin&#xa;                exploration_state &lt;= EXP_SETTLE;&#xa;                action_ms &lt;= SETTLE_MS;&#xa;                settle_scan_seen &lt;= 1&#x27;b0;&#xa;                turn_right_preferred &lt;= right_clearance &gt; left_clearance;&#xa;              end else if (action_ms == 16&#x27;d0) begin&#xa;                exploration_state &lt;= EXP_SETTLE;&#xa;                action_ms &lt;= SETTLE_MS;&#xa;                settle_scan_seen &lt;= 1&#x27;b0;&#xa;              end&#xa;            end&#xa;&#xa;            EXP_REVERSE: begin&#xa;              if (action_ms == 16&#x27;d0 || rear_blocked) begin&#xa;                if (turn_right_preferred &amp;&amp; !right_turn_blocked) begin&#xa;                  exploration_state &lt;= EXP_RIGHT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else if (!left_turn_blocked) begin&#xa;                  exploration_state &lt;= EXP_LEFT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else if (!right_turn_blocked) begin&#xa;                  exploration_state &lt;= EXP_RIGHT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else begin&#xa;                  exploration_state &lt;= EXP_SETTLE;&#xa;                  action_ms &lt;= SETTLE_MS;&#xa;                  settle_scan_seen &lt;= 1&#x27;b0;&#xa;                end&#xa;              end&#xa;            end&#xa;&#xa;            EXP_LEFT, EXP_RIGHT: begin&#xa;              if (action_ms == 16&#x27;d0 ||&#xa;                  (exploration_state == EXP_LEFT &amp;&amp; left_turn_blocked) ||&#xa;                  (exploration_state == EXP_RIGHT &amp;&amp; right_turn_blocked)) begin&#xa;                exploration_state &lt;= EXP_SETTLE;&#xa;                action_ms &lt;= SETTLE_MS;&#xa;                settle_scan_seen &lt;= 1&#x27;b0;&#xa;              end&#xa;            end&#xa;&#xa;            EXP_SETTLE: begin&#xa;              if (action_ms == 16&#x27;d0 &amp;&amp; settle_scan_seen) begin&#xa;                exploration_state &lt;= EXP_DECIDE;&#xa;                settle_scan_seen &lt;= 1&#x27;b0;&#xa;              end&#xa;            end&#xa;&#xa;            default: begin&#xa;              exploration_state &lt;= EXP_STOP;&#xa;            end&#xa;          endcase&#xa;        end&#xa;      end else begin&#xa;        ms_divider &lt;= ms_divider + 32&#x27;d1;&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="onboard_exploration_controller35" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="1600" X="5100" Y="3650">
