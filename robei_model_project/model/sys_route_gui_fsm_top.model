  <Port Color="#9932cc" Connect="" Datasize="11" Datatype="wire" Description="" Height="30" Inout="output" Name="flow_correction" Parent="c5_motion_stabilizer29" Side="right" Width="30" X="0.98125" Y="0.56"/>
