 <Module Category="Current" Class="temp_c5_motor_config_source" Code="  assign motor_enable = 1'b1;&#10;  assign motor_forward_ms = 16'd2500;&#10;  assign motor_turn_ms = 16'd550;&#10;  assign motor_forward_speed = 10'd700;&#10;  assign motor_turn_speed = 10'd650;" Color="#8b5cf6" Comment="" Height="561" Name="temp_c5_motor_config_source11" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="376" X="657.518" Y="2241.91">
