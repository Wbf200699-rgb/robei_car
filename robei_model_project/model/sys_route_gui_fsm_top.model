 <Module Category="Current" Class="ultrasonic_obstacle_guard" Code="  localparam [2:0] ST_TRIG      = 3'd0;&#10;  localparam [2:0] ST_WAIT_ECHO = 3'd1;&#10;  localparam [2:0] ST_MEASURE   = 3'd2;&#10;  localparam [2:0] ST_GAP       = 3'd3;&#10;&#10;  localparam [31:0] TRIG_CYCLES     = 32'd500;      // 10 us at 50 MHz&#10;  localparam [31:0] ECHO_TIMEOUT    = 32'd1500000;  // 30 ms at 50 MHz&#10;  localparam [31:0] MEASURE_PERIOD  = 32'd3000000;  // 60 ms at 50 MHz&#10;  localparam [31:0] CYCLES_PER_CM   = 32'd2900;     // 58 us/cm * 50 cycles/us&#10;  localparam [15:0] DEFAULT_STEP_CM = 16'd20;&#10;&#10;  reg [2:0] state;&#10;  reg [31:0] cnt;&#10;  reg [31:0] echo_cycles;&#10;  reg [31:0] cm_cycle_cnt;&#10;  reg [15:0] measured_cm;&#10;  reg echo_d0;&#10;  reg echo_d1;&#10;  reg echo_d2;&#10;  reg [15:0] compare_length;&#10;&#10;  wire echo_sync;&#10;  wire echo_rise;&#10;  wire echo_fall;&#10;&#10;  assign echo_sync = echo_d1;&#10;  assign echo_rise = echo_d1 &amp; ~echo_d2;&#10;  assign echo_fall = ~echo_d1 &amp; echo_d2;&#10;&#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      echo_d0 &lt;= 1'b0;&#10;      echo_d1 &lt;= 1'b0;&#10;      echo_d2 &lt;= 1'b0;&#10;    end else begin&#10;      echo_d0 &lt;= echo;&#10;      echo_d1 &lt;= echo_d0;&#10;      echo_d2 &lt;= echo_d1;&#10;    end&#10;  end&#10;&#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      state &lt;= ST_TRIG;&#10;      cnt &lt;= 32'd0;&#10;      echo_cycles &lt;= 32'd0;&#10;      cm_cycle_cnt &lt;= 32'd0;&#10;      measured_cm &lt;= 16'd0;&#10;      trig &lt;= 1'b0;&#10;      distance_cm &lt;= 16'd0;&#10;      distance_valid &lt;= 1'b0;&#10;      obstacle_stop &lt;= 1'b0;&#10;      echo_timeout &lt;= 1'b0;&#10;      compare_length &lt;= DEFAULT_STEP_CM;&#10;    end else begin&#10;      distance_valid &lt;= 1'b0;&#10;      obstacle_stop &lt;= 1'b0;&#10;&#10;      if (step_length == 16'd0)&#10;        compare_length &lt;= DEFAULT_STEP_CM;&#10;      else&#10;        compare_length &lt;= step_length;&#10;&#10;      if (!enable) begin&#10;        state &lt;= ST_TRIG;&#10;        cnt &lt;= 32'd0;&#10;        echo_cycles &lt;= 32'd0;&#10;        cm_cycle_cnt &lt;= 32'd0;&#10;        measured_cm &lt;= 16'd0;&#10;        trig &lt;= 1'b0;&#10;        obstacle_stop &lt;= 1'b0;&#10;        echo_timeout &lt;= 1'b0;&#10;      end else begin&#10;        case (state)&#10;        ST_TRIG: begin&#10;          trig &lt;= 1'b1;&#10;          echo_timeout &lt;= 1'b0;&#10;          echo_cycles &lt;= 32'd0;&#10;          cm_cycle_cnt &lt;= 32'd0;&#10;          measured_cm &lt;= 16'd0;&#10;&#10;          if (cnt &gt;= TRIG_CYCLES - 32'd1) begin&#10;            cnt &lt;= 32'd0;&#10;            trig &lt;= 1'b0;&#10;            state &lt;= ST_WAIT_ECHO;&#10;          end else begin&#10;            cnt &lt;= cnt + 32'd1;&#10;          end&#10;        end&#10;&#10;        ST_WAIT_ECHO: begin&#10;          trig &lt;= 1'b0;&#10;&#10;          if (echo_rise || echo_sync) begin&#10;            cnt &lt;= 32'd0;&#10;            echo_cycles &lt;= 32'd0;&#10;            cm_cycle_cnt &lt;= 32'd0;&#10;            measured_cm &lt;= 16'd0;&#10;            state &lt;= ST_MEASURE;&#10;          end else if (cnt &gt;= ECHO_TIMEOUT - 32'd1) begin&#10;            cnt &lt;= 32'd0;&#10;            echo_timeout &lt;= 1'b1;&#10;            distance_cm &lt;= 16'hFFFF;&#10;            distance_valid &lt;= 1'b1;&#10;            obstacle_stop &lt;= 1'b0;&#10;            state &lt;= ST_GAP;&#10;          end else begin&#10;            cnt &lt;= cnt + 32'd1;&#10;          end&#10;        end&#10;&#10;        ST_MEASURE: begin&#10;          trig &lt;= 1'b0;&#10;&#10;          if (echo_fall) begin&#10;            if (measured_cm == 16'd0 &amp;&amp; echo_cycles != 32'd0)&#10;              distance_cm &lt;= 16'd1;&#10;            else&#10;              distance_cm &lt;= measured_cm;&#10;&#10;            distance_valid &lt;= 1'b1;&#10;            echo_timeout &lt;= 1'b0;&#10;&#10;            if (((measured_cm == 16'd0 &amp;&amp; echo_cycles != 32'd0) ? 16'd1 : measured_cm) &lt; compare_length)&#10;              obstacle_stop &lt;= 1'b1;&#10;&#10;            cnt &lt;= 32'd0;&#10;            state &lt;= ST_GAP;&#10;          end else if (echo_cycles &gt;= ECHO_TIMEOUT - 32'd1) begin&#10;            cnt &lt;= 32'd0;&#10;            echo_cycles &lt;= 32'd0;&#10;            cm_cycle_cnt &lt;= 32'd0;&#10;            measured_cm &lt;= 16'd0;&#10;            echo_timeout &lt;= 1'b1;&#10;            distance_cm &lt;= 16'hFFFF;&#10;            distance_valid &lt;= 1'b1;&#10;            obstacle_stop &lt;= 1'b0;&#10;            state &lt;= ST_GAP;&#10;          end else begin&#10;            echo_cycles &lt;= echo_cycles + 32'd1;&#10;            if (cm_cycle_cnt &gt;= CYCLES_PER_CM - 32'd1) begin&#10;              cm_cycle_cnt &lt;= 32'd0;&#10;              if (measured_cm != 16'hFFFF)&#10;                measured_cm &lt;= measured_cm + 16'd1;&#10;            end else begin&#10;              cm_cycle_cnt &lt;= cm_cycle_cnt + 32'd1;&#10;            end&#10;          end&#10;        end&#10;&#10;        ST_GAP: begin&#10;          trig &lt;= 1'b0;&#10;&#10;          if (cnt &gt;= MEASURE_PERIOD - TRIG_CYCLES - 32'd1) begin&#10;            cnt &lt;= 32'd0;&#10;            state &lt;= ST_TRIG;&#10;          end else begin&#10;            cnt &lt;= cnt + 32'd1;&#10;          end&#10;        end&#10;&#10;        default: begin&#10;          state &lt;= ST_TRIG;&#10;          cnt &lt;= 32'd0;&#10;          trig &lt;= 1'b0;&#10;        end&#10;        endcase&#10;      end&#10;    end&#10;  end&#10;" Color="bisque" Comment="" Height="794" Name="ultrasonic_obstacle_guard6" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="680" X="1274.17" Y="2099.29">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="ultrasonic_obstacle_guard6" Side="left" Width="30" X="-0.0441176" Y="0.313602" />
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="ultrasonic_obstacle_guard6" Side="left" Width="30" X="-0.0441176" Y="0.479849" />
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="echo" Parent="ultrasonic_obstacle_guard6" Side="left" Width="30" X="-0.0441176" Y="0.646096" />
  <Port Color="#f0ffff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="step_length" Parent="ultrasonic_obstacle_guard6" Side="left" Width="30" X="-0.0441176" Y="0.812343" />
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="trig" Parent="ultrasonic_obstacle_guard6" Side="right" Width="30" X="0.955882" Y="0.180101" />
  <Port Color="#ffe4c4" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="distance_cm" Parent="ultrasonic_obstacle_guard6" Side="right" Width="30" X="0.955882" Y="0.379093" />
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="distance_valid" Parent="ultrasonic_obstacle_guard6" Side="right" Width="30" X="0.955882" Y="0.578086" />
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="obstacle_stop" Parent="ultrasonic_obstacle_guard6" Side="right" Width="30" X="0.955882" Y="0.777078" />
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="echo_timeout" Parent="ultrasonic_obstacle_guard6" Side="bottom" Width="30" X="0.477941" Y="0.962217" />
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="enable" Parent="ultrasonic_obstacle_guard6" Side="left" Width="30" X="-0.0441176" Y="0.147355" />
 </Module>
