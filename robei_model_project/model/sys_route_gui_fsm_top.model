 <Module Category="Current" Class="buzzer_ctrl" Code="  localparam integer CLK_HZ = 50000000;&#10;  localparam integer TONE_HZ = 2000;&#10;  localparam integer BEEP_MS = 80;&#10;  localparam integer GAP_MS = 80;&#10;  localparam ACTIVE_LOW = 1'b0;&#10;&#10;  localparam integer HALF_PERIOD = CLK_HZ / (TONE_HZ * 2);&#10;  localparam integer BEEP_CYCLES = (CLK_HZ / 1000) * BEEP_MS;&#10;  localparam integer GAP_CYCLES  = (CLK_HZ / 1000) * GAP_MS;&#10;&#10;  reg tone_bit;&#10;  reg beep_active;&#10;  reg gap_active;&#10;  reg [31:0] tone_cnt;&#10;  reg [31:0] beep_cnt;&#10;  reg [31:0] gap_cnt;&#10;  reg [1:0] pending_beeps;&#10;  reg [1:0] current_beeps;&#10;  wire raw_buzzer;&#10;&#10;  assign raw_buzzer = beep_active ? tone_bit : 1'b0;&#10;  assign buzzer_out = ACTIVE_LOW ? ~raw_buzzer : raw_buzzer;&#10;&#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      tone_bit &lt;= 1'b0;&#10;      beep_active &lt;= 1'b0;&#10;      gap_active &lt;= 1'b0;&#10;      tone_cnt &lt;= 32'd0;&#10;      beep_cnt &lt;= 32'd0;&#10;      gap_cnt &lt;= 32'd0;&#10;      pending_beeps &lt;= 2'd0;&#10;      current_beeps &lt;= 2'd0;&#10;    end else begin&#10;      if (stop_enter_pulse)&#10;        pending_beeps &lt;= 2'd2;&#10;      else if (run_enter_pulse)&#10;        pending_beeps &lt;= 2'd1;&#10;      else if (route_add_pulse)&#10;        pending_beeps &lt;= 2'd1;&#10;      else if (power_on_pulse)&#10;        pending_beeps &lt;= 2'd1;&#10;&#10;      if (beep_active) begin&#10;        if (tone_cnt == HALF_PERIOD - 1) begin&#10;          tone_cnt &lt;= 32'd0;&#10;          tone_bit &lt;= ~tone_bit;&#10;        end else begin&#10;          tone_cnt &lt;= tone_cnt + 32'd1;&#10;        end&#10;&#10;        if (beep_cnt == BEEP_CYCLES - 1) begin&#10;          beep_active &lt;= 1'b0;&#10;          beep_cnt &lt;= 32'd0;&#10;          tone_cnt &lt;= 32'd0;&#10;          tone_bit &lt;= 1'b0;&#10;          if (current_beeps &gt; 2'd1) begin&#10;            current_beeps &lt;= current_beeps - 2'd1;&#10;            gap_active &lt;= 1'b1;&#10;            gap_cnt &lt;= 32'd0;&#10;          end else begin&#10;            current_beeps &lt;= 2'd0;&#10;          end&#10;        end else begin&#10;          beep_cnt &lt;= beep_cnt + 32'd1;&#10;        end&#10;      end else if (gap_active) begin&#10;        if (gap_cnt == GAP_CYCLES - 1) begin&#10;          gap_active &lt;= 1'b0;&#10;          gap_cnt &lt;= 32'd0;&#10;          beep_active &lt;= 1'b1;&#10;          beep_cnt &lt;= 32'd0;&#10;          tone_cnt &lt;= 32'd0;&#10;          tone_bit &lt;= 1'b0;&#10;        end else begin&#10;          gap_cnt &lt;= gap_cnt + 32'd1;&#10;        end&#10;      end else if (current_beeps != 2'd0) begin&#10;        beep_active &lt;= 1'b1;&#10;        beep_cnt &lt;= 32'd0;&#10;        tone_cnt &lt;= 32'd0;&#10;        tone_bit &lt;= 1'b0;&#10;      end else if (pending_beeps != 2'd0) begin&#10;        current_beeps &lt;= pending_beeps;&#10;        pending_beeps &lt;= 2'd0;&#10;      end&#10;    end&#10;  end&#10;" Color="chartreuse" Comment="" Height="355" Name="buzzer_ctrl14" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="302" X="1356.5" Y="3035.5">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="buzzer_ctrl14" Side="left" Width="30" X="-0.0993377" Y="0.0985915" />
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="buzzer_ctrl14" Side="left" Width="30" X="-0.0993377" Y="0.239437" />
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="power_on_pulse" Parent="buzzer_ctrl14" Side="left" Width="30" X="-0.0993377" Y="0.380282" />
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="route_add_pulse" Parent="buzzer_ctrl14" Side="left" Width="30" X="-0.0993377" Y="0.521127" />
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="run_enter_pulse" Parent="buzzer_ctrl14" Side="left" Width="30" X="-0.0993377" Y="0.661972" />
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="stop_enter_pulse" Parent="buzzer_ctrl14" Side="left" Width="30" X="-0.0993377" Y="0.802817" />
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="buzzer_out" Parent="buzzer_ctrl14" Side="right" Width="30" X="0.900662" Y="0.456338" />
 </Module>
 <Module Category="Current" Class="buzzer_event_gen" Code="  localparam [4:0] STATE_RUN  = 5'b00011;&#10;  localparam [4:0] STATE_STOP = 5'b00100;&#10;&#10;  reg rst_n_d;&#10;  reg [4:0] state_info_d;&#10;  reg [5:0] active_route_steps_d;&#10;&#10;  assign power_on_pulse = rst_n &amp; ~rst_n_d;&#10;  assign route_add_pulse = (active_route_steps &gt; active_route_steps_d);&#10;  assign run_enter_pulse = (state_info == STATE_RUN) &amp;&amp; (state_info_d != STATE_RUN);&#10;  assign stop_enter_pulse = (state_info == STATE_STOP) &amp;&amp; (state_info_d != STATE_STOP);&#10;&#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      rst_n_d &lt;= 1'b0;&#10;      state_info_d &lt;= 5'd0;&#10;      active_route_steps_d &lt;= 6'd0;&#10;    end else begin&#10;      rst_n_d &lt;= 1'b1;&#10;      state_info_d &lt;= state_info;&#10;      active_route_steps_d &lt;= active_route_steps;&#10;    end&#10;  end" Color="chocolate" Comment="" Height="295" Name="buzzer_event_gen15" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="287" X="787" Y="2998">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="buzzer_event_gen15" Side="left" Width="30" X="-0.10453" Y="0.149153" />
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="buzzer_event_gen15" Side="left" Width="30" X="-0.10453" Y="0.349153" />
  <Port Color="#7fffd4" Connect="" Datasize="5" Datatype="wire" Description="" Height="30" Inout="input" Name="state_info" Parent="buzzer_event_gen15" Side="left" Width="30" X="-0.10453" Y="0.549153" />
  <Port Color="#f0ffff" Connect="" Datasize="6" Datatype="wire" Description="" Height="30" Inout="input" Name="active_route_steps" Parent="buzzer_event_gen15" Side="left" Width="30" X="-0.10453" Y="0.749153" />
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="power_on_pulse" Parent="buzzer_event_gen15" Side="right" Width="30" X="0.89547" Y="0.149153" />
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="route_add_pulse" Parent="buzzer_event_gen15" Side="right" Width="30" X="0.89547" Y="0.349153" />
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="run_enter_pulse" Parent="buzzer_event_gen15" Side="right" Width="30" X="0.89547" Y="0.549153" />
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="stop_enter_pulse" Parent="buzzer_event_gen15" Side="right" Width="30" X="0.89547" Y="0.749153" />
 </Module>
 <Module Category="Current" Class="lidar_map_sampler" Code="parameter integer CLK_HZ = 50000000;&#10;  // A complete report is 6 x 50 UART bytes. At 115200 baud, two reports per&#10;  // second plus 5 Hz motion telemetry remain comfortably below the physical&#10;  // UART capacity and provide useful phone-side mapping/replanning latency.&#10;  parameter integer REPORT_INTERVAL_TICKS = 50;&#10;  parameter integer CHUNK_GAP_MS = 10;&#10;&#10;  localparam integer TICK_CYCLES = CLK_HZ / 100;&#10;  localparam integer CHUNK_GAP_CYCLES = (CLK_HZ / 1000) * CHUNK_GAP_MS;&#10;  localparam [5:0] MAP_MIN_QUALITY = 6'd8;&#10;  localparam [15:0] MAP_MIN_DISTANCE_Q2 = 16'd200;&#10;  localparam [15:0] MAP_MAX_DISTANCE_Q2 = 16'd48000;&#10;  localparam [14:0] FULL_CIRCLE_Q6 = 15'd23040;&#10;&#10;  localparam [1:0] LOOKUP_IDLE = 2'd0;&#10;  localparam [1:0] LOOKUP_WAIT = 2'd1;&#10;  localparam [1:0] LOOKUP_CAPTURE = 2'd2;&#10;  localparam [1:0] LOAD_IDLE = 2'd0;&#10;  localparam [1:0] LOAD_SET_ADDRESS = 2'd1;&#10;  localparam [1:0] LOAD_WAIT = 2'd2;&#10;  localparam [1:0] LOAD_CAPTURE = 2'd3;&#10;&#10;  &#10;  &#10;  &#10;  (* ram_style = &quot;block&quot; *) reg [20:0] bank0_mem [0:71];&#10;  (* ram_style = &quot;block&quot; *) reg [20:0] bank1_mem [0:71];&#10;  reg [6:0] bank0_read_address;&#10;  reg [6:0] bank1_read_address;&#10;  reg [20:0] bank0_read_data;&#10;  reg [20:0] bank1_read_data;&#10;  reg bank0_write_enable;&#10;  reg bank1_write_enable;&#10;  reg [6:0] bank0_write_address;&#10;  reg [6:0] bank1_write_address;&#10;  reg [20:0] bank0_write_data;&#10;  reg [20:0] bank1_write_data;&#10;&#10;  always @(posedge clk) begin&#10;    if (bank0_write_enable)&#10;      bank0_mem[bank0_write_address] &lt;= bank0_write_data;&#10;    if (bank1_write_enable)&#10;      bank1_mem[bank1_write_address] &lt;= bank1_write_data;&#10;    bank0_read_data &lt;= bank0_mem[bank0_read_address];&#10;    bank1_read_data &lt;= bank1_mem[bank1_read_address];&#10;  end&#10;&#10;  reg collect_bank;&#10;  reg report_bank;&#10;  reg scan_seen;&#10;  reg [7:0] current_scan_seq;&#10;  reg [15:0] current_scan_tick;&#10;  reg report_active;&#10;  reg report_started;&#10;  reg [15:0] last_report_tick;&#10;&#10;  reg [18:0] tick_divider;&#10;  reg [15:0] tick_10ms;&#10;  reg [21:0] chunk_gap_count;&#10;&#10;  reg clear_active;&#10;  reg clear_bank;&#10;  reg [6:0] clear_index;&#10;  reg first_sample_pending;&#10;  reg first_sample_good;&#10;  reg [6:0] first_sample_bin;&#10;  reg [7:0] first_sample_error;&#10;  reg [11:0] first_sample_data;&#10;&#10;  reg sample_write_pending;&#10;  reg sample_write_bank;&#10;  reg [6:0] sample_write_bin;&#10;  reg [7:0] sample_write_error;&#10;  reg [11:0] sample_write_data;&#10;&#10;  reg [1:0] lookup_state;&#10;  reg lookup_bank;&#10;  reg [6:0] lookup_bin;&#10;  reg [7:0] lookup_error;&#10;  reg [11:0] lookup_data;&#10;&#10;  reg [1:0] load_state;&#10;  reg [3:0] load_index;&#10;  reg [7:0] load_crc;&#10;&#10;  wire [8:0] angle_degree = angle_q6[14:6];&#10;  &#10;  wire [16:0] degree_times_205 =&#10;      ({8'd0, angle_degree} &lt;&lt; 7) +&#10;      ({8'd0, angle_degree} &lt;&lt; 6) +&#10;      ({8'd0, angle_degree} &lt;&lt; 3) +&#10;      ({8'd0, angle_degree} &lt;&lt; 2) +&#10;      {8'd0, angle_degree};&#10;  wire [6:0] sample_bin = degree_times_205[16:10];&#10;  wire [14:0] sample_bin_center_q6 =&#10;      ({8'd0, sample_bin} &lt;&lt; 8) +&#10;      ({8'd0, sample_bin} &lt;&lt; 6) + 15'd160;&#10;  wire [14:0] sample_error_full =&#10;      (angle_q6 &gt;= sample_bin_center_q6) ?&#10;      (angle_q6 - sample_bin_center_q6) :&#10;      (sample_bin_center_q6 - angle_q6);&#10;  wire [7:0] sample_error = sample_error_full[7:0];&#10;&#10;  wire sample_good = (quality &gt;= MAP_MIN_QUALITY) &amp;&amp;&#10;                     (angle_q6 &lt; FULL_CIRCLE_Q6) &amp;&amp;&#10;                     (distance_q2 &gt;= MAP_MIN_DISTANCE_Q2) &amp;&amp;&#10;                     (distance_q2 &lt;= MAP_MAX_DISTANCE_Q2) &amp;&amp;&#10;                     (sample_bin &lt; 7'd72);&#10;  wire [16:0] rounded_distance_q2 = {1'b0, distance_q2} + 17'd32;&#10;  wire [10:0] rounded_distance_code = rounded_distance_q2[16:6];&#10;  wire [9:0] map_distance_code =&#10;      (rounded_distance_code &gt;= 11'd1023) ? 10'd1022 :&#10;      rounded_distance_code[9:0];&#10;  wire [1:0] map_quality_class =&#10;      (quality &gt;= 6'd40) ? 2'd3 :&#10;      (quality &gt;= 6'd20) ? 2'd2 :&#10;      (quality &gt;= MAP_MIN_QUALITY) ? 2'd1 : 2'd0;&#10;  wire [11:0] packed_sample = {map_quality_class, map_distance_code};&#10;&#10;  wire [15:0] ticks_since_report = tick_10ms - last_report_tick;&#10;  wire report_due = !report_started ||&#10;                    (ticks_since_report &gt;= REPORT_INTERVAL_TICKS[15:0]);&#10;  wire start_report = scan_enable &amp;&amp; sample_valid &amp;&amp; new_scan &amp;&amp; scan_seen &amp;&amp;&#10;                      report_due &amp;&amp; !report_active;&#10;  wire next_collect_bank = start_report ? ~collect_bank : collect_bank;&#10;&#10;  wire [6:0] report_part_base =&#10;      ({4'd0, map_part} &lt;&lt; 3) + ({4'd0, map_part} &lt;&lt; 2);&#10;  wire [6:0] load_address = report_part_base + {3'd0, load_index};&#10;  wire [20:0] report_read_entry = report_bank ? bank1_read_data : bank0_read_data;&#10;  wire [11:0] load_word = report_read_entry[20] ?&#10;                          report_read_entry[11:0] : 12'hfff;&#10;  wire [20:0] lookup_entry = lookup_bank ? bank1_read_data : bank0_read_data;&#10;  wire lookup_should_write = !lookup_entry[20] ||&#10;                             (lookup_error &lt; lookup_entry[19:12]) ||&#10;                             ((lookup_error == lookup_entry[19:12]) &amp;&amp;&#10;                              (lookup_data[11:10] &gt; lookup_entry[11:10]));&#10;&#10;  function [7:0] hex_ascii;&#10;    input [3:0] value;&#10;    begin&#10;      hex_ascii = value + ((value &lt; 4'd10) ? 8'd48 : 8'd55);&#10;    end&#10;  endfunction&#10;&#10;  function [7:0] crc8_next;&#10;    input [7:0] crc_in;&#10;    input [7:0] data_in;&#10;    integer bit_index;&#10;    reg [7:0] value;&#10;    begin&#10;      value = crc_in ^ data_in;&#10;      for (bit_index = 0; bit_index &lt; 8; bit_index = bit_index + 1) begin&#10;        if (value[7])&#10;          value = (value &lt;&lt; 1) ^ 8'h07;&#10;        else&#10;          value = value &lt;&lt; 1;&#10;      end&#10;      crc8_next = value;&#10;    end&#10;  endfunction&#10;&#10;  function [7:0] map_header_crc;&#10;    input [7:0] sequence_in;&#10;    input [15:0] tick_in;&#10;    input [2:0] part_in;&#10;    reg [7:0] value;&#10;    begin&#10;      value = crc8_next(8'h00, &quot;R&quot;);&#10;      value = crc8_next(value, &quot;1&quot;);&#10;      value = crc8_next(value, hex_ascii(sequence_in[7:4]));&#10;      value = crc8_next(value, hex_ascii(sequence_in[3:0]));&#10;      value = crc8_next(value, hex_ascii(tick_in[15:12]));&#10;      value = crc8_next(value, hex_ascii(tick_in[11:8]));&#10;      value = crc8_next(value, hex_ascii(tick_in[7:4]));&#10;      value = crc8_next(value, hex_ascii(tick_in[3:0]));&#10;      value = crc8_next(value, hex_ascii({1'b0, part_in}));&#10;      value = crc8_next(value, &quot;6&quot;);&#10;      map_header_crc = value;&#10;    end&#10;  endfunction&#10;&#10;  wire [7:0] load_crc_after_word =&#10;      crc8_next(&#10;        crc8_next(&#10;          crc8_next(load_crc, hex_ascii(load_word[11:8])),&#10;          hex_ascii(load_word[7:4])),&#10;        hex_ascii(load_word[3:0]));&#10;&#10;  &#10;  &#10;  always @* begin&#10;    bank0_write_enable = 1'b0;&#10;    bank1_write_enable = 1'b0;&#10;    bank0_write_address = 7'd0;&#10;    bank1_write_address = 7'd0;&#10;    bank0_write_data = 21'd0;&#10;    bank1_write_data = 21'd0;&#10;&#10;    if (clear_active) begin&#10;      if (!clear_bank) begin&#10;        bank0_write_enable = 1'b1;&#10;        bank0_write_address = clear_index;&#10;      end else begin&#10;        bank1_write_enable = 1'b1;&#10;        bank1_write_address = clear_index;&#10;      end&#10;    end else if (sample_write_pending) begin&#10;      if (!sample_write_bank) begin&#10;        bank0_write_enable = 1'b1;&#10;        bank0_write_address = sample_write_bin;&#10;        bank0_write_data = {1'b1, sample_write_error, sample_write_data};&#10;      end else begin&#10;        bank1_write_enable = 1'b1;&#10;        bank1_write_address = sample_write_bin;&#10;        bank1_write_data = {1'b1, sample_write_error, sample_write_data};&#10;      end&#10;    end&#10;  end&#10;&#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      tick_divider &lt;= 19'd0;&#10;      tick_10ms &lt;= 16'd0;&#10;    end else if (tick_divider &gt;= TICK_CYCLES - 1) begin&#10;      tick_divider &lt;= 19'd0;&#10;      tick_10ms &lt;= tick_10ms + 16'd1;&#10;    end else begin&#10;      tick_divider &lt;= tick_divider + 19'd1;&#10;    end&#10;  end&#10;&#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      bank0_read_address &lt;= 7'd0;&#10;      bank1_read_address &lt;= 7'd0;&#10;      collect_bank &lt;= 1'b0;&#10;      report_bank &lt;= 1'b0;&#10;      scan_seen &lt;= 1'b0;&#10;      current_scan_seq &lt;= 8'd0;&#10;      current_scan_tick &lt;= 16'd0;&#10;      report_active &lt;= 1'b0;&#10;      report_started &lt;= 1'b0;&#10;      last_report_tick &lt;= 16'd0;&#10;      chunk_gap_count &lt;= 22'd0;&#10;      clear_active &lt;= 1'b0;&#10;      clear_bank &lt;= 1'b0;&#10;      clear_index &lt;= 7'd0;&#10;      first_sample_pending &lt;= 1'b0;&#10;      first_sample_good &lt;= 1'b0;&#10;      first_sample_bin &lt;= 7'd0;&#10;      first_sample_error &lt;= 8'd0;&#10;      first_sample_data &lt;= 12'd0;&#10;      sample_write_pending &lt;= 1'b0;&#10;      sample_write_bank &lt;= 1'b0;&#10;      sample_write_bin &lt;= 7'd0;&#10;      sample_write_error &lt;= 8'd0;&#10;      sample_write_data &lt;= 12'd0;&#10;      lookup_state &lt;= LOOKUP_IDLE;&#10;      lookup_bank &lt;= 1'b0;&#10;      lookup_bin &lt;= 7'd0;&#10;      lookup_error &lt;= 8'd0;&#10;      lookup_data &lt;= 12'd0;&#10;      load_state &lt;= LOAD_IDLE;&#10;      load_index &lt;= 4'd0;&#10;      load_crc &lt;= 8'd0;&#10;      map_chunk_valid &lt;= 1'b0;&#10;      map_scan_seq &lt;= 8'd0;&#10;      map_tick_10ms &lt;= 16'd0;&#10;      map_part &lt;= 3'd0;&#10;      map_chunk_data &lt;= 144'd0;&#10;      map_chunk_crc &lt;= 8'd0;&#10;      map_drop_count &lt;= 16'd0;&#10;    end else if (!scan_enable) begin&#10;      collect_bank &lt;= 1'b0;&#10;      scan_seen &lt;= 1'b0;&#10;      current_scan_seq &lt;= 8'd0;&#10;      current_scan_tick &lt;= tick_10ms;&#10;      report_active &lt;= 1'b0;&#10;      report_started &lt;= 1'b0;&#10;      last_report_tick &lt;= tick_10ms;&#10;      chunk_gap_count &lt;= 22'd0;&#10;      clear_active &lt;= 1'b0;&#10;      first_sample_pending &lt;= 1'b0;&#10;      sample_write_pending &lt;= 1'b0;&#10;      lookup_state &lt;= LOOKUP_IDLE;&#10;      load_state &lt;= LOAD_IDLE;&#10;      load_index &lt;= 4'd0;&#10;      load_crc &lt;= 8'd0;&#10;      map_chunk_valid &lt;= 1'b0;&#10;      map_part &lt;= 3'd0;&#10;    end else begin&#10;      &#10;      if (sample_write_pending)&#10;        sample_write_pending &lt;= 1'b0;&#10;&#10;      if (clear_active) begin&#10;        if (clear_index == 7'd71) begin&#10;          clear_active &lt;= 1'b0;&#10;          clear_index &lt;= 7'd0;&#10;          if (first_sample_pending &amp;&amp; first_sample_good) begin&#10;            sample_write_pending &lt;= 1'b1;&#10;            sample_write_bank &lt;= clear_bank;&#10;            sample_write_bin &lt;= first_sample_bin;&#10;            sample_write_error &lt;= first_sample_error;&#10;            sample_write_data &lt;= first_sample_data;&#10;          end&#10;          first_sample_pending &lt;= 1'b0;&#10;        end else begin&#10;          clear_index &lt;= clear_index + 7'd1;&#10;        end&#10;      end&#10;&#10;      if (chunk_gap_count != 0) begin&#10;        chunk_gap_count &lt;= chunk_gap_count - 22'd1;&#10;        if (chunk_gap_count == 22'd1) begin&#10;          load_state &lt;= LOAD_SET_ADDRESS;&#10;          load_index &lt;= 4'd0;&#10;          load_crc &lt;= map_header_crc(map_scan_seq, map_tick_10ms, map_part);&#10;        end&#10;      end&#10;&#10;      case (load_state)&#10;        LOAD_SET_ADDRESS: begin&#10;          if (!report_bank)&#10;            bank0_read_address &lt;= load_address;&#10;          else&#10;            bank1_read_address &lt;= load_address;&#10;          load_state &lt;= LOAD_WAIT;&#10;        end&#10;        LOAD_WAIT: load_state &lt;= LOAD_CAPTURE;&#10;        LOAD_CAPTURE: begin&#10;          &#10;          &#10;          map_chunk_data[load_index * 12 +: 4] &lt;= load_word[11:8];&#10;          map_chunk_data[load_index * 12 + 4 +: 4] &lt;= load_word[7:4];&#10;          map_chunk_data[load_index * 12 + 8 +: 4] &lt;= load_word[3:0];&#10;          load_crc &lt;= load_crc_after_word;&#10;          if (load_index == 4'd11) begin&#10;            load_state &lt;= LOAD_IDLE;&#10;            load_index &lt;= 4'd0;&#10;            map_chunk_crc &lt;= load_crc_after_word;&#10;            map_chunk_valid &lt;= 1'b1;&#10;          end else begin&#10;            load_index &lt;= load_index + 4'd1;&#10;            load_state &lt;= LOAD_SET_ADDRESS;&#10;          end&#10;        end&#10;        default: begin end&#10;      endcase&#10;&#10;      if (map_chunk_accept &amp;&amp; map_chunk_valid) begin&#10;        map_chunk_valid &lt;= 1'b0;&#10;        if (map_part == 3'd5) begin&#10;          report_active &lt;= 1'b0;&#10;          map_part &lt;= 3'd0;&#10;        end else begin&#10;          map_part &lt;= map_part + 3'd1;&#10;          if (CHUNK_GAP_CYCLES &lt;= 1) begin&#10;            load_state &lt;= LOAD_SET_ADDRESS;&#10;            load_index &lt;= 4'd0;&#10;            load_crc &lt;= map_header_crc(map_scan_seq, map_tick_10ms,&#10;                                       map_part + 3'd1);&#10;          end else begin&#10;            chunk_gap_count &lt;= CHUNK_GAP_CYCLES[21:0];&#10;          end&#10;        end&#10;      end&#10;&#10;      case (lookup_state)&#10;        LOOKUP_WAIT: lookup_state &lt;= LOOKUP_CAPTURE;&#10;        LOOKUP_CAPTURE: begin&#10;          lookup_state &lt;= LOOKUP_IDLE;&#10;          if (lookup_should_write &amp;&amp; !sample_write_pending &amp;&amp; !clear_active) begin&#10;            sample_write_pending &lt;= 1'b1;&#10;            sample_write_bank &lt;= lookup_bank;&#10;            sample_write_bin &lt;= lookup_bin;&#10;            sample_write_error &lt;= lookup_error;&#10;            sample_write_data &lt;= lookup_data;&#10;          end&#10;        end&#10;        default: begin end&#10;      endcase&#10;&#10;      if (sample_valid &amp;&amp; new_scan) begin&#10;        lookup_state &lt;= LOOKUP_IDLE;&#10;        sample_write_pending &lt;= 1'b0;&#10;        clear_active &lt;= 1'b1;&#10;        clear_bank &lt;= next_collect_bank;&#10;        clear_index &lt;= 7'd0;&#10;        first_sample_pending &lt;= 1'b1;&#10;        first_sample_good &lt;= sample_good;&#10;        first_sample_bin &lt;= sample_bin;&#10;        first_sample_error &lt;= sample_error;&#10;        first_sample_data &lt;= packed_sample;&#10;        collect_bank &lt;= next_collect_bank;&#10;&#10;        if (scan_seen) begin&#10;          current_scan_seq &lt;= current_scan_seq + 8'd1;&#10;          current_scan_tick &lt;= tick_10ms;&#10;        end else begin&#10;          scan_seen &lt;= 1'b1;&#10;          current_scan_seq &lt;= 8'd0;&#10;          current_scan_tick &lt;= tick_10ms;&#10;        end&#10;&#10;        if (start_report) begin&#10;          report_bank &lt;= collect_bank;&#10;          report_active &lt;= 1'b1;&#10;          report_started &lt;= 1'b1;&#10;          last_report_tick &lt;= tick_10ms;&#10;          map_scan_seq &lt;= current_scan_seq;&#10;          map_tick_10ms &lt;= current_scan_tick;&#10;          map_part &lt;= 3'd0;&#10;          map_chunk_valid &lt;= 1'b0;&#10;          load_state &lt;= LOAD_SET_ADDRESS;&#10;          load_index &lt;= 4'd0;&#10;          load_crc &lt;= map_header_crc(current_scan_seq, current_scan_tick, 3'd0);&#10;          chunk_gap_count &lt;= 22'd0;&#10;        end else if (scan_seen &amp;&amp; report_due &amp;&amp; report_active &amp;&amp;&#10;                     (map_drop_count != 16'hffff)) begin&#10;          map_drop_count &lt;= map_drop_count + 16'd1;&#10;        end&#10;      end else if (sample_valid &amp;&amp; scan_seen &amp;&amp; sample_good &amp;&amp;&#10;                   !clear_active &amp;&amp; !sample_write_pending &amp;&amp;&#10;                   (lookup_state == LOOKUP_IDLE)) begin&#10;        lookup_bank &lt;= collect_bank;&#10;        lookup_bin &lt;= sample_bin;&#10;        lookup_error &lt;= sample_error;&#10;        lookup_data &lt;= packed_sample;&#10;        if (!collect_bank)&#10;          bank0_read_address &lt;= sample_bin;&#10;        else&#10;          bank1_read_address &lt;= sample_bin;&#10;        lookup_state &lt;= LOOKUP_WAIT;&#10;      end&#10;    end&#10;  end" Color="#d3d3d3" Comment="" Height="1080" Name="lidar_map_sampler26" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="1600" X="4750" Y="3150">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="lidar_map_sampler26" Side="left" Width="30" X="-0.01875" Y="0.1" />
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="lidar_map_sampler26" Side="left" Width="30" X="-0.01875" Y="0.2" />
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="scan_enable" Parent="lidar_map_sampler26" Side="left" Width="30" X="-0.01875" Y="0.3" />
