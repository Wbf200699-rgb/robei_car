  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_pin5" Parent="gpio_key_adapter12" Side="left" Width="30" X="-0.113208" Y="0.814732" />
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_active_low" Parent="gpio_key_adapter12" Side="bottom" Width="30" X="0.275472" Y="0.966518" />
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="key_up_n" Parent="gpio_key_adapter12" Side="right" Width="30" X="0.886792" Y="0.183036" />
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="key_down_n" Parent="gpio_key_adapter12" Side="right" Width="30" X="0.886792" Y="0.382813" />
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="key_left_n" Parent="gpio_key_adapter12" Side="right" Width="30" X="0.886792" Y="0.582589" />
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="key_right_n" Parent="gpio_key_adapter12" Side="right" Width="30" X="0.886792" Y="0.782366" />
  <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="key_mid_n" Parent="gpio_key_adapter12" Side="bottom" Width="30" X="0.607547" Y="0.966518" />
