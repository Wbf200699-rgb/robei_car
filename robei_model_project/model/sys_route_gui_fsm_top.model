 <Module Category="Current" Class="gpio_key_adapter" Code="  wire sw1_n;&#10;  wire sw2_n;&#10;  wire sw3_n;&#10;  wire sw4_n;&#10;  wire sw5_n;&#10;&#10;  assign sw1_n = key_active_low ? key_pin1 : ~key_pin1;&#10;  assign sw2_n = key_active_low ? key_pin2 : ~key_pin2;&#10;  assign sw3_n = key_active_low ? key_pin3 : ~key_pin3;&#10;  assign sw4_n = key_active_low ? key_pin4 : ~key_pin4;&#10;  assign sw5_n = key_active_low ? key_pin5 : ~key_pin5;&#10;&#10;  assign key_up_n    = sw1_n;&#10;  assign key_left_n  = sw2_n;&#10;  assign key_right_n = sw3_n;&#10;  assign key_down_n  = sw4_n;&#10;  assign key_mid_n   = sw5_n;" Color="burlywood" Comment="" Height="896" Name="gpio_key_adapter12" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="265" X="59.6535" Y="750.267">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_pin1" Parent="gpio_key_adapter12" Side="left" Width="30" X="-0.113208" Y="0.149554" />
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_pin2" Parent="gpio_key_adapter12" Side="left" Width="30" X="-0.113208" Y="0.315848" />
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_pin3" Parent="gpio_key_adapter12" Side="left" Width="30" X="-0.113208" Y="0.482143" />
