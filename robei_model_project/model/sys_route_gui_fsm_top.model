 <Module Category="Current" Class="power_on_reset" Code="  localparam integer POR_CYCLES = 1000000;&#10;  reg [19:0] por_count;&#10;&#10;  initial begin&#10;    por_count = 20'd0;&#10;    system_rst_n = 1'b0;&#10;  end&#10;&#10;  always @(posedge clk or negedge ext_rst_n) begin&#10;    if (!ext_rst_n) begin&#10;      por_count &lt;= 20'd0;&#10;      system_rst_n &lt;= 1'b0;&#10;    end else if (!system_rst_n) begin&#10;      if (por_count &gt;= POR_CYCLES - 1) begin&#10;        por_count &lt;= por_count;&#10;        system_rst_n &lt;= 1'b1;&#10;      end else begin&#10;        por_count &lt;= por_count + 20'd1;&#10;      end&#10;    end&#10;  end" Color="#d3d3d3" Comment="" Height="260" Name="power_on_reset24" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="240" X="40" Y="3150">
