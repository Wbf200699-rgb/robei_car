 <Module Category="Current" Class="field_map_config_uart" Code="  parameter integer CLK_HZ = 50000000;&#xa;  parameter integer BAUD = 115200;&#xa;  localparam integer CLKS_PER_BIT = CLK_HZ / BAUD;&#xa;  localparam integer FRAME_TIMEOUT_CYCLES = CLK_HZ / 10;&#xa;  localparam [1:0] RX_IDLE = 2&#x27;d0;&#xa;  localparam [1:0] RX_START = 2&#x27;d1;&#xa;  localparam [1:0] RX_DATA = 2&#x27;d2;&#xa;  localparam [1:0] RX_STOP = 2&#x27;d3;&#xa;&#xa;  reg [1:0] rx_sync;&#xa;  reg [1:0] rx_state;&#xa;  reg [15:0] rx_clock_count;&#xa;  reg [2:0] rx_bit_index;&#xa;  reg [7:0] rx_shift;&#xa;  reg [7:0] rx_data;&#xa;  reg rx_valid;&#xa;&#xa;  reg frame_active;&#xa;  reg [4:0] frame_index;&#xa;  reg [22:0] frame_timeout_count;&#xa;  reg [7:0] next_pose_x;&#xa;  reg [7:0] next_pose_y;&#xa;  reg [11:0] next_heading;&#xa;  reg [7:0] next_low_x;&#xa;  reg [7:0] next_high_x;&#xa;  reg [7:0] next_low_y;&#xa;  reg [7:0] next_high_y;&#xa;&#xa;  &#xa;  &#xa;  &#xa;  function nibble_valid;&#xa;    input [7:0] value;&#xa;    begin&#xa;      case (value)&#xa;        &quot;!&quot;, &quot;#&quot;, &quot;$&quot;, &quot;%&quot;, &quot;&amp;&quot;, &quot;&#x27;&quot;, &quot;(&quot;, &quot;)&quot;,&#xa;        &quot;*&quot;, &quot;,&quot;, &quot;.&quot;, &quot;/&quot;, &quot;:&quot;, &quot;;&quot;, &quot;&lt;&quot;, &quot;&gt;&quot;: nibble_valid = 1&#x27;b1;&#xa;        default: nibble_valid = 1&#x27;b0;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [3:0] decode_nibble;&#xa;    input [7:0] value;&#xa;    begin&#xa;      case (value)&#xa;        &quot;!&quot;: decode_nibble = 4&#x27;h0;&#xa;        &quot;#&quot;: decode_nibble = 4&#x27;h1;&#xa;        &quot;$&quot;: decode_nibble = 4&#x27;h2;&#xa;        &quot;%&quot;: decode_nibble = 4&#x27;h3;&#xa;        &quot;&amp;&quot;: decode_nibble = 4&#x27;h4;&#xa;        &quot;&#x27;&quot;: decode_nibble = 4&#x27;h5;&#xa;        &quot;(&quot;: decode_nibble = 4&#x27;h6;&#xa;        &quot;)&quot;: decode_nibble = 4&#x27;h7;&#xa;        &quot;*&quot;: decode_nibble = 4&#x27;h8;&#xa;        &quot;,&quot;: decode_nibble = 4&#x27;h9;&#xa;        &quot;.&quot;: decode_nibble = 4&#x27;ha;&#xa;        &quot;/&quot;: decode_nibble = 4&#x27;hb;&#xa;        &quot;:&quot;: decode_nibble = 4&#x27;hc;&#xa;        &quot;;&quot;: decode_nibble = 4&#x27;hd;&#xa;        &quot;&lt;&quot;: decode_nibble = 4&#x27;he;&#xa;        default: decode_nibble = 4&#x27;hf;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      rx_sync &lt;= 2&#x27;b11;&#xa;      rx_state &lt;= RX_IDLE;&#xa;      rx_clock_count &lt;= 16&#x27;d0;&#xa;      rx_bit_index &lt;= 3&#x27;d0;&#xa;      rx_shift &lt;= 8&#x27;d0;&#xa;      rx_data &lt;= 8&#x27;d0;&#xa;      rx_valid &lt;= 1&#x27;b0;&#xa;    end else begin&#xa;      rx_sync &lt;= {rx_sync[0], bt_uart_rx};&#xa;      rx_valid &lt;= 1&#x27;b0;&#xa;      case (rx_state)&#xa;        RX_IDLE: begin&#xa;          rx_clock_count &lt;= 16&#x27;d0;&#xa;          rx_bit_index &lt;= 3&#x27;d0;&#xa;          if (!rx_sync[1]) rx_state &lt;= RX_START;&#xa;        end&#xa;        RX_START: begin&#xa;          if (rx_clock_count == CLKS_PER_BIT / 2) begin&#xa;            rx_clock_count &lt;= 16&#x27;d0;&#xa;            rx_state &lt;= !rx_sync[1] ? RX_DATA : RX_IDLE;&#xa;          end else rx_clock_count &lt;= rx_clock_count + 16&#x27;d1;&#xa;        end&#xa;        RX_DATA: begin&#xa;          if (rx_clock_count == CLKS_PER_BIT - 1) begin&#xa;            rx_clock_count &lt;= 16&#x27;d0;&#xa;            rx_shift[rx_bit_index] &lt;= rx_sync[1];&#xa;            if (rx_bit_index == 3&#x27;d7) begin&#xa;              rx_bit_index &lt;= 3&#x27;d0;&#xa;              rx_state &lt;= RX_STOP;&#xa;            end else rx_bit_index &lt;= rx_bit_index + 3&#x27;d1;&#xa;          end else rx_clock_count &lt;= rx_clock_count + 16&#x27;d1;&#xa;        end&#xa;        default: begin&#xa;          if (rx_clock_count == CLKS_PER_BIT - 1) begin&#xa;            rx_clock_count &lt;= 16&#x27;d0;&#xa;            rx_data &lt;= rx_shift;&#xa;            rx_valid &lt;= rx_sync[1];&#xa;            rx_state &lt;= RX_IDLE;&#xa;          end else rx_clock_count &lt;= rx_clock_count + 16&#x27;d1;&#xa;        end&#xa;      endcase&#xa;    end&#xa;  end&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      config_valid &lt;= 1&#x27;b0;&#xa;      config_update_pulse &lt;= 1&#x27;b0;&#xa;      pose_x_cell &lt;= 8&#x27;d64;&#xa;      pose_y_cell &lt;= 8&#x27;d64;&#xa;      heading_1024 &lt;= 10&#x27;d0;&#xa;      low_x_cell &lt;= 8&#x27;d9;&#xa;      high_x_cell &lt;= 8&#x27;d119;&#xa;      low_y_cell &lt;= 8&#x27;d9;&#xa;      high_y_cell &lt;= 8&#x27;d119;&#xa;      frame_active &lt;= 1&#x27;b0;&#xa;      frame_index &lt;= 5&#x27;d0;&#xa;      frame_timeout_count &lt;= 23&#x27;d0;&#xa;      next_pose_x &lt;= 8&#x27;d0;&#xa;      next_pose_y &lt;= 8&#x27;d0;&#xa;      next_heading &lt;= 12&#x27;d0;&#xa;      next_low_x &lt;= 8&#x27;d0;&#xa;      next_high_x &lt;= 8&#x27;d0;&#xa;      next_low_y &lt;= 8&#x27;d0;&#xa;      next_high_y &lt;= 8&#x27;d0;&#xa;    end else begin&#xa;      config_update_pulse &lt;= 1&#x27;b0;&#xa;      if (frame_active) begin&#xa;        if (frame_timeout_count &gt;= FRAME_TIMEOUT_CYCLES - 1) begin&#xa;          frame_active &lt;= 1&#x27;b0;&#xa;          frame_index &lt;= 5&#x27;d0;&#xa;          frame_timeout_count &lt;= 23&#x27;d0;&#xa;        end else frame_timeout_count &lt;= frame_timeout_count + 23&#x27;d1;&#xa;      end&#xa;      if (rx_valid) begin&#xa;        frame_timeout_count &lt;= 23&#x27;d0;&#xa;        if (rx_data == &quot;{&quot;) begin&#xa;          frame_active &lt;= 1&#x27;b1;&#xa;          frame_index &lt;= 5&#x27;d0;&#xa;          next_pose_x &lt;= 8&#x27;d0;&#xa;          next_pose_y &lt;= 8&#x27;d0;&#xa;          next_heading &lt;= 12&#x27;d0;&#xa;          next_low_x &lt;= 8&#x27;d0;&#xa;          next_high_x &lt;= 8&#x27;d0;&#xa;          next_low_y &lt;= 8&#x27;d0;&#xa;          next_high_y &lt;= 8&#x27;d0;&#xa;        end else if (frame_active &amp;&amp; frame_index == 5&#x27;d15 &amp;&amp; rx_data == &quot;}&quot;) begin&#xa;          frame_active &lt;= 1&#x27;b0;&#xa;          frame_index &lt;= 5&#x27;d0;&#xa;          if (next_heading &lt;= 12&#x27;d1023 &amp;&amp; next_low_x &lt; next_high_x &amp;&amp;&#xa;              next_low_y &lt; next_high_y &amp;&amp; next_high_x &lt; 8&#x27;d128 &amp;&amp;&#xa;              next_high_y &lt; 8&#x27;d128) begin&#xa;            pose_x_cell &lt;= next_pose_x;&#xa;            pose_y_cell &lt;= next_pose_y;&#xa;            heading_1024 &lt;= next_heading[9:0];&#xa;            low_x_cell &lt;= next_low_x;&#xa;            high_x_cell &lt;= next_high_x;&#xa;            low_y_cell &lt;= next_low_y;&#xa;            high_y_cell &lt;= next_high_y;&#xa;            config_valid &lt;= 1&#x27;b1;&#xa;            config_update_pulse &lt;= 1&#x27;b1;&#xa;          end&#xa;        end else if (frame_active &amp;&amp; frame_index &lt; 5&#x27;d15 &amp;&amp; nibble_valid(rx_data)) begin&#xa;          case (frame_index)&#xa;            5&#x27;d0, 5&#x27;d1: next_pose_x &lt;= {next_pose_x[3:0], decode_nibble(rx_data)};&#xa;            5&#x27;d2, 5&#x27;d3: next_pose_y &lt;= {next_pose_y[3:0], decode_nibble(rx_data)};&#xa;            5&#x27;d4, 5&#x27;d5, 5&#x27;d6: next_heading &lt;= {next_heading[7:0], decode_nibble(rx_data)};&#xa;            5&#x27;d7, 5&#x27;d8: next_low_x &lt;= {next_low_x[3:0], decode_nibble(rx_data)};&#xa;            5&#x27;d9, 5&#x27;d10: next_high_x &lt;= {next_high_x[3:0], decode_nibble(rx_data)};&#xa;            5&#x27;d11, 5&#x27;d12: next_low_y &lt;= {next_low_y[3:0], decode_nibble(rx_data)};&#xa;            default: next_high_y &lt;= {next_high_y[3:0], decode_nibble(rx_data)};&#xa;          endcase&#xa;          frame_index &lt;= frame_index + 5&#x27;d1;&#xa;        end else if (frame_active) begin&#xa;          frame_active &lt;= 1&#x27;b0;&#xa;          frame_index &lt;= 5&#x27;d0;&#xa;        end&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="field_map_config_uart36" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="1600" X="6500" Y="3650">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="field_map_config_uart36" Side="left" Width="30" X="-0.01875" Y="0.2"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="field_map_config_uart36" Side="left" Width="30" X="-0.01875" Y="0.5"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_uart_rx" Parent="field_map_config_uart36" Side="left" Width="30" X="-0.01875" Y="0.8"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="config_valid" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.1"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="config_update_pulse" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.2"/>
  <Port Color="#ffe4c4" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="pose_x_cell" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.3"/>
  <Port Color="#b8860b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="pose_y_cell" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.4"/>
  <Port Color="#ffebcd" Connect="" Datasize="10" Datatype="reg" Description="" Height="30" Inout="output" Name="heading_1024" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.5"/>
  <Port Color="#0000ff" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="low_x_cell" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.6"/>
  <Port Color="#8a2be2" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="high_x_cell" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.7"/>
  <Port Color="#a52a2a" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="low_y_cell" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.8"/>
  <Port Color="#deb887" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="high_y_cell" Parent="field_map_config_uart36" Side="right" Width="30" X="0.98125" Y="0.9"/>
 </Module>
 <Module Category="Current" Class="dual_imu_static_calibrator" Code="`ifdef DUAL_IMU_CAL_SIM_FAST&#xa;  localparam integer SAMPLE_COUNT = 8;&#xa;  localparam integer SAMPLE_SHIFT = 3;&#xa;`else&#xa;  localparam integer SAMPLE_COUNT = 256;&#xa;  localparam integer SAMPLE_SHIFT = 8;&#xa;`endif&#xa;&#xa;  &#xa;  &#xa;  &#xa;  &#xa;  localparam [15:0] GRAVITY_MIN = 16'd4000;&#xa;  localparam [15:0] GRAVITY_MAX = 16'd7000;&#xa;  localparam [15:0] SECONDARY_ACCEL_MAX = 16'd2500;&#xa;  localparam [15:0] GYRO_MEAN_MAX = 16'd128;&#xa;  localparam [15:0] GYRO_PEAK_MAX = 16'd500;&#xa;&#xa;  localparam [1:0] STATE_IDLE = 2'd0;&#xa;  localparam [1:0] STATE_COLLECT = 2'd1;&#xa;  localparam [1:0] STATE_EVALUATE = 2'd2;&#xa;&#xa;  reg [1:0] state;&#xa;  reg [7:0] sample_count;&#xa;  reg all_samples_online;&#xa;&#xa;  reg signed [31:0] imu0_accel_sum_x;&#xa;  reg signed [31:0] imu0_accel_sum_y;&#xa;  reg signed [31:0] imu0_accel_sum_z;&#xa;  reg signed [31:0] imu0_gyro_sum_x;&#xa;  reg signed [31:0] imu0_gyro_sum_y;&#xa;  reg signed [31:0] imu0_gyro_sum_z;&#xa;  reg signed [31:0] imu1_accel_sum_x;&#xa;  reg signed [31:0] imu1_accel_sum_y;&#xa;  reg signed [31:0] imu1_accel_sum_z;&#xa;  reg signed [31:0] imu1_gyro_sum_x;&#xa;  reg signed [31:0] imu1_gyro_sum_y;&#xa;  reg signed [31:0] imu1_gyro_sum_z;&#xa;&#xa;  function [15:0] abs16;&#xa;    input signed [15:0] value;&#xa;    begin&#xa;      abs16 = value[15] ? $unsigned(-value) : $unsigned(value);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function signed [31:0] sign_extend16;&#xa;    input signed [15:0] value;&#xa;    begin&#xa;      sign_extend16 = {{16{value[15]}}, value};&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [15:0] max3_abs;&#xa;    input signed [15:0] x;&#xa;    input signed [15:0] y;&#xa;    input signed [15:0] z;&#xa;    reg [15:0] xy;&#xa;    begin&#xa;      xy = (abs16(x) &gt;= abs16(y)) ? abs16(x) : abs16(y);&#xa;      max3_abs = (xy &gt;= abs16(z)) ? xy : abs16(z);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [1:0] dominant_axis;&#xa;    input signed [15:0] x;&#xa;    input signed [15:0] y;&#xa;    input signed [15:0] z;&#xa;    begin&#xa;      if ((abs16(x) &gt;= abs16(y)) &amp;&amp; (abs16(x) &gt;= abs16(z)))&#xa;        dominant_axis = 2'd0;&#xa;      else if (abs16(y) &gt;= abs16(z))&#xa;        dominant_axis = 2'd1;&#xa;      else&#xa;        dominant_axis = 2'd2;&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [15:0] selected_abs;&#xa;    input [1:0] axis;&#xa;    input signed [15:0] x;&#xa;    input signed [15:0] y;&#xa;    input signed [15:0] z;&#xa;    begin&#xa;      case (axis)&#xa;        2'd0: selected_abs = abs16(x);&#xa;        2'd1: selected_abs = abs16(y);&#xa;        default: selected_abs = abs16(z);&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  function selected_positive;&#xa;    input [1:0] axis;&#xa;    input signed [15:0] x;&#xa;    input signed [15:0] y;&#xa;    input signed [15:0] z;&#xa;    begin&#xa;      case (axis)&#xa;        2'd0: selected_positive = !x[15];&#xa;        2'd1: selected_positive = !y[15];&#xa;        default: selected_positive = !z[15];&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [15:0] largest_nonvertical_abs;&#xa;    input [1:0] axis;&#xa;    input signed [15:0] x;&#xa;    input signed [15:0] y;&#xa;    input signed [15:0] z;&#xa;    begin&#xa;      case (axis)&#xa;        2'd0: largest_nonvertical_abs = (abs16(y) &gt;= abs16(z)) ? abs16(y) : abs16(z);&#xa;        2'd1: largest_nonvertical_abs = (abs16(x) &gt;= abs16(z)) ? abs16(x) : abs16(z);&#xa;        default: largest_nonvertical_abs = (abs16(x) &gt;= abs16(y)) ? abs16(x) : abs16(y);&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  wire [1:0] imu0_axis_eval = dominant_axis(&#xa;      imu0_accel_mean_x, imu0_accel_mean_y, imu0_accel_mean_z);&#xa;  wire [1:0] imu1_axis_eval = dominant_axis(&#xa;      imu1_accel_mean_x, imu1_accel_mean_y, imu1_accel_mean_z);&#xa;  wire [15:0] imu0_gravity_eval = selected_abs(&#xa;      imu0_axis_eval, imu0_accel_mean_x, imu0_accel_mean_y, imu0_accel_mean_z);&#xa;  wire [15:0] imu1_gravity_eval = selected_abs(&#xa;      imu1_axis_eval, imu1_accel_mean_x, imu1_accel_mean_y, imu1_accel_mean_z);&#xa;  wire [15:0] imu0_secondary_eval = largest_nonvertical_abs(&#xa;      imu0_axis_eval, imu0_accel_mean_x, imu0_accel_mean_y, imu0_accel_mean_z);&#xa;  wire [15:0] imu1_secondary_eval = largest_nonvertical_abs(&#xa;      imu1_axis_eval, imu1_accel_mean_x, imu1_accel_mean_y, imu1_accel_mean_z);&#xa;  wire imu0_gravity_valid = (imu0_gravity_eval &gt;= GRAVITY_MIN) &amp;&amp;&#xa;                            (imu0_gravity_eval &lt;= GRAVITY_MAX) &amp;&amp;&#xa;                            (imu0_secondary_eval &lt;= SECONDARY_ACCEL_MAX);&#xa;  wire imu1_gravity_valid = (imu1_gravity_eval &gt;= GRAVITY_MIN) &amp;&amp;&#xa;                            (imu1_gravity_eval &lt;= GRAVITY_MAX) &amp;&amp;&#xa;                            (imu1_secondary_eval &lt;= SECONDARY_ACCEL_MAX);&#xa;  wire imu0_gyro_quiet = (abs16(imu0_gyro_mean_x) &lt;= GYRO_MEAN_MAX) &amp;&amp;&#xa;                         (abs16(imu0_gyro_mean_y) &lt;= GYRO_MEAN_MAX) &amp;&amp;&#xa;                         (abs16(imu0_gyro_mean_z) &lt;= GYRO_MEAN_MAX) &amp;&amp;&#xa;                         (imu0_gyro_peak &lt;= GYRO_PEAK_MAX);&#xa;  wire imu1_gyro_quiet = (abs16(imu1_gyro_mean_x) &lt;= GYRO_MEAN_MAX) &amp;&amp;&#xa;                         (abs16(imu1_gyro_mean_y) &lt;= GYRO_MEAN_MAX) &amp;&amp;&#xa;                         (abs16(imu1_gyro_mean_z) &lt;= GYRO_MEAN_MAX) &amp;&amp;&#xa;                         (imu1_gyro_peak &lt;= GYRO_PEAK_MAX);&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      state &lt;= STATE_IDLE;&#xa;      sample_count &lt;= 8'd0;&#xa;      all_samples_online &lt;= 1'b0;&#xa;      busy &lt;= 1'b0;&#xa;      done &lt;= 1'b0;&#xa;      pass &lt;= 1'b0;&#xa;      result_flags &lt;= 8'd0;&#xa;      imu0_vertical_axis &lt;= 2'd0;&#xa;      imu0_vertical_positive &lt;= 1'b0;&#xa;      imu1_vertical_axis &lt;= 2'd0;&#xa;      imu1_vertical_positive &lt;= 1'b0;&#xa;      imu0_accel_mean_x &lt;= 16'sd0;&#xa;      imu0_accel_mean_y &lt;= 16'sd0;&#xa;      imu0_accel_mean_z &lt;= 16'sd0;&#xa;      imu0_gyro_mean_x &lt;= 16'sd0;&#xa;      imu0_gyro_mean_y &lt;= 16'sd0;&#xa;      imu0_gyro_mean_z &lt;= 16'sd0;&#xa;      imu1_accel_mean_x &lt;= 16'sd0;&#xa;      imu1_accel_mean_y &lt;= 16'sd0;&#xa;      imu1_accel_mean_z &lt;= 16'sd0;&#xa;      imu1_gyro_mean_x &lt;= 16'sd0;&#xa;      imu1_gyro_mean_y &lt;= 16'sd0;&#xa;      imu1_gyro_mean_z &lt;= 16'sd0;&#xa;      imu0_gyro_peak &lt;= 16'd0;&#xa;      imu1_gyro_peak &lt;= 16'd0;&#xa;      imu0_accel_sum_x &lt;= 32'sd0;&#xa;      imu0_accel_sum_y &lt;= 32'sd0;&#xa;      imu0_accel_sum_z &lt;= 32'sd0;&#xa;      imu0_gyro_sum_x &lt;= 32'sd0;&#xa;      imu0_gyro_sum_y &lt;= 32'sd0;&#xa;      imu0_gyro_sum_z &lt;= 32'sd0;&#xa;      imu1_accel_sum_x &lt;= 32'sd0;&#xa;      imu1_accel_sum_y &lt;= 32'sd0;&#xa;      imu1_accel_sum_z &lt;= 32'sd0;&#xa;      imu1_gyro_sum_x &lt;= 32'sd0;&#xa;      imu1_gyro_sum_y &lt;= 32'sd0;&#xa;      imu1_gyro_sum_z &lt;= 32'sd0;&#xa;    end else begin&#xa;      if (start) begin&#xa;        state &lt;= STATE_COLLECT;&#xa;        sample_count &lt;= 8'd0;&#xa;        all_samples_online &lt;= imu0_online &amp;&amp; imu1_online;&#xa;        busy &lt;= 1'b1;&#xa;        done &lt;= 1'b0;&#xa;        pass &lt;= 1'b0;&#xa;        result_flags &lt;= 8'd0;&#xa;        imu0_gyro_peak &lt;= 16'd0;&#xa;        imu1_gyro_peak &lt;= 16'd0;&#xa;        imu0_accel_sum_x &lt;= 32'sd0;&#xa;        imu0_accel_sum_y &lt;= 32'sd0;&#xa;        imu0_accel_sum_z &lt;= 32'sd0;&#xa;        imu0_gyro_sum_x &lt;= 32'sd0;&#xa;        imu0_gyro_sum_y &lt;= 32'sd0;&#xa;        imu0_gyro_sum_z &lt;= 32'sd0;&#xa;        imu1_accel_sum_x &lt;= 32'sd0;&#xa;        imu1_accel_sum_y &lt;= 32'sd0;&#xa;        imu1_accel_sum_z &lt;= 32'sd0;&#xa;        imu1_gyro_sum_x &lt;= 32'sd0;&#xa;        imu1_gyro_sum_y &lt;= 32'sd0;&#xa;        imu1_gyro_sum_z &lt;= 32'sd0;&#xa;      end else if ((state == STATE_COLLECT) &amp;&amp; sample_valid) begin&#xa;        if (!imu0_online || !imu1_online)&#xa;          all_samples_online &lt;= 1'b0;&#xa;        imu0_accel_sum_x &lt;= imu0_accel_sum_x + sign_extend16(imu0_accel_x);&#xa;        imu0_accel_sum_y &lt;= imu0_accel_sum_y + sign_extend16(imu0_accel_y);&#xa;        imu0_accel_sum_z &lt;= imu0_accel_sum_z + sign_extend16(imu0_accel_z);&#xa;        imu0_gyro_sum_x &lt;= imu0_gyro_sum_x + sign_extend16(imu0_gyro_x);&#xa;        imu0_gyro_sum_y &lt;= imu0_gyro_sum_y + sign_extend16(imu0_gyro_y);&#xa;        imu0_gyro_sum_z &lt;= imu0_gyro_sum_z + sign_extend16(imu0_gyro_z);&#xa;        imu1_accel_sum_x &lt;= imu1_accel_sum_x + sign_extend16(imu1_accel_x);&#xa;        imu1_accel_sum_y &lt;= imu1_accel_sum_y + sign_extend16(imu1_accel_y);&#xa;        imu1_accel_sum_z &lt;= imu1_accel_sum_z + sign_extend16(imu1_accel_z);&#xa;        imu1_gyro_sum_x &lt;= imu1_gyro_sum_x + sign_extend16(imu1_gyro_x);&#xa;        imu1_gyro_sum_y &lt;= imu1_gyro_sum_y + sign_extend16(imu1_gyro_y);&#xa;        imu1_gyro_sum_z &lt;= imu1_gyro_sum_z + sign_extend16(imu1_gyro_z);&#xa;        if (max3_abs(imu0_gyro_x, imu0_gyro_y, imu0_gyro_z) &gt; imu0_gyro_peak)&#xa;          imu0_gyro_peak &lt;= max3_abs(imu0_gyro_x, imu0_gyro_y, imu0_gyro_z);&#xa;        if (max3_abs(imu1_gyro_x, imu1_gyro_y, imu1_gyro_z) &gt; imu1_gyro_peak)&#xa;          imu1_gyro_peak &lt;= max3_abs(imu1_gyro_x, imu1_gyro_y, imu1_gyro_z);&#xa;&#xa;        if (sample_count &gt;= SAMPLE_COUNT - 1) begin&#xa;          imu0_accel_mean_x &lt;= (imu0_accel_sum_x + sign_extend16(imu0_accel_x)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu0_accel_mean_y &lt;= (imu0_accel_sum_y + sign_extend16(imu0_accel_y)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu0_accel_mean_z &lt;= (imu0_accel_sum_z + sign_extend16(imu0_accel_z)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu0_gyro_mean_x &lt;= (imu0_gyro_sum_x + sign_extend16(imu0_gyro_x)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu0_gyro_mean_y &lt;= (imu0_gyro_sum_y + sign_extend16(imu0_gyro_y)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu0_gyro_mean_z &lt;= (imu0_gyro_sum_z + sign_extend16(imu0_gyro_z)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu1_accel_mean_x &lt;= (imu1_accel_sum_x + sign_extend16(imu1_accel_x)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu1_accel_mean_y &lt;= (imu1_accel_sum_y + sign_extend16(imu1_accel_y)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu1_accel_mean_z &lt;= (imu1_accel_sum_z + sign_extend16(imu1_accel_z)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu1_gyro_mean_x &lt;= (imu1_gyro_sum_x + sign_extend16(imu1_gyro_x)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu1_gyro_mean_y &lt;= (imu1_gyro_sum_y + sign_extend16(imu1_gyro_y)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          imu1_gyro_mean_z &lt;= (imu1_gyro_sum_z + sign_extend16(imu1_gyro_z)) &gt;&gt;&gt; SAMPLE_SHIFT;&#xa;          busy &lt;= 1'b0;&#xa;          state &lt;= STATE_EVALUATE;&#xa;        end else begin&#xa;          sample_count &lt;= sample_count + 8'd1;&#xa;        end&#xa;      end else if (state == STATE_EVALUATE) begin&#xa;        imu0_vertical_axis &lt;= imu0_axis_eval;&#xa;        imu0_vertical_positive &lt;= selected_positive(&#xa;            imu0_axis_eval, imu0_accel_mean_x, imu0_accel_mean_y, imu0_accel_mean_z);&#xa;        imu1_vertical_axis &lt;= imu1_axis_eval;&#xa;        imu1_vertical_positive &lt;= selected_positive(&#xa;            imu1_axis_eval, imu1_accel_mean_x, imu1_accel_mean_y, imu1_accel_mean_z);&#xa;        pass &lt;= all_samples_online &amp;&amp; imu0_gravity_valid &amp;&amp;&#xa;                imu1_gravity_valid &amp;&amp; imu0_gyro_quiet &amp;&amp; imu1_gyro_quiet;&#xa;        result_flags &lt;= {&#xa;            (imu0_axis_eval == imu1_axis_eval),&#xa;            imu1_gyro_quiet,&#xa;            imu0_gyro_quiet,&#xa;            imu1_gravity_valid,&#xa;            imu0_gravity_valid,&#xa;            all_samples_online,&#xa;            (all_samples_online &amp;&amp; imu0_gravity_valid &amp;&amp; imu1_gravity_valid &amp;&amp;&#xa;             imu0_gyro_quiet &amp;&amp; imu1_gyro_quiet),&#xa;            1'b1&#xa;        };&#xa;        done &lt;= 1'b1;&#xa;        state &lt;= STATE_IDLE;&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="dual_imu_static_calibrator38" Parameters="" Parent="sys_route_gui_fsm_top" Type="model" Width="1600" X="8200" Y="1200">
