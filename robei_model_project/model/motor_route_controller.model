<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  // Temporary wheel mapping note from on-board single-wheel test:&#xa;  // code signal `lr` currently drives the physical right-rear wheel,&#xa;  // and the direction observed with this mapping is correct.&#xa;  // code signal `lf` currently drives the physical left-rear wheel,&#xa;  // and the direction observed with this mapping is correct.&#xa;  // code signal `rf` currently drives the physical left-front wheel,&#xa;  // but the forward direction is inverted and must be flipped later.&#xa;  // code signal `rr` currently drives the physical right-front wheel,&#xa;  // but the forward direction is inverted and must be flipped later.&#xa;  //&#xa;  // Finalized physical mapping:&#xa;  //   lf -> left-rear   (normal polarity)&#xa;  //   lr -> right-rear  (normal polarity)&#xa;  //   rf -> left-front  (inverted polarity)&#xa;  //   rr -> right-front (inverted polarity)&#xa;&#xa;  localparam [4:0] STATE_RUN = 5'b00011;&#xa;&#xa;  localparam [1:0] ROUTE_STOP    = 2'b00;&#xa;  localparam [1:0] ROUTE_RIGHT   = 2'b01;&#xa;  localparam [1:0] ROUTE_LEFT    = 2'b10;&#xa;  localparam [1:0] ROUTE_FORWARD = 2'b11;&#xa;&#xa;  localparam [1:0] MOTOR_STOP    = 2'b00;&#xa;  localparam [1:0] MOTOR_FORWARD = 2'b01;&#xa;  localparam [1:0] MOTOR_REVERSE = 2'b10;&#xa;&#xa;  reg [15:0] target_ticks;&#xa;  reg [1:0] start_cmd;&#xa;  reg restart_pending;&#xa;&#xa;  wire in_run;&#xa;  wire motion_done;&#xa;&#xa;  assign in_run = (state_info == STATE_RUN);&#xa;  assign motion_done = motion_busy &amp;&amp;&#xa;                       (lf_count >= target_ticks) &amp;&amp;&#xa;                       (rf_count >= target_ticks) &amp;&amp;&#xa;                       (lr_count >= target_ticks) &amp;&amp;&#xa;                       (rr_count >= target_ticks);&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      run_step_pulse &lt;= 1'b0;&#xa;      lf_dir &lt;= MOTOR_STOP;&#xa;      rf_dir &lt;= MOTOR_STOP;&#xa;      lr_dir &lt;= MOTOR_STOP;&#xa;      rr_dir &lt;= MOTOR_STOP;&#xa;      lf_duty &lt;= 8'd0;&#xa;      rf_duty &lt;= 8'd0;&#xa;      lr_duty &lt;= 8'd0;&#xa;      rr_duty &lt;= 8'd0;&#xa;      motion_busy &lt;= 1'b0;&#xa;      current_cmd &lt;= ROUTE_STOP;&#xa;      lf_count &lt;= 16'd0;&#xa;      rf_count &lt;= 16'd0;&#xa;      lr_count &lt;= 16'd0;&#xa;      rr_count &lt;= 16'd0;&#xa;      target_ticks &lt;= 16'd0;&#xa;      start_cmd &lt;= ROUTE_STOP;&#xa;      restart_pending &lt;= 1'b0;&#xa;    end else begin&#xa;      run_step_pulse &lt;= 1'b0;&#xa;&#xa;      if (!motor_enable || !in_run || active_route_steps == 6'd0) begin&#xa;        lf_dir &lt;= MOTOR_STOP;&#xa;        rf_dir &lt;= MOTOR_STOP;&#xa;        lr_dir &lt;= MOTOR_STOP;&#xa;        rr_dir &lt;= MOTOR_STOP;&#xa;        lf_duty &lt;= 8'd0;&#xa;        rf_duty &lt;= 8'd0;&#xa;        lr_duty &lt;= 8'd0;&#xa;        rr_duty &lt;= 8'd0;&#xa;        motion_busy &lt;= 1'b0;&#xa;        current_cmd &lt;= ROUTE_STOP;&#xa;        lf_count &lt;= 16'd0;&#xa;        rf_count &lt;= 16'd0;&#xa;        lr_count &lt;= 16'd0;&#xa;        rr_count &lt;= 16'd0;&#xa;        target_ticks &lt;= 16'd0;&#xa;        start_cmd &lt;= ROUTE_STOP;&#xa;        restart_pending &lt;= 1'b0;&#xa;      end else if (!motion_busy &amp;&amp; restart_pending) begin&#xa;        restart_pending &lt;= 1'b0;&#xa;      end else if (!motion_busy) begin&#xa;        start_cmd &lt;= route_info[1:0];&#xa;        current_cmd &lt;= route_info[1:0];&#xa;        lf_count &lt;= 16'd0;&#xa;        rf_count &lt;= 16'd0;&#xa;        lr_count &lt;= 16'd0;&#xa;        rr_count &lt;= 16'd0;&#xa;        motion_busy &lt;= 1'b1;&#xa;        restart_pending &lt;= 1'b0;&#xa;&#xa;        case (route_info[1:0])&#xa;          ROUTE_FORWARD: begin&#xa;            lf_dir &lt;= MOTOR_REVERSE;&#xa;            rf_dir &lt;= MOTOR_FORWARD;&#xa;            lr_dir &lt;= MOTOR_REVERSE;&#xa;            rr_dir &lt;= MOTOR_FORWARD;&#xa;            lf_duty &lt;= forward_duty;&#xa;            rf_duty &lt;= forward_duty;&#xa;            lr_duty &lt;= forward_duty;&#xa;            rr_duty &lt;= forward_duty;&#xa;            target_ticks &lt;= forward_ticks;&#xa;          end&#xa;&#xa;          ROUTE_LEFT: begin&#xa;            lf_dir &lt;= MOTOR_FORWARD;&#xa;            rf_dir &lt;= MOTOR_REVERSE;&#xa;            lr_dir &lt;= MOTOR_REVERSE;&#xa;            rr_dir &lt;= MOTOR_FORWARD;&#xa;            lf_duty &lt;= turn_duty;&#xa;            rf_duty &lt;= turn_duty;&#xa;            lr_duty &lt;= turn_duty;&#xa;            rr_duty &lt;= turn_duty;&#xa;            target_ticks &lt;= turn_ticks;&#xa;          end&#xa;&#xa;          ROUTE_RIGHT: begin&#xa;            lf_dir &lt;= MOTOR_REVERSE;&#xa;            rf_dir &lt;= MOTOR_FORWARD;&#xa;            lr_dir &lt;= MOTOR_FORWARD;&#xa;            rr_dir &lt;= MOTOR_REVERSE;&#xa;            lf_duty &lt;= turn_duty;&#xa;            rf_duty &lt;= turn_duty;&#xa;            lr_duty &lt;= turn_duty;&#xa;            rr_duty &lt;= turn_duty;&#xa;            target_ticks &lt;= turn_ticks;&#xa;          end&#xa;&#xa;          default: begin&#xa;            lf_dir &lt;= MOTOR_STOP;&#xa;            rf_dir &lt;= MOTOR_STOP;&#xa;            lr_dir &lt;= MOTOR_STOP;&#xa;            rr_dir &lt;= MOTOR_STOP;&#xa;            lf_duty &lt;= 8'd0;&#xa;            rf_duty &lt;= 8'd0;&#xa;            lr_duty &lt;= 8'd0;&#xa;            rr_duty &lt;= 8'd0;&#xa;            target_ticks &lt;= 16'd1;&#xa;          end&#xa;        endcase&#xa;      end else begin&#xa;        if (lf_tick &amp;&amp; lf_count != 16'hFFFF)&#xa;          lf_count &lt;= lf_count + 16'd1;&#xa;&#xa;        if (rf_tick &amp;&amp; rf_count != 16'hFFFF)&#xa;          rf_count &lt;= rf_count + 16'd1;&#xa;&#xa;        if (lr_tick &amp;&amp; lr_count != 16'hFFFF)&#xa;          lr_count &lt;= lr_count + 16'd1;&#xa;&#xa;        if (rr_tick &amp;&amp; rr_count != 16'hFFFF)&#xa;          rr_count &lt;= rr_count + 16'd1;&#xa;&#xa;        if (motion_done || start_cmd == ROUTE_STOP) begin&#xa;          lf_dir &lt;= MOTOR_STOP;&#xa;          rf_dir &lt;= MOTOR_STOP;&#xa;          lr_dir &lt;= MOTOR_STOP;&#xa;          rr_dir &lt;= MOTOR_STOP;&#xa;          lf_duty &lt;= 8'd0;&#xa;          rf_duty &lt;= 8'd0;&#xa;          lr_duty &lt;= 8'd0;&#xa;          rr_duty &lt;= 8'd0;&#xa;          motion_busy &lt;= 1'b0;&#xa;          run_step_pulse &lt;= 1'b1;&#xa;          restart_pending &lt;= 1'b1;&#xa;        end&#xa;      end&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="motor_route_controller" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.0527778"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.118519"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="motor_enable" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.183333"/>
 <Port Color="#f0ffff" Connect="" Datasize="5" Datatype="wire" Description="" Height="30" Inout="input" Name="state_info" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.252778"/>
 <Port Color="#f5f5dc" Connect="" Datasize="64" Datatype="wire" Description="" Height="30" Inout="input" Name="route_info" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.318519"/>
 <Port Color="#ffe4c4" Connect="" Datasize="6" Datatype="wire" Description="" Height="30" Inout="input" Name="active_route_steps" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.383333"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="lf_tick" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.452778"/>
 <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rf_tick" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.518519"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="lr_tick" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.583333"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rr_tick" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.652778"/>
 <Port Color="#a52a2a" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="forward_ticks" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.718519"/>
 <Port Color="#deb887" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="turn_ticks" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.783333"/>
 <Port Color="#5f9ea0" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="forward_duty" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.852778"/>
 <Port Color="#7fff00" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="turn_duty" Parent="motor_route_controller" Side="left" Width="30" X="-0.01875" Y="0.918519"/>
 <Port Color="#d2691e" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="run_step_pulse" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.0527778"/>
 <Port Color="#ff7f50" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="lf_dir" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.107407"/>
 <Port Color="#6495ed" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="rf_dir" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.169444"/>
 <Port Color="#fff8dc" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="lr_dir" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.231481"/>
 <Port Color="#dc143c" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="rr_dir" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.293519"/>
 <Port Color="#00ffff" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="lf_duty" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.355556"/>
 <Port Color="#00008b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="rf_duty" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.418519"/>
 <Port Color="#008b8b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="lr_duty" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.50463"/>
 <Port Color="#b8860b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="rr_duty" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.543519"/>
 <Port Color="#a9a9a9" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="motion_busy" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.605556"/>
 <Port Color="#006400" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="current_cmd" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.668519"/>
 <Port Color="#a9a9a9" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="lf_count" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.730556"/>
 <Port Color="#bdb76b" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="rf_count" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.792593"/>
 <Port Color="#8b008b" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="lr_count" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.85463"/>
 <Port Color="#556b2f" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="rr_count" Parent="motor_route_controller" Side="right" Width="30" X="0.98125" Y="0.916667"/>
</Module>
