 <Module Category="Current" Class="key_pulse_filter" Code="  reg [1:0] key_sync;&#xa;  reg key_level;&#xa;  reg key_level_d;&#xa;  reg [19:0] stable_cnt;&#xa;&#xa;  wire key_pressed;&#xa;&#xa;  assign key_pressed = ~key_sync[1];&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      key_sync    &lt;= 2'b11;&#xa;      key_level   &lt;= 1'b0;&#xa;      key_level_d &lt;= 1'b0;&#xa;      stable_cnt  &lt;= 20'd0;&#xa;      key_pulse   &lt;= 1'b0;&#xa;    end else begin&#xa;      key_sync &lt;= {key_sync[0], key_n};&#xa;&#xa;      if (key_pressed == key_level) begin&#xa;        stable_cnt &lt;= 20'd0;&#xa;      end else if (stable_cnt >= 20'd999999) begin&#xa;        key_level  &lt;= key_pressed;&#xa;        stable_cnt &lt;= 20'd0;&#xa;      end else begin&#xa;        stable_cnt &lt;= stable_cnt + 20'd1;&#xa;      end&#xa;&#xa;      key_level_d &lt;= key_level;&#xa;      key_pulse   &lt;= key_level &amp; ~key_level_d;&#xa;    end&#xa;  end" Color="antiquewhite" Comment="" Height="220" Name="key_up_filter" Parameters="" Parent="sys_route_control_fsm" Type="model" Width="200" X="176.31" Y="70.0672">
