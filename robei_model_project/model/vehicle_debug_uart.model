 <Port Color="#deb887" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_packet_count" Parent="vehicle_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.5675"/>
