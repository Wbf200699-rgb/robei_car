<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="    `ifdef SYNTHESIS&#xa;      wire clkfb_mmcm;&#xa;      wire clkfb_bufg;&#xa;      wire clk_pix_mmcm;&#xa;      wire clk_5x_mmcm;&#xa;      wire mmcm_locked;&#xa;      reg [15:0] lock_count = 16'd0;&#xa;      reg stable_locked = 1'b0;&#xa;    &#xa;      MMCME2_ADV #(&#xa;        .BANDWIDTH(&quot;OPTIMIZED&quot;),&#xa;        .CLKIN1_PERIOD(20.000),&#xa;        .CLKIN2_PERIOD(0.000),&#xa;        .CLKFBOUT_MULT_F(20.000),&#xa;        .CLKFBOUT_PHASE(0.000),&#xa;        .DIVCLK_DIVIDE(1),&#xa;        .CLKOUT0_DIVIDE_F(20.000),&#xa;        .CLKOUT0_PHASE(0.000),&#xa;        .CLKOUT0_DUTY_CYCLE(0.500),&#xa;        .CLKOUT1_DIVIDE(4),&#xa;        .CLKOUT1_PHASE(0.000),&#xa;        .CLKOUT1_DUTY_CYCLE(0.500),&#xa;        .CLKOUT2_DIVIDE(16),&#xa;        .CLKOUT2_PHASE(0.000),&#xa;        .CLKOUT2_DUTY_CYCLE(0.500),&#xa;        .CLKOUT3_DIVIDE(16),&#xa;        .CLKOUT3_PHASE(0.000),&#xa;        .CLKOUT3_DUTY_CYCLE(0.500),&#xa;        .CLKOUT4_DIVIDE(16),&#xa;        .CLKOUT4_PHASE(0.000),&#xa;        .CLKOUT4_DUTY_CYCLE(0.500),&#xa;        .CLKOUT5_DIVIDE(16),&#xa;        .CLKOUT5_PHASE(0.000),&#xa;        .CLKOUT5_DUTY_CYCLE(0.500),&#xa;        .CLKOUT6_DIVIDE(16),&#xa;        .CLKOUT6_PHASE(0.000),&#xa;        .CLKOUT6_DUTY_CYCLE(0.500),&#xa;        .COMPENSATION(&quot;ZHOLD&quot;),&#xa;        .REF_JITTER1(0.010),&#xa;        .STARTUP_WAIT(&quot;FALSE&quot;)&#xa;      ) mmcm_inst (&#xa;        .CLKIN1(clk_in1),&#xa;        .CLKIN2(1'b0),&#xa;        .CLKINSEL(1'b1),&#xa;        .RST(1'b0),&#xa;        .PWRDWN(1'b0),&#xa;        .CLKFBIN(clkfb_bufg),&#xa;        .CLKFBOUT(clkfb_mmcm),&#xa;        .CLKFBOUTB(),&#xa;          .CLKOUT0(clk_pix_mmcm),&#xa;          .CLKOUT0B(),&#xa;          .CLKOUT1(clk_5x_mmcm),&#xa;          .CLKOUT1B(),&#xa;        .CLKOUT2(),&#xa;        .CLKOUT2B(),&#xa;        .CLKOUT3(),&#xa;        .CLKOUT3B(),&#xa;        .CLKOUT4(),&#xa;        .CLKOUT5(),&#xa;        .CLKOUT6(),&#xa;        .DO(),&#xa;        .DRDY(),&#xa;        .DADDR(7'd0),&#xa;        .DCLK(1'b0),&#xa;        .DEN(1'b0),&#xa;        .DI(16'd0),&#xa;        .DWE(1'b0),&#xa;        .PSCLK(1'b0),&#xa;        .PSEN(1'b0),&#xa;        .PSINCDEC(1'b0),&#xa;        .PSDONE(),&#xa;        .LOCKED(mmcm_locked),&#xa;        .CLKINSTOPPED(),&#xa;        .CLKFBSTOPPED()&#xa;      );&#xa;    &#xa;      BUFG clkfb_bufg_inst (&#xa;        .I(clkfb_mmcm),&#xa;        .O(clkfb_bufg)&#xa;      );&#xa;    &#xa;      BUFG clk_pix_bufg_inst (&#xa;        .I(clk_pix_mmcm),&#xa;        .O(clk_out1)&#xa;      );&#xa;    &#xa;      BUFG clk_5x_bufg_inst (&#xa;        .I(clk_5x_mmcm),&#xa;        .O(clk_out2)&#xa;      );&#xa;    &#xa;      always @(posedge clk_out1) begin&#xa;        if (!mmcm_locked) begin&#xa;          lock_count &lt;= 16'd0;&#xa;          stable_locked &lt;= 1'b0;&#xa;        end else if (!stable_locked) begin&#xa;          if (lock_count == 16'd49999)&#xa;            stable_locked &lt;= 1'b1;&#xa;          else&#xa;            lock_count &lt;= lock_count + 16'd1;&#xa;        end&#xa;      end&#xa;&#xa;      assign locked = stable_locked;&#xa;    `else&#xa;      reg clk_50m = 1'b0;&#xa;      reg clk_250m = 1'b0;&#xa;      reg is_locked = 1'b0;&#xa;    &#xa;      always @(posedge clk_in1 or negedge resetn) begin&#xa;        if (!resetn)&#xa;          is_locked &lt;= 1'b0;&#xa;        else&#xa;          #100 is_locked &lt;= 1'b1;&#xa;      end&#xa;    &#xa;      always #10.000 clk_50m = ~clk_50m;&#xa;      always #2.000 clk_250m = ~clk_250m;&#xa;    &#xa;      assign clk_out1 = clk_50m;&#xa;      assign clk_out2 = clk_250m;&#xa;      assign locked = is_locked;&#xa;    `endif" Color="#d3d3d3" Comment="" Height="1080" Name="clk_wiz_0" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_in1" Parent="clk_wiz_0" Side="left" Width="30" X="-0.01875" Y="0.275"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="resetn" Parent="clk_wiz_0" Side="left" Width="30" X="-0.01875" Y="0.725"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="clk_out1" Parent="clk_wiz_0" Side="right" Width="30" X="0.98125" Y="0.2"/>
