 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="locked" Parent="clk_wiz_0" Side="right" Width="30" X="0.98125" Y="0.8"/>
</Module>
