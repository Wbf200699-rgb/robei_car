<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam [4:0] STATE_MENU   = 5'b00000;&#xa;  localparam [4:0] STATE_CHANGE = 5'b00001;&#xa;  localparam [4:0] STATE_RUN    = 5'b00011;&#xa;  localparam [4:0] STATE_STOP   = 5'b00100;&#xa;&#xa;  localparam [1:0] MENU_FOCUS_CHANGE = 2'b00;&#xa;  localparam [1:0] MENU_IN_CHANGE    = 2'b01;&#xa;  localparam [1:0] MENU_FOCUS_RUN    = 2'b10;&#xa;  localparam [1:0] MENU_IN_RUN       = 2'b11;&#xa;&#xa;  localparam [1:0] ROUTE_STOP    = 2'b00;&#xa;  localparam [1:0] ROUTE_RIGHT   = 2'b01;&#xa;  localparam [1:0] ROUTE_LEFT    = 2'b10;&#xa;  localparam [1:0] ROUTE_FORWARD = 2'b11;&#xa;&#xa;  localparam [1:0] DIR_UP    = 2'd0;&#xa;  localparam [1:0] DIR_RIGHT = 2'd1;&#xa;  localparam [1:0] DIR_DOWN  = 2'd2;&#xa;  localparam [1:0] DIR_LEFT  = 2'd3;&#xa;&#xa;  reg focus_run;&#xa;  reg [1:0] now_dir;&#xa;  reg [1:0] target_dir;&#xa;&#xa;  reg [5:0] step_count;&#xa;  reg [5:0] step_start [0:31];&#xa;  reg [1:0] step_words [0:31];&#xa;&#xa;  integer i;&#xa;  reg [5:0] undo_start;&#xa;  reg [1:0] undo_words;&#xa;  reg [1:0] run_cmd;&#xa;&#xa;  assign step_length = (step_length_set == 16'd0) ? 16'd20 : step_length_set;&#xa;  assign speed = speed_set;&#xa;  assign total_route_length = (completed_route_steps + active_route_steps) * step_length;&#xa;  assign complete_route_length = completed_route_steps * step_length;&#xa;  assign remaining_route_length = active_route_steps * step_length;&#xa;&#xa;  always @(*) begin&#xa;    case (state_info)&#xa;      STATE_CHANGE: menu_info = MENU_IN_CHANGE;&#xa;      STATE_RUN:    menu_info = MENU_IN_RUN;&#xa;      STATE_STOP:   menu_info = MENU_FOCUS_CHANGE;&#xa;      default:      menu_info = focus_run ? MENU_FOCUS_RUN : MENU_FOCUS_CHANGE;&#xa;    endcase&#xa;  end&#xa;&#xa;  task apply_route_cmd_to_target;&#xa;    input [1:0] cmd;&#xa;    begin&#xa;      if (cmd == ROUTE_RIGHT)&#xa;        target_dir = target_dir + 2'd1;&#xa;      else if (cmd == ROUTE_LEFT)&#xa;        target_dir = target_dir - 2'd1;&#xa;      else if (cmd == ROUTE_FORWARD) begin&#xa;        case (target_dir)&#xa;          DIR_UP:    target_y = target_y - 8'd1;&#xa;          DIR_RIGHT: target_x = target_x + 8'd1;&#xa;          DIR_DOWN:  target_y = target_y + 8'd1;&#xa;          default:   target_x = target_x - 8'd1;&#xa;        endcase&#xa;      end&#xa;    end&#xa;  endtask&#xa;&#xa;  task apply_route_cmd_to_now;&#xa;    input [1:0] cmd;&#xa;    begin&#xa;      if (cmd == ROUTE_RIGHT)&#xa;        now_dir = now_dir + 2'd1;&#xa;      else if (cmd == ROUTE_LEFT)&#xa;        now_dir = now_dir - 2'd1;&#xa;      else if (cmd == ROUTE_FORWARD) begin&#xa;        case (now_dir)&#xa;          DIR_UP:    now_y = now_y - 8'd1;&#xa;          DIR_RIGHT: now_x = now_x + 8'd1;&#xa;          DIR_DOWN:  now_y = now_y + 8'd1;&#xa;          default:   now_x = now_x - 8'd1;&#xa;        endcase&#xa;      end&#xa;    end&#xa;  endtask&#xa;&#xa;  task clear_active_route;&#xa;    begin&#xa;      route_info &lt;= 64'd0;&#xa;      active_route_steps &lt;= 6'd0;&#xa;      step_count &lt;= 6'd0;&#xa;      target_x &lt;= now_x;&#xa;      target_y &lt;= now_y;&#xa;      target_dir &lt;= now_dir;&#xa;      for (i = 0; i &lt; 32; i = i + 1) begin&#xa;        step_start[i] &lt;= 6'd0;&#xa;        step_words[i] &lt;= 2'd0;&#xa;      end&#xa;    end&#xa;  endtask&#xa;&#xa;  task rebuild_target_from_active;&#xa;    input [5:0] limit_count;&#xa;    begin&#xa;      target_x = now_x;&#xa;      target_y = now_y;&#xa;      target_dir = now_dir;&#xa;      for (i = 0; i &lt; 32; i = i + 1) begin&#xa;        if (i &lt; limit_count) begin&#xa;          if (route_info[i*2 +: 2] != ROUTE_STOP)&#xa;            apply_route_cmd_to_target(route_info[i*2 +: 2]);&#xa;        end&#xa;      end&#xa;    end&#xa;  endtask&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      focus_run &lt;= 1'b0;&#xa;      state_info &lt;= STATE_MENU;&#xa;      route_info &lt;= 64'd0;&#xa;      old_route_info &lt;= 64'd0;&#xa;      active_route_steps &lt;= 6'd0;&#xa;      completed_route_steps &lt;= 6'd0;&#xa;      step_count &lt;= 6'd0;&#xa;      now_x &lt;= 8'd128;&#xa;      now_y &lt;= 8'd128;&#xa;      target_x &lt;= 8'd128;&#xa;      target_y &lt;= 8'd128;&#xa;      now_dir &lt;= DIR_UP;&#xa;      target_dir &lt;= DIR_UP;&#xa;&#xa;      for (i = 0; i &lt; 32; i = i + 1) begin&#xa;        step_start[i] &lt;= 6'd0;&#xa;        step_words[i] &lt;= 2'd0;&#xa;      end&#xa;    end else begin&#xa;      case (state_info)&#xa;        STATE_CHANGE: begin&#xa;          if (key_mid_pulse) begin&#xa;            state_info &lt;= STATE_MENU;&#xa;          end else if (key_down_pulse) begin&#xa;            if (step_count != 6'd0) begin&#xa;              undo_start = step_start[step_count - 6'd1];&#xa;              undo_words = step_words[step_count - 6'd1];&#xa;&#xa;              for (i = 0; i &lt; 32; i = i + 1) begin&#xa;                if ((i >= undo_start) &amp;&amp; (i &lt; undo_start + undo_words))&#xa;                  route_info[i*2 +: 2] &lt;= 2'b00;&#xa;              end&#xa;&#xa;              active_route_steps &lt;= undo_start;&#xa;              step_count &lt;= step_count - 6'd1;&#xa;              rebuild_target_from_active(undo_start);&#xa;            end&#xa;          end else if (key_up_pulse) begin&#xa;            if (active_route_steps &lt; 6'd32 &amp;&amp; step_count &lt; 6'd32) begin&#xa;              route_info[active_route_steps*2 +: 2] &lt;= ROUTE_FORWARD;&#xa;              step_start[step_count] &lt;= active_route_steps;&#xa;              step_words[step_count] &lt;= 2'd1;&#xa;              active_route_steps &lt;= active_route_steps + 6'd1;&#xa;              step_count &lt;= step_count + 6'd1;&#xa;              apply_route_cmd_to_target(ROUTE_FORWARD);&#xa;            end&#xa;          end else if (key_left_pulse) begin&#xa;            if (active_route_steps &lt; 6'd31 &amp;&amp; step_count &lt; 6'd32) begin&#xa;              route_info[active_route_steps*2 +: 2] &lt;= ROUTE_LEFT;&#xa;              route_info[(active_route_steps + 6'd1)*2 +: 2] &lt;= ROUTE_FORWARD;&#xa;              step_start[step_count] &lt;= active_route_steps;&#xa;              step_words[step_count] &lt;= 2'd2;&#xa;              active_route_steps &lt;= active_route_steps + 6'd2;&#xa;              step_count &lt;= step_count + 6'd1;&#xa;              apply_route_cmd_to_target(ROUTE_LEFT);&#xa;              apply_route_cmd_to_target(ROUTE_FORWARD);&#xa;            end&#xa;          end else if (key_right_pulse) begin&#xa;            if (active_route_steps &lt; 6'd31 &amp;&amp; step_count &lt; 6'd32) begin&#xa;              route_info[active_route_steps*2 +: 2] &lt;= ROUTE_RIGHT;&#xa;              route_info[(active_route_steps + 6'd1)*2 +: 2] &lt;= ROUTE_FORWARD;&#xa;              step_start[step_count] &lt;= active_route_steps;&#xa;              step_words[step_count] &lt;= 2'd2;&#xa;              active_route_steps &lt;= active_route_steps + 6'd2;&#xa;              step_count &lt;= step_count + 6'd1;&#xa;              apply_route_cmd_to_target(ROUTE_RIGHT);&#xa;              apply_route_cmd_to_target(ROUTE_FORWARD);&#xa;            end&#xa;          end&#xa;        end&#xa;&#xa;        STATE_RUN: begin&#xa;          if (obstacle_stop) begin&#xa;            state_info &lt;= STATE_STOP;&#xa;            clear_active_route();&#xa;          end else if (run_step_pulse &amp;&amp; active_route_steps != 6'd0) begin&#xa;            run_cmd = route_info[1:0];&#xa;            old_route_info[completed_route_steps*2 +: 2] &lt;= run_cmd;&#xa;            completed_route_steps &lt;= completed_route_steps + 6'd1;&#xa;            apply_route_cmd_to_now(run_cmd);&#xa;            route_info &lt;= {2'b00, route_info[63:2]};&#xa;            active_route_steps &lt;= active_route_steps - 6'd1;&#xa;          end else if (active_route_steps == 6'd0) begin&#xa;            state_info &lt;= STATE_MENU;&#xa;            focus_run &lt;= 1'b0;&#xa;          end&#xa;        end&#xa;&#xa;        STATE_STOP: begin&#xa;          if (key_mid_pulse) begin&#xa;            state_info &lt;= STATE_CHANGE;&#xa;            focus_run &lt;= 1'b0;&#xa;            clear_active_route();&#xa;          end&#xa;        end&#xa;&#xa;        default: begin&#xa;          state_info &lt;= STATE_MENU;&#xa;&#xa;          if (key_up_pulse)&#xa;            focus_run &lt;= 1'b0;&#xa;          else if (key_down_pulse)&#xa;            focus_run &lt;= 1'b1;&#xa;&#xa;          if (key_mid_pulse) begin&#xa;            if (focus_run)&#xa;              state_info &lt;= STATE_RUN;&#xa;            else&#xa;              state_info &lt;= STATE_CHANGE;&#xa;          end&#xa;        end&#xa;      endcase&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="sys_route_control_core" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.0694444"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.152778"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_up_pulse" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.236111"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_down_pulse" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.319444"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_left_pulse" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.402778"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_right_pulse" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_mid_pulse" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.652778"/>
 <Port Color="#ffebcd" Connect="" Datasize="64" Datatype="reg" Description="" Height="30" Inout="output" Name="old_route_info" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.234259"/>
 <Port Color="#0000ff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="complete_route_length" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.606481"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="run_step_pulse" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.736111"/>
 <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="obstacle_stop" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.569444"/>
 <Port Color="#7fff00" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="menu_info" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.0481481"/>
 <Port Color="#d2691e" Connect="" Datasize="5" Datatype="reg" Description="" Height="30" Inout="output" Name="state_info" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.110185"/>
 <Port Color="#ff7f50" Connect="" Datasize="64" Datatype="reg" Description="" Height="30" Inout="output" Name="route_info" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.172222"/>
 <Port Color="#6495ed" Connect="" Datasize="6" Datatype="reg" Description="" Height="30" Inout="output" Name="active_route_steps" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.296296"/>
 <Port Color="#fff8dc" Connect="" Datasize="6" Datatype="reg" Description="" Height="30" Inout="output" Name="completed_route_steps" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.358333"/>
 <Port Color="#dc143c" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="step_length" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.42037"/>
 <Port Color="#00ffff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="speed" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.482407"/>
 <Port Color="#00008b" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="step_length_set" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.819444"/>
 <Port Color="#008b8b" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="speed_set" Parent="sys_route_control_core" Side="left" Width="30" X="-0.01875" Y="0.902778"/>
 <Port Color="#b8860b" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="total_route_length" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.544444"/>
 <Port Color="#a9a9a9" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="remaining_route_length" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.668519"/>
 <Port Color="#006400" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="now_x" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.730556"/>
 <Port Color="#a9a9a9" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="now_y" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.792593"/>
 <Port Color="#bdb76b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="target_x" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.85463"/>
 <Port Color="#8b008b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="target_y" Parent="sys_route_control_core" Side="right" Width="30" X="0.98125" Y="0.916667"/>
</Module>
