<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam integer POR_CYCLES = 1000000;&#xa;  reg [19:0] por_count;&#xa;&#xa;  initial begin&#xa;    por_count = 20'd0;&#xa;    system_rst_n = 1'b0;&#xa;  end&#xa;&#xa;  always @(posedge clk or negedge ext_rst_n) begin&#xa;    if (!ext_rst_n) begin&#xa;      por_count &lt;= 20'd0;&#xa;      system_rst_n &lt;= 1'b0;&#xa;    end else if (!system_rst_n) begin&#xa;      if (por_count &gt;= POR_CYCLES - 1) begin&#xa;        por_count &lt;= por_count;&#xa;        system_rst_n &lt;= 1'b1;&#xa;      end else begin&#xa;        por_count &lt;= por_count + 20'd1;&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="power_on_reset" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="power_on_reset" Side="left" Width="30" X="-0.01875" Y="0.275"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="ext_rst_n" Parent="power_on_reset" Side="left" Width="30" X="-0.01875" Y="0.725"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="system_rst_n" Parent="power_on_reset" Side="right" Width="30" X="0.98125" Y="0.5"/>
</Module>
