<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam [4:0] STATE_MENU   = 5'b00000;&#xa;  localparam [4:0] STATE_CHANGE = 5'b00001;&#xa;  localparam [4:0] STATE_RUN    = 5'b00011;&#xa;  localparam [4:0] STATE_STOP   = 5'b00100;&#xa;&#xa;  localparam [1:0] MENU_FOCUS_CHANGE = 2'b00;&#xa;  localparam [1:0] MENU_IN_CHANGE    = 2'b01;&#xa;  localparam [1:0] MENU_FOCUS_RUN    = 2'b10;&#xa;  localparam [1:0] MENU_IN_RUN       = 2'b11;&#xa;&#xa;  localparam [1:0] ROUTE_STOP    = 2'b00;&#xa;  localparam [1:0] ROUTE_RIGHT   = 2'b01;&#xa;  localparam [1:0] ROUTE_LEFT    = 2'b10;&#xa;  localparam [1:0] ROUTE_FORWARD = 2'b11;&#xa;&#xa;  localparam [1:0] DIR_UP    = 2'd0;&#xa;  localparam [1:0] DIR_RIGHT = 2'd1;&#xa;  localparam [1:0] DIR_DOWN  = 2'd2;&#xa;  localparam [1:0] DIR_LEFT  = 2'd3;&#xa;  localparam integer ROUTE_WORDS = 16;&#xa;  localparam integer ROUTE_LAST = ROUTE_WORDS - 1;&#xa;&#xa;  integer i;&#xa;  reg focus_run;&#xa;  reg [1:0] now_dir;&#xa;  reg [1:0] target_dir;&#xa;  reg [5:0] step_count;&#xa;  reg [15:0] step_is_turn;&#xa;  reg [1:0] route_cmd_mem [0:ROUTE_WORDS-1];&#xa;  reg [1:0] old_route_cmd_mem [0:ROUTE_WORDS-1];&#xa;&#xa;  assign step_length = (step_length_set == 16'd0) ? 16'd20 : step_length_set;&#xa;  assign speed = speed_set;&#xa;  assign total_route_length = {10'd0, completed_route_steps + active_route_steps} * step_length;&#xa;  assign complete_route_length = {10'd0, completed_route_steps} * step_length;&#xa;  assign remaining_route_length = {10'd0, active_route_steps} * step_length;&#xa;&#xa;  always @(*) begin&#xa;    case (state_info)&#xa;      STATE_CHANGE: menu_info = MENU_IN_CHANGE;&#xa;      STATE_RUN:    menu_info = MENU_IN_RUN;&#xa;      STATE_STOP:   menu_info = MENU_FOCUS_CHANGE;&#xa;      default:      menu_info = focus_run ? MENU_FOCUS_RUN : MENU_FOCUS_CHANGE;&#xa;    endcase&#xa;  end&#xa;&#xa;  always @(*) begin&#xa;    route_info = 64'd0;&#xa;    old_route_info = 64'd0;&#xa;    for (i = 0; i &lt; ROUTE_WORDS; i = i + 1) begin&#xa;      route_info[i*2 +: 2] = route_cmd_mem[i];&#xa;      old_route_info[i*2 +: 2] = old_route_cmd_mem[i];&#xa;    end&#xa;  end&#xa;&#xa;  task move_target_forward;&#xa;    begin&#xa;      case (target_dir)&#xa;        DIR_UP:    target_y &lt;= target_y - 8'd1;&#xa;        DIR_RIGHT: target_x &lt;= target_x + 8'd1;&#xa;        DIR_DOWN:  target_y &lt;= target_y + 8'd1;&#xa;        default:   target_x &lt;= target_x - 8'd1;&#xa;      endcase&#xa;    end&#xa;  endtask&#xa;&#xa;  task move_target_backward;&#xa;    begin&#xa;      case (target_dir)&#xa;        DIR_UP:    target_y &lt;= target_y + 8'd1;&#xa;        DIR_RIGHT: target_x &lt;= target_x - 8'd1;&#xa;        DIR_DOWN:  target_y &lt;= target_y - 8'd1;&#xa;        default:   target_x &lt;= target_x + 8'd1;&#xa;      endcase&#xa;    end&#xa;  endtask&#xa;&#xa;  task move_now_forward;&#xa;    begin&#xa;      case (now_dir)&#xa;        DIR_UP:    now_y &lt;= now_y - 8'd1;&#xa;        DIR_RIGHT: now_x &lt;= now_x + 8'd1;&#xa;        DIR_DOWN:  now_y &lt;= now_y + 8'd1;&#xa;        default:   now_x &lt;= now_x - 8'd1;&#xa;      endcase&#xa;    end&#xa;  endtask&#xa;&#xa;  task clear_active_route;&#xa;    begin&#xa;      for (i = 0; i &lt; ROUTE_WORDS; i = i + 1)&#xa;        route_cmd_mem[i] &lt;= ROUTE_STOP;&#xa;      active_route_steps &lt;= 6'd0;&#xa;      step_count &lt;= 6'd0;&#xa;      step_is_turn &lt;= 16'd0;&#xa;      target_x &lt;= now_x;&#xa;      target_y &lt;= now_y;&#xa;      target_dir &lt;= now_dir;&#xa;    end&#xa;  endtask&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      focus_run &lt;= 1'b0;&#xa;      state_info &lt;= STATE_MENU;&#xa;      active_route_steps &lt;= 6'd0;&#xa;      completed_route_steps &lt;= 6'd0;&#xa;      step_count &lt;= 6'd0;&#xa;      step_is_turn &lt;= 32'd0;&#xa;      now_x &lt;= 8'd128;&#xa;      now_y &lt;= 8'd128;&#xa;      target_x &lt;= 8'd128;&#xa;      target_y &lt;= 8'd128;&#xa;      now_dir &lt;= DIR_UP;&#xa;      target_dir &lt;= DIR_UP;&#xa;      for (i = 0; i &lt; ROUTE_WORDS; i = i + 1) begin&#xa;        route_cmd_mem[i] &lt;= ROUTE_STOP;&#xa;        old_route_cmd_mem[i] &lt;= ROUTE_STOP;&#xa;      end&#xa;    end else begin&#xa;      case (state_info)&#xa;        STATE_CHANGE: begin&#xa;          if (key_mid_pulse) begin&#xa;            state_info &lt;= STATE_MENU;&#xa;          end else if (key_down_pulse) begin&#xa;            if (step_count != 6'd0) begin&#xa;              if (step_is_turn[step_count - 6'd1]) begin&#xa;                route_cmd_mem[active_route_steps - 6'd1] &lt;= ROUTE_STOP;&#xa;                route_cmd_mem[active_route_steps - 6'd2] &lt;= ROUTE_STOP;&#xa;                active_route_steps &lt;= active_route_steps - 6'd2;&#xa;                step_count &lt;= step_count - 6'd1;&#xa;                step_is_turn[step_count - 6'd1] &lt;= 1'b0;&#xa;                move_target_backward();&#xa;                if (route_cmd_mem[active_route_steps - 6'd2] == ROUTE_LEFT)&#xa;                  target_dir &lt;= target_dir + 2'd1;&#xa;                else&#xa;                  target_dir &lt;= target_dir - 2'd1;&#xa;              end else begin&#xa;                route_cmd_mem[active_route_steps - 6'd1] &lt;= ROUTE_STOP;&#xa;                active_route_steps &lt;= active_route_steps - 6'd1;&#xa;                step_count &lt;= step_count - 6'd1;&#xa;                step_is_turn[step_count - 6'd1] &lt;= 1'b0;&#xa;                move_target_backward();&#xa;              end&#xa;            end&#xa;          end else if (key_up_pulse) begin&#xa;            if (active_route_steps &lt; 6'd32 &amp;&amp; step_count &lt; 6'd32) begin&#xa;              route_cmd_mem[active_route_steps] &lt;= ROUTE_FORWARD;&#xa;              active_route_steps &lt;= active_route_steps + 6'd1;&#xa;              step_count &lt;= step_count + 6'd1;&#xa;              step_is_turn[step_count] &lt;= 1'b0;&#xa;              move_target_forward();&#xa;            end&#xa;          end else if (key_left_pulse) begin&#xa;            if (active_route_steps &lt; 6'd15 &amp;&amp; step_count &lt; 6'd16) begin&#xa;              route_cmd_mem[active_route_steps] &lt;= ROUTE_LEFT;&#xa;              route_cmd_mem[active_route_steps + 6'd1] &lt;= ROUTE_FORWARD;&#xa;              active_route_steps &lt;= active_route_steps + 6'd2;&#xa;              step_count &lt;= step_count + 6'd1;&#xa;              step_is_turn[step_count] &lt;= 1'b1;&#xa;              target_dir &lt;= target_dir - 2'd1;&#xa;              case (target_dir - 2'd1)&#xa;                DIR_UP:    target_y &lt;= target_y - 8'd1;&#xa;                DIR_RIGHT: target_x &lt;= target_x + 8'd1;&#xa;                DIR_DOWN:  target_y &lt;= target_y + 8'd1;&#xa;                default:   target_x &lt;= target_x - 8'd1;&#xa;              endcase&#xa;            end&#xa;          end else if (key_right_pulse) begin&#xa;            if (active_route_steps &lt; 6'd15 &amp;&amp; step_count &lt; 6'd16) begin&#xa;              route_cmd_mem[active_route_steps] &lt;= ROUTE_RIGHT;&#xa;              route_cmd_mem[active_route_steps + 6'd1] &lt;= ROUTE_FORWARD;&#xa;              active_route_steps &lt;= active_route_steps + 6'd2;&#xa;              step_count &lt;= step_count + 6'd1;&#xa;              step_is_turn[step_count] &lt;= 1'b1;&#xa;              target_dir &lt;= target_dir + 2'd1;&#xa;              case (target_dir + 2'd1)&#xa;                DIR_UP:    target_y &lt;= target_y - 8'd1;&#xa;                DIR_RIGHT: target_x &lt;= target_x + 8'd1;&#xa;                DIR_DOWN:  target_y &lt;= target_y + 8'd1;&#xa;                default:   target_x &lt;= target_x - 8'd1;&#xa;              endcase&#xa;            end&#xa;          end&#xa;        end&#xa;&#xa;        STATE_RUN: begin&#xa;          if (obstacle_stop) begin&#xa;            state_info &lt;= STATE_STOP;&#xa;            clear_active_route();&#xa;          end else if (run_step_pulse &amp;&amp; active_route_steps != 6'd0) begin&#xa;            old_route_cmd_mem[completed_route_steps] &lt;= route_cmd_mem[0];&#xa;            completed_route_steps &lt;= completed_route_steps + 6'd1;&#xa;&#xa;            if (route_cmd_mem[0] == ROUTE_RIGHT)&#xa;              now_dir &lt;= now_dir + 2'd1;&#xa;            else if (route_cmd_mem[0] == ROUTE_LEFT)&#xa;              now_dir &lt;= now_dir - 2'd1;&#xa;            else&#xa;              move_now_forward();&#xa;&#xa;            for (i = 0; i &lt; ROUTE_LAST; i = i + 1)&#xa;              route_cmd_mem[i] &lt;= route_cmd_mem[i + 1];&#xa;            route_cmd_mem[ROUTE_LAST] &lt;= ROUTE_STOP;&#xa;            active_route_steps &lt;= active_route_steps - 6'd1;&#xa;          end else if (active_route_steps == 6'd0) begin&#xa;            state_info &lt;= STATE_MENU;&#xa;            focus_run &lt;= 1'b0;&#xa;          end&#xa;        end&#xa;&#xa;        STATE_STOP: begin&#xa;          if (key_mid_pulse) begin&#xa;            state_info &lt;= STATE_CHANGE;&#xa;            focus_run &lt;= 1'b0;&#xa;            clear_active_route();&#xa;          end&#xa;        end&#xa;&#xa;        default: begin&#xa;          state_info &lt;= STATE_MENU;&#xa;&#xa;          if (key_up_pulse)&#xa;            focus_run &lt;= 1'b0;&#xa;          else if (key_down_pulse)&#xa;            focus_run &lt;= 1'b1;&#xa;&#xa;          if (key_mid_pulse) begin&#xa;            if (focus_run)&#xa;              state_info &lt;= STATE_RUN;&#xa;            else&#xa;              state_info &lt;= STATE_CHANGE;&#xa;          end&#xa;        end&#xa;      endcase&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="route_contol_core" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.0675926"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.152778"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_up_pulse" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.233333"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_down_pulse" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.318519"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_left_pulse" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.402778"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_right_pulse" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.483333"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_mid_pulse" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.568519"/>
 <Port Color="#ffebcd" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="menu_info" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.0462963"/>
 <Port Color="#0000ff" Connect="" Datasize="64" Datatype="reg" Description="" Height="30" Inout="output" Name="route_info" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.169444"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="run_step_pulse" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.652778"/>
 <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="obstacle_stop" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.733333"/>
 <Port Color="#deb887" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="step_length_set" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.818519"/>
 <Port Color="#5f9ea0" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="speed_set" Parent="route_contol_core" Side="left" Width="30" X="-0.01875" Y="0.902778"/>
 <Port Color="#7fff00" Connect="" Datasize="5" Datatype="reg" Description="" Height="30" Inout="output" Name="state_info" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.107407"/>
 <Port Color="#d2691e" Connect="" Datasize="64" Datatype="reg" Description="" Height="30" Inout="output" Name="old_route_info" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.231481"/>
 <Port Color="#ff7f50" Connect="" Datasize="6" Datatype="reg" Description="" Height="30" Inout="output" Name="active_route_steps" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.293519"/>
 <Port Color="#6495ed" Connect="" Datasize="6" Datatype="reg" Description="" Height="30" Inout="output" Name="completed_route_steps" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.355556"/>
 <Port Color="#fff8dc" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="step_length" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.418519"/>
 <Port Color="#dc143c" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="speed" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.480556"/>
 <Port Color="#00ffff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="total_route_length" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.543519"/>
 <Port Color="#00008b" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="complete_route_length" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.605556"/>
 <Port Color="#008b8b" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="remaining_route_length" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.668519"/>
 <Port Color="#b8860b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="now_x" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.730556"/>
 <Port Color="#a9a9a9" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="now_y" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.792593"/>
 <Port Color="#006400" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="target_x" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.85463"/>
 <Port Color="#a9a9a9" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="target_y" Parent="route_contol_core" Side="right" Width="30" X="0.98125" Y="0.916667"/>
</Module>
