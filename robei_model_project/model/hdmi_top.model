 <Module Category="Current" Class="hdmi_tmds_encoder" Code="wire [3:0] n1d = data_in[0] + data_in[1] + data_in[2] + data_in[3] +&#xa;                 data_in[4] + data_in[5] + data_in[6] + data_in[7];&#xa;&#xa;wire [8:0] q_m;&#xa;wire use_xnor = (n1d > 4'd4) || (n1d == 4'd4 &amp;&amp; data_in[0] == 1'b0);&#xa;&#xa;assign q_m[0] = data_in[0];&#xa;assign q_m[1] = use_xnor ? (q_m[0] ^~ data_in[1]) : (q_m[0] ^ data_in[1]);&#xa;assign q_m[2] = use_xnor ? (q_m[1] ^~ data_in[2]) : (q_m[1] ^ data_in[2]);&#xa;assign q_m[3] = use_xnor ? (q_m[2] ^~ data_in[3]) : (q_m[2] ^ data_in[3]);&#xa;assign q_m[4] = use_xnor ? (q_m[3] ^~ data_in[4]) : (q_m[3] ^ data_in[4]);&#xa;assign q_m[5] = use_xnor ? (q_m[4] ^~ data_in[5]) : (q_m[4] ^ data_in[5]);&#xa;assign q_m[6] = use_xnor ? (q_m[5] ^~ data_in[6]) : (q_m[5] ^ data_in[6]);&#xa;assign q_m[7] = use_xnor ? (q_m[6] ^~ data_in[7]) : (q_m[6] ^ data_in[7]);&#xa;assign q_m[8] = use_xnor ? 1'b0 : 1'b1;&#xa;&#xa;reg  [3:0] cnt;&#xa;wire [3:0] n1q_m = q_m[0] + q_m[1] + q_m[2] + q_m[3] +&#xa;                   q_m[4] + q_m[5] + q_m[6] + q_m[7];&#xa;wire [3:0] n0q_m = 4'd8 - n1q_m;&#xa;&#xa;always @(posedge clk_pix or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;        tmds_10b &lt;= 10'b0;&#xa;        cnt      &lt;= 4'b0;&#xa;&#xa;    end else if (!v_de) begin&#xa;        cnt &lt;= 4'b0;&#xa;        case ({c1, c0})&#xa;            2'b00:  tmds_10b &lt;= 10'b1101010100;&#xa;            2'b01:  tmds_10b &lt;= 10'b0010101011;&#xa;            2'b10:  tmds_10b &lt;= 10'b0101010100;&#xa;            default:tmds_10b &lt;= 10'b1010101011;&#xa;        endcase&#xa;&#xa;    end else begin&#xa;        if (cnt == 4'd0 || n1q_m == n0q_m) begin&#xa;            tmds_10b &lt;= {~q_m[8], q_m[8],&#xa;                         (q_m[8] ? q_m[7:0] : ~q_m[7:0])};&#xa;&#xa;            if (q_m[8] == 1'b0)&#xa;                cnt &lt;= cnt + (n0q_m - n1q_m);&#xa;            else&#xa;                cnt &lt;= cnt + (n1q_m - n0q_m);&#xa;&#xa;        end else begin&#xa;            if ((cnt[3] == 1'b0 &amp;&amp; n1q_m > n0q_m) ||&#xa;                (cnt[3] == 1'b1 &amp;&amp; n0q_m > n1q_m)) begin&#xa;&#xa;                tmds_10b &lt;= {1'b1, q_m[8], ~q_m[7:0]};&#xa;                cnt &lt;= cnt + {q_m[8], 1'b0} + (n0q_m - n1q_m);&#xa;&#xa;            end else begin&#xa;                tmds_10b &lt;= {1'b0, q_m[8], q_m[7:0]};&#xa;                cnt &lt;= cnt - {~q_m[8], 1'b0} + (n1q_m - n0q_m);&#xa;            end&#xa;        end&#xa;    end&#xa;end" Color="bisque" Comment="" Height="220" Name="hdmi_tmds_encoder_R" Parameters="" Parent="hdmi_top" Type="model" Width="200" X="654.73" Y="564.476">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_pix" Parent="hdmi_tmds_encoder_R" Side="left" Width="30" X="-0.15" Y="0.0727273"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="hdmi_tmds_encoder_R" Side="left" Width="30" X="-0.15" Y="0.209091"/>
  <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="data_in" Parent="hdmi_tmds_encoder_R" Side="left" Width="30" X="-0.15" Y="0.35"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="c0" Parent="hdmi_tmds_encoder_R" Side="left" Width="30" X="-0.15" Y="0.495455"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="c1" Parent="hdmi_tmds_encoder_R" Side="left" Width="30" X="-0.15" Y="0.636364"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="v_de" Parent="hdmi_tmds_encoder_R" Side="left" Width="30" X="-0.15" Y="0.777273"/>
  <Port Color="#b8860b" Connect="" Datasize="10" Datatype="reg" Description="" Height="30" Inout="output" Name="tmds_10b" Parent="hdmi_tmds_encoder_R" Side="right" Width="30" X="0.85" Y="0.427273"/>
 </Module>
 <Module Category="Current" Class="hdmi_serializer" Code="    reg [9:0] pix_word;&#xa;    reg pix_toggle;&#xa;    reg pix_toggle_sync0;&#xa;    reg pix_toggle_sync1;&#xa;    reg pix_toggle_sync2;&#xa;    reg [9:0] shift_word;&#xa;    reg [2:0] pair_idx;&#xa;    reg ser_d1;&#xa;    reg ser_d2;&#xa;    reg [1:0] reset_sync_5x;&#xa;    wire load_word_5x;&#xa;    wire rst_5x_n;&#xa;    (* keep = &quot;true&quot; *) wire ser_data_out;&#xa;  &#xa;    always @(posedge clk_pix or negedge rst_n) begin&#xa;      if (!rst_n) begin&#xa;        pix_word &lt;= 10&#x27;d0;&#xa;        pix_toggle &lt;= 1&#x27;b0;&#xa;      end else begin&#xa;        pix_word &lt;= data_10b;&#xa;        pix_toggle &lt;= ~pix_toggle;&#xa;      end&#xa;    end&#xa;  &#xa;    always @(posedge clk_5x or negedge rst_n) begin&#xa;      if (!rst_n)&#xa;        reset_sync_5x &lt;= 2&#x27;b00;&#xa;      else&#xa;        reset_sync_5x &lt;= {reset_sync_5x[0], 1&#x27;b1};&#xa;    end&#xa;&#xa;    always @(posedge clk_5x or negedge rst_5x_n) begin&#xa;      if (!rst_5x_n) begin&#xa;        pix_toggle_sync0 &lt;= 1&#x27;b0;&#xa;        pix_toggle_sync1 &lt;= 1&#x27;b0;&#xa;        pix_toggle_sync2 &lt;= 1&#x27;b0;&#xa;        shift_word &lt;= 10&#x27;d0;&#xa;        pair_idx &lt;= 3&#x27;d0;&#xa;        ser_d1 &lt;= 1&#x27;b0;&#xa;        ser_d2 &lt;= 1&#x27;b0;&#xa;      end else begin&#xa;        pix_toggle_sync0 &lt;= pix_toggle;&#xa;        pix_toggle_sync1 &lt;= pix_toggle_sync0;&#xa;        pix_toggle_sync2 &lt;= pix_toggle_sync1;&#xa;  &#xa;        if (load_word_5x) begin&#xa;          shift_word &lt;= pix_word;&#xa;          pair_idx &lt;= 3&#x27;d0;&#xa;          ser_d1 &lt;= pix_word[0];&#xa;          ser_d2 &lt;= pix_word[1];&#xa;        end else begin&#xa;          shift_word &lt;= {2&#x27;b00, shift_word[9:2]};&#xa;          if (pair_idx &lt; 3&#x27;d4)&#xa;            pair_idx &lt;= pair_idx + 3&#x27;d1;&#xa;          ser_d1 &lt;= shift_word[2];&#xa;          ser_d2 &lt;= shift_word[3];&#xa;        end&#xa;      end&#xa;    end&#xa;  &#xa;    assign load_word_5x = pix_toggle_sync1 ^ pix_toggle_sync2;&#xa;    assign rst_5x_n = reset_sync_5x[1];&#xa;  &#xa;    (* keep = &quot;true&quot;, dont_touch = &quot;true&quot; *)&#xa;    ODDR #(&#xa;      .DDR_CLK_EDGE(&quot;SAME_EDGE&quot;),&#xa;      .INIT(1&#x27;b0),&#xa;      .SRTYPE(&quot;SYNC&quot;)&#xa;    ) oddr_inst (&#xa;      .Q(ser_data_out),&#xa;      .C(clk_5x),&#xa;      .CE(1&#x27;b1),&#xa;      .D1(ser_d1),&#xa;      .D2(ser_d2),&#xa;      .R(1&#x27;b0),&#xa;      .S(1&#x27;b0)&#xa;    );&#xa;  &#xa;    (* keep = &quot;true&quot;, dont_touch = &quot;true&quot; *)&#xa;    OBUFDS #(&#xa;      .IOSTANDARD(&quot;TMDS_33&quot;)&#xa;    ) obuf_inst (&#xa;      .I  (ser_data_out),&#xa;      .O  (ser_p),&#xa;      .OB (ser_n)&#xa;    );" Color="#d3d3d3" Comment="" Height="220" Name="hdmi_serializer_B" Parameters="" Parent="hdmi_top" Type="model" Width="200" X="994.529" Y="35">
