<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="&#xa;&#xa;(* keep_hierarchy = &quot;yes&quot;, dont_touch = &quot;true&quot;, hu_set = &quot;hdmi_serdes_b&quot; *)&#xa;(* keep_hierarchy = &quot;yes&quot;, dont_touch = &quot;true&quot;, hu_set = &quot;hdmi_serdes_g&quot; *)&#xa;(* keep_hierarchy = &quot;yes&quot;, dont_touch = &quot;true&quot;, hu_set = &quot;hdmi_serdes_r&quot; *)&#xa;(* keep_hierarchy = &quot;yes&quot;, dont_touch = &quot;true&quot;, hu_set = &quot;hdmi_serdes_clk&quot; *)" Color="#d3d3d3" Comment="" Height="1080" Name="hdmi_top" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="clk_wiz_0" Code="    `ifdef SYNTHESIS&#xa;      wire clkfb_mmcm;&#xa;      wire clkfb_bufg;&#xa;      wire clk_pix_mmcm;&#xa;      wire clk_5x_mmcm;&#xa;      wire mmcm_locked;&#xa;      reg [15:0] lock_count = 16&#x27;d0;&#xa;      reg stable_locked = 1&#x27;b0;&#xa;    &#xa;      MMCME2_ADV #(&#xa;        .BANDWIDTH(&quot;OPTIMIZED&quot;),&#xa;        .CLKIN1_PERIOD(20.000),&#xa;        .CLKIN2_PERIOD(0.000),&#xa;        .CLKFBOUT_MULT_F(20.000),&#xa;        .CLKFBOUT_PHASE(0.000),&#xa;        .DIVCLK_DIVIDE(1),&#xa;        .CLKOUT0_DIVIDE_F(20.000),&#xa;        .CLKOUT0_PHASE(0.000),&#xa;        .CLKOUT0_DUTY_CYCLE(0.500),&#xa;        .CLKOUT1_DIVIDE(4),&#xa;        .CLKOUT1_PHASE(0.000),&#xa;        .CLKOUT1_DUTY_CYCLE(0.500),&#xa;        .CLKOUT2_DIVIDE(16),&#xa;        .CLKOUT2_PHASE(0.000),&#xa;        .CLKOUT2_DUTY_CYCLE(0.500),&#xa;        .CLKOUT3_DIVIDE(16),&#xa;        .CLKOUT3_PHASE(0.000),&#xa;        .CLKOUT3_DUTY_CYCLE(0.500),&#xa;        .CLKOUT4_DIVIDE(16),&#xa;        .CLKOUT4_PHASE(0.000),&#xa;        .CLKOUT4_DUTY_CYCLE(0.500),&#xa;        .CLKOUT5_DIVIDE(16),&#xa;        .CLKOUT5_PHASE(0.000),&#xa;        .CLKOUT5_DUTY_CYCLE(0.500),&#xa;        .CLKOUT6_DIVIDE(16),&#xa;        .CLKOUT6_PHASE(0.000),&#xa;        .CLKOUT6_DUTY_CYCLE(0.500),&#xa;        .COMPENSATION(&quot;ZHOLD&quot;),&#xa;        .REF_JITTER1(0.010),&#xa;        .STARTUP_WAIT(&quot;FALSE&quot;)&#xa;      ) mmcm_inst (&#xa;        .CLKIN1(clk_in1),&#xa;        .CLKIN2(1&#x27;b0),&#xa;        .CLKINSEL(1&#x27;b1),&#xa;        .RST(1&#x27;b0),&#xa;        .PWRDWN(1&#x27;b0),&#xa;        .CLKFBIN(clkfb_bufg),&#xa;        .CLKFBOUT(clkfb_mmcm),&#xa;        .CLKFBOUTB(),&#xa;          .CLKOUT0(clk_pix_mmcm),&#xa;          .CLKOUT0B(),&#xa;          .CLKOUT1(clk_5x_mmcm),&#xa;          .CLKOUT1B(),&#xa;        .CLKOUT2(),&#xa;        .CLKOUT2B(),&#xa;        .CLKOUT3(),&#xa;        .CLKOUT3B(),&#xa;        .CLKOUT4(),&#xa;        .CLKOUT5(),&#xa;        .CLKOUT6(),&#xa;        .DO(),&#xa;        .DRDY(),&#xa;        .DADDR(7&#x27;d0),&#xa;        .DCLK(1&#x27;b0),&#xa;        .DEN(1&#x27;b0),&#xa;        .DI(16&#x27;d0),&#xa;        .DWE(1&#x27;b0),&#xa;        .PSCLK(1&#x27;b0),&#xa;        .PSEN(1&#x27;b0),&#xa;        .PSINCDEC(1&#x27;b0),&#xa;        .PSDONE(),&#xa;        .LOCKED(mmcm_locked),&#xa;        .CLKINSTOPPED(),&#xa;        .CLKFBSTOPPED()&#xa;      );&#xa;    &#xa;      BUFG clkfb_bufg_inst (&#xa;        .I(clkfb_mmcm),&#xa;        .O(clkfb_bufg)&#xa;      );&#xa;    &#xa;      BUFG clk_pix_bufg_inst (&#xa;        .I(clk_pix_mmcm),&#xa;        .O(clk_out1)&#xa;      );&#xa;    &#xa;      BUFG clk_5x_bufg_inst (&#xa;        .I(clk_5x_mmcm),&#xa;        .O(clk_out2)&#xa;      );&#xa;    &#xa;      always @(posedge clk_out1) begin&#xa;        if (!mmcm_locked) begin&#xa;          lock_count &lt;= 16&#x27;d0;&#xa;          stable_locked &lt;= 1&#x27;b0;&#xa;        end else if (!stable_locked) begin&#xa;          if (lock_count == 16&#x27;d49999)&#xa;            stable_locked &lt;= 1&#x27;b1;&#xa;          else&#xa;            lock_count &lt;= lock_count + 16&#x27;d1;&#xa;        end&#xa;      end&#xa;&#xa;      assign locked = stable_locked;&#xa;    `else&#xa;      reg clk_50m = 1&#x27;b0;&#xa;      reg clk_250m = 1&#x27;b0;&#xa;      reg is_locked = 1&#x27;b0;&#xa;    &#xa;      always @(posedge clk_in1 or negedge resetn) begin&#xa;        if (!resetn)&#xa;          is_locked &lt;= 1&#x27;b0;&#xa;        else&#xa;          #100 is_locked &lt;= 1&#x27;b1;&#xa;      end&#xa;    &#xa;      always #10.000 clk_50m = ~clk_50m;&#xa;      always #2.000 clk_250m = ~clk_250m;&#xa;    &#xa;      assign clk_out1 = clk_50m;&#xa;      assign clk_out2 = clk_250m;&#xa;      assign locked = is_locked;&#xa;    `endif" Color="antiquewhite" Comment="" Height="220" Name="clk_wiz_01" Parameters="" Parent="hdmi_top" Type="model" Width="200" X="41.7253" Y="35">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_in1" Parent="clk_wiz_01" Side="left" Width="30" X="-0.15" Y="0.259091"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="resetn" Parent="clk_wiz_01" Side="left" Width="30" X="-0.15" Y="0.595455"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="clk_out1" Parent="clk_wiz_01" Side="right" Width="30" X="0.85" Y="0.177273"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="clk_out2" Parent="clk_wiz_01" Side="right" Width="30" X="0.85" Y="0.427273"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="locked" Parent="clk_wiz_01" Side="right" Width="30" X="0.85" Y="0.677273"/>
 </Module>
 <Module Category="Current" Class="hdmi_timing_gen" Code="  parameter H_ACTIVE = 12&#x27;d1024, H_FP = 12&#x27;d40, H_SYNC = 12&#x27;d100, H_BP = 12&#x27;d160, H_TOTAL = 12&#x27;d1324;&#xa;  parameter V_ACTIVE = 12&#x27;d600,  V_FP = 12&#x27;d12, V_SYNC = 12&#x27;d10,  V_BP = 12&#x27;d23,  V_TOTAL = 12&#x27;d645;&#xa;  &#xa;  reg [11:0] h_cnt, v_cnt;&#xa;  &#xa;  always @(posedge clk_pix or negedge rst_n) begin&#xa;      if (!rst_n) h_cnt &lt;= 0;&#xa;      else h_cnt &lt;= (h_cnt == H_TOTAL - 1) ? 0 : h_cnt + 1;&#xa;  end&#xa;  &#xa;  always @(posedge clk_pix or negedge rst_n) begin&#xa;      if (!rst_n) v_cnt &lt;= 0;&#xa;      else if (h_cnt == H_TOTAL - 1) v_cnt &lt;= (v_cnt == V_TOTAL - 1) ? 0 : v_cnt + 1;&#xa;  end&#xa;  &#xa;  always @(posedge clk_pix or negedge rst_n) begin&#xa;      if (!rst_n) begin&#xa;          hsync &lt;= 1&#x27;b0;&#xa;          vsync &lt;= 1&#x27;b0;&#xa;          v_de &lt;= 1&#x27;b0;&#xa;      end else begin&#xa;          hsync &lt;= (h_cnt &gt;= (H_ACTIVE + H_FP)) &amp;&amp; (h_cnt &lt; (H_ACTIVE + H_FP + H_SYNC));&#xa;          vsync &lt;= (v_cnt &gt;= (V_ACTIVE + V_FP)) &amp;&amp; (v_cnt &lt; (V_ACTIVE + V_FP + V_SYNC));&#xa;          v_de  &lt;= (h_cnt &lt; H_ACTIVE) &amp;&amp; (v_cnt &lt; V_ACTIVE);&#xa;      end&#xa;  end&#xa;  &#xa;  assign pixel_x = v_de ? h_cnt : 12&#x27;d0;&#xa;  assign pixel_y = v_de ? v_cnt : 12&#x27;d0;" Color="aqua" Comment="" Height="220" Name="hdmi_timing_gen2" Parameters="" Parent="hdmi_top" Type="model" Width="200" X="343.959" Y="35">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_pix" Parent="hdmi_timing_gen2" Side="left" Width="30" X="-0.15" Y="0.259091"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="hdmi_timing_gen2" Side="left" Width="30" X="-0.15" Y="0.595455"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="hsync" Parent="hdmi_timing_gen2" Side="right" Width="30" X="0.85" Y="0.0909091"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="vsync" Parent="hdmi_timing_gen2" Side="right" Width="30" X="0.85" Y="0.259091"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="v_de" Parent="hdmi_timing_gen2" Side="right" Width="30" X="0.85" Y="0.418182"/>
  <Port Color="#ffe4c4" Connect="" Datasize="12" Datatype="wire" Description="" Height="30" Inout="output" Name="pixel_x" Parent="hdmi_timing_gen2" Side="right" Width="30" X="0.85" Y="0.586364"/>
  <Port Color="#b8860b" Connect="" Datasize="12" Datatype="wire" Description="" Height="30" Inout="output" Name="pixel_y" Parent="hdmi_timing_gen2" Side="right" Width="30" X="0.85" Y="0.75"/>
 </Module>
 <Module Category="Current" Class="hdmi_tmds_encoder" Code="wire [3:0] n1d = data_in[0] + data_in[1] + data_in[2] + data_in[3] +&#xa;                 data_in[4] + data_in[5] + data_in[6] + data_in[7];&#xa;&#xa;wire [8:0] q_m;&#xa;wire use_xnor = (n1d > 4'd4) || (n1d == 4'd4 &amp;&amp; data_in[0] == 1'b0);&#xa;&#xa;assign q_m[0] = data_in[0];&#xa;assign q_m[1] = use_xnor ? (q_m[0] ^~ data_in[1]) : (q_m[0] ^ data_in[1]);&#xa;assign q_m[2] = use_xnor ? (q_m[1] ^~ data_in[2]) : (q_m[1] ^ data_in[2]);&#xa;assign q_m[3] = use_xnor ? (q_m[2] ^~ data_in[3]) : (q_m[2] ^ data_in[3]);&#xa;assign q_m[4] = use_xnor ? (q_m[3] ^~ data_in[4]) : (q_m[3] ^ data_in[4]);&#xa;assign q_m[5] = use_xnor ? (q_m[4] ^~ data_in[5]) : (q_m[4] ^ data_in[5]);&#xa;assign q_m[6] = use_xnor ? (q_m[5] ^~ data_in[6]) : (q_m[5] ^ data_in[6]);&#xa;assign q_m[7] = use_xnor ? (q_m[6] ^~ data_in[7]) : (q_m[6] ^ data_in[7]);&#xa;assign q_m[8] = use_xnor ? 1'b0 : 1'b1;&#xa;&#xa;reg  [3:0] cnt;&#xa;wire [3:0] n1q_m = q_m[0] + q_m[1] + q_m[2] + q_m[3] +&#xa;                   q_m[4] + q_m[5] + q_m[6] + q_m[7];&#xa;wire [3:0] n0q_m = 4'd8 - n1q_m;&#xa;&#xa;always @(posedge clk_pix or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;        tmds_10b &lt;= 10'b0;&#xa;        cnt      &lt;= 4'b0;&#xa;&#xa;    end else if (!v_de) begin&#xa;        cnt &lt;= 4'b0;&#xa;        case ({c1, c0})&#xa;            2'b00:  tmds_10b &lt;= 10'b1101010100;&#xa;            2'b01:  tmds_10b &lt;= 10'b0010101011;&#xa;            2'b10:  tmds_10b &lt;= 10'b0101010100;&#xa;            default:tmds_10b &lt;= 10'b1010101011;&#xa;        endcase&#xa;&#xa;    end else begin&#xa;        if (cnt == 4'd0 || n1q_m == n0q_m) begin&#xa;            tmds_10b &lt;= {~q_m[8], q_m[8],&#xa;                         (q_m[8] ? q_m[7:0] : ~q_m[7:0])};&#xa;&#xa;            if (q_m[8] == 1'b0)&#xa;                cnt &lt;= cnt + (n0q_m - n1q_m);&#xa;            else&#xa;                cnt &lt;= cnt + (n1q_m - n0q_m);&#xa;&#xa;        end else begin&#xa;            if ((cnt[3] == 1'b0 &amp;&amp; n1q_m > n0q_m) ||&#xa;                (cnt[3] == 1'b1 &amp;&amp; n0q_m > n1q_m)) begin&#xa;&#xa;                tmds_10b &lt;= {1'b1, q_m[8], ~q_m[7:0]};&#xa;                cnt &lt;= cnt + {q_m[8], 1'b0} + (n0q_m - n1q_m);&#xa;&#xa;            end else begin&#xa;                tmds_10b &lt;= {1'b0, q_m[8], q_m[7:0]};&#xa;                cnt &lt;= cnt - {~q_m[8], 1'b0} + (n1q_m - n0q_m);&#xa;            end&#xa;        end&#xa;    end&#xa;end" Color="azure" Comment="" Height="220" Name="hdmi_tmds_encoder_B" Parameters="" Parent="hdmi_top" Type="model" Width="200" X="647.9" Y="35">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_pix" Parent="hdmi_tmds_encoder_B" Side="left" Width="30" X="-0.15" Y="0.0727273"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="hdmi_tmds_encoder_B" Side="left" Width="30" X="-0.15" Y="0.209091"/>
  <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="data_in" Parent="hdmi_tmds_encoder_B" Side="left" Width="30" X="-0.15" Y="0.35"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="c0" Parent="hdmi_tmds_encoder_B" Side="left" Width="30" X="-0.15" Y="0.495455"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="c1" Parent="hdmi_tmds_encoder_B" Side="left" Width="30" X="-0.15" Y="0.636364"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="v_de" Parent="hdmi_tmds_encoder_B" Side="left" Width="30" X="-0.15" Y="0.777273"/>
  <Port Color="#b8860b" Connect="" Datasize="10" Datatype="reg" Description="" Height="30" Inout="output" Name="tmds_10b" Parent="hdmi_tmds_encoder_B" Side="right" Width="30" X="0.85" Y="0.427273"/>
 </Module>
 <Module Category="Current" Class="hdmi_tmds_encoder" Code="wire [3:0] n1d = data_in[0] + data_in[1] + data_in[2] + data_in[3] +&#xa;                 data_in[4] + data_in[5] + data_in[6] + data_in[7];&#xa;&#xa;wire [8:0] q_m;&#xa;wire use_xnor = (n1d > 4'd4) || (n1d == 4'd4 &amp;&amp; data_in[0] == 1'b0);&#xa;&#xa;assign q_m[0] = data_in[0];&#xa;assign q_m[1] = use_xnor ? (q_m[0] ^~ data_in[1]) : (q_m[0] ^ data_in[1]);&#xa;assign q_m[2] = use_xnor ? (q_m[1] ^~ data_in[2]) : (q_m[1] ^ data_in[2]);&#xa;assign q_m[3] = use_xnor ? (q_m[2] ^~ data_in[3]) : (q_m[2] ^ data_in[3]);&#xa;assign q_m[4] = use_xnor ? (q_m[3] ^~ data_in[4]) : (q_m[3] ^ data_in[4]);&#xa;assign q_m[5] = use_xnor ? (q_m[4] ^~ data_in[5]) : (q_m[4] ^ data_in[5]);&#xa;assign q_m[6] = use_xnor ? (q_m[5] ^~ data_in[6]) : (q_m[5] ^ data_in[6]);&#xa;assign q_m[7] = use_xnor ? (q_m[6] ^~ data_in[7]) : (q_m[6] ^ data_in[7]);&#xa;assign q_m[8] = use_xnor ? 1'b0 : 1'b1;&#xa;&#xa;reg  [3:0] cnt;&#xa;wire [3:0] n1q_m = q_m[0] + q_m[1] + q_m[2] + q_m[3] +&#xa;                   q_m[4] + q_m[5] + q_m[6] + q_m[7];&#xa;wire [3:0] n0q_m = 4'd8 - n1q_m;&#xa;&#xa;always @(posedge clk_pix or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;        tmds_10b &lt;= 10'b0;&#xa;        cnt      &lt;= 4'b0;&#xa;&#xa;    end else if (!v_de) begin&#xa;        cnt &lt;= 4'b0;&#xa;        case ({c1, c0})&#xa;            2'b00:  tmds_10b &lt;= 10'b1101010100;&#xa;            2'b01:  tmds_10b &lt;= 10'b0010101011;&#xa;            2'b10:  tmds_10b &lt;= 10'b0101010100;&#xa;            default:tmds_10b &lt;= 10'b1010101011;&#xa;        endcase&#xa;&#xa;    end else begin&#xa;        if (cnt == 4'd0 || n1q_m == n0q_m) begin&#xa;            tmds_10b &lt;= {~q_m[8], q_m[8],&#xa;                         (q_m[8] ? q_m[7:0] : ~q_m[7:0])};&#xa;&#xa;            if (q_m[8] == 1'b0)&#xa;                cnt &lt;= cnt + (n0q_m - n1q_m);&#xa;            else&#xa;                cnt &lt;= cnt + (n1q_m - n0q_m);&#xa;&#xa;        end else begin&#xa;            if ((cnt[3] == 1'b0 &amp;&amp; n1q_m > n0q_m) ||&#xa;                (cnt[3] == 1'b1 &amp;&amp; n0q_m > n1q_m)) begin&#xa;&#xa;                tmds_10b &lt;= {1'b1, q_m[8], ~q_m[7:0]};&#xa;                cnt &lt;= cnt + {q_m[8], 1'b0} + (n0q_m - n1q_m);&#xa;&#xa;            end else begin&#xa;                tmds_10b &lt;= {1'b0, q_m[8], q_m[7:0]};&#xa;                cnt &lt;= cnt - {~q_m[8], 1'b0} + (n1q_m - n0q_m);&#xa;            end&#xa;        end&#xa;    end&#xa;end" Color="beige" Comment="" Height="220" Name="hdmi_tmds_encoder_G" Parameters="" Parent="hdmi_top" Type="model" Width="200" X="649.607" Y="301.516">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_pix" Parent="hdmi_tmds_encoder_G" Side="left" Width="30" X="-0.15" Y="0.0727273"/>
