 <Port Color="#8b008b" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="imu0_accel_mean_x" Parent="dual_imu_static_calibrator" Side="right" Width="30" X="0.98125" Y="0.3977273"/>
