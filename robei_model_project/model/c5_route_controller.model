<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="          localparam integer CLK_HZ = 50000000;&#xa;          localparam integer CYCLES_PER_MS = CLK_HZ / 1000;&#xa;  &#xa;          localparam [4:0] STATE_RUN = 5'b00011;&#xa;  &#xa;          localparam [1:0] ROUTE_STOP    = 2'b00;&#xa;          localparam [1:0] ROUTE_RIGHT   = 2'b01;&#xa;          localparam [1:0] ROUTE_LEFT    = 2'b10;&#xa;          localparam [1:0] ROUTE_FORWARD = 2'b11;&#xa;          localparam [2:0] MANUAL_STOP    = 3'd0;&#xa;          localparam [2:0] MANUAL_FORWARD = 3'd1;&#xa;          localparam [2:0] MANUAL_REVERSE = 3'd2;&#xa;          localparam [2:0] MANUAL_LEFT    = 3'd3;&#xa;          localparam [2:0] MANUAL_RIGHT   = 3'd4;&#xa;          localparam [9:0] CAL_BASE_SPEED = 10'd700;&#xa;          localparam [9:0] SPEED_MIN = 10'd100;&#xa;          localparam [9:0] SPEED_MAX = 10'd900;&#xa;          // Onboard exploration must stay above the C5 static-friction region,&#xa;          // but does not need the full manually selected speed while mapping.&#xa;          localparam [9:0] AUTO_SPEED_MAX = 10'd550;&#xa;  &#xa;          reg [31:0] elapsed_cycles;&#xa;          reg [31:0] target_cycles;&#xa;          reg restart_pending;&#xa;  &#xa;          wire in_run;&#xa;          wire motion_done;&#xa;          wire [9:0] effective_forward_speed;&#xa;          wire [9:0] effective_turn_speed;&#xa;          wire [9:0] selected_forward_speed;&#xa;          wire [9:0] selected_turn_speed;&#xa;          wire control_mode;&#xa;          wire [2:0] control_cmd;&#xa;  &#xa;          assign in_run = (state_info == STATE_RUN);&#xa;          assign motion_done = motion_busy &amp;&amp; (elapsed_cycles &gt;= target_cycles);&#xa;          assign selected_forward_speed =&#xa;              (overall_speed == 10'd0) ? forward_speed : overall_speed;&#xa;          assign selected_turn_speed =&#xa;              (overall_speed == 10'd0) ? turn_speed : overall_speed;&#xa;          assign effective_forward_speed =&#xa;              (auto_mode &amp;&amp; selected_forward_speed &gt; AUTO_SPEED_MAX) ?&#xa;              AUTO_SPEED_MAX : selected_forward_speed;&#xa;          assign effective_turn_speed =&#xa;              (auto_mode &amp;&amp; selected_turn_speed &gt; AUTO_SPEED_MAX) ?&#xa;              AUTO_SPEED_MAX : selected_turn_speed;&#xa;          // A local autonomous command is used only while the phone has not&#xa;          // explicitly entered manual mode.  This keeps manual emergency&#xa;          // control deterministic while allowing mapping to survive BLE loss.&#xa;          assign control_mode = manual_mode || auto_mode;&#xa;          assign control_cmd = manual_mode ? manual_cmd : auto_cmd;&#xa;  &#xa;          function [9:0] adjusted_speed;&#xa;            input [9:0] wheel_default;&#xa;            input [9:0] common_speed;&#xa;            integer signed value;&#xa;            begin&#xa;              value = common_speed + wheel_default - CAL_BASE_SPEED;&#xa;              if (value &lt; SPEED_MIN)&#xa;                adjusted_speed = SPEED_MIN;&#xa;              else if (value &gt; SPEED_MAX)&#xa;                adjusted_speed = SPEED_MAX;&#xa;              else&#xa;                adjusted_speed = value[9:0];&#xa;            end&#xa;          endfunction&#xa;  &#xa;          function [9:0] turn_mag;&#xa;            input [9:0] speed;&#xa;            begin&#xa;              if (speed &gt; 10'd150)&#xa;                turn_mag = speed - 10'd50;&#xa;              else&#xa;                turn_mag = speed;&#xa;            end&#xa;          endfunction&#xa;  &#xa;          function [10:0] pos_speed;&#xa;            input [9:0] speed;&#xa;            begin&#xa;              pos_speed = {1'b0, speed};&#xa;            end&#xa;          endfunction&#xa;  &#xa;          function [10:0] neg_speed;&#xa;            input [9:0] speed;&#xa;            begin&#xa;              neg_speed = (~{1'b0, speed}) + 11'd1;&#xa;            end&#xa;          endfunction&#xa;  &#xa;          function [31:0] ms_to_cycles;&#xa;            input [15:0] ms;&#xa;            begin&#xa;              if (ms == 16'd0)&#xa;                ms_to_cycles = CYCLES_PER_MS - 1;&#xa;              else&#xa;                ms_to_cycles = ({16'd0, ms} * CYCLES_PER_MS) - 32'd1;&#xa;            end&#xa;          endfunction&#xa;  &#xa;          function [15:0] step_to_ms;&#xa;            input [15:0] steps;&#xa;            reg [31:0] ms_calc;&#xa;            begin&#xa;              if (steps == 16'd0) begin&#xa;                step_to_ms = forward_ms;&#xa;              end else begin&#xa;                ms_calc = ({16'd0, steps} &lt;&lt; 7) - ({16'd0, steps} &lt;&lt; 1) -&#xa;                          {16'd0, steps};&#xa;                if (ms_calc &gt; 32'd60000)&#xa;                  step_to_ms = 16'd60000;&#xa;                else&#xa;                  step_to_ms = ms_calc[15:0];&#xa;              end&#xa;            end&#xa;          endfunction&#xa;  &#xa;          task stop_motors;&#xa;            begin&#xa;              lf_speed &lt;= 11'd0;&#xa;              rf_speed &lt;= 11'd0;&#xa;              lr_speed &lt;= 11'd0;&#xa;              rr_speed &lt;= 11'd0;&#xa;            end&#xa;          endtask&#xa;  &#xa;          always @(posedge clk or negedge rst_n) begin&#xa;            if (!rst_n) begin&#xa;              run_step_pulse &lt;= 1'b0;&#xa;              lf_speed &lt;= 11'd0;&#xa;              rf_speed &lt;= 11'd0;&#xa;              lr_speed &lt;= 11'd0;&#xa;              rr_speed &lt;= 11'd0;&#xa;              motion_busy &lt;= 1'b0;&#xa;              current_cmd &lt;= ROUTE_STOP;&#xa;              elapsed_cycles &lt;= 32'd0;&#xa;              target_cycles &lt;= 32'd0;&#xa;              restart_pending &lt;= 1'b0;&#xa;              motor_blocked &lt;= 1'b0;&#xa;            end else begin&#xa;              run_step_pulse &lt;= 1'b0;&#xa;              motor_blocked &lt;= 1'b0;&#xa;  &#xa;              if (!motor_enable) begin&#xa;                stop_motors();&#xa;                motion_busy &lt;= 1'b0;&#xa;                current_cmd &lt;= ROUTE_STOP;&#xa;                elapsed_cycles &lt;= 32'd0;&#xa;                target_cycles &lt;= 32'd0;&#xa;                restart_pending &lt;= 1'b0;&#xa;              end else if (control_mode) begin&#xa;                motion_busy &lt;= 1'b0;&#xa;                current_cmd &lt;= ROUTE_STOP;&#xa;                elapsed_cycles &lt;= 32'd0;&#xa;                target_cycles &lt;= 32'd0;&#xa;                restart_pending &lt;= 1'b0;&#xa;                if (obstacle_stop &amp;&amp; (control_cmd == MANUAL_FORWARD)) begin&#xa;                  stop_motors();&#xa;                  motor_blocked &lt;= 1'b1;&#xa;                end else begin&#xa;                  case (control_cmd)&#xa;                    MANUAL_FORWARD: begin&#xa;                      lf_speed &lt;= pos_speed(adjusted_speed(lf_default_speed, effective_forward_speed));&#xa;                      rf_speed &lt;= pos_speed(adjusted_speed(rf_default_speed, effective_forward_speed));&#xa;                      lr_speed &lt;= pos_speed(adjusted_speed(lr_default_speed, effective_forward_speed));&#xa;                      rr_speed &lt;= pos_speed(adjusted_speed(rr_default_speed, effective_forward_speed));&#xa;                    end&#xa;                    MANUAL_REVERSE: begin&#xa;                      lf_speed &lt;= neg_speed(adjusted_speed(lf_default_speed, effective_forward_speed));&#xa;                      rf_speed &lt;= neg_speed(adjusted_speed(rf_default_speed, effective_forward_speed));&#xa;                      lr_speed &lt;= neg_speed(adjusted_speed(lr_default_speed, effective_forward_speed));&#xa;                      rr_speed &lt;= neg_speed(adjusted_speed(rr_default_speed, effective_forward_speed));&#xa;                    end&#xa;                    MANUAL_LEFT: begin&#xa;                      lf_speed &lt;= neg_speed(turn_mag(adjusted_speed(lf_default_speed, effective_turn_speed)));&#xa;                      rf_speed &lt;= pos_speed(turn_mag(adjusted_speed(rf_default_speed, effective_turn_speed)));&#xa;                      lr_speed &lt;= neg_speed(turn_mag(adjusted_speed(lr_default_speed, effective_turn_speed)));&#xa;                      rr_speed &lt;= pos_speed(turn_mag(adjusted_speed(rr_default_speed, effective_turn_speed)));&#xa;                    end&#xa;                    MANUAL_RIGHT: begin&#xa;                      lf_speed &lt;= pos_speed(turn_mag(adjusted_speed(lf_default_speed, effective_turn_speed)));&#xa;                      rf_speed &lt;= neg_speed(turn_mag(adjusted_speed(rf_default_speed, effective_turn_speed)));&#xa;                      lr_speed &lt;= pos_speed(turn_mag(adjusted_speed(lr_default_speed, effective_turn_speed)));&#xa;                      rr_speed &lt;= neg_speed(turn_mag(adjusted_speed(rr_default_speed, effective_turn_speed)));&#xa;                    end&#xa;                    default: stop_motors();&#xa;                  endcase&#xa;                end&#xa;              end else if (!in_run || active_route_steps == 6'd0) begin&#xa;                // Obstacle chatter while idle is not a blocked motor event.&#xa;                // Keeping motor_blocked low here also prevents needless&#xa;                // immediate status reports when no route can move the car.&#xa;                stop_motors();&#xa;                motion_busy &lt;= 1'b0;&#xa;                current_cmd &lt;= ROUTE_STOP;&#xa;                elapsed_cycles &lt;= 32'd0;&#xa;                target_cycles &lt;= 32'd0;&#xa;                restart_pending &lt;= 1'b0;&#xa;              end else if (obstacle_stop) begin&#xa;                stop_motors();&#xa;                motion_busy &lt;= 1'b0;&#xa;                current_cmd &lt;= ROUTE_STOP;&#xa;                elapsed_cycles &lt;= 32'd0;&#xa;                target_cycles &lt;= 32'd0;&#xa;                restart_pending &lt;= 1'b0;&#xa;                motor_blocked &lt;= 1'b1;&#xa;              end else if (!motion_busy &amp;&amp; restart_pending) begin&#xa;                restart_pending &lt;= 1'b0;&#xa;              end else if (!motion_busy) begin&#xa;                current_cmd &lt;= route_info[1:0];&#xa;                motion_busy &lt;= 1'b1;&#xa;                elapsed_cycles &lt;= 32'd0;&#xa;                restart_pending &lt;= 1'b0;&#xa;  &#xa;                case (route_info[1:0])&#xa;                  ROUTE_FORWARD: begin&#xa;                    lf_speed &lt;= pos_speed(adjusted_speed(lf_default_speed, effective_forward_speed));&#xa;                    rf_speed &lt;= pos_speed(adjusted_speed(rf_default_speed, effective_forward_speed));&#xa;                    lr_speed &lt;= pos_speed(adjusted_speed(lr_default_speed, effective_forward_speed));&#xa;                    rr_speed &lt;= pos_speed(adjusted_speed(rr_default_speed, effective_forward_speed));&#xa;                    target_cycles &lt;= ms_to_cycles(step_to_ms(step_length));&#xa;                  end&#xa;  &#xa;                  ROUTE_LEFT: begin&#xa;                    lf_speed &lt;= neg_speed(turn_mag(adjusted_speed(lf_default_speed, effective_turn_speed)));&#xa;                    rf_speed &lt;= pos_speed(turn_mag(adjusted_speed(rf_default_speed, effective_turn_speed)));&#xa;                    lr_speed &lt;= neg_speed(turn_mag(adjusted_speed(lr_default_speed, effective_turn_speed)));&#xa;                    rr_speed &lt;= pos_speed(turn_mag(adjusted_speed(rr_default_speed, effective_turn_speed)));&#xa;                    target_cycles &lt;= ms_to_cycles(turn_ms);&#xa;                  end&#xa;  &#xa;                  ROUTE_RIGHT: begin&#xa;                    lf_speed &lt;= pos_speed(turn_mag(adjusted_speed(lf_default_speed, effective_turn_speed)));&#xa;                    rf_speed &lt;= neg_speed(turn_mag(adjusted_speed(rf_default_speed, effective_turn_speed)));&#xa;                    lr_speed &lt;= pos_speed(turn_mag(adjusted_speed(lr_default_speed, effective_turn_speed)));&#xa;                    rr_speed &lt;= neg_speed(turn_mag(adjusted_speed(rr_default_speed, effective_turn_speed)));&#xa;                    target_cycles &lt;= ms_to_cycles(turn_ms);&#xa;                  end&#xa;  &#xa;                  default: begin&#xa;                    stop_motors();&#xa;                    target_cycles &lt;= CYCLES_PER_MS - 1;&#xa;                  end&#xa;                endcase&#xa;              end else begin&#xa;                if (motion_done || current_cmd == ROUTE_STOP) begin&#xa;                  stop_motors();&#xa;                  motion_busy &lt;= 1'b0;&#xa;                  elapsed_cycles &lt;= 32'd0;&#xa;                  run_step_pulse &lt;= 1'b1;&#xa;                  restart_pending &lt;= 1'b1;&#xa;                end else begin&#xa;                  elapsed_cycles &lt;= elapsed_cycles + 32'd1;&#xa;                end&#xa;              end&#xa;            end&#xa;          end" Color="#d3d3d3" Comment="" Height="1080" Name="c5_route_controller" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.07142857"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.1142857"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="motor_enable" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.1571429"/>
 <Port Color="#f0ffff" Connect="" Datasize="5" Datatype="wire" Description="" Height="30" Inout="input" Name="state_info" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.2"/>
 <Port Color="#f5f5dc" Connect="" Datasize="64" Datatype="wire" Description="" Height="30" Inout="input" Name="route_info" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.2428571"/>
 <Port Color="#ffe4c4" Connect="" Datasize="6" Datatype="wire" Description="" Height="30" Inout="input" Name="active_route_steps" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.2857143"/>
 <Port Color="#b8860b" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="forward_ms" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.3285714"/>
 <Port Color="#ffebcd" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="turn_ms" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.3714286"/>
 <Port Color="#0000ff" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="forward_speed" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.4142857"/>
 <Port Color="#8a2be2" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="turn_speed" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.4571429"/>
 <Port Color="#a52a2a" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="step_length" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.5"/>
 <Port Color="#deb887" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="overall_speed" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.5428571"/>
 <Port Color="#5f9ea0" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="lf_default_speed" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.5857143"/>
 <Port Color="#7fff00" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="rf_default_speed" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.6285714"/>
 <Port Color="#d2691e" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="lr_default_speed" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.6714286"/>
 <Port Color="#ff7f50" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="rr_default_speed" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.7142857"/>
 <Port Color="#6495ed" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="manual_mode" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.7571429"/>
 <Port Color="#fff8dc" Connect="" Datasize="3" Datatype="wire" Description="" Height="30" Inout="input" Name="manual_cmd" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.8"/>
 <Port Color="#dc143c" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="auto_mode" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.8428571"/>
 <Port Color="#00ffff" Connect="" Datasize="3" Datatype="wire" Description="" Height="30" Inout="input" Name="auto_cmd" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.8857143"/>
 <Port Color="#00008b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="obstacle_stop" Parent="c5_route_controller" Side="left" Width="30" X="-0.01875" Y="0.9285714"/>
 <Port Color="#008b8b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="run_step_pulse" Parent="c5_route_controller" Side="right" Width="30" X="0.98125" Y="0.10625"/>
 <Port Color="#b8860b" Connect="" Datasize="11" Datatype="reg" Description="" Height="30" Inout="output" Name="lf_speed" Parent="c5_route_controller" Side="right" Width="30" X="0.98125" Y="0.21875"/>
 <Port Color="#a9a9a9" Connect="" Datasize="11" Datatype="reg" Description="" Height="30" Inout="output" Name="rf_speed" Parent="c5_route_controller" Side="right" Width="30" X="0.98125" Y="0.33125"/>
 <Port Color="#006400" Connect="" Datasize="11" Datatype="reg" Description="" Height="30" Inout="output" Name="lr_speed" Parent="c5_route_controller" Side="right" Width="30" X="0.98125" Y="0.44375"/>
 <Port Color="#bdb76b" Connect="" Datasize="11" Datatype="reg" Description="" Height="30" Inout="output" Name="rr_speed" Parent="c5_route_controller" Side="right" Width="30" X="0.98125" Y="0.55625"/>
 <Port Color="#8b008b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="motion_busy" Parent="c5_route_controller" Side="right" Width="30" X="0.98125" Y="0.66875"/>
 <Port Color="#556b2f" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="current_cmd" Parent="c5_route_controller" Side="right" Width="30" X="0.98125" Y="0.78125"/>
 <Port Color="#ff8c00" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="motor_blocked" Parent="c5_route_controller" Side="right" Width="30" X="0.98125" Y="0.89375"/>
</Module>
