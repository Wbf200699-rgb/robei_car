<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="wire [3:0] n1d = data_in[0] + data_in[1] + data_in[2] + data_in[3] +&#xa;                 data_in[4] + data_in[5] + data_in[6] + data_in[7];&#xa;&#xa;wire [8:0] q_m;&#xa;wire use_xnor = (n1d > 4'd4) || (n1d == 4'd4 &amp;&amp; data_in[0] == 1'b0);&#xa;&#xa;assign q_m[0] = data_in[0];&#xa;assign q_m[1] = use_xnor ? (q_m[0] ^~ data_in[1]) : (q_m[0] ^ data_in[1]);&#xa;assign q_m[2] = use_xnor ? (q_m[1] ^~ data_in[2]) : (q_m[1] ^ data_in[2]);&#xa;assign q_m[3] = use_xnor ? (q_m[2] ^~ data_in[3]) : (q_m[2] ^ data_in[3]);&#xa;assign q_m[4] = use_xnor ? (q_m[3] ^~ data_in[4]) : (q_m[3] ^ data_in[4]);&#xa;assign q_m[5] = use_xnor ? (q_m[4] ^~ data_in[5]) : (q_m[4] ^ data_in[5]);&#xa;assign q_m[6] = use_xnor ? (q_m[5] ^~ data_in[6]) : (q_m[5] ^ data_in[6]);&#xa;assign q_m[7] = use_xnor ? (q_m[6] ^~ data_in[7]) : (q_m[6] ^ data_in[7]);&#xa;assign q_m[8] = use_xnor ? 1'b0 : 1'b1;&#xa;&#xa;reg  [3:0] cnt;&#xa;wire [3:0] n1q_m = q_m[0] + q_m[1] + q_m[2] + q_m[3] +&#xa;                   q_m[4] + q_m[5] + q_m[6] + q_m[7];&#xa;wire [3:0] n0q_m = 4'd8 - n1q_m;&#xa;&#xa;always @(posedge clk_pix or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;        tmds_10b &lt;= 10'b0;&#xa;        cnt      &lt;= 4'b0;&#xa;&#xa;    end else if (!v_de) begin&#xa;        cnt &lt;= 4'b0;&#xa;        case ({c1, c0})&#xa;            2'b00:  tmds_10b &lt;= 10'b1101010100;&#xa;            2'b01:  tmds_10b &lt;= 10'b0010101011;&#xa;            2'b10:  tmds_10b &lt;= 10'b0101010100;&#xa;            default:tmds_10b &lt;= 10'b1010101011;&#xa;        endcase&#xa;&#xa;    end else begin&#xa;        if (cnt == 4'd0 || n1q_m == n0q_m) begin&#xa;            tmds_10b &lt;= {~q_m[8], q_m[8],&#xa;                         (q_m[8] ? q_m[7:0] : ~q_m[7:0])};&#xa;&#xa;            if (q_m[8] == 1'b0)&#xa;                cnt &lt;= cnt + (n0q_m - n1q_m);&#xa;            else&#xa;                cnt &lt;= cnt + (n1q_m - n0q_m);&#xa;&#xa;        end else begin&#xa;            if ((cnt[3] == 1'b0 &amp;&amp; n1q_m > n0q_m) ||&#xa;                (cnt[3] == 1'b1 &amp;&amp; n0q_m > n1q_m)) begin&#xa;&#xa;                tmds_10b &lt;= {1'b1, q_m[8], ~q_m[7:0]};&#xa;                cnt &lt;= cnt + {q_m[8], 1'b0} + (n0q_m - n1q_m);&#xa;&#xa;            end else begin&#xa;                tmds_10b &lt;= {1'b0, q_m[8], q_m[7:0]};&#xa;                cnt &lt;= cnt - {~q_m[8], 1'b0} + (n1q_m - n0q_m);&#xa;            end&#xa;        end&#xa;    end&#xa;end" Color="#d3d3d3" Comment="" Height="1080" Name="hdmi_tmds_encoder" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_pix" Parent="hdmi_tmds_encoder" Side="left" Width="30" X="-0.01875" Y="0.0805556"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="hdmi_tmds_encoder" Side="left" Width="30" X="-0.01875" Y="0.182407"/>
 <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="data_in" Parent="hdmi_tmds_encoder" Side="left" Width="30" X="-0.01875" Y="0.287037"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="c0" Parent="hdmi_tmds_encoder" Side="left" Width="30" X="-0.01875" Y="0.37963"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="c1" Parent="hdmi_tmds_encoder" Side="left" Width="30" X="-0.01875" Y="0.467593"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="v_de" Parent="hdmi_tmds_encoder" Side="left" Width="30" X="-0.01875" Y="0.562037"/>
 <Port Color="#b8860b" Connect="" Datasize="10" Datatype="reg" Description="" Height="30" Inout="output" Name="tmds_10b" Parent="hdmi_tmds_encoder" Side="right" Width="30" X="0.98125" Y="0.432407"/>
</Module>
