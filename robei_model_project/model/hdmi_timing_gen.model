<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  parameter H_ACTIVE = 12'd1024, H_FP = 12'd40, H_SYNC = 12'd100, H_BP = 12'd160, H_TOTAL = 12'd1324;&#xa;  parameter V_ACTIVE = 12'd600,  V_FP = 12'd12, V_SYNC = 12'd10,  V_BP = 12'd23,  V_TOTAL = 12'd645;&#xa;  &#xa;  reg [11:0] h_cnt, v_cnt;&#xa;  &#xa;  always @(posedge clk_pix or negedge rst_n) begin&#xa;      if (!rst_n) h_cnt &lt;= 0;&#xa;      else h_cnt &lt;= (h_cnt == H_TOTAL - 1) ? 0 : h_cnt + 1;&#xa;  end&#xa;  &#xa;  always @(posedge clk_pix or negedge rst_n) begin&#xa;      if (!rst_n) v_cnt &lt;= 0;&#xa;      else if (h_cnt == H_TOTAL - 1) v_cnt &lt;= (v_cnt == V_TOTAL - 1) ? 0 : v_cnt + 1;&#xa;  end&#xa;  &#xa;  always @(posedge clk_pix or negedge rst_n) begin&#xa;      if (!rst_n) begin&#xa;          hsync &lt;= 1'b0;&#xa;          vsync &lt;= 1'b0;&#xa;          v_de &lt;= 1'b0;&#xa;      end else begin&#xa;          hsync &lt;= (h_cnt &gt;= (H_ACTIVE + H_FP)) &amp;&amp; (h_cnt &lt; (H_ACTIVE + H_FP + H_SYNC));&#xa;          vsync &lt;= (v_cnt &gt;= (V_ACTIVE + V_FP)) &amp;&amp; (v_cnt &lt; (V_ACTIVE + V_FP + V_SYNC));&#xa;          v_de  &lt;= (h_cnt &lt; H_ACTIVE) &amp;&amp; (v_cnt &lt; V_ACTIVE);&#xa;      end&#xa;  end&#xa;  &#xa;  assign pixel_x = v_de ? h_cnt : 12'd0;&#xa;  assign pixel_y = v_de ? v_cnt : 12'd0;" Color="#d3d3d3" Comment="" Height="1080" Name="hdmi_timing_gen" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_pix" Parent="hdmi_timing_gen" Side="left" Width="30" X="-0.01875" Y="0.275"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="hdmi_timing_gen" Side="left" Width="30" X="-0.01875" Y="0.725"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="hsync" Parent="hdmi_timing_gen" Side="right" Width="30" X="0.98125" Y="0.14"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="vsync" Parent="hdmi_timing_gen" Side="right" Width="30" X="0.98125" Y="0.32"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="v_de" Parent="hdmi_timing_gen" Side="right" Width="30" X="0.98125" Y="0.5"/>
 <Port Color="#ffe4c4" Connect="" Datasize="12" Datatype="wire" Description="" Height="30" Inout="output" Name="pixel_x" Parent="hdmi_timing_gen" Side="right" Width="30" X="0.98125" Y="0.68"/>
 <Port Color="#b8860b" Connect="" Datasize="12" Datatype="wire" Description="" Height="30" Inout="output" Name="pixel_y" Parent="hdmi_timing_gen" Side="right" Width="30" X="0.98125" Y="0.86"/>
</Module>
