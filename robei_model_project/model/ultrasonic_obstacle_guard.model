<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam [2:0] ST_TRIG      = 3'd0;&#xa;  localparam [2:0] ST_WAIT_ECHO = 3'd1;&#xa;  localparam [2:0] ST_MEASURE   = 3'd2;&#xa;  localparam [2:0] ST_GAP       = 3'd3;&#xa;&#xa;  localparam [31:0] TRIG_CYCLES     = 32'd500;      // 10 us at 50 MHz&#xa;  localparam [31:0] ECHO_TIMEOUT    = 32'd1500000;  // 30 ms at 50 MHz&#xa;  localparam [31:0] MEASURE_PERIOD  = 32'd3000000;  // 60 ms at 50 MHz&#xa;  localparam [31:0] CYCLES_PER_CM   = 32'd2900;     // 58 us/cm * 50 cycles/us&#xa;  localparam [15:0] DEFAULT_STEP_CM = 16'd20;&#xa;&#xa;  reg [2:0] state;&#xa;  reg [31:0] cnt;&#xa;  reg [31:0] echo_cycles;&#xa;  reg [31:0] cm_cycle_cnt;&#xa;  reg [15:0] measured_cm;&#xa;  reg echo_d0;&#xa;  reg echo_d1;&#xa;  reg echo_d2;&#xa;  reg [15:0] compare_length;&#xa;&#xa;  wire echo_sync;&#xa;  wire echo_rise;&#xa;  wire echo_fall;&#xa;&#xa;  assign echo_sync = echo_d1;&#xa;  assign echo_rise = echo_d1 &amp; ~echo_d2;&#xa;  assign echo_fall = ~echo_d1 &amp; echo_d2;&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      echo_d0 &lt;= 1'b0;&#xa;      echo_d1 &lt;= 1'b0;&#xa;      echo_d2 &lt;= 1'b0;&#xa;    end else begin&#xa;      echo_d0 &lt;= echo;&#xa;      echo_d1 &lt;= echo_d0;&#xa;      echo_d2 &lt;= echo_d1;&#xa;    end&#xa;  end&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      state &lt;= ST_TRIG;&#xa;      cnt &lt;= 32'd0;&#xa;      echo_cycles &lt;= 32'd0;&#xa;      cm_cycle_cnt &lt;= 32'd0;&#xa;      measured_cm &lt;= 16'd0;&#xa;      trig &lt;= 1'b0;&#xa;      distance_cm &lt;= 16'd0;&#xa;      distance_valid &lt;= 1'b0;&#xa;      obstacle_stop &lt;= 1'b0;&#xa;      echo_timeout &lt;= 1'b0;&#xa;      compare_length &lt;= DEFAULT_STEP_CM;&#xa;    end else begin&#xa;      distance_valid &lt;= 1'b0;&#xa;      obstacle_stop &lt;= 1'b0;&#xa;&#xa;      if (step_length == 16'd0)&#xa;        compare_length &lt;= DEFAULT_STEP_CM;&#xa;      else&#xa;        compare_length &lt;= step_length;&#xa;&#xa;      if (!enable) begin&#xa;        state &lt;= ST_TRIG;&#xa;        cnt &lt;= 32'd0;&#xa;        echo_cycles &lt;= 32'd0;&#xa;        cm_cycle_cnt &lt;= 32'd0;&#xa;        measured_cm &lt;= 16'd0;&#xa;        trig &lt;= 1'b0;&#xa;        obstacle_stop &lt;= 1'b0;&#xa;        echo_timeout &lt;= 1'b0;&#xa;      end else begin&#xa;        case (state)&#xa;        ST_TRIG: begin&#xa;          trig &lt;= 1'b1;&#xa;          echo_timeout &lt;= 1'b0;&#xa;          echo_cycles &lt;= 32'd0;&#xa;          cm_cycle_cnt &lt;= 32'd0;&#xa;          measured_cm &lt;= 16'd0;&#xa;&#xa;          if (cnt >= TRIG_CYCLES - 32'd1) begin&#xa;            cnt &lt;= 32'd0;&#xa;            trig &lt;= 1'b0;&#xa;            state &lt;= ST_WAIT_ECHO;&#xa;          end else begin&#xa;            cnt &lt;= cnt + 32'd1;&#xa;          end&#xa;        end&#xa;&#xa;        ST_WAIT_ECHO: begin&#xa;          trig &lt;= 1'b0;&#xa;&#xa;          if (echo_rise || echo_sync) begin&#xa;            cnt &lt;= 32'd0;&#xa;            echo_cycles &lt;= 32'd0;&#xa;            cm_cycle_cnt &lt;= 32'd0;&#xa;            measured_cm &lt;= 16'd0;&#xa;            state &lt;= ST_MEASURE;&#xa;          end else if (cnt >= ECHO_TIMEOUT - 32'd1) begin&#xa;            cnt &lt;= 32'd0;&#xa;            echo_timeout &lt;= 1'b1;&#xa;            distance_cm &lt;= 16'hFFFF;&#xa;            distance_valid &lt;= 1'b1;&#xa;            obstacle_stop &lt;= 1'b0;&#xa;            state &lt;= ST_GAP;&#xa;          end else begin&#xa;            cnt &lt;= cnt + 32'd1;&#xa;          end&#xa;        end&#xa;&#xa;        ST_MEASURE: begin&#xa;          trig &lt;= 1'b0;&#xa;&#xa;          if (echo_fall) begin&#xa;            if (measured_cm == 16'd0 &amp;&amp; echo_cycles != 32'd0)&#xa;              distance_cm &lt;= 16'd1;&#xa;            else&#xa;              distance_cm &lt;= measured_cm;&#xa;&#xa;            distance_valid &lt;= 1'b1;&#xa;            echo_timeout &lt;= 1'b0;&#xa;&#xa;            if (((measured_cm == 16'd0 &amp;&amp; echo_cycles != 32'd0) ? 16'd1 : measured_cm) &lt; compare_length)&#xa;              obstacle_stop &lt;= 1'b1;&#xa;&#xa;            cnt &lt;= 32'd0;&#xa;            state &lt;= ST_GAP;&#xa;          end else if (echo_cycles >= ECHO_TIMEOUT - 32'd1) begin&#xa;            cnt &lt;= 32'd0;&#xa;            echo_cycles &lt;= 32'd0;&#xa;            cm_cycle_cnt &lt;= 32'd0;&#xa;            measured_cm &lt;= 16'd0;&#xa;            echo_timeout &lt;= 1'b1;&#xa;            distance_cm &lt;= 16'hFFFF;&#xa;            distance_valid &lt;= 1'b1;&#xa;            obstacle_stop &lt;= 1'b0;&#xa;            state &lt;= ST_GAP;&#xa;          end else begin&#xa;            echo_cycles &lt;= echo_cycles + 32'd1;&#xa;            if (cm_cycle_cnt >= CYCLES_PER_CM - 32'd1) begin&#xa;              cm_cycle_cnt &lt;= 32'd0;&#xa;              if (measured_cm != 16'hFFFF)&#xa;                measured_cm &lt;= measured_cm + 16'd1;&#xa;            end else begin&#xa;              cm_cycle_cnt &lt;= cm_cycle_cnt + 32'd1;&#xa;            end&#xa;          end&#xa;        end&#xa;&#xa;        ST_GAP: begin&#xa;          trig &lt;= 1'b0;&#xa;&#xa;          if (cnt >= MEASURE_PERIOD - TRIG_CYCLES - 32'd1) begin&#xa;            cnt &lt;= 32'd0;&#xa;            state &lt;= ST_TRIG;&#xa;          end else begin&#xa;            cnt &lt;= cnt + 32'd1;&#xa;          end&#xa;        end&#xa;&#xa;        default: begin&#xa;          state &lt;= ST_TRIG;&#xa;          cnt &lt;= 32'd0;&#xa;          trig &lt;= 1'b0;&#xa;        end&#xa;        endcase&#xa;      end&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="ultrasonic_obstacle_guard" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="ultrasonic_obstacle_guard" Side="left" Width="30" X="-0.01875" Y="0.152778"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="ultrasonic_obstacle_guard" Side="left" Width="30" X="-0.01875" Y="0.319444"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="echo" Parent="ultrasonic_obstacle_guard" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#f0ffff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="step_length" Parent="ultrasonic_obstacle_guard" Side="left" Width="30" X="-0.01875" Y="0.652778"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="trig" Parent="ultrasonic_obstacle_guard" Side="right" Width="30" X="0.98125" Y="0.152778"/>
 <Port Color="#ffe4c4" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="distance_cm" Parent="ultrasonic_obstacle_guard" Side="right" Width="30" X="0.98125" Y="0.319444"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="distance_valid" Parent="ultrasonic_obstacle_guard" Side="right" Width="30" X="0.98125" Y="0.486111"/>
 <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="obstacle_stop" Parent="ultrasonic_obstacle_guard" Side="right" Width="30" X="0.98125" Y="0.652778"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="echo_timeout" Parent="ultrasonic_obstacle_guard" Side="right" Width="30" X="0.98125" Y="0.819444"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="enable" Parent="ultrasonic_obstacle_guard" Side="left" Width="30" X="-0.01875" Y="0.819444"/>
</Module>
