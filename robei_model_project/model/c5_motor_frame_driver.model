<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="            localparam integer CLK_HZ = 50000000;&#xa;            localparam integer BAUD = 115200;&#xa;`ifdef C5_MOTOR_SIM_FAST&#xa;            localparam integer CLKS_PER_BIT = CLK_HZ / BAUD;&#xa;            localparam integer MOVING_REFRESH_CYCLES = 5000;&#xa;            localparam integer STARTUP_CYCLES = 32;&#xa;`else&#xa;            localparam integer CLKS_PER_BIT = CLK_HZ / BAUD;&#xa;            localparam integer MOVING_REFRESH_MS = 100;&#xa;            localparam integer MOVING_REFRESH_CYCLES = (CLK_HZ / 1000) * MOVING_REFRESH_MS;&#xa;            localparam integer STARTUP_DELAY_MS = 500;&#xa;            localparam integer STARTUP_CYCLES = (CLK_HZ / 1000) * STARTUP_DELAY_MS;&#xa;`endif&#xa;            // The factory STM32 C5 controller forwards every received command&#xa;            // to both USART3 (the 5 V single-wire motor bus) and USART1 (echo).&#xa;            // Its receive ISR rejects new bytes while that blocking forward is&#xa;            // in progress. A 62-byte four-wheel command therefore needs about&#xa;            // 10.8 ms before the controller can safely accept another frame.&#xa;            // Keep a 12 ms guard between complete FPGA frames. Requests that&#xa;            // arrive during the guard are coalesced by command_changed, so the&#xa;            // latest four-wheel vector is sent atomically when the guard ends.&#xa;`ifdef C5_MOTOR_SIM_FAST&#xa;            localparam integer INTERFRAME_GUARD_CYCLES = 5000;&#xa;`else&#xa;            localparam integer INTERFRAME_GUARD_MS = 12;&#xa;            localparam integer INTERFRAME_GUARD_CYCLES =&#xa;                (CLK_HZ / 1000) * INTERFRAME_GUARD_MS;&#xa;`endif&#xa;          localparam [6:0] FRAME_LAST = 7'd61;&#xa;          localparam [6:0] STOP_FRAME_LAST = 7'd8;&#xa;            localparam [1:0] UART_IDLE  = 2'd0;&#xa;            localparam [1:0] UART_START = 2'd1;&#xa;            localparam [1:0] UART_DATA  = 2'd2;&#xa;            localparam [1:0] UART_STOP  = 2'd3;&#xa;      &#xa;            wire [10:0] effective_lf_speed;&#xa;            wire [10:0] effective_rf_speed;&#xa;            wire [10:0] effective_lr_speed;&#xa;            wire [10:0] effective_rr_speed;&#xa;            wire uart_done;&#xa;            wire command_changed;&#xa;            wire refresh_due;&#xa;            wire any_motion;&#xa;            wire last_any_motion;&#xa;            wire stop_transition;&#xa;          wire send_stop_now;&#xa;          wire [6:0] active_frame_last;&#xa;      &#xa;            reg [10:0] last_lf_speed;&#xa;            reg [10:0] last_rf_speed;&#xa;            reg [10:0] last_lr_speed;&#xa;            reg [10:0] last_rr_speed;&#xa;            reg [11:0] frame_lf_pulse;&#xa;            reg [11:0] frame_rf_pulse;&#xa;            reg [11:0] frame_lr_pulse;&#xa;            reg [11:0] frame_rr_pulse;&#xa;            reg [31:0] refresh_count;&#xa;            reg [19:0] interframe_guard_count;&#xa;            reg [6:0] send_index;&#xa;            reg [7:0] uart_data;&#xa;            reg uart_start;&#xa;            reg uart_tx;&#xa;            reg uart_busy;&#xa;            reg uart_busy_d;&#xa;            reg [1:0] uart_state;&#xa;            reg [15:0] uart_clk_count;&#xa;            reg [2:0] uart_bit_index;&#xa;            reg [7:0] uart_shifter;&#xa;            reg sending;&#xa;            reg pending_send;&#xa;            reg frame_is_stop;&#xa;            reg [24:0] startup_count;&#xa;            reg startup_ready;&#xa;      &#xa;            assign effective_lf_speed = motor_enable ? lf_speed : 11'd0;&#xa;            assign effective_rf_speed = motor_enable ? rf_speed : 11'd0;&#xa;            assign effective_lr_speed = motor_enable ? lr_speed : 11'd0;&#xa;            assign effective_rr_speed = motor_enable ? rr_speed : 11'd0;&#xa;            assign command_changed = (effective_lf_speed != last_lf_speed) ||&#xa;                                     (effective_rf_speed != last_rf_speed) ||&#xa;                                     (effective_lr_speed != last_lr_speed) ||&#xa;                                     (effective_rr_speed != last_rr_speed);&#xa;            assign any_motion = (effective_lf_speed != 11'd0) ||&#xa;                                (effective_rf_speed != 11'd0) ||&#xa;                                (effective_lr_speed != 11'd0) ||&#xa;                                (effective_rr_speed != 11'd0);&#xa;            assign last_any_motion = (last_lf_speed != 11'd0) ||&#xa;                                     (last_rf_speed != 11'd0) ||&#xa;                                     (last_lr_speed != 11'd0) ||&#xa;                                     (last_rr_speed != 11'd0);&#xa;            assign stop_transition = !any_motion &amp;&amp; last_any_motion;&#xa;          assign refresh_due = any_motion &amp;&amp;&#xa;                               (refresh_count &gt;= MOVING_REFRESH_CYCLES - 1);&#xa;            assign send_stop_now = force_stop || stop_transition ||&#xa;                                   (stop_frames_remaining != 2'd0) || !any_motion;&#xa;          assign uart_done = uart_busy_d &amp;&amp; !uart_busy;&#xa;          assign active_frame_last = frame_is_stop ? STOP_FRAME_LAST : FRAME_LAST;&#xa;            assign c5_bus_tx = uart_tx;&#xa;      &#xa;            function [10:0] speed_abs;&#xa;              input [10:0] speed;&#xa;              begin&#xa;                if (speed[10])&#xa;                  speed_abs = (~speed) + 11'd1;&#xa;                else&#xa;                  speed_abs = speed;&#xa;              end&#xa;            endfunction&#xa;      &#xa;            function [11:0] left_motor_pulse;&#xa;              input [10:0] speed;&#xa;              reg [10:0] mag;&#xa;              begin&#xa;                mag = speed_abs(speed);&#xa;                if (speed[10])&#xa;                  left_motor_pulse = 12'd1500 - {1'b0, mag};&#xa;                else&#xa;                  left_motor_pulse = 12'd1500 + {1'b0, mag};&#xa;              end&#xa;            endfunction&#xa;      &#xa;            function [11:0] right_motor_pulse;&#xa;              input [10:0] speed;&#xa;              reg [10:0] mag;&#xa;              begin&#xa;                mag = speed_abs(speed);&#xa;                if (speed[10])&#xa;                  right_motor_pulse = 12'd1500 + {1'b0, mag};&#xa;                else&#xa;                  right_motor_pulse = 12'd1500 - {1'b0, mag};&#xa;              end&#xa;            endfunction&#xa;      &#xa;            function [7:0] digit4;&#xa;              input [11:0] value;&#xa;              input [1:0] index;&#xa;              integer digit;&#xa;              integer remainder;&#xa;              begin&#xa;                remainder = value;&#xa;                if (remainder &gt;= 2000) begin&#xa;                  remainder = remainder - 2000;&#xa;                  if (index == 2'd0) digit = 2;&#xa;                end else if (remainder &gt;= 1000) begin&#xa;                  remainder = remainder - 1000;&#xa;                  if (index == 2'd0) digit = 1;&#xa;                end else if (index == 2'd0) begin&#xa;                  digit = 0;&#xa;                end&#xa;      &#xa;                if (index != 2'd0) begin&#xa;                  if (remainder &gt;= 900) begin remainder = remainder - 900; digit = 9; end&#xa;                  else if (remainder &gt;= 800) begin remainder = remainder - 800; digit = 8; end&#xa;                  else if (remainder &gt;= 700) begin remainder = remainder - 700; digit = 7; end&#xa;                  else if (remainder &gt;= 600) begin remainder = remainder - 600; digit = 6; end&#xa;                  else if (remainder &gt;= 500) begin remainder = remainder - 500; digit = 5; end&#xa;                  else if (remainder &gt;= 400) begin remainder = remainder - 400; digit = 4; end&#xa;                  else if (remainder &gt;= 300) begin remainder = remainder - 300; digit = 3; end&#xa;                  else if (remainder &gt;= 200) begin remainder = remainder - 200; digit = 2; end&#xa;                  else if (remainder &gt;= 100) begin remainder = remainder - 100; digit = 1; end&#xa;                  else digit = 0;&#xa;                end&#xa;      &#xa;                if (index &gt;= 2'd2) begin&#xa;                  if (remainder &gt;= 90) begin remainder = remainder - 90; digit = 9; end&#xa;                  else if (remainder &gt;= 80) begin remainder = remainder - 80; digit = 8; end&#xa;                  else if (remainder &gt;= 70) begin remainder = remainder - 70; digit = 7; end&#xa;                  else if (remainder &gt;= 60) begin remainder = remainder - 60; digit = 6; end&#xa;                  else if (remainder &gt;= 50) begin remainder = remainder - 50; digit = 5; end&#xa;                  else if (remainder &gt;= 40) begin remainder = remainder - 40; digit = 4; end&#xa;                  else if (remainder &gt;= 30) begin remainder = remainder - 30; digit = 3; end&#xa;                  else if (remainder &gt;= 20) begin remainder = remainder - 20; digit = 2; end&#xa;                  else if (remainder &gt;= 10) begin remainder = remainder - 10; digit = 1; end&#xa;                  else digit = 0;&#xa;                end&#xa;      &#xa;                case (index)&#xa;                  2'd3: digit = remainder;&#xa;                  default: begin end&#xa;                endcase&#xa;                digit4 = 8'd48 + digit[7:0];&#xa;              end&#xa;            endfunction&#xa;      &#xa;          function [7:0] frame_char;&#xa;              input [6:0] index;&#xa;              begin&#xa;              if (frame_is_stop) begin&#xa;                case (index)&#xa;                  7'd0: frame_char = &quot;#&quot;;&#xa;                  7'd1: frame_char = &quot;2&quot;;&#xa;                  7'd2, 7'd3: frame_char = &quot;5&quot;;&#xa;                  7'd4: frame_char = &quot;P&quot;;&#xa;                  7'd5: frame_char = &quot;D&quot;;&#xa;                  7'd6: frame_char = &quot;S&quot;;&#xa;                  7'd7: frame_char = &quot;T&quot;;&#xa;                  default: frame_char = &quot;!&quot;;&#xa;                endcase&#xa;              end else begin&#xa;                case (index)&#xa;                  7'd0:  frame_char = &quot;{&quot;;&#xa;                  7'd1, 7'd16, 7'd31, 7'd46: frame_char = &quot;#&quot;;&#xa;                  7'd2, 7'd3, 7'd17, 7'd18, 7'd32, 7'd33, 7'd47, 7'd48: frame_char = &quot;0&quot;;&#xa;                  7'd4:  frame_char = &quot;6&quot;;&#xa;                  7'd19: frame_char = &quot;7&quot;;&#xa;                  7'd34: frame_char = &quot;8&quot;;&#xa;                  7'd49: frame_char = &quot;9&quot;;&#xa;                  7'd5, 7'd20, 7'd35, 7'd50: frame_char = &quot;P&quot;;&#xa;                  7'd6:  frame_char = digit4(frame_lf_pulse, 2'd0);&#xa;                  7'd7:  frame_char = digit4(frame_lf_pulse, 2'd1);&#xa;                  7'd8:  frame_char = digit4(frame_lf_pulse, 2'd2);&#xa;                  7'd9:  frame_char = digit4(frame_lf_pulse, 2'd3);&#xa;                  7'd21: frame_char = digit4(frame_rf_pulse, 2'd0);&#xa;                  7'd22: frame_char = digit4(frame_rf_pulse, 2'd1);&#xa;                  7'd23: frame_char = digit4(frame_rf_pulse, 2'd2);&#xa;                  7'd24: frame_char = digit4(frame_rf_pulse, 2'd3);&#xa;                  7'd36: frame_char = digit4(frame_lr_pulse, 2'd0);&#xa;                  7'd37: frame_char = digit4(frame_lr_pulse, 2'd1);&#xa;                  7'd38: frame_char = digit4(frame_lr_pulse, 2'd2);&#xa;                  7'd39: frame_char = digit4(frame_lr_pulse, 2'd3);&#xa;                  7'd51: frame_char = digit4(frame_rr_pulse, 2'd0);&#xa;                  7'd52: frame_char = digit4(frame_rr_pulse, 2'd1);&#xa;                  7'd53: frame_char = digit4(frame_rr_pulse, 2'd2);&#xa;                  7'd54: frame_char = digit4(frame_rr_pulse, 2'd3);&#xa;                  7'd10, 7'd25, 7'd40, 7'd55: frame_char = &quot;T&quot;;&#xa;                  7'd11, 7'd12, 7'd13, 7'd14,&#xa;                  7'd26, 7'd27, 7'd28, 7'd29,&#xa;                  7'd41, 7'd42, 7'd43, 7'd44,&#xa;                  7'd56, 7'd57, 7'd58, 7'd59: frame_char = &quot;0&quot;;&#xa;                  7'd15, 7'd30, 7'd45, 7'd60: frame_char = &quot;!&quot;;&#xa;                default: frame_char = &quot;}&quot;;&#xa;                endcase&#xa;              end&#xa;              end&#xa;            endfunction&#xa;      &#xa;            always @(posedge clk or negedge rst_n) begin&#xa;              if (!rst_n) begin&#xa;                last_lf_speed &lt;= 11'h7ff;&#xa;                last_rf_speed &lt;= 11'h7ff;&#xa;                last_lr_speed &lt;= 11'h7ff;&#xa;                last_rr_speed &lt;= 11'h7ff;&#xa;                frame_lf_pulse &lt;= 12'd1500;&#xa;                frame_rf_pulse &lt;= 12'd1500;&#xa;                frame_lr_pulse &lt;= 12'd1500;&#xa;                frame_rr_pulse &lt;= 12'd1500;&#xa;                refresh_count &lt;= 32'd0;&#xa;                interframe_guard_count &lt;= 20'd0;&#xa;                send_index &lt;= 7'd0;&#xa;                uart_data &lt;= 8'd0;&#xa;                uart_start &lt;= 1'b0;&#xa;                uart_tx &lt;= 1'b1;&#xa;                uart_busy &lt;= 1'b0;&#xa;                uart_busy_d &lt;= 1'b0;&#xa;                uart_state &lt;= UART_IDLE;&#xa;                uart_clk_count &lt;= 16'd0;&#xa;                uart_bit_index &lt;= 3'd0;&#xa;                uart_shifter &lt;= 8'd0;&#xa;                sending &lt;= 1'b0;&#xa;                pending_send &lt;= 1'b0;&#xa;                frame_is_stop &lt;= 1'b0;&#xa;                startup_count &lt;= 25'd0;&#xa;                startup_ready &lt;= 1'b0;&#xa;                frame_busy &lt;= 1'b0;&#xa;                frame_count &lt;= 16'd0;&#xa;                last_lf_pulse &lt;= 12'd1500;&#xa;                last_rf_pulse &lt;= 12'd1500;&#xa;                last_lr_pulse &lt;= 12'd1500;&#xa;                last_rr_pulse &lt;= 12'd1500;&#xa;                stop_frames_complete &lt;= 1'b0;&#xa;                stop_frames_remaining &lt;= 2'd0;&#xa;              end else begin&#xa;                uart_start &lt;= 1'b0;&#xa;                uart_busy_d &lt;= uart_busy;&#xa;&#xa;                if (interframe_guard_count != 20'd0)&#xa;                  interframe_guard_count &lt;= interframe_guard_count - 20'd1;&#xa;      &#xa;                case (uart_state)&#xa;                  UART_IDLE: begin&#xa;                    uart_tx &lt;= 1'b1;&#xa;                    uart_busy &lt;= 1'b0;&#xa;                    uart_clk_count &lt;= 16'd0;&#xa;                    uart_bit_index &lt;= 3'd0;&#xa;                    if (uart_start) begin&#xa;                      uart_busy &lt;= 1'b1;&#xa;                      uart_shifter &lt;= uart_data;&#xa;                      uart_state &lt;= UART_START;&#xa;                      uart_tx &lt;= 1'b0;&#xa;                    end&#xa;                  end&#xa;      &#xa;                  UART_START: begin&#xa;                    uart_busy &lt;= 1'b1;&#xa;                    uart_tx &lt;= 1'b0;&#xa;                    if (uart_clk_count == CLKS_PER_BIT - 1) begin&#xa;                      uart_clk_count &lt;= 16'd0;&#xa;                      uart_state &lt;= UART_DATA;&#xa;                      uart_tx &lt;= uart_shifter[0];&#xa;                    end else begin&#xa;                      uart_clk_count &lt;= uart_clk_count + 16'd1;&#xa;                    end&#xa;                  end&#xa;      &#xa;                  UART_DATA: begin&#xa;                    uart_busy &lt;= 1'b1;&#xa;                    uart_tx &lt;= uart_shifter[uart_bit_index];&#xa;                    if (uart_clk_count == CLKS_PER_BIT - 1) begin&#xa;                      uart_clk_count &lt;= 16'd0;&#xa;                      if (uart_bit_index == 3'd7) begin&#xa;                        uart_bit_index &lt;= 3'd0;&#xa;                        uart_state &lt;= UART_STOP;&#xa;                        uart_tx &lt;= 1'b1;&#xa;                      end else begin&#xa;                        uart_bit_index &lt;= uart_bit_index + 3'd1;&#xa;                        uart_tx &lt;= uart_shifter[uart_bit_index + 3'd1];&#xa;                      end&#xa;                    end else begin&#xa;                      uart_clk_count &lt;= uart_clk_count + 16'd1;&#xa;                    end&#xa;                  end&#xa;      &#xa;                  default: begin&#xa;                    uart_busy &lt;= 1'b1;&#xa;                    uart_tx &lt;= 1'b1;&#xa;                    if (uart_clk_count == CLKS_PER_BIT - 1) begin&#xa;                      uart_clk_count &lt;= 16'd0;&#xa;                      uart_busy &lt;= 1'b0;&#xa;                      uart_state &lt;= UART_IDLE;&#xa;                    end else begin&#xa;                      uart_clk_count &lt;= uart_clk_count + 16'd1;&#xa;                    end&#xa;                  end&#xa;                endcase&#xa;      &#xa;                if (!startup_ready) begin&#xa;                  refresh_count &lt;= 32'd0;&#xa;                  frame_busy &lt;= 1'b0;&#xa;                  if (startup_count &gt;= STARTUP_CYCLES - 1) begin&#xa;                    startup_count &lt;= startup_count;&#xa;                    startup_ready &lt;= 1'b1;&#xa;                    stop_frames_remaining &lt;= 2'd3;&#xa;                    stop_frames_complete &lt;= 1'b0;&#xa;                  end else begin&#xa;                    startup_count &lt;= startup_count + 25'd1;&#xa;                  end&#xa;              end else if (!sending &amp;&amp; any_motion &amp;&amp; !refresh_due) begin&#xa;                refresh_count &lt;= refresh_count + 32'd1;&#xa;              end else if (!sending &amp;&amp; !any_motion) begin&#xa;                refresh_count &lt;= 32'd0;&#xa;                end&#xa;    &#xa;                if (startup_ready &amp;&amp; (force_stop || stop_transition)) begin&#xa;                  stop_frames_remaining &lt;= 2'd3;&#xa;                  stop_frames_complete &lt;= 1'b0;&#xa;                end&#xa;      &#xa;                if (startup_ready &amp;&amp; !sending) begin&#xa;                  frame_busy &lt;= 1'b0;&#xa;                  if ((force_stop || (stop_frames_remaining != 2'd0) ||&#xa;                       pending_send || command_changed || refresh_due) &amp;&amp; !uart_busy &amp;&amp;&#xa;                      (interframe_guard_count == 20'd0)) begin&#xa;                    if (send_stop_now) begin&#xa;                      frame_lf_pulse &lt;= 12'd1500;&#xa;                      frame_rf_pulse &lt;= 12'd1500;&#xa;                      frame_lr_pulse &lt;= 12'd1500;&#xa;                      frame_rr_pulse &lt;= 12'd1500;&#xa;                      last_lf_pulse &lt;= 12'd1500;&#xa;                      last_rf_pulse &lt;= 12'd1500;&#xa;                      last_lr_pulse &lt;= 12'd1500;&#xa;                      last_rr_pulse &lt;= 12'd1500;&#xa;                      last_lf_speed &lt;= 11'd0;&#xa;                      last_rf_speed &lt;= 11'd0;&#xa;                      last_lr_speed &lt;= 11'd0;&#xa;                      last_rr_speed &lt;= 11'd0;&#xa;                      frame_is_stop &lt;= 1'b1;&#xa;                    end else begin&#xa;                      frame_lf_pulse &lt;= left_motor_pulse(effective_lf_speed);&#xa;                      frame_rf_pulse &lt;= right_motor_pulse(effective_rf_speed);&#xa;                      frame_lr_pulse &lt;= left_motor_pulse(effective_lr_speed);&#xa;                      frame_rr_pulse &lt;= right_motor_pulse(effective_rr_speed);&#xa;                      last_lf_pulse &lt;= left_motor_pulse(effective_lf_speed);&#xa;                      last_rf_pulse &lt;= right_motor_pulse(effective_rf_speed);&#xa;                      last_lr_pulse &lt;= left_motor_pulse(effective_lr_speed);&#xa;                      last_rr_pulse &lt;= right_motor_pulse(effective_rr_speed);&#xa;                      last_lf_speed &lt;= effective_lf_speed;&#xa;                      last_rf_speed &lt;= effective_rf_speed;&#xa;                      last_lr_speed &lt;= effective_lr_speed;&#xa;                      last_rr_speed &lt;= effective_rr_speed;&#xa;                      frame_is_stop &lt;= 1'b0;&#xa;                      stop_frames_complete &lt;= 1'b0;&#xa;                    end&#xa;                    refresh_count &lt;= 32'd0;&#xa;                    pending_send &lt;= 1'b0;&#xa;                    sending &lt;= 1'b1;&#xa;                    frame_busy &lt;= 1'b1;&#xa;                    send_index &lt;= 7'd0;&#xa;                uart_data &lt;= send_stop_now ? &quot;#&quot; : &quot;{&quot;;&#xa;                    uart_start &lt;= 1'b1;&#xa;                  end&#xa;                end else if (startup_ready) begin&#xa;                  frame_busy &lt;= 1'b1;&#xa;                  if (uart_done) begin&#xa;                  if (send_index == active_frame_last) begin&#xa;                      sending &lt;= 1'b0;&#xa;                      frame_busy &lt;= 1'b0;&#xa;                      frame_count &lt;= frame_count + 16'd1;&#xa;                      interframe_guard_count &lt;= INTERFRAME_GUARD_CYCLES;&#xa;                      if (frame_is_stop) begin&#xa;                        if (stop_frames_remaining &gt; 2'd1) begin&#xa;                          stop_frames_remaining &lt;= stop_frames_remaining - 2'd1;&#xa;                        end else begin&#xa;                          stop_frames_remaining &lt;= 2'd0;&#xa;                          stop_frames_complete &lt;= 1'b1;&#xa;                        end&#xa;                      end&#xa;                    end else begin&#xa;                      send_index &lt;= send_index + 7'd1;&#xa;                      uart_data &lt;= frame_char(send_index + 7'd1);&#xa;                      uart_start &lt;= 1'b1;&#xa;                    end&#xa;                  end&#xa;                end&#xa;              end&#xa;            end" Color="#d3d3d3" Comment="" Height="1080" Name="c5_motor_frame_driver" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="c5_motor_frame_driver" Side="left" Width="30" X="-0.01875" Y="0.10625"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="c5_motor_frame_driver" Side="left" Width="30" X="-0.01875" Y="0.21875"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="motor_enable" Parent="c5_motor_frame_driver" Side="left" Width="30" X="-0.01875" Y="0.33125"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="force_stop" Parent="c5_motor_frame_driver" Side="left" Width="30" X="-0.01875" Y="0.44375"/>
 <Port Color="#f5f5dc" Connect="" Datasize="11" Datatype="wire" Description="" Height="30" Inout="input" Name="lf_speed" Parent="c5_motor_frame_driver" Side="left" Width="30" X="-0.01875" Y="0.55625"/>
 <Port Color="#ffe4c4" Connect="" Datasize="11" Datatype="wire" Description="" Height="30" Inout="input" Name="rf_speed" Parent="c5_motor_frame_driver" Side="left" Width="30" X="-0.01875" Y="0.66875"/>
 <Port Color="#b8860b" Connect="" Datasize="11" Datatype="wire" Description="" Height="30" Inout="input" Name="lr_speed" Parent="c5_motor_frame_driver" Side="left" Width="30" X="-0.01875" Y="0.78125"/>
 <Port Color="#ffebcd" Connect="" Datasize="11" Datatype="wire" Description="" Height="30" Inout="input" Name="rr_speed" Parent="c5_motor_frame_driver" Side="left" Width="30" X="-0.01875" Y="0.89375"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="c5_bus_tx" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.1"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="frame_busy" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.2"/>
 <Port Color="#a52a2a" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="frame_count" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.3"/>
 <Port Color="#deb887" Connect="" Datasize="12" Datatype="reg" Description="" Height="30" Inout="output" Name="last_lf_pulse" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.4"/>
 <Port Color="#5f9ea0" Connect="" Datasize="12" Datatype="reg" Description="" Height="30" Inout="output" Name="last_rf_pulse" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.5"/>
 <Port Color="#7fff00" Connect="" Datasize="12" Datatype="reg" Description="" Height="30" Inout="output" Name="last_lr_pulse" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.6"/>
 <Port Color="#d2691e" Connect="" Datasize="12" Datatype="reg" Description="" Height="30" Inout="output" Name="last_rr_pulse" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.7"/>
 <Port Color="#ff7f50" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="stop_frames_complete" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.8"/>
 <Port Color="#6495ed" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="stop_frames_remaining" Parent="c5_motor_frame_driver" Side="right" Width="30" X="0.98125" Y="0.9"/>
</Module>
