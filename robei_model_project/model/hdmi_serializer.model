<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="    reg [9:0] pix_word;&#xa;    reg pix_toggle;&#xa;    reg pix_toggle_sync0;&#xa;    reg pix_toggle_sync1;&#xa;    reg pix_toggle_sync2;&#xa;    reg [9:0] shift_word;&#xa;    reg [2:0] pair_idx;&#xa;    reg ser_d1;&#xa;    reg ser_d2;&#xa;    reg [1:0] reset_sync_5x;&#xa;    wire load_word_5x;&#xa;    wire rst_5x_n;&#xa;    (* keep = &quot;true&quot; *) wire ser_data_out;&#xa;  &#xa;    always @(posedge clk_pix or negedge rst_n) begin&#xa;      if (!rst_n) begin&#xa;        pix_word &lt;= 10'd0;&#xa;        pix_toggle &lt;= 1'b0;&#xa;      end else begin&#xa;        pix_word &lt;= data_10b;&#xa;        pix_toggle &lt;= ~pix_toggle;&#xa;      end&#xa;    end&#xa;  &#xa;    always @(posedge clk_5x or negedge rst_n) begin&#xa;      if (!rst_n)&#xa;        reset_sync_5x &lt;= 2'b00;&#xa;      else&#xa;        reset_sync_5x &lt;= {reset_sync_5x[0], 1'b1};&#xa;    end&#xa;&#xa;    always @(posedge clk_5x or negedge rst_5x_n) begin&#xa;      if (!rst_5x_n) begin&#xa;        pix_toggle_sync0 &lt;= 1'b0;&#xa;        pix_toggle_sync1 &lt;= 1'b0;&#xa;        pix_toggle_sync2 &lt;= 1'b0;&#xa;        shift_word &lt;= 10'd0;&#xa;        pair_idx &lt;= 3'd0;&#xa;        ser_d1 &lt;= 1'b0;&#xa;        ser_d2 &lt;= 1'b0;&#xa;      end else begin&#xa;        pix_toggle_sync0 &lt;= pix_toggle;&#xa;        pix_toggle_sync1 &lt;= pix_toggle_sync0;&#xa;        pix_toggle_sync2 &lt;= pix_toggle_sync1;&#xa;  &#xa;        if (load_word_5x) begin&#xa;          shift_word &lt;= pix_word;&#xa;          pair_idx &lt;= 3'd0;&#xa;          ser_d1 &lt;= pix_word[0];&#xa;          ser_d2 &lt;= pix_word[1];&#xa;        end else begin&#xa;          shift_word &lt;= {2'b00, shift_word[9:2]};&#xa;          if (pair_idx &lt; 3'd4)&#xa;            pair_idx &lt;= pair_idx + 3'd1;&#xa;          ser_d1 &lt;= shift_word[2];&#xa;          ser_d2 &lt;= shift_word[3];&#xa;        end&#xa;      end&#xa;    end&#xa;  &#xa;    assign load_word_5x = pix_toggle_sync1 ^ pix_toggle_sync2;&#xa;    assign rst_5x_n = reset_sync_5x[1];&#xa;  &#xa;    (* keep = &quot;true&quot;, dont_touch = &quot;true&quot; *)&#xa;    ODDR #(&#xa;      .DDR_CLK_EDGE(&quot;SAME_EDGE&quot;),&#xa;      .INIT(1'b0),&#xa;      .SRTYPE(&quot;SYNC&quot;)&#xa;    ) oddr_inst (&#xa;      .Q(ser_data_out),&#xa;      .C(clk_5x),&#xa;      .CE(1'b1),&#xa;      .D1(ser_d1),&#xa;      .D2(ser_d2),&#xa;      .R(1'b0),&#xa;      .S(1'b0)&#xa;    );&#xa;  &#xa;    (* keep = &quot;true&quot;, dont_touch = &quot;true&quot; *)&#xa;    OBUFDS #(&#xa;      .IOSTANDARD(&quot;TMDS_33&quot;)&#xa;    ) obuf_inst (&#xa;      .I  (ser_data_out),&#xa;      .O  (ser_p),&#xa;      .OB (ser_n)&#xa;    );" Color="#d3d3d3" Comment="" Height="1080" Name="hdmi_serializer" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
