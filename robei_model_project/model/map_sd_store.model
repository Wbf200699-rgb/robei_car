 <Module Category="Current" Class="sd_spi_block_device" Code="  parameter integer CLK_HZ = 50000000;&#10;  parameter integer STARTUP_WAIT_CYCLES = CLK_HZ / 100;&#10;  parameter integer ACMD_RETRY_WAIT_CYCLES = CLK_HZ / 1000;&#10;  parameter integer INIT_SPI_HALF_CYCLES = 125;&#10;  parameter integer DATA_SPI_HALF_CYCLES = 5;&#10;  parameter integer TOKEN_TIMEOUT_BYTES = 65535;&#10;  parameter integer WRITE_BUSY_TIMEOUT_BYTES = 65535;&#10;&#10;  localparam [7:0] ST_IDLE                 = 8'd0;&#10;  localparam [7:0] ST_STARTUP_WAIT         = 8'd1;&#10;  localparam [7:0] ST_POWER_CLOCKS         = 8'd2;&#10;  localparam [7:0] ST_ISSUE_CMD0           = 8'd3;&#10;  localparam [7:0] ST_EVAL_CMD0            = 8'd4;&#10;  localparam [7:0] ST_ISSUE_CMD8           = 8'd5;&#10;  localparam [7:0] ST_EVAL_CMD8            = 8'd6;&#10;  localparam [7:0] ST_ISSUE_CMD55          = 8'd7;&#10;  localparam [7:0] ST_EVAL_CMD55           = 8'd8;&#10;  localparam [7:0] ST_ISSUE_ACMD41         = 8'd9;&#10;  localparam [7:0] ST_EVAL_ACMD41          = 8'd10;&#10;  localparam [7:0] ST_ACMD_RETRY_WAIT      = 8'd11;&#10;  localparam [7:0] ST_ISSUE_CMD58          = 8'd12;&#10;  localparam [7:0] ST_EVAL_CMD58           = 8'd13;&#10;  localparam [7:0] ST_ISSUE_CMD16          = 8'd14;&#10;  localparam [7:0] ST_EVAL_CMD16           = 8'd15;&#10;  localparam [7:0] ST_READY                = 8'd16;&#10;  localparam [7:0] ST_ISSUE_READ           = 8'd17;&#10;  localparam [7:0] ST_EVAL_READ            = 8'd18;&#10;  localparam [7:0] ST_READ_TOKEN           = 8'd19;&#10;  localparam [7:0] ST_READ_DATA            = 8'd20;&#10;  localparam [7:0] ST_READ_CRC1            = 8'd21;&#10;  localparam [7:0] ST_READ_CRC2            = 8'd22;&#10;  localparam [7:0] ST_ISSUE_WRITE          = 8'd23;&#10;  localparam [7:0] ST_EVAL_WRITE           = 8'd24;&#10;  localparam [7:0] ST_WRITE_GAP            = 8'd25;&#10;  localparam [7:0] ST_WRITE_TOKEN          = 8'd26;&#10;  localparam [7:0] ST_WRITE_DATA           = 8'd27;