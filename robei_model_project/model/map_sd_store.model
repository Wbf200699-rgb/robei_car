dex, 1'b1};&#10;          map_mem_wdata &lt;= sector_read_data[7:4];&#10;          map_mem_we &lt;= 1'b1;&#10;          map_mem_req &lt;= 1'b1;&#10;          state &lt;= ST_LOAD_NEXT_BYTE;&#10;        end&#10;&#10;        ST_LOAD_NEXT_BYTE: begin&#10;          if (payload_byte_index == 9'd511) begin&#10;            if (payload_sector_index == 4'd15) begin&#10;              load_drain_count &lt;= 3'd0;&#10;              state &lt;= ST_LOAD_APPLY_DRAIN;&#10;            end else begin&#10;              payload_sector_index &lt;= payload_sector_index + 4'd1;&#10;              payload_byte_index &lt;= 9'd0;&#10;              flash_progress &lt;= 8'd40 +&#10;                  ({4'd0, payload_sector_index} * 8'd3);&#10;              state &lt;= ST_LOAD_SECTOR_REQUEST;&#10;            end&#10;          end else begin&#10;            payload_byte_index &lt;= payload_byte_index + 9'd1;&#10;            controller_buffer_addr &lt;= controller_buffer_addr + 9'd1;&#10;            state &lt;= ST_LOAD_WRITE_LOW;&#10;          end&#10;        end&#10;&#10;        ST_LOAD_APPLY_DRAIN: begin&#10;          if (load_drain_count == 3'd3) begin&#10;            load_apply_pulse &lt;= 1'b1;&#10;            state &lt;= ST_LOAD_DONE;&#10;          end else begin&#10;            load_drain_count &lt;= load_drain_count + 3'd1;&#10;          end&#10;        end&#10;&#10;        ST_LOAD_DONE: begin&#10;          flash_progress &lt;= 8'd100;&#10;          flash_error &lt;= ERR_NONE;&#10;          flash_busy &lt;= 1'b0;&#10;          flash_operation &lt;= 2'd0;&#10;          state &lt;= ST_IDLE;&#10;        end&#10;&#10;        ST_FILL_START: begin&#10;          fill_index &lt;= 9'd0;&#10;          crc_work &lt;= 32'hffffffff;&#10;          state &lt;= ST_FILL_DATA;&#10;        end&#10;&#10;        ST_FILL_DATA: begin&#10;          if (fill_kind == FILL_HEADER) begin&#10;            crc_work &lt;= crc32_update(crc_work, header_byte(fill_index));&#10;          end else begin&#10;            crc_work &lt;= crc32_update(&#10;                crc_work, commit_byte(fill_index,&#10;                fill_kind == FILL_VALID_COMMIT));&#10;          end&#10;          if (fill_index == 9'd507) begin&#10;            if (fill_kind == FILL_HEADER) begin&#10;              fill_crc_value &lt;= crc32_update(&#10;                  crc_work, header_byte(fill_index)) ^ 32'hffffffff;&#10;              pending_header_crc &lt;= crc32_update(&#10;                  crc_work, header_byte(fill_index)) ^ 32'hffffffff;&#10;            end else begin&#10;              fill_crc_value &lt;= crc32_update(&#10;                  crc_work, commit_byte(fill_index,&#10;                  fill_kind == FILL_VALID_COMMIT)) ^ 32'hffffffff;&#10;            end&#10;            fill_index &lt;= 9'd508;&#10;            state &lt;= ST_FILL_CRC;&#10;          end else begin&#10;            fill_index &lt;= fill_index + 9'd1;&#10;          end&#10;        end&#10;&#10;        ST_FILL_CRC: begin&#10;          if (fill_index == 9'd511)&#10;            state &lt;= fill_return_state;&#10;          else&#10;            fill_index &lt;= fill_index + 9'd1;&#10;        end&#10;&#10;        ST_PARSE_START: begin&#10;          controller_buffer_addr &lt;= 9'd0;&#10;          crc_index &lt;= 9'd0;&#10;          crc_work &lt;= 32'hffffffff;&#10;          crc_result &lt;= 32'd0;&#10;          parse_magic &lt;= 64'd0;&#10;          parse_word8 &lt;= 32'd0;&#10;          parse_word12 &lt;= 32'd0;&#10;          parse_word16 &lt;= 32'd0;&#10;          parse_width &lt;= 16'd0;&#10;          parse_height &lt;= 16'd0;&#10;          parse_resolution &lt;= 16'd0;&#10;          parse_payload_bytes &lt;= 32'd0;&#10;          parse_payload_sectors &lt;= 16'd0;&#10;          parse_map_epoch &lt;= 8'd0;&#10;          parse_pose_x_mm &lt;= 16'd0;&#10;          parse_pose_y_mm &lt;= 16'd0;&#10;          parse_pose_heading &lt;= 10'd0;&#10;          parse_scan_count &lt;= 16'd0;&#10;          parse_occupied_count &lt;= 16'd0;&#10;          parse_free_count &lt;= 16'd0;&#10;          parse_payload_crc &lt;= 32'd0;&#10;          parse_slot &lt;= 1'b0;&#10;          parse_marker &lt;= 8'd0;&#10;          parse_format_version &lt;= 8'd0;&#10;          parse_stored_sector_crc &lt;= 32'd0;&#10;          state &lt;= ST_PARSE_RUN;&#10;        end&#10;&#10;        ST_PARSE_RUN: begin&#10;          if (crc_index &lt;= 9'd7)&#10;            parse_magic &lt;= {parse_magic[55:0], sector_read_data};&#10;&#10;          if (!parse_kind) begin&#10;            case (crc_index)&#10;              9'd8: parse_word8[7:0] &lt;= sector_read_data;&#10;              9'd9: parse_word8[15:8] &lt;= sector_read_data;&#10;              9'd10: parse_word8[23:16] &lt;= sector_read_data;&#10;              9'd11: parse_word8[31:24] &lt;= sector_read_data;&#10;              9'd12: parse_word12[7:0] &lt;= sector_read_data;&#10;              9'd13: parse_word12[15:8] &lt;= sector_read_data;&#10;              9'd14: parse_word12[23:16] &lt;= sector_read_data;&#10;              9'd15: parse_word12[31:24] &lt;= sector_read_data;&#10;              9'd16: parse_width[7:0] &lt;= sector_read_data;&#10;              9'd17: parse_width[15:8] &lt;= sector_read_data;&#10;              9'd18: parse_height[7:0] &lt;= sector_read_data;&#10;              9'd19: parse_height[15:8] &lt;= sector_read_data;&#10;              9'd20: parse_resolution[7:0] &lt;= sector_read_data;&#10;              9'd21: parse_resolution[15:8] &lt;= sector_read_data;&#10;              9'd24: parse_payload_bytes[7:0] &lt;= sector_read_data;&#10;              9'd25: parse_payload_bytes[15:8] &lt;= sector_read_data;&#10;              9'd26: parse_payload_bytes[23:16] &lt;= sector_read_data;&#10;              9'd27: parse_payload_bytes[31:24] &lt;= sector_read_data;&#10;              9'd28: parse_payload_sectors[7:0] &lt;= sector_read_data;&#10;              9'd29: parse_payload_sectors[15:8] &lt;= sector_read_data;&#10;              9'd30: parse_map_epoch &lt;= sector_read_data;