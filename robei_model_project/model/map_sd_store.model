 endfunction&#10;&#10;  reg spi_start;&#10;  reg spi_fast;&#10;  reg [7:0] spi_tx_data;&#10;  reg [7:0] spi_rx_data;&#10;  reg spi_busy;&#10;  reg spi_done;&#10;  reg [15:0] spi_div_count;&#10;  reg [2:0] spi_bit_index;&#10;  reg spi_last_sampled;&#10;  wire [15:0] spi_half_cycles = spi_fast ?&#10;      DATA_SPI_HALF_CYCLES[15:0] : INIT_SPI_HALF_CYCLES[15:0];&#10;&#10;  &#10;  &#10;  &#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      sd_sclk &lt;= 1'b0;&#10;      sd_mosi &lt;= 1'b1;&#10;      spi_rx_data &lt;= 8'hff;&#10;      spi_busy &lt;= 1'b0;&#10;      spi_done &lt;= 1'b0;&#10;      spi_div_count &lt;= 16'd0;&#10;      spi_bit_index &lt;= 3'd7;&#10;      spi_last_sampled &lt;= 1'b0;&#10;    end else begin&#10;      spi_done &lt;= 1'b0;&#10;      if (!spi_busy) begin&#10;        sd_sclk &lt;= 1'b0;&#10;        spi_div_count &lt;= 16'd0;&#10;        if (spi_start) begin&#10;          spi_busy &lt;= 1'b1;&#10;          spi_bit_index &lt;= 3'd7;&#10;          spi_last_sampled &lt;= 1'b0;&#10;          spi_rx_data &lt;= 8'd0;&#10;          sd_mosi &lt;= spi_tx_data[7];&#10;        end else begin&#10;          sd_mosi &lt;= 1'b1;&#10;        end&#10;      end else if (spi_div_count &gt;= spi_half_cycles - 1'b1) begin&#10;        spi_div_count &lt;= 16'd0;&#10;        if (!sd_sclk) begin&#10;          sd_sclk &lt;= 1'b1;&#10;          spi_rx_data[spi_bit_index] &lt;= sd_miso;&#10;          if (spi_bit_index == 3'd0)&#10;            spi_last_sampled &lt;= 1'b1;&#10;          else&#10;            spi_bit_index &lt;= spi_bit_index - 3'd1;&#10;        end else if (spi_last_sampled) begin&#10;          sd_sclk &lt;= 1'b0;&#10;          sd_mosi &lt;= 1'b1;&#10;          spi_busy &lt;= 1'b0;&#10;          spi_done &lt;= 1'b1;&#10;          spi_last_sampled &lt;= 1'b0;&#10;        end else begin&#10;          sd_sclk &lt;= 1'b0;&#10;          sd_mosi &lt;= spi_tx_data[spi_bit_index];&#10;        end&#10;      end else begin&#10;        spi