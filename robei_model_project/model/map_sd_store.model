lba;&#10;              block_busy &lt;= 1'b1;&#10;              error_code &lt;= ERR_NONE;&#10;              operation_failed &lt;= 1'b0;&#10;              block_byte_index &lt;= 10'd0;&#10;              buffer_addr &lt;= 9'd0;&#10;              token_wait_count &lt;= 16'd0;&#10;              write_busy_wait_count &lt;= 16'd0;&#10;              if (block_write)&#10;                write_data_response &lt;= 8'hff;&#10;              state &lt;= block_write ? ST_ISSUE_WRITE : ST_ISSUE_READ;&#10;            end&#10;          end&#10;        end&#10;&#10;        ST_ISSUE_READ: begin&#10;          command_number &lt;= 6'd17;&#10;          command_argument &lt;= high_capacity ? active_lba : (active_lba &lt;&lt; 9);&#10;          command_crc &lt;= 8'h01;&#10;          command_has_extra &lt;= 1'b0;&#10;          command_keep_selected &lt;= 1'b1;&#10;          command_return_state &lt;= ST_EVAL_READ;&#10;          state &lt;= ST_CMD_ASSERT;&#10;        end&#10;&#10;        ST_EVAL_READ: begin&#10;          last_r1 &lt;= command_r1;&#10;          if (command_r1 == 8'h00) begin&#10;            byte_pending &lt;= 1'b0;&#10;            token_wait_count &lt;= 16'd0;&#10;            state &lt;= ST_READ_TOKEN;&#10;          end else begin&#10;            sd_cs_n &lt;= 1'b1;&#10;            error_code &lt;= ERR_CMD17;&#10;            operation_failed &lt;= 1'b1;&#10;            state &lt;= ST_OPERATION_RELEASE;&#10;          end&#10;        end&#10;&#10;        ST_READ_TOKEN: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            if (spi_rx_data == 8'hfe) begin&#10;              block_byte_index &lt;= 10'd0;&#10;              buffer_addr &lt;= 9'd0;&#10;              state &lt;= ST_READ_DATA;&#10;            end else if (token_wait_count &gt;= TOKEN_TIMEOUT_BYTES - 1) begin&#10;              sd_cs_n &lt;= 1'b1;&#10;              error_code &lt;= ERR_READ_TOKEN;&#10;              operation_failed &lt;= 1'b1;&#10;              state &lt;= ST_OPERATION_RELEASE;&#10;            end else begin&#10;              token_wait_count &lt;= token_wait_count + 16'd1;&#10;            end&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_READ_DATA: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            buffer_addr &lt;= block_byte_index[8:0];&#10;            buffer_write_data &lt;= spi_rx_data;&#10;            buffer_write_enable &lt;= 1'b1;&#10;            if (block_byte_index == 10'd511) begin&#10;              state &lt;= ST_READ_CRC1;&#10;            end else begin&#10;              block_byte_index &lt;= block_byte_index + 10'd1;&#10;            end&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_READ_CRC1: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            state &lt;= ST_READ_CRC2;&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_READ_CRC2: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            sd_cs_n &lt;= 1'b1;&#10;            operation_failed &lt;= 1'b0;&#10;            state &lt;= ST_OPERATION_RELEASE;&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_ISSUE_WRITE: begin&#10;          command_number &lt;= 6'd24;&#10;          command_argument &lt;= high_capacity ? active_lba : (active_lba &lt;&lt; 9);&#10;          command_crc &lt;= 8'h01;&#10;          command_has_extra &lt;= 1'b0;&#10;          command_keep_selected &lt;= 1'b1;&#10;          command_return_state &lt;= ST_EVAL_WRITE;&#10;          state &lt;= ST_CMD_ASSERT;&#10;        end&#10;&#10;        ST_EVAL_WRITE: begin&#10;          last_r1 &lt;= command_r1;&#10;          if (command_r1 == 8'h00) begin&#10;            byte_pending &lt;= 1'b0;&#10;            state &lt;= ST_WRITE_GAP;&#10;          end else begin&#10;            sd_cs_n &lt;= 1'b1;&#10;            error_code &lt;= ERR_CMD24;&#10;            operation_failed &lt;= 1'b1;&#10;            state &lt;= ST_OPERATION_RELEASE;&#10;          end&#10;        end&#10;&#10;        ST_WRITE_GAP: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            state &lt;= ST_WRITE_TOKEN;&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_WRITE_TOKEN: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            block_byte_index &lt;= 10'd0;&#10;            buffer_addr &lt;= 9'd0;&#10;            state &lt;= ST_WRITE_DATA;&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hfe;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_WRITE_DATA: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            if (block_byte_index == 10'd511) begin&#10;              state &lt;= ST_WRITE_CRC1;&#10;            end else begin&#10;              block_byte_index &lt;= block_byte_index + 10'd1;&#10;              buffer_addr &lt;= block_byte_index[8:0] + 9'd1;&#10;            end&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= buffer_read_data;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_WRITE_CRC1: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            state &lt;= ST_WRITE_CRC2;&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_WRITE_CRC2: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            token_wait_count &lt;= 16'd0;&#10;            state &lt;= ST_WRITE_RESPONSE;&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_WRITE_RESPONSE: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            if ((spi_rx_data &amp; 8'h1f) == 8'h05) begin&#10;              write_data_response &lt;= spi_rx_data;&#10;              write_busy_wait_count &lt;= 16'd0;&#10;              state &lt;= ST_WRITE_BUSY;&#10;            end else if (token_wait_count &gt;= TOKEN_TIMEOUT_BYTES - 1) begin&#10;              write_data_response &lt;= spi_rx_data;&#10;              sd_cs_n &lt;= 1'b1;&#10;              error_code &lt;= ERR_WRITE_RESPONSE;&#10;              operation_failed &lt;= 1'b1;&#10;              state &lt;= ST_OPERATION_RELEASE;&#10;            end else begin&#10;              token_wait_count &lt;= token_wait_count + 16'd1;&#10;            end&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_WRITE_BUSY: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            if (spi_rx_data == 8'hff) begin&#10;              sd_cs_n &lt;= 1'b1;&#10;              operation_failed &lt;= 1'b0;&#10;              state &lt;= ST_OPERATION_RELEASE;&#10;            end else if (write_busy_wait_count &gt;=&#10;                         WRITE_BUSY_TIMEOUT_BYTES - 1) begin&#10;              sd_cs_n &lt;= 1'b1;&#10;              error_code &lt;= ERR_WRITE_BUSY_TIMEOUT;&#10;              operation_failed &lt;= 1'b1;&#10;              state &lt;= ST_OPERATION_RELEASE;&#10;            end else begin&#10;              write_busy_wait_count &lt;= write_busy_wait_count + 16'd1;&#10;            end&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_OPERATION_RELEASE: begin&#10;          sd_cs_n &lt;= 1'b1;&#10;          if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;            state &lt;= ST_OPERATION_RELEASE_WAIT;&#10;          end&#10;        end&#10;&#10;        ST_OPERATION_RELEASE_WAIT: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            block_busy &lt;= 1'b0;&#10;            block_done &lt;= 1'b1;&#10;            state &lt;= ST_READY;&#10;          end&#10;        end&#10;&#10;        ST_INIT_FAILED: begin&#10;          sd_cs_n &lt;= 1'b1;&#10;          initialized &lt;= 1'b0;&#10;          init_busy &lt;= 1'b0;&#10;          init_done &lt;= 1'b1;&#10;          state &lt;= ST_IDLE;&#10;        end&#10;&#10;        ST_CMD_ASSERT: begin&#10;          sd_cs_n &lt;= 1'b0;&#10;          command_index &lt;= 3'd0;&#10;          response_wait_count &lt;= 5'd0;&#10;          extra_index &lt;= 2'd0;&#10;          command_r1 &lt;= 8'hff;&#10;          command_extra &lt;= 32'd0;&#10;          byte_pending &lt;= 1'b0;&#10;          state &lt;= ST_CMD_SEND;&#10;        end&#10;&#10;        ST_CMD_SEND: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            if (command_index == 3'd5) begin&#10;              response_wait_count &lt;= 5'd0;&#10;              state &lt;= ST_CMD_RESPONSE;&#10;            end else begin&#10;              command_index &lt;= command_index + 3'd1;&#10;            end&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= command_byte(&#10;                command_number, command_argument, command_crc, command_index);&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_CMD_RESPONSE: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            if (!spi_rx_data[7]) begin&#10;              command_r1 &lt;= spi_rx_data;&#10;              if (command_has_extra) begin&#10;                extra_index &lt;= 2'd0;&#10;                state &lt;= ST_CMD_EXTRA;&#10;              end else if (command_keep_selected) begin&#10;                state &lt;= command_return_state;&#10;              end else begin&#10;                sd_cs_n &lt;= 1'b1;&#10;                state &lt;= ST_CMD_RELEASE;&#10;              end&#10;            end else if (response_wait_count == 5'd15) begin&#10;              command_r1 &lt;= 8'hff;&#10;              if (command_keep_selected) begin&#10;                state &lt;= command_return_state;&#10;              end else begin&#10;                sd_cs_n &lt;= 1'b1;&#10;                state &lt;= ST_CMD_RELEASE;&#10;              end&#10;            end else begin&#10;              response_wait_count &lt;= response_wait_count + 5'd1;&#10;            end&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_CMD_EXTRA: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            command_extra &lt;= {command_extra[23:0], spi_rx_data};&#10;            if (extra_index == 2'd3) begin&#10;              if (command_keep_selected) begin&#10;                state &lt;= command_return_state;&#10;              end else begin&#10;                sd_cs_n &lt;= 1'b1;&#10;                state &lt;= ST_CMD_RELEASE;&#10;              end&#10;            end else begin&#10;              extra_index &lt;= extra_index + 2'd1;&#10;            end&#10;          end else if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;          end&#10;        end&#10;&#10;        ST_CMD_RELEASE: begin&#10;          sd_cs_n &lt;= 1'b1;&#10;          if (!byte_pending &amp;&amp; !spi_busy) begin&#10;            spi_tx_data &lt;= 8'hff;&#10;            spi_start &lt;= 1'b1;&#10;            byte_pending &lt;= 1'b1;&#10;            state &lt;= ST_CMD_RELEASE_WAIT;&#10;          end&#10;        end&#10;&#10;        ST_CMD_RELEASE_WAIT: begin&#10;          if (spi_done) begin&#10;            byte_pending &lt;= 1'b0;&#10;            state &lt;= command_return_state;&#10;          end&#10;        end&#10;&#10;        default: begin&#10;          sd_cs_n &lt;= 1'b1;&#10;          initialized &lt;= 1'b0;&#10;          init_busy &lt;= 1'b0;&#10;          block_busy &lt;= 1'b0;&#10;          error_code &lt;= 8'hff;&#10;          state &lt;= ST_IDLE;&#10;        end&#10;      endcase&#10;    end&#10;  end" Color="#d3d3d3" Comment="" Height="1250" Name="sd_spi_block_device0" Parameters="" Parent="map_sd_store" Type="model" Width="950" X="2450" Y="180">
