UWB_GATEWAY_TOKEN=change-me-gateway
UWB_MOBILE_TOKEN=change-me-mobile
UWB_COMMAND_TAG_ID=1

# Tag role mapping. Change these after checking the physical corner labels.
UWB_TAG_FRONT_LEFT=1
