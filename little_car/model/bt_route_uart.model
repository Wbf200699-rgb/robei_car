          input [7:0] value;&#xa;                begin&#xa;                  case (value)&#xa;                    &quot;J&quot;, &quot;j&quot;, &quot;K&quot;, &quot;k&quot;, &quot;6&quot;, &quot;7&quot;, &quot;8&quot;, &quot;9&quot;:&#xa;                      onboard_map_command = 1'b1;&#xa;                    default: onboard_map_command = 1'b0;&#xa;                  endcase&#xa;                end&#xa;              endfunction&#xa;  &#xa;              function [7:0] reply_char;&#xa;                input [1:0] kind;&#xa;                input [2:0] index;&#xa;                input [7:0] key_char;&#xa;                begin&#xa;                  case (kind)&#xa;                    REPLY_KEY: begin&#xa;                      case (index)&#xa;                        3'd0: reply_char = &quot;@&quot;;&#xa;                        3'd1: reply_char = &quot;K&quot;;&#xa;                        3'd2: reply_char = key_char;&#xa;                        default: reply_char = 8'd10;&#xa;                      endcase&#xa;                    end&#xa;                    REPLY_PONG: begin&#xa;                      case (index)&#xa;                        3'd0: reply_char = &quot;@&quot;;&#xa;                        3'd1: reply_char = &quot;P&quot;;&#xa;                        3'd2: reply_char = &quot;O&quot;;&#xa;                        3'd3: reply_char = &quot;N&quot;;&#xa;                        3'd4: reply_char = &quot;G&quot;;&#xa;                        default: reply_char = 8'd10;&#xa;                      endcase&#xa;                    end&#xa;                    default: reply_char = 8'd10;&#xa;                  endcase&#xa;                end&#xa;              endfunction&#xa;&#xa;              &#xa;              &#xa;              &#xa;              always @(posedge clk or negedge rst_n) begin&#xa;                if (!rst_n) begin&#xa;                  &#xa;                  &#xa;                  &#xa;                  bt_boot_state &lt;= BT_BOOT_READY;&#xa;                