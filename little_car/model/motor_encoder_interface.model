1 &lt;= lr_b_d0;&#xa;      rr_a_d0 &lt;= rr_enc_a;&#xa;      rr_a_d1 &lt;= rr_a_d0;&#xa;      rr_b_d0 &lt;= rr_enc_b;&#xa;      rr_b_d1 &lt;= rr_b_d0;&#xa;&#xa;      lf_tick &lt;= lf_a_rise;&#xa;      rf_tick &lt;= rf_a_rise;&#xa;      lr_tick &lt;= lr_a_rise;&#xa;      rr_tick &lt;= rr_a_rise;&#xa;&#xa;      if (lf_a_rise) begin&#xa;        lf_dir &lt;= lf_b_d1;&#xa;        if (lf_total_count != 16'hFFFF)&#xa;          lf_total_count &lt;= lf_total_count + 16'd1;&#xa;      end&#xa;&#xa;      if (rf_a_rise) begin&#xa;        rf_dir &lt;= rf_b_d1;&#xa;        if (rf_total_count != 16'hFFFF)&#xa;          rf_total_count &lt;= rf_total_count + 16'd1;&#xa;      end&#xa;&#xa;      if (lr_a_rise) begin&#xa;        lr_dir &lt;= lr_b_d1;&#xa;        if (lr_total_count != 16'hFFFF)&#xa;          lr_total_count &lt;= lr_total_count + 16'd1;&#xa;      end&#xa;&#xa;      if (rr_a_rise) begin&#xa;        rr_dir &lt;= rr_b_d1;&#xa;        if (rr_total_count != 16'hFFFF)&#xa;          rr_total_count &lt;= rr_total_count + 16'd1;&#xa;      end&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="motor_encoder_interface" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
