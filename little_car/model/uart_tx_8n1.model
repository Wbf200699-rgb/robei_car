<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam integer CLK_HZ = 50000000;&#xa;  localparam integer BAUD = 115200;&#xa;  localparam integer CLKS_PER_BIT = CLK_HZ / BAUD;&#xa;&#xa;  localparam [1:0] STATE_IDLE  = 2'd0;&#xa;  localparam [1:0] STATE_START = 2'd1;&#xa;  localparam [1:0] STATE_DATA  = 2'd2;&#xa;  localparam [1:0] STATE_STOP  = 2'd3;&#xa;&#xa;  reg [1:0] state;&#xa;  reg [15:0] clk_count;&#xa;  reg [2:0] bit_index;&#xa;  reg [7:0] shifter;&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      tx &lt;= 1'b1;&#xa;      busy &lt;= 1'b0;&#xa;      state &lt;= STATE_IDLE;&#xa;      clk_count &lt;= 16'd0;&#xa;      bit_index &lt;= 3'd0;&#xa;      shifter &lt;= 8'd0;&#xa;    end else begin&#xa;      case (state)&#xa;        STATE_IDLE: begin&#xa;          tx &lt;= 1'b1;&#xa;          busy &lt;= 1'b0;&#xa;          clk_count &lt;= 16'd0;&#xa;          bit_index &lt;= 3'd0;&#xa;          if (start) begin&#xa;            busy &lt;= 1'b1;&#xa;            shifter &lt;= data;&#xa;            state &lt;= STATE_START;&#xa;            tx &lt;= 1'b0;&#xa;          end&#xa;        end&#xa;&#xa;        STATE_START: begin&#xa;          busy &lt;= 1'b1;&#xa;          tx &lt;= 1'b0;&#xa;          if (clk_count == CLKS_PER_BIT - 1) begin&#xa;            clk_count &lt;= 16'd0;&#xa;            state &lt;= STATE_DATA;&#xa;            tx &lt;= shifter[0];&#xa;          end else begin&#xa;            clk_count &lt;= clk_count + 16'd1;&#xa;          end&#xa;        end&#xa;&#xa;        STATE_DATA: begin&#xa;          busy &lt;= 1'b1;&#xa;          tx &lt;= shifter[bit_index];&#xa;          if (clk_count == CLKS_PER_BIT - 1) begin&#xa;            clk_count &lt;= 16'd0;&#xa;            if (bit_index == 3'd7) begin&#xa;              bit_index &lt;= 3'd0;&#xa;              state &lt;= STATE_STOP;&#xa;              tx &lt;= 1'b1;&#xa;            end else begin&#xa;              bit_index &lt;= bit_index + 3'd1;&#xa;              tx &lt;= shifter[bit_index + 3'd1];&#xa;            end&#xa;          end else begin&#xa;            clk_count &lt;= clk_count + 16'd1;&#xa;          end&#xa;        end&#xa;&#xa;        default: begin&#xa;          busy &lt;= 1'b1;&#xa;          tx &lt;= 1'b1;&#xa;          if (clk_count == CLKS_PER_BIT - 1) begin&#xa;            clk_count &lt;= 16'd0;&#xa;            busy &lt;= 1'b0;&#xa;            state &lt;= STATE_IDLE;&#xa;          end else begin&#xa;            clk_count &lt;= clk_count + 16'd1;&#xa;          end&#xa;        end&#xa;      endcase&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="uart_tx_8n1" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="uart_tx_8n1" Side="left" Width="30" X="-0.01875" Y="0.1625"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="uart_tx_8n1" Side="left" Width="30" X="-0.01875" Y="0.3875"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="start" Parent="uart_tx_8n1" Side="left" Width="30" X="-0.01875" Y="0.6125"/>
 <Port Color="#f0ffff" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="data" Parent="uart_tx_8n1" Side="left" Width="30" X="-0.01875" Y="0.8375"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="tx" Parent="uart_tx_8n1" Side="right" Width="30" X="0.98125" Y="0.275"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="busy" Parent="uart_tx_8n1" Side="right" Width="30" X="0.98125" Y="0.725"/>
</Module>
