<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam integer CLK_HZ = 50000000;&#xa;  localparam integer TONE_HZ = 2000;&#xa;  localparam integer BEEP_MS = 80;&#xa;  localparam integer GAP_MS = 80;&#xa;  localparam ACTIVE_LOW = 1'b0;&#xa;&#xa;  localparam integer HALF_PERIOD = CLK_HZ / (TONE_HZ * 2);&#xa;  localparam integer BEEP_CYCLES = (CLK_HZ / 1000) * BEEP_MS;&#xa;  localparam integer GAP_CYCLES  = (CLK_HZ / 1000) * GAP_MS;&#xa;&#xa;  reg tone_bit;&#xa;  reg beep_active;&#xa;  reg gap_active;&#xa;  reg [31:0] tone_cnt;&#xa;  reg [31:0] beep_cnt;&#xa;  reg [31:0] gap_cnt;&#xa;  reg [1:0] pending_beeps;&#xa;  reg [1:0] current_beeps;&#xa;  wire raw_buzzer;&#xa;&#xa;  assign raw_buzzer = beep_active ? tone_bit : 1'b0;&#xa;  assign buzzer_out = ACTIVE_LOW ? ~raw_buzzer : raw_buzzer;&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      tone_bit &lt;= 1'b0;&#xa;      beep_active &lt;= 1'b0;&#xa;      gap_active &lt;= 1'b0;&#xa;      tone_cnt &lt;= 32'd0;&#xa;      beep_cnt &lt;= 32'd0;&#xa;      gap_cnt &lt;= 32'd0;&#xa;      pending_beeps &lt;= 2'd0;&#xa;      current_beeps &lt;= 2'd0;&#xa;    end else begin&#xa;      if (stop_enter_pulse)&#xa;        pending_beeps &lt;= 2'd2;&#xa;      else if (run_enter_pulse)&#xa;        pending_beeps &lt;= 2'd1;&#xa;      else if (route_add_pulse)&#xa;        pending_beeps &lt;= 2'd1;&#xa;      else if (power_on_pulse)&#xa;        pending_beeps &lt;= 2'd1;&#xa;&#xa;      if (beep_active) begin&#xa;        if (tone_cnt == HALF_PERIOD - 1) begin&#xa;          tone_cnt &lt;= 32'd0;&#xa;          tone_bit &lt;= ~tone_bit;&#xa;        end else begin&#xa;          tone_cnt &lt;= tone_cnt + 32'd1;&#xa;        end&#xa;&#xa;        if (beep_cnt == BEEP_CYCLES - 1) begin&#xa;          beep_active &lt;= 1'b0;&#xa;          beep_cnt &lt;= 32'd0;&#xa;          tone_cnt &lt;= 32'd0;&#xa;          tone_bit &lt;= 1'b0;&#xa;          if (current_beeps > 2'd1) begin&#xa;            current_beeps &lt;= current_beeps - 2'd1;&#xa;            gap_active &lt;= 1'b1;&#xa;            gap_cnt &lt;= 32'd0;&#xa;          end else begin&#xa;            current_beeps &lt;= 2'd0;&#xa;          end&#xa;        end else begin&#xa;          beep_cnt &lt;= beep_cnt + 32'd1;&#xa;        end&#xa;      end else if (gap_active) begin&#xa;        if (gap_cnt == GAP_CYCLES - 1) begin&#xa;          gap_active &lt;= 1'b0;&#xa;          gap_cnt &lt;= 32'd0;&#xa;          beep_active &lt;= 1'b1;&#xa;          beep_cnt &lt;= 32'd0;&#xa;          tone_cnt &lt;= 32'd0;&#xa;          tone_bit &lt;= 1'b0;&#xa;        end else begin&#xa;          gap_cnt &lt;= gap_cnt + 32'd1;&#xa;        end&#xa;      end else if (current_beeps != 2'd0) begin&#xa;        beep_active &lt;= 1'b1;&#xa;        beep_cnt &lt;= 32'd0;&#xa;        tone_cnt &lt;= 32'd0;&#xa;        tone_bit &lt;= 1'b0;&#xa;      end else if (pending_beeps != 2'd0) begin&#xa;        current_beeps &lt;= pending_beeps;&#xa;        pending_beeps &lt;= 2'd0;&#xa;      end&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="buzzer_ctrl" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="buzzer_ctrl" Side="left" Width="30" X="-0.01875" Y="0.117593"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="buzzer_ctrl" Side="left" Width="30" X="-0.01875" Y="0.199074"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="power_on_pulse" Parent="buzzer_ctrl" Side="left" Width="30" X="-0.01875" Y="0.298148"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="route_add_pulse" Parent="buzzer_ctrl" Side="left" Width="30" X="-0.01875" Y="0.4"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="run_enter_pulse" Parent="buzzer_ctrl" Side="left" Width="30" X="-0.01875" Y="0.50463"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="stop_enter_pulse" Parent="buzzer_ctrl" Side="left" Width="30" X="-0.01875" Y="0.626852"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="buzzer_out" Parent="buzzer_ctrl" Side="right" Width="30" X="0.98125" Y="0.441667"/>
</Module>
