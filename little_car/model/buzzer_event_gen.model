<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam [4:0] STATE_RUN  = 5'b00011;&#xa;  localparam [4:0] STATE_STOP = 5'b00100;&#xa;&#xa;  reg rst_n_d;&#xa;  reg [4:0] state_info_d;&#xa;  reg [5:0] active_route_steps_d;&#xa;&#xa;  assign power_on_pulse = rst_n &amp; ~rst_n_d;&#xa;  assign route_add_pulse = (active_route_steps > active_route_steps_d);&#xa;  assign run_enter_pulse = (state_info == STATE_RUN) &amp;&amp; (state_info_d != STATE_RUN);&#xa;  assign stop_enter_pulse = (state_info == STATE_STOP) &amp;&amp; (state_info_d != STATE_STOP);&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      rst_n_d &lt;= 1'b0;&#xa;      state_info_d &lt;= 5'd0;&#xa;      active_route_steps_d &lt;= 6'd0;&#xa;    end else begin&#xa;      rst_n_d &lt;= 1'b1;&#xa;      state_info_d &lt;= state_info;&#xa;      active_route_steps_d &lt;= active_route_steps;&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="buzzer_event_gen" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="buzzer_event_gen" Side="left" Width="30" X="-0.01875" Y="0.186111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="buzzer_event_gen" Side="left" Width="30" X="-0.01875" Y="0.386111"/>
 <Port Color="#7fffd4" Connect="" Datasize="5" Datatype="wire" Description="" Height="30" Inout="input" Name="state_info" Parent="buzzer_event_gen" Side="left" Width="30" X="-0.01875" Y="0.586111"/>
 <Port Color="#f0ffff" Connect="" Datasize="6" Datatype="wire" Description="" Height="30" Inout="input" Name="active_route_steps" Parent="buzzer_event_gen" Side="left" Width="30" X="-0.01875" Y="0.786111"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="power_on_pulse" Parent="buzzer_event_gen" Side="right" Width="30" X="0.98125" Y="0.186111"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="route_add_pulse" Parent="buzzer_event_gen" Side="right" Width="30" X="0.98125" Y="0.386111"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="run_enter_pulse" Parent="buzzer_event_gen" Side="right" Width="30" X="0.98125" Y="0.586111"/>
 <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="stop_enter_pulse" Parent="buzzer_event_gen" Side="right" Width="30" X="0.98125" Y="0.786111"/>
</Module>
