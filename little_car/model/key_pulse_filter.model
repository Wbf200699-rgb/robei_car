<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  reg [1:0] key_sync;&#xa;  reg key_level;&#xa;  reg key_level_d;&#xa;  reg [19:0] stable_cnt;&#xa;&#xa;  wire key_pressed;&#xa;&#xa;  assign key_pressed = ~key_sync[1];&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      key_sync    &lt;= 2'b11;&#xa;      key_level   &lt;= 1'b0;&#xa;      key_level_d &lt;= 1'b0;&#xa;      stable_cnt  &lt;= 20'd0;&#xa;      key_pulse   &lt;= 1'b0;&#xa;    end else begin&#xa;      key_sync &lt;= {key_sync[0], key_n};&#xa;&#xa;      if (key_pressed == key_level) begin&#xa;        stable_cnt &lt;= 20'd0;&#xa;      end else if (stable_cnt >= 20'd999999) begin&#xa;        key_level  &lt;= key_pressed;&#xa;        stable_cnt &lt;= 20'd0;&#xa;      end else begin&#xa;        stable_cnt &lt;= stable_cnt + 20'd1;&#xa;      end&#xa;&#xa;      key_level_d &lt;= key_level;&#xa;      key_pulse   &lt;= key_level &amp; ~key_level_d;&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="key_pulse_filter" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="key_pulse_filter" Side="left" Width="30" X="-0.01875" Y="0.236111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="key_pulse_filter" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_n" Parent="key_pulse_filter" Side="left" Width="30" X="-0.01875" Y="0.736111"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="key_pulse" Parent="key_pulse_filter" Side="right" Width="30" X="0.98125" Y="0.486111"/>
</Module>
