mp;&amp;&#xa;                         (pixel_x &lt;= target_draw_x + 5) &amp;&amp;&#xa;                         (pixel_y >= target_draw_y - 5) &amp;&amp;&#xa;                         (pixel_y &lt;= target_draw_y + 5);&#xa;&#xa;  function [4:0] font5x7;&#xa;    input [7:0] ch;&#xa;    input [2:0] row;&#xa;    begin&#xa;      case (ch)&#xa;        &quot;0&quot;: case (row) 3'd0: font5x7=5'b01110; 3'd1: font5x7=5'b10001; 3'd2: font5x7=5'b10011; 3'd3: font5x7=5'b10101; 3'd4: font5x7=5'b11001; 3'd5: font5x7=5'b10001; default: font5x7=5'b01110; endcase&#xa;        &quot;1&quot;: case (row) 3'd0: font5x7=5'b00100; 3'd1: font5x7=5'b01100; 3'd2: font5x7=5'b00100; 3'd3: font5x7=5'b00100; 3'd4: font5x7=5'b00100; 3'd5: font5x7=5'b00100; default: font5x7=5'b01110; endcase&#xa;        &quot;2&quot;: case (row) 3'd0: font5x7=5'b01110; 3'd1: font5x7=5'b10001; 3'd2: font5x7=5'b00001; 3'd3: font5x7=5'b00110; 3'd4: font5x7=5'b01000; 3'd5: font5x7=5'b10000; default: font5x7=5'b11111; endcase&#xa;        &quot;3&quot;: case (row) 3'd0: font5x7=5'b11110; 3'd1: font5x7=5'b00001; 3'd2: font5x7=5'b00001; 3'd3: font5x7=5'b01110; 3'd4: font5x7=5'b00001; 3'd5: font5x7=5'b00001; default: font5x7=5'b11110; endcase&#xa;        &quot;4&quot;: case (row) 3'd0: font5x7=5'b00010; 3'd1: font5x7=5'b00110; 3'd2: font5x7=5'b01010; 3'd3: font5x7=5'b10010; 3'd4: font5x7=5'b11111; 3'd5: font5x7=5'b00010; default: font5x7=5'b00010; endcase&#xa;        &quot;5&quot;: case (row) 3'd0: font5x7=5'b11111; 3'd1: font5x7=5'b10000; 3'd2: font5x7=5'b11110; 3'd3: font5x7=5'b00001; 3'd4: font5x7=5'b00001; 3'd5: font5x7=5'b10001; default: font5x7=5'b01110; endcase&#xa;        &quot;6&quot;: case (row) 3'd0: font5x7=5'b00110; 3'd1: font5x7=5'b01000; 3'd2: font5x7=5'b10000; 3'd3: font5x7=5'b11110; 3'd4: font5x7=5'b10001; 3'd5: font5x7=5'b10001; default: font5x7=5'b01110; endcase&#xa;        &quot;7&quot;: case (row) 3'd0: font5x7=5'b11111; 3'd1: font5x7=5'b00001; 3'd2: font5x7=5'b00010; 3'd3: font5x7=5'b00100; 3'd4: font5