  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="hdmi_top2" Side="left" Width="30" X="-0.0608519" Y="0.478029"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="hdmi_clk_p" Parent="hdmi_top2" Side="right" Width="30" X="0.939148" Y="0.479361"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="hdmi_d0_p" Parent="hdmi_top2" Side="right" Width="30" X="0.939148" Y="0.679095"/>
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="hdmi_d1_p" Parent="hdmi_top2" Side="right" Width="30" X="0.939148" Y="0.878828"/>
  <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="hdmi_d2_p" Parent="hdmi_top2" Side="bottom" Width="30" X="0.219067" Y="0.960053"/>
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="hdmi_clk_n" Parent="hdmi_top2" Side="right" Width="30" X="0.939148" Y="0.579228"/>
