nt5x7=5'b00100; 3'd5: font5x7=5'b00100; default: font5x7=5'b00100; endcase&#xa;        &quot;U&quot;: case (row) 3'd0: font5x7=5'b10001; 3'd1: font5x7=5'b10001; 3'd2: font5x7=5'b10001; 3'd3: font5x7=5'b10001; 3'd4: font5x7=5'b10001; 3'd5: font5x7=5'b10001; default: font5x7=5'b01110; endcase&#xa;        &quot;W&quot;: case (row) 3'd0: font5x7=5'b10001; 3'd1: font5x7=5'b10001; 3'd2: font5x7=5'b10001; 3'd3: font5x7=5'b10101; 3'd4: font5x7=5'b10101; 3'd5: font5x7=5'b11011; default: font5x7=5'b10001; endcase&#xa;        &quot;X&quot;: case (row) 3'd0: font5x7=5'b10001; 3'd1: font5x7=5'b10001; 3'd2: font5x7=5'b01010; 3'd3: font5x7=5'b00100; 3'd4: font5x7=5'b01010; 3'd5: font5x7=5'b10001; default: font5x7=5'b10001; endcase&#xa;        &quot;Y&quot;: case (row) 3'd0: font5x7=5'b10001; 3'd1: font5x7=5'b10001; 3'd2: font5x7=5'b01010; 3'd3: font5x7=5'b00100; 3'd4: font5x7=5'b00100; 3'd5: font5x7=5'b00100; default: font5x7=5'b00100; endcase&#xa;        default: font5x7=5'b00000;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  function text_pixel;&#xa;    input [11:0] px;&#xa;    input [11:0] py;&#xa;    input [11:0] x0;&#xa;    input [11:0] y0;&#xa;    input [7:0] ch;&#xa;    input integer scale;&#xa;    integer lx;&#xa;    integer ly;&#xa;    integer row;&#xa;    integer col;&#xa;    reg [4:0] bits;&#xa;    begin&#xa;      lx = px - x0;&#xa;      ly = py - y0;&#xa;      row = ly / scale;&#xa;      col = lx / scale;&#xa;      bits = font5x7(ch, row[2:0]);&#xa;      text_pixel = (px >= x0) &amp;&amp; (px &lt; x0 + 5 * scale) &amp;&amp;&#xa;                   (py >= y0) &amp;&amp; (py &lt; y0 + 7 * scale) &amp;&amp;&#xa;                   (row >= 0) &amp;&amp; (row &lt; 7) &amp;&amp;&#xa;                   (col >= 0) &amp;&amp; (col &lt; 5) &amp;&amp;&#xa;                   bits[4-col];&#xa;    end&#xa;  endfunction&#xa;&#xa;  function word_pixel_5;&#xa;    input [11:0] px; input [11:0] py; input [11:0] x0; input [11:0] y0;&#xa;    input [7:0] c0; input [7:0] c1; input [7:0] c2; input [7:0] c3; input [7:0] c4;&#xa;    begin&#xa;      word_pixel_5 = text_pixel(px,py,x0+0,y0,c0,2) || text_pixel(px,py,x0+12,y0,c1,2) ||&#xa;                     text_pixel(px,py,x0+24,y0,c2,2) || text_pixel(px,py,x0+36,y0,c3,2) ||&#xa;                     text_pixel(px,py,x0+48,y0,c4,2);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function number3_pixel;&#xa;    input [11:0] px; input [11:0] py; input [11:0] x0; input [11:0] y0; input [15:0] value;&#xa;    integer h; integer t; integer o;&#xa;    begin&#xa;      h = (value / 100) % 10;&#xa;      t = (value / 10) % 10;&#xa;      o = value % 10;&#xa;      number3_pixel = text_pixel(px,py,x0,y0,8'd48+h,2) ||&#xa;                      text_pixel(px,py,x0+12,y0,8'd48+t,2) ||&#xa;                      text_pixel(px,py,x0+24,y0,8'd48+o,2);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function coord2_pixel;&#xa;    input [11:0] px; input [11:0] py; input [11:0] x0; input [11:0] y0; input [7:0] value;&#xa;    integer abs_v;&#xa;    begin&#xa;      abs_v = (value >= 8'd128) ? (value - 8'd128) : (8'd128 - value);&#xa;      coord2_pixel = ((value &lt; 8'd128) ? text_pixel(px,py,x0,y0,&quot;-&quot;,2) : 1'b0) ||&#xa;                     text_pixel(px,py,x0+12,y0,8'd48+((abs_v/10)%10),2) ||&#xa;                     text_pixel(px,py,x0+24,y0,8'd48+(abs_v%10),2);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function draw_text_change_route;&#xa;    input [11:0] px; input [11:0] py; input [11:0] x0; input [11:0] y0; input integer scale;&#xa;    begin&#xa;      draw_text_change_route =&#xa;        text_pixel(px,py,x0+0,y0,&quot;C&quot;,scale) || text_pixel(px,py,x0+12,y0,&quot;H&quot;,scale) ||&#xa;        text_pixel(px,py,x0+24,y0,&quot;A&quot;,scale) || text_pixel(px,py,x0+36,y0,&quot;N&quot;,scale) ||&#xa;        text_pixel(px,py,x0+48,y0,&quot;G&quot;,scale) || text_pixel(px,py,x0+60,y0,&quot;E&quot;,scale) ||&#xa;        text_pixel(px,py,x0+0,y0+18,&quot;R&quot;,scale) || text_pixel(px,py,x0+12,y0+18,&quot;O&quot;,scale) ||&#xa;        text_pixel(px,py,x0+24,y0+18,&quot;U&quot;,scale) || text_pixel(px,py,x0+36,y0+18,&quot;T&quot;,scale) ||&#xa;        text_pixel(px,py,x0+48,y0+18,&quot;E&quot;,scale);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function draw_text_run;&#xa;    input [11:0] px; input [11:0] py; input [11:0] x0; input [11:0] y0; input integer scale;&#xa;    begin&#xa;      draw_text_run = text_pixel(px,py,x0,y0,&quot;R&quot;,scale) ||&#xa;                      text_pixel(px,py,x0+12,y0,&quot;U&quot;,scale) ||&#xa;                      text_pixel(px,py,x0+24,y0,&quot;N&quot;,scale);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [23:0] step_color;&#xa;    input integer step_idx;&#xa;    begin&#xa;      case (step_idx[2:0])&#xa;        3'd0: step_color = 24'hE11D48;&#xa;        3'd1: step_color = 24'hF97316;&#xa;        3'd2: step_color = 24'hEAB308;&#xa;        3'd3: step_color = 24'h22C55E;&#xa;        3'd4: step_color = 24'h06B6D4;&#xa;        3'd5: step_color = 24'h2563EB;&#xa;        3'd6: step_color = 24'h7C3AED;&#xa;        default: step_color = 24'hDB2777;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  function segment_hit;&#xa;    input integer sx; input integer sy; input integer ex; input integer ey; input integer width;&#xa;    integer lx; integer hx; integer ly; integer hy;&#xa;    begin&#xa;      if (sx &lt; ex) begin lx = sx; hx = ex; end else begin lx = ex; hx = sx; end&#xa;      if (sy &lt; ey) begin ly = sy; hy = ey; end else begin ly = ey; hy = sy; end&#xa;      segment_hit = (pixel_x >= lx - width) &amp;&amp; (pixel_x &lt;= hx + width) &amp;&amp;&#xa;                    (pixel_y >= ly - width) &amp;&amp; (pixel_y &lt;= hy + width) &amp;&amp;&#xa;                    (((sx == ex) &amp;&amp; (pixel_x >= sx - width) &amp;&amp; (pixel_x &lt;= sx + width)) ||&#xa;                     ((sy == ey) &amp;&amp; (pixel_y >= sy - width) &amp;&amp; (pixel_y &lt;= sy + width)));&#xa;    end&#xa;  endfunction&#xa;&#xa;  always @(*) begin&#xa;    if (active_route_steps &lt;= 4)&#xa;      step_pix = 58;&#xa;    else if (active_route_steps &lt;= 8)&#xa;      step_pix = 44;&#xa;    else if (active_route_steps &lt;= 12)&#xa;      step_pix = 34;&#xa;    else if (active_route_steps &lt;= 18)&#xa;      step_pix = 26;&#xa;    else if (active_route_steps &lt;= 24)&#xa;      step_pix = 20;&#xa;    else&#xa;      step_pix = 16;&#xa;  end&#xa;&#xa;  always @(*) begin&#xa;    old_route_pixel = 1'b0;&#xa;    active_route_pixel = 1'b0;&#xa;    stop_line_pixel = 1'b0;&#xa;    active_route_color = 24'h2563EB;&#xa;    cur_x = 675;&#xa;    cur_y = 370;&#xa;    dir = DIR_UP;&#xa;    target_draw_x = 675 + (target_x - 128) * step_pix;&#xa;    target_draw_y = 370 + (target_y - 128) * step_pix;&#xa;&#xa;    for (i = 0; i &lt; 32; i = i + 1) begin&#xa;      cmd = old_route_info[i*2 +: 2];&#xa;      if (cmd != ROUTE_STOP &amp;&amp; i &lt; completed_route_steps) begin&#xa;        if (cmd == ROUTE_RIGHT) dir = dir + 2'd1;&#xa;        else if (cmd == ROUTE_LEFT) dir = dir - 2'd1;&#xa;        next_x = cur_x;&#xa;        next_y = cur_y;&#xa;        case (dir)&#xa;          DIR_UP:    next_y = cur_y - step_pix;&#xa;          DIR_RIGHT: next_x = cur_x + step_pix;&#xa;          DIR_DOWN:  next_y = cur_y + step_pix;&#xa;          default:   next_x = cur_x - step_pix;&#xa;        endcase&#xa;        if (segment_hit(cur_x, cur_y, next_x, next_y, 2) &amp;&amp; (pixel_x[3] == pixel_y[3]))&#xa;          old_route_pixel = 1'b1;&#xa;        cur_x = next_x;&#xa;        cur_y = next_y;&#xa;      end&#xa;    end&#xa;&#xa;    car_x = cur_x;&#xa;    car_y = cur_y;&#xa;    car_dir = dir;&#xa;&#xa;    for (i = 0; i &lt; 32; i = i + 1) begin&#xa;      cmd = route_info[i*2 +: 2];&#xa;      if (cmd != ROUTE_STOP &amp;&amp; i &lt; active_route_steps) begin&#xa;        if (cmd == ROUTE_RIGHT) dir = dir + 2'd1;&#xa;        else if (cmd == ROUTE_LEFT) dir = dir - 2'd1;&#xa;        next_x = cur_x;&#xa;        next_y = cur_y;&#xa;        case (dir)&#xa;          DIR_UP:    next_y = cur_y - step_pix;&#xa;          DIR_RIGHT: next_x = cur_x + step_pix;&#xa;          DIR_DOWN:  next_y = cur_y + step_pix;&#xa;          default:   next_x = cur_x - step_pix;&#xa;        endcase&#xa;        if (segment_hit(cur_x, cur_y, next_x, next_y, 3)) begin&#xa;          active_route_pixel = 1'b1;&#xa;          active_route_color = step_color(i);&#xa;        end&#xa;        cur_x = next_x;&#xa;        cur_y = next_y;&#xa;      end&#xa;    end&#xa;&#xa;    if (state_stop) begin&#xa;      case (car_dir)&#xa;        DIR_UP:    stop_line_pixel = segment_hit(car_x - 16, car_y - step_pix, car_x + 16, car_y - step_pix, 2);&#xa;        DIR_RIGHT: stop_line_pixel = segment_hit(car_x + step_pix, car_y - 16, car_x + step_pix, car_y + 16, 2);&#xa;        DIR_DOWN:  stop_line_pixel = segment_hit(car_x - 16, car_y + step_pix, car_x + 16, car_y + step_pix, 2);&#xa;        default:   stop_line_pixel = segment_hit(car_x - step_pix, car_y - 16, car_x - step_pix, car_y + 16, 2);&#xa;      endcase&#xa;    end&#xa;  end&#xa;&#xa;  always @(*) begin&#xa;    if (!pixel_de) begin&#xa;      rgb_next = 24'h000000;&#xa;    end else begin&#xa;      rgb_next = 24'hF4F7FB;&#xa;&#xa;      if (status_panel) rgb_next = 24'hFFFFFF;&#xa;      if (menu_panel) rgb_next = 24'hEAF2FF;&#xa;      if (route_panel) rgb_next = 24'hF8FAFC;&#xa;      if (map_area) rgb_next = 24'hFFFFFF;&#xa;      if (grid_line) rgb_next = 24'hE5E7EB;&#xa;&#xa;      if (change_box) rgb_next = change_select ? 24'h1D4ED8 : 24'hFFFFFF;&#xa;      if (run_box) rgb_next = run_select ? 24'h16A34A : 24'hFFFFFF;&#xa;      if (menu_info == MENU_IN_CHANGE &amp;&amp; change_box) rgb_next = 24'h0F172A;&#xa;      if (menu_info == MENU_IN_RUN &amp;&amp; run_box) rgb_next = 24'h0F172A;&#xa;&#xa;      if (old_route_pixel) rgb_next = 24'h6B7280;&#xa;      if (active_route_pixel) rgb_next = active_route_color;&#xa;      if (target_marker) rgb_next = 24'h0891B2;&#xa;      if (car_body) rgb_next = 24'h111827;&#xa;      if (car_arrow) rgb_next = 24'hFACC15;&#xa;      if (stop_line_pixel) rgb_next = 24'hDC2626;&#xa;      if (border_line) rgb_next = 24'h334155;&#xa;&#xa;      if (word_pixel_5(pixel_x,pixel_y,12'd38,12'd34,&quot;S&quot;,&quot;T&quot;,&quot;A&quot;,&quot;T&quot;,&quot;E&quot;)) rgb_next = 24'h111827;&#xa;      if (state_info == STATE_MENU &amp;&amp; word_pixel_5(pixel_x,pixel_y,12'd102,12'd34,&quot;M&quot;,&quot;E&quot;,&quot;N&quot;,&quot;U&quot;,&quot; &quot;)) rgb_next = 24'h2563EB;&#xa;      if (state_info == STATE_CHANGE &amp;&amp; word_pixel_5(pixel_x,pixel_y,12'd102,12'd34,&quot;C&quot;,&quot;H&quot;,&quot;A&quot;,&quot;N&quot;,&quot;G&quot;)) rgb_next = 24'h2563EB;&#xa;      if (state_info == STATE_RUN &amp;&amp; word_pixel_5(pixel_x,pixel_y,12'd102,12'd34,&quot;R&quot;,&quot;U&quot;,&quot;N&quot;,&quot; &quot;,&quot; &quot;)) rgb_next = 24'h16A34A;&#xa;      if (state_info == STATE_STOP &amp;&amp; word_pixel_5(pixel_x,pixel_y,12'd102,12'd34,&quot;S&quot;,&quot;T&quot;,&quot;O&quot;,&quot;P&quot;,&quot; &quot;)) rgb_next = 24'hDC2626;&#xa;&#xa;      if (word_pixel_5(pixel_x,pixel_y,12'd260,12'd30,&quot;T&quot;,&quot;O&quot;,&quot;T&quot;,&quot;A&quot;,&quot;L&quot;)) rgb_next = 24'h111827;&#xa;      if (number3_pixel(pixel_x,pixel_y,12'd322,12'd30,total_route_length)) rgb_next = 24'h111827;&#xa;      if (word_pixel_5(pixel_x,pixel_y,12'd390,12'd30,&quot;D&quot;,&quot;O&quot;,&quot;N&quot;,&quot;E&quot;,&quot; &quot;)) rgb_next = 24'h111827;&#xa;      if (number3_pixel(pixel_x,pixel_y,12'd452,12'd30,complete_route_length)) rgb_next = 24'h111827;&#xa;      if (word_pixel_5(pixel_x,pixel_y,12'd520,12'd30,&quot;L&quot;,&quot;E&quot;,&quot;F&quot;,&quot;T&quot;,&quot; &quot;)) rgb_next = 24'h111827;&#xa;      if (number3_pixel(pixel_x,pixel_y,12'd582,12'd30,remaining_route_length)) rgb_next = 24'h111827;&#xa;      if (word_pixel_5(pixel_x,pixel_y,12'd650,12'd30,&quot;S&quot;,&quot;P&quot;,&quot;E&quot;,&quot;E&quot;,&quot;D&quot;)) rgb_next = 24'h111827;&#xa;      if (number3_pixel(pixel_x,pixel_y,12'd720,12'd30,speed)) rgb_next = 24'h111827;&#xa;&#xa;      if (word_pixel_5(pixel_x,pixel_y,12'd260,12'd70,&quot;N&quot;,&quot;O&quot;,&quot;W&quot;,&quot; &quot;,&quot; &quot;)) rgb_next = 24'h111827;&#xa;      if (text_pixel(pixel_x,pixel_y,12'd320,12'd70,&quot;X&quot;,2) || coord2_pixel(pixel_x,pixel_y,12'd334,12'd70,now_x) ||&#xa;          text_pixel(pixel_x,pixel_y,12'd382,12'd70,&quot;Y&quot;,2) || coord2_pixel(pixel_x,pixel_y,12'd396,12'd70,now_y)) rgb_next = 24'h111827;&#xa;      if (word_pixel_5(pixel_x,pixel_y,12'd520,12'd70,&quot;T&quot;,&quot;A&quot;,&quot;R&quot;,&quot;G&quot;,&quot;T&quot;)) rgb_next = 24'h111827;&#xa;      if (text_pixel(pixel_x,pixel_y,12'd590,12'd70,&quot;X&quot;,2) || coord2_pixel(pixel_x,pixel_y,12'd604,12'd70,target_x) ||&#xa;          text_pixel(pixel_x,pixel_y,12'd652,12'd70,&quot;Y&quot;,2) || coord2_pixel(pixel_x,pixel_y,12'd666,12'd70,target_y)) rgb_next = 24'h111827;&#xa;&#xa;      if (state_stop &amp;&amp; draw_text_change_route(pixel_x,pixel_y,12'd740,12'd70,2)) rgb_next = 24'hDC2626;&#xa;&#xa;      if (change_text) rgb_next = change_select ? 24'hFFFFFF : 24'h1F2937;&#xa;      if (run_text) rgb_next = run_select ? 24'hFFFFFF : 24'h1F2937;&#xa;    end&#xa;  end&#xa;&#xa;  always @(posedge clk_pix or negedge rst_n) begin&#xa;    if (!rst_n)&#xa;      rgb_data &lt;= 24'h000000;&#xa;    else&#xa;      rgb_data &lt;= rgb_next;&#xa;  end&#xa;" Color="antiquewhite" Comment="" Height="955" Name="gui_route_renderer1" Parameters="" Parent="gui_route_test_top" Type="model" Width="706" X="808.123" Y="233.334">
  <Port Color="#faebd7" Connect="" Datasize="12" Datatype="wire" Description="" Height="30" Inout="input" Name="pixel_x" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.672251"/>
  <Port Color="#00ffff" Connect="" Datasize="12" Datatype="wire" Description="" Height="30" Inout="input" Name="pixel_y" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.748691"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="pixel_de" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.825131"/>
  <Port Color="#f5f5dc" Connect="" Datasize="64" Datatype="wire" Description="" Height="30" Inout="input" Name="route_info" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.901571"/>
  <Port Color="#ffe4c4" Connect="" Datasize="24" Datatype="reg" Description="" Height="30" Inout="output" Name="rgb_data" Parent="gui_route_renderer1" Side="right" Width="30" X="0.957507" Y="0.48377"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_pix" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.595812"/>
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.519372"/>
  <Port Color="#f0ffff" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="menu_info" Parent="gui_route_renderer1" Side="top" Width="30" X="0.0892351" Y="-0.0314136"/>
  <Port Color="#0000ff" Connect="" Datasize="5" Datatype="wire" Description="" Height="30" Inout="input" Name="state_info" Parent="gui_route_renderer1" Side="top" Width="30" X="0.199717" Y="-0.0314136"/>
  <Port Color="#8a2be2" Connect="" Datasize="64" Datatype="wire" Description="" Height="30" Inout="input" Name="old_route_info" Parent="gui_route_renderer1" Side="top" Width="30" X="0.310198" Y="-0.0314136"/>
  <Port Color="#a52a2a" Connect="" Datasize="6" Datatype="wire" Description="" Height="30" Inout="input" Name="active_route_steps" Parent="gui_route_renderer1" Side="top" Width="30" X="0.42068" Y="-0.0314136"/>
  <Port Color="#deb887" Connect="" Datasize="6" Datatype="wire" Description="" Height="30" Inout="input" Name="completed_route_steps" Parent="gui_route_renderer1" Side="top" Width="30" X="0.531161" Y="-0.0314136"/>
  <Port Color="#5f9ea0" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="step_length" Parent="gui_route_renderer1" Side="top" Width="30" X="0.641643" Y="-0.0314136"/>
  <Port Color="#7fff00" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="speed" Parent="gui_route_renderer1" Side="top" Width="30" X="0.752125" Y="-0.0314136"/>
  <Port Color="#d2691e" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="total_route_length" Parent="gui_route_renderer1" Side="top" Width="30" X="0.862606" Y="-0.0314136"/>
  <Port Color="#ff7f50" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="complete_route_length" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.060733"/>
  <Port Color="#6495ed" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="remaining_route_length" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.137173"/>
  <Port Color="#fff8dc" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="output" Name="now_x" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.213613"/>
  <Port Color="#dc143c" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="output" Name="now_y" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.290052"/>
  <Port Color="#00ffff" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="output" Name="target_x" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.366492"/>
  <Port Color="#00008b" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="output" Name="target_y" Parent="gui_route_renderer1" Side="left" Width="30" X="-0.0424929" Y="0.442932"/>
 </Module>
 <Module Category="Current" Class="hdmi_top" Code="&#xa;&#xa;" Color="aqua" Comment="" Height="751" Name="hdmi_top2" Parameters="" Parent="gui_route_test_top" Type="model" Width="493" X="1622.04" Y="357.532">
