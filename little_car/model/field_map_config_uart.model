 <Port Color="#ffe4c4" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="pose_x_cell" Parent="field_map_config_uart" Side="right" Width="30" X="0.98125" Y="0.3"/>
