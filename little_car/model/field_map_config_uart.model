<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  parameter integer CLK_HZ = 50000000;&#xa;  parameter integer BAUD = 115200;&#xa;  localparam integer CLKS_PER_BIT = CLK_HZ / BAUD;&#xa;  localparam integer FRAME_TIMEOUT_CYCLES = CLK_HZ / 10;&#xa;  localparam [1:0] RX_IDLE = 2'd0;&#xa;  localparam [1:0] RX_START = 2'd1;&#xa;  localparam [1:0] RX_DATA = 2'd2;&#xa;  localparam [1:0] RX_STOP = 2'd3;&#xa;&#xa;  reg [1:0] rx_sync;&#xa;  reg [1:0] rx_state;&#xa;  reg [15:0] rx_clock_count;&#xa;  reg [2:0] rx_bit_index;&#xa;  reg [7:0] rx_shift;&#xa;  reg [7:0] rx_data;&#xa;  reg rx_valid;&#xa;&#xa;  reg frame_active;&#xa;  reg [4:0] frame_index;&#xa;  reg [22:0] frame_timeout_count;&#xa;  reg [7:0] next_pose_x;&#xa;  reg [7:0] next_pose_y;&#xa;  reg [11:0] next_heading;&#xa;  reg [7:0] next_low_x;&#xa;  reg [7:0] next_high_x;&#xa;  reg [7:0] next_low_y;&#xa;  reg [7:0] next_high_y;&#xa;&#xa;  &#xa;  &#xa;  &#xa;  function nibble_valid;&#xa;    input [7:0] value;&#xa;    begin&#xa;      case (value)&#xa;        &quot;!&quot;, &quot;#&quot;, &quot;$&quot;, &quot;%&quot;, &quot;&amp;&quot;, &quot;'&quot;, &quot;(&quot;, &quot;)&quot;,&#xa;        &quot;*&quot;, &quot;,&quot;, &quot;.&quot;, &quot;/&quot;, &quot;:&quot;, &quot;;&quot;, &quot;&lt;&quot;, &quot;&gt;&quot;: nibble_valid = 1'b1;&#xa;        default: nibble_valid = 1'b0;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [3:0] decode_nibble;&#xa;    input [7:0] value;&#xa;    begin&#xa;      case (value)&#xa;        &quot;!&quot;: decode_nibble = 4'h0;&#xa;        &quot;#&quot;: decode_nibble = 4'h1;&#xa;        &quot;$&quot;: decode_nibble = 4'h2;&#xa;        &quot;%&quot;: decode_nibble = 4'h3;&#xa;        &quot;&amp;&quot;: decode_nibble = 4'h4;&#xa;        &quot;'&quot;: decode_nibble = 4'h5;&#xa;        &quot;(&quot;: decode_nibble = 4'h6;&#xa;        &quot;)&quot;: decode_nibble = 4'h7;&#xa;        &quot;*&quot;: decode_nibble = 4'h8;&#xa;        &quot;,&quot;: decode_nibble = 4'h9;&#xa;        &quot;.&quot;: decode_nibble = 4'ha;&#xa;        &quot;/&quot;: decode_nibble = 4'hb;&#xa;        &quot;:&quot;: decode_nibble = 4'hc;&#xa;        &quot;;&quot;: decode_nibble = 4'hd;&#xa;        &quot;&lt;&quot;: decode_nibble = 4'he;&#xa;        default: decode_nibble = 4'hf;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      rx_sync &lt;= 2'b11;&#xa;      rx_state &lt;= RX_IDLE;&#xa;      rx_clock_count &lt;= 16'd0;&#xa;      rx_bit_index &lt;= 3'd0;&#xa;      rx_shift &lt;= 8'd0;&#xa;      rx_data &lt;= 8'd0;&#xa;      rx_valid &lt;= 1'b0;&#xa;    end else begin&#xa;      rx_sync &lt;= {rx_sync[0], bt_uart_rx};&#xa;      rx_valid &lt;= 1'b0;&#xa;      case (rx_state)&#xa;        RX_IDLE: begin&#xa;          rx_clock_count &lt;= 16'd0;&#xa;          rx_bit_index &lt;= 3'd0;&#xa;          if (!rx_sync[1]) rx_state &lt;= RX_START;&#xa;        end&#xa;        RX_START: begin&#xa;          if (rx_clock_count == CLKS_PER_BIT / 2) begin&#xa;            rx_clock_count &lt;= 16'd0;&#xa;            rx_state &lt;= !rx_sync[1] ? RX_DATA : RX_IDLE;&#xa;          end else rx_clock_count &lt;= rx_clock_count + 16'd1;&#xa;        end&#xa;        RX_DATA: begin&#xa;          if (rx_clock_count == CLKS_PER_BIT - 1) begin&#xa;            rx_clock_count &lt;= 16'd0;&#xa;            rx_shift[rx_bit_index] &lt;= rx_sync[1];&#xa;            if (rx_bit_index == 3'd7) begin&#xa;              rx_bit_index &lt;= 3'd0;&#xa;              rx_state &lt;= RX_STOP;&#xa;            end else rx_bit_index &lt;= rx_bit_index + 3'd1;&#xa;          end else rx_clock_count &lt;= rx_clock_count + 16'd1;&#xa;        end&#xa;        default: begin&#xa;          if (rx_clock_count == CLKS_PER_BIT - 1) begin&#xa;            rx_clock_count &lt;= 16'd0;&#xa;            rx_data &lt;= rx_shift;&#xa;            rx_valid &lt;= rx_sync[1];&#xa;            rx_state &lt;= RX_IDLE;&#xa;          end else rx_clock_count &lt;= rx_clock_count + 16'd1;&#xa;        end&#xa;      endcase&#xa;    end&#xa;  end&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      config_valid &lt;= 1'b0;&#xa;      config_update_pulse &lt;= 1'b0;&#xa;      pose_x_cell &lt;= 8'd64;&#xa;      pose_y_cell &lt;= 8'd64;&#xa;      heading_1024 &lt;= 10'd0;&#xa;      low_x_cell &lt;= 8'd9;&#xa;      high_x_cell &lt;= 8'd119;&#xa;      low_y_cell &lt;= 8'd9;&#xa;      high_y_cell &lt;= 8'd119;&#xa;      frame_active &lt;= 1'b0;&#xa;      frame_index &lt;= 5'd0;&#xa;      frame_timeout_count &lt;= 23'd0;&#xa;      next_pose_x &lt;= 8'd0;&#xa;      next_pose_y &lt;= 8'd0;&#xa;      next_heading &lt;= 12'd0;&#xa;      next_low_x &lt;= 8'd0;&#xa;      next_high_x &lt;= 8'd0;&#xa;      next_low_y &lt;= 8'd0;&#xa;      next_high_y &lt;= 8'd0;&#xa;    end else begin&#xa;      config_update_pulse &lt;= 1'b0;&#xa;      if (frame_active) begin&#xa;        if (frame_timeout_count &gt;= FRAME_TIMEOUT_CYCLES - 1) begin&#xa;          frame_active &lt;= 1'b0;&#xa;          frame_index &lt;= 5'd0;&#xa;          frame_timeout_count &lt;= 23'd0;&#xa;        end else frame_timeout_count &lt;= frame_timeout_count + 23'd1;&#xa;      end&#xa;      if (rx_valid) begin&#xa;        frame_timeout_count &lt;= 23'd0;&#xa;        if (rx_data == &quot;{&quot;) begin&#xa;          frame_active &lt;= 1'b1;&#xa;          frame_index &lt;= 5'd0;&#xa;          next_pose_x &lt;= 8'd0;&#xa;          next_pose_y &lt;= 8'd0;&#xa;          next_heading &lt;= 12'd0;&#xa;          next_low_x &lt;= 8'd0;&#xa;          next_high_x &lt;= 8'd0;&#xa;          next_low_y &lt;= 8'd0;&#xa;          next_high_y &lt;= 8'd0;&#xa;        end else if (frame_active &amp;&amp; frame_index == 5'd15 &amp;&amp; rx_data == &quot;}&quot;) begin&#xa;          frame_active &lt;= 1'b0;&#xa;          frame_index &lt;= 5'd0;&#xa;          if (next_heading &lt;= 12'd1023 &amp;&amp; next_low_x &lt; next_high_x &amp;&amp;&#xa;              next_low_y &lt; next_high_y &amp;&amp; next_high_x &lt; 8'd128 &amp;&amp;&#xa;              next_high_y &lt; 8'd128) begin&#xa;            pose_x_cell &lt;= next_pose_x;&#xa;            pose_y_cell &lt;= next_pose_y;&#xa;            heading_1024 &lt;= next_heading[9:0];&#xa;            low_x_cell &lt;= next_low_x;&#xa;            high_x_cell &lt;= next_high_x;&#xa;            low_y_cell &lt;= next_low_y;&#xa;            high_y_cell &lt;= next_high_y;&#xa;            config_valid &lt;= 1'b1;&#xa;            config_update_pulse &lt;= 1'b1;&#xa;          end&#xa;        end else if (frame_active &amp;&amp; frame_index &lt; 5'd15 &amp;&amp; nibble_valid(rx_data)) begin&#xa;          case (frame_index)&#xa;            5'd0, 5'd1: next_pose_x &lt;= {next_pose_x[3:0], decode_nibble(rx_data)};&#xa;            5'd2, 5'd3: next_pose_y &lt;= {next_pose_y[3:0], decode_nibble(rx_data)};&#xa;            5'd4, 5'd5, 5'd6: next_heading &lt;= {next_heading[7:0], decode_nibble(rx_data)};&#xa;            5'd7, 5'd8: next_low_x &lt;= {next_low_x[3:0], decode_nibble(rx_data)};&#xa;            5'd9, 5'd10: next_high_x &lt;= {next_high_x[3:0], decode_nibble(rx_data)};&#xa;            5'd11, 5'd12: next_low_y &lt;= {next_low_y[3:0], decode_nibble(rx_data)};&#xa;            default: next_high_y &lt;= {next_high_y[3:0], decode_nibble(rx_data)};&#xa;          endcase&#xa;          frame_index &lt;= frame_index + 5'd1;&#xa;        end else if (frame_active) begin&#xa;          frame_active &lt;= 1'b0;&#xa;          frame_index &lt;= 5'd0;&#xa;        end&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="field_map_config_uart" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="field_map_config_uart" Side="left" Width="30" X="-0.01875" Y="0.2"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="field_map_config_uart" Side="left" Width="30" X="-0.01875" Y="0.5"/>
