<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="`ifdef UWB_DEBUG_SIM_FAST&#xa;  localparam integer REPORT_PERIOD_CLKS = 50;&#xa;  localparam integer CLKS_PER_BIT = 4;&#xa;`else&#xa;  localparam integer REPORT_PERIOD_CLKS = 25000000;&#xa;  localparam integer CLKS_PER_BIT = 434;&#xa;`endif&#xa;  localparam [5:0] LINE_LENGTH = 6'd26;&#xa;&#xa;  function [7:0] hex_ascii;&#xa;    input [3:0] value;&#xa;    begin&#xa;      if (value &lt; 4'd10)&#xa;        hex_ascii = 8'h30 + value;&#xa;      else&#xa;        hex_ascii = 8'h41 + value - 4'd10;&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [7:0] report_byte;&#xa;    input [5:0] index;&#xa;    input [15:0] rx_packets;&#xa;    input [15:0] crc_errors;&#xa;    input [15:0] tx_packets;&#xa;    input link_online;&#xa;    input ack_valid;&#xa;    input [7:0] ack_sequence;&#xa;    input [1:0] ack_result;&#xa;    begin&#xa;      case (index)&#xa;        6'd0:  report_byte = &quot;@&quot;;&#xa;        6'd1:  report_byte = &quot;U&quot;;&#xa;        6'd2:  report_byte = hex_ascii(rx_packets[15:12]);&#xa;        6'd3:  report_byte = hex_ascii(rx_packets[11:8]);&#xa;        6'd4:  report_byte = hex_ascii(rx_packets[7:4]);&#xa;        6'd5:  report_byte = hex_ascii(rx_packets[3:0]);&#xa;        6'd6:  report_byte = &quot;,&quot;;&#xa;        6'd7:  report_byte = hex_ascii(crc_errors[15:12]);&#xa;        6'd8:  report_byte = hex_ascii(crc_errors[11:8]);&#xa;        6'd9:  report_byte = hex_ascii(crc_errors[7:4]);&#xa;        6'd10: report_byte = hex_ascii(crc_errors[3:0]);&#xa;        6'd11: report_byte = &quot;,&quot;;&#xa;        6'd12: report_byte = hex_ascii(tx_packets[15:12]);&#xa;        6'd13: report_byte = hex_ascii(tx_packets[11:8]);&#xa;        6'd14: report_byte = hex_ascii(tx_packets[7:4]);&#xa;        6'd15: report_byte = hex_ascii(tx_packets[3:0]);&#xa;        6'd16: report_byte = &quot;,&quot;;&#xa;        6'd17: report_byte = link_online ? &quot;1&quot; : &quot;0&quot;;&#xa;        6'd18: report_byte = &quot;,&quot;;&#xa;        6'd19: report_byte = ack_valid ? &quot;1&quot; : &quot;0&quot;;&#xa;        6'd20: report_byte = &quot;,&quot;;&#xa;        6'd21: report_byte = hex_ascii(ack_sequence[7:4]);&#xa;        6'd22: report_byte = hex_ascii(ack_sequence[3:0]);&#xa;        6'd23: report_byte = &quot;,&quot;;&#xa;        6'd24: report_byte = &quot;0&quot; + ack_result;&#xa;        default: report_byte = 8'h0A;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  &#xa;  &#xa;  reg [15:0] snapshot_rx_packets;&#xa;  reg [15:0] snapshot_crc_errors;&#xa;  reg [15:0] snapshot_tx_packets;&#xa;  reg snapshot_link_online;&#xa;  reg snapshot_ack_valid;&#xa;  reg [7:0] snapshot_ack_sequence;&#xa;  reg [1:0] snapshot_ack_result;&#xa;&#xa;  reg [24:0] report_clock_count;&#xa;  reg report_sending;&#xa;  reg [5:0] report_char_index;&#xa;  reg [7:0] tx_data;&#xa;  reg tx_start;&#xa;&#xa;  reg tx_busy;&#xa;  reg [8:0] tx_clock_count;&#xa;  reg [3:0] tx_bit_index;&#xa;  reg [7:0] tx_shift;&#xa;&#xa;  &#xa;  &#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      uart_tx &lt;= 1'b1;&#xa;      tx_busy &lt;= 1'b0;&#xa;      tx_clock_count &lt;= 9'd0;&#xa;      tx_bit_index &lt;= 4'd0;&#xa;      tx_shift &lt;= 8'd0;&#xa;    end else if (!tx_busy) begin&#xa;      uart_tx &lt;= 1'b1;&#xa;      tx_clock_count &lt;= 9'd0;&#xa;      tx_bit_index &lt;= 4'd0;&#xa;      if (tx_start) begin&#xa;        uart_tx &lt;= 1'b0;&#xa;        tx_busy &lt;= 1'b1;&#xa;        tx_shift &lt;= tx_data;&#xa;      end&#xa;    end else if (tx_clock_count &gt;= CLKS_PER_BIT - 1) begin&#xa;      tx_clock_count &lt;= 9'd0;&#xa;      if (tx_bit_index &lt; 4'd8) begin&#xa;        uart_tx &lt;= tx_shift[tx_bit_index];&#xa;        tx_bit_index &lt;= tx_bit_index + 4'd1;&#xa;      end else if (tx_bit_index == 4'd8) begin&#xa;        uart_tx &lt;= 1'b1;&#xa;        tx_bit_index &lt;= 4'd9;&#xa;      end else begin&#xa;        uart_tx &lt;= 1'b1;&#xa;        tx_busy &lt;= 1'b0;&#xa;      end&#xa;    end else begin&#xa;      tx_clock_count &lt;= tx_clock_count + 9'd1;&#xa;    end&#xa;  end&#xa;&#xa;  &#xa;  &#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      snapshot_rx_packets &lt;= 16'd0;&#xa;      snapshot_crc_errors &lt;= 16'd0;&#xa;      snapshot_tx_packets &lt;= 16'd0;&#xa;      snapshot_link_online &lt;= 1'b0;&#xa;      snapshot_ack_valid &lt;= 1'b0;&#xa;      snapshot_ack_sequence &lt;= 8'd0;&#xa;      snapshot_ack_result &lt;= 2'd0;&#xa;      report_clock_count &lt;= 25'd0;&#xa;      report_sending &lt;= 1'b0;&#xa;      report_char_index &lt;= 6'd0;&#xa;      tx_data &lt;= 8'd0;&#xa;      tx_start &lt;= 1'b0;&#xa;    end else begin&#xa;      tx_start &lt;= 1'b0;&#xa;&#xa;      if (report_clock_count &gt;= REPORT_PERIOD_CLKS - 1) begin&#xa;        if (!report_sending) begin&#xa;          snapshot_rx_packets &lt;= rx_packet_count;&#xa;          snapshot_crc_errors &lt;= rx_crc_error_count;&#xa;          snapshot_tx_packets &lt;= tx_packet_count;&#xa;          snapshot_link_online &lt;= uwb_link_online;&#xa;          snapshot_ack_valid &lt;= debug_last_ack_valid;&#xa;          snapshot_ack_sequence &lt;= debug_last_sequence;&#xa;          snapshot_ack_result &lt;= debug_last_result;&#xa;          report_clock_count &lt;= 25'd0;&#xa;          report_sending &lt;= 1'b1;&#xa;          report_char_index &lt;= 6'd0;&#xa;        end&#xa;      end else begin&#xa;        report_clock_count &lt;= report_clock_count + 25'd1;&#xa;      end&#xa;&#xa;      if (report_sending &amp;&amp; !tx_busy &amp;&amp; !tx_start) begin&#xa;        if (report_char_index &lt; LINE_LENGTH) begin&#xa;          tx_data &lt;= report_byte(&#xa;              report_char_index,&#xa;              snapshot_rx_packets,&#xa;              snapshot_crc_errors,&#xa;              snapshot_tx_packets,&#xa;              snapshot_link_online,&#xa;              snapshot_ack_valid,&#xa;              snapshot_ack_sequence,&#xa;              snapshot_ack_result);&#xa;          tx_start &lt;= 1'b1;&#xa;          report_char_index &lt;= report_char_index + 6'd1;&#xa;        end else begin&#xa;          report_sending &lt;= 1'b0;&#xa;        end&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="uwb_debug_uart" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.1"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.2"/>
 <Port Color="#7fffd4" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="rx_packet_count" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.3"/>
 <Port Color="#f0ffff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="rx_crc_error_count" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.4"/>
 <Port Color="#f5f5dc" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="tx_packet_count" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.5"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_link_online" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.6"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="debug_last_ack_valid" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.7"/>
 <Port Color="#ffebcd" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="debug_last_sequence" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.8"/>
 <Port Color="#0000ff" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="debug_last_result" Parent="uwb_debug_uart" Side="left" Width="30" X="-0.01875" Y="0.9"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="uart_tx" Parent="uwb_debug_uart" Side="right" Width="30" X="0.98125" Y="0.5"/>
</Module>
