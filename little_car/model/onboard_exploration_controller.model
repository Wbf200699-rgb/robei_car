<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="parameter integer CLK_HZ = 50000000;&#xa;&#xa;  localparam [2:0] CMD_STOP    = 3'd0;&#xa;  localparam [2:0] CMD_FORWARD = 3'd1;&#xa;  localparam [2:0] CMD_REVERSE = 3'd2;&#xa;  localparam [2:0] CMD_LEFT    = 3'd3;&#xa;  localparam [2:0] CMD_RIGHT   = 3'd4;&#xa;&#xa;  localparam [3:0] EXP_STOP    = 4'd0;&#xa;  localparam [3:0] EXP_DECIDE  = 4'd1;&#xa;  localparam [3:0] EXP_FORWARD = 4'd2;&#xa;  localparam [3:0] EXP_REVERSE = 4'd3;&#xa;  localparam [3:0] EXP_LEFT    = 4'd4;&#xa;  localparam [3:0] EXP_RIGHT   = 4'd5;&#xa;  localparam [3:0] EXP_SETTLE  = 4'd6;&#xa;&#xa;  localparam [3:0] STOP_NONE       = 4'd0;&#xa;  localparam [3:0] STOP_NOT_ARMED  = 4'd1;&#xa;  localparam [3:0] STOP_CALIBRATION = 4'd2;&#xa;  localparam [3:0] STOP_LIDAR      = 4'd3;&#xa;  localparam [3:0] STOP_SCAN_STALE = 4'd4;&#xa;&#xa;`ifdef ONBOARD_EXPLORATION_SIM_FAST&#xa;  localparam integer MS_DIVISOR = 4;&#xa;  localparam [15:0] FORWARD_MS = 16'd12;&#xa;  localparam [15:0] REVERSE_MS = 16'd8;&#xa;  localparam [15:0] TURN_MS = 16'd10;&#xa;  localparam [15:0] SETTLE_MS = 16'd4;&#xa;  localparam [15:0] SCAN_TIMEOUT_MS = 16'd25;&#xa;`else&#xa;  localparam integer MS_DIVISOR = CLK_HZ / 1000;&#xa;  // Bound blind travel to one short lease. EXP_SETTLE still requires a scan&#xa;  // captured after the stop before the next movement is selected.&#xa;  localparam [15:0] FORWARD_MS = 16'd90;&#xa;  localparam [15:0] REVERSE_MS = 16'd120;&#xa;  localparam [15:0] TURN_MS = 16'd300;&#xa;  localparam [15:0] SETTLE_MS = 16'd650;&#xa;  localparam [15:0] SCAN_TIMEOUT_MS = 16'd1000;&#xa;`endif&#xa;&#xa;  localparam [15:0] MAP_LOW_LIMIT_MM = 16'd450;&#xa;  localparam [15:0] MAP_HIGH_LIMIT_MM = 16'd5950;&#xa;&#xa;  reg [31:0] ms_divider;&#xa;  reg [15:0] action_ms;&#xa;  reg [15:0] scan_age_ms;&#xa;  reg turn_right_preferred;&#xa;  reg settle_scan_seen;&#xa;&#xa;  wire request_active = map_active &amp;&amp; !map_paused &amp;&amp; !manual_mode;&#xa;  wire sensors_ready = sensor_calibration_done &amp;&amp; gyro_polarity_valid;&#xa;  wire lidar_ready = lidar_online &amp;&amp; scan_active;&#xa;  wire scan_fresh = scan_age_ms &lt; SCAN_TIMEOUT_MS;&#xa;  assign auto_mode = request_active;&#xa;&#xa;  function distance_below;&#xa;    input [15:0] distance;&#xa;    input [15:0] threshold;&#xa;    begin&#xa;      distance_below = (distance != 16'hffff) &amp;&amp;&#xa;                       (distance &gt;= 16'd50) &amp;&amp;&#xa;                       (distance &lt; threshold);&#xa;    end&#xa;  endfunction&#xa;&#xa;  function [15:0] clearance_value;&#xa;    input [15:0] distance;&#xa;    begin&#xa;      clearance_value = (distance == 16'hffff) ? 16'hfffe : distance;&#xa;    end&#xa;  endfunction&#xa;&#xa;  wire [15:0] front_threshold = safe_distance_mm + 16'd120;&#xa;  wire front_data_valid = (sector_front_mm != 16'hffff) ||&#xa;      (sector_front_left_mm != 16'hffff) ||&#xa;      (sector_front_right_mm != 16'hffff);&#xa;  wire front_blocked = !front_data_valid || obstacle_stop ||&#xa;      distance_below(sector_front_mm, front_threshold) ||&#xa;      distance_below(sector_front_left_mm, safe_distance_mm) ||&#xa;      distance_below(sector_front_right_mm, safe_distance_mm);&#xa;  wire rear_blocked = distance_below(sector_rear_mm, safe_distance_mm) ||&#xa;      distance_below(sector_rear_left_mm, safe_distance_mm) ||&#xa;      distance_below(sector_rear_right_mm, safe_distance_mm);&#xa;  wire [15:0] left_clearance =&#xa;      (clearance_value(sector_left_mm) &lt; clearance_value(sector_front_left_mm)) ?&#xa;      clearance_value(sector_left_mm) : clearance_value(sector_front_left_mm);&#xa;  wire [15:0] right_clearance =&#xa;      (clearance_value(sector_right_mm) &lt; clearance_value(sector_front_right_mm)) ?&#xa;      clearance_value(sector_right_mm) : clearance_value(sector_front_right_mm);&#xa;  &#xa;  &#xa;  &#xa;  wire left_turn_blocked =&#xa;      distance_below(sector_front_left_mm, front_threshold) ||&#xa;      distance_below(sector_left_mm, safe_distance_mm) ||&#xa;      distance_below(sector_rear_right_mm, safe_distance_mm);&#xa;  wire right_turn_blocked =&#xa;      distance_below(sector_front_right_mm, front_threshold) ||&#xa;      distance_below(sector_right_mm, safe_distance_mm) ||&#xa;      distance_below(sector_rear_left_mm, safe_distance_mm);&#xa;&#xa;  &#xa;  &#xa;  &#xa;  &#xa;  wire [15:0] field_low_x_ext = {8'd0, field_low_x_cell};&#xa;  wire [15:0] field_high_x_ext = {8'd0, field_high_x_cell};&#xa;  wire [15:0] field_low_y_ext = {8'd0, field_low_y_cell};&#xa;  wire [15:0] field_high_y_ext = {8'd0, field_high_y_cell};&#xa;  wire [15:0] field_low_x_mm = (field_low_x_ext &lt;&lt; 5) +&#xa;      (field_low_x_ext &lt;&lt; 4) + (field_low_x_ext &lt;&lt; 1);&#xa;  wire [15:0] field_high_x_mm = (field_high_x_ext &lt;&lt; 5) +&#xa;      (field_high_x_ext &lt;&lt; 4) + (field_high_x_ext &lt;&lt; 1);&#xa;  wire [15:0] field_low_y_mm = (field_low_y_ext &lt;&lt; 5) +&#xa;      (field_low_y_ext &lt;&lt; 4) + (field_low_y_ext &lt;&lt; 1);&#xa;  wire [15:0] field_high_y_mm = (field_high_y_ext &lt;&lt; 5) +&#xa;      (field_high_y_ext &lt;&lt; 4) + (field_high_y_ext &lt;&lt; 1);&#xa;  wire local_map_boundary_ahead =&#xa;      ((pose_heading &lt; 10'd128 || pose_heading &gt;= 10'd896) &amp;&amp;&#xa;       pose_x_mm &gt;= MAP_HIGH_LIMIT_MM) ||&#xa;      ((pose_heading &gt;= 10'd128 &amp;&amp; pose_heading &lt; 10'd384) &amp;&amp;&#xa;       pose_y_mm &gt;= MAP_HIGH_LIMIT_MM) ||&#xa;      ((pose_heading &gt;= 10'd384 &amp;&amp; pose_heading &lt; 10'd640) &amp;&amp;&#xa;       pose_x_mm &lt;= MAP_LOW_LIMIT_MM) ||&#xa;      ((pose_heading &gt;= 10'd640 &amp;&amp; pose_heading &lt; 10'd896) &amp;&amp;&#xa;       pose_y_mm &lt;= MAP_LOW_LIMIT_MM);&#xa;  wire configured_boundary_ahead =&#xa;      ((pose_heading &lt; 10'd128 || pose_heading &gt;= 10'd896) &amp;&amp;&#xa;       pose_x_mm &gt;= field_high_x_mm) ||&#xa;      ((pose_heading &gt;= 10'd128 &amp;&amp; pose_heading &lt; 10'd384) &amp;&amp;&#xa;       pose_y_mm &gt;= field_high_y_mm) ||&#xa;      ((pose_heading &gt;= 10'd384 &amp;&amp; pose_heading &lt; 10'd640) &amp;&amp;&#xa;       pose_x_mm &lt;= field_low_x_mm) ||&#xa;      ((pose_heading &gt;= 10'd640 &amp;&amp; pose_heading &lt; 10'd896) &amp;&amp;&#xa;       pose_y_mm &lt;= field_low_y_mm);&#xa;  wire boundary_ahead = field_config_valid ?&#xa;      configured_boundary_ahead : local_map_boundary_ahead;&#xa;&#xa;  wire millisecond_tick = (ms_divider &gt;= MS_DIVISOR - 1);&#xa;&#xa;  always @* begin&#xa;    case (exploration_state)&#xa;      EXP_FORWARD: auto_cmd = CMD_FORWARD;&#xa;      EXP_REVERSE: auto_cmd = CMD_REVERSE;&#xa;      EXP_LEFT: auto_cmd = CMD_LEFT;&#xa;      EXP_RIGHT: auto_cmd = CMD_RIGHT;&#xa;      default: auto_cmd = CMD_STOP;&#xa;    endcase&#xa;  end&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      ms_divider &lt;= 32'd0;&#xa;      action_ms &lt;= 16'd0;&#xa;      scan_age_ms &lt;= SCAN_TIMEOUT_MS;&#xa;      turn_right_preferred &lt;= 1'b0;&#xa;      settle_scan_seen &lt;= 1'b0;&#xa;      exploration_state &lt;= EXP_STOP;&#xa;      stop_reason &lt;= STOP_NOT_ARMED;&#xa;    end else begin&#xa;      if (lidar_new_scan) begin&#xa;        scan_age_ms &lt;= 16'd0;&#xa;        if (exploration_state == EXP_SETTLE)&#xa;          settle_scan_seen &lt;= 1'b1;&#xa;      end&#xa;&#xa;      if (millisecond_tick) begin&#xa;        ms_divider &lt;= 32'd0;&#xa;        if (!lidar_new_scan &amp;&amp; scan_age_ms != 16'hffff)&#xa;          scan_age_ms &lt;= scan_age_ms + 16'd1;&#xa;        if (action_ms != 16'd0)&#xa;          action_ms &lt;= action_ms - 16'd1;&#xa;&#xa;        if (!request_active) begin&#xa;          exploration_state &lt;= EXP_STOP;&#xa;          action_ms &lt;= 16'd0;&#xa;          stop_reason &lt;= STOP_NOT_ARMED;&#xa;        end else if (!sensors_ready) begin&#xa;          exploration_state &lt;= EXP_STOP;&#xa;          action_ms &lt;= 16'd0;&#xa;          stop_reason &lt;= STOP_CALIBRATION;&#xa;        end else if (!lidar_ready) begin&#xa;          exploration_state &lt;= EXP_STOP;&#xa;          action_ms &lt;= 16'd0;&#xa;          stop_reason &lt;= STOP_LIDAR;&#xa;        end else if (!scan_fresh) begin&#xa;          exploration_state &lt;= EXP_STOP;&#xa;          action_ms &lt;= 16'd0;&#xa;          stop_reason &lt;= STOP_SCAN_STALE;&#xa;        end else begin&#xa;          stop_reason &lt;= STOP_NONE;&#xa;          case (exploration_state)&#xa;            EXP_STOP, EXP_DECIDE: begin&#xa;              if (front_blocked || boundary_ahead) begin&#xa;                turn_right_preferred &lt;= right_clearance &gt; left_clearance;&#xa;                if (!rear_blocked) begin&#xa;                  exploration_state &lt;= EXP_REVERSE;&#xa;                  action_ms &lt;= REVERSE_MS;&#xa;                end else if (!right_turn_blocked &amp;&amp;&#xa;                             (left_turn_blocked || right_clearance &gt; left_clearance)) begin&#xa;                  exploration_state &lt;= EXP_RIGHT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else if (!left_turn_blocked) begin&#xa;                  exploration_state &lt;= EXP_LEFT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else begin&#xa;                  exploration_state &lt;= EXP_SETTLE;&#xa;                  action_ms &lt;= SETTLE_MS;&#xa;                end&#xa;              end else begin&#xa;                exploration_state &lt;= EXP_FORWARD;&#xa;                action_ms &lt;= FORWARD_MS;&#xa;              end&#xa;            end&#xa;&#xa;            EXP_FORWARD: begin&#xa;              if (front_blocked || boundary_ahead) begin&#xa;                exploration_state &lt;= EXP_SETTLE;&#xa;                action_ms &lt;= SETTLE_MS;&#xa;                settle_scan_seen &lt;= 1'b0;&#xa;                turn_right_preferred &lt;= right_clearance &gt; left_clearance;&#xa;              end else if (action_ms == 16'd0) begin&#xa;                exploration_state &lt;= EXP_SETTLE;&#xa;                action_ms &lt;= SETTLE_MS;&#xa;                settle_scan_seen &lt;= 1'b0;&#xa;              end&#xa;            end&#xa;&#xa;            EXP_REVERSE: begin&#xa;              if (action_ms == 16'd0 || rear_blocked) begin&#xa;                if (turn_right_preferred &amp;&amp; !right_turn_blocked) begin&#xa;                  exploration_state &lt;= EXP_RIGHT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else if (!left_turn_blocked) begin&#xa;                  exploration_state &lt;= EXP_LEFT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else if (!right_turn_blocked) begin&#xa;                  exploration_state &lt;= EXP_RIGHT;&#xa;                  action_ms &lt;= TURN_MS;&#xa;                end else begin&#xa;                  exploration_state &lt;= EXP_SETTLE;&#xa;                  action_ms &lt;= SETTLE_MS;&#xa;                  settle_scan_seen &lt;= 1'b0;&#xa;                end&#xa;              end&#xa;            end&#xa;&#xa;            EXP_LEFT, EXP_RIGHT: begin&#xa;              if (action_ms == 16'd0 ||&#xa;                  (exploration_state == EXP_LEFT &amp;&amp; left_turn_blocked) ||&#xa;                  (exploration_state == EXP_RIGHT &amp;&amp; right_turn_blocked)) begin&#xa;                exploration_state &lt;= EXP_SETTLE;&#xa;                action_ms &lt;= SETTLE_MS;&#xa;                settle_scan_seen &lt;= 1'b0;&#xa;              end&#xa;            end&#xa;&#xa;            EXP_SETTLE: begin&#xa;              if (action_ms == 16'd0 &amp;&amp; settle_scan_seen) begin&#xa;                exploration_state &lt;= EXP_DECIDE;&#xa;                settle_scan_seen &lt;= 1'b0;&#xa;              end&#xa;            end&#xa;&#xa;            default: begin&#xa;              exploration_state &lt;= EXP_STOP;&#xa;            end&#xa;          endcase&#xa;        end&#xa;      end else begin&#xa;        ms_divider &lt;= ms_divider + 32'd1;&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="onboard_exploration_controller" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.06607143"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.09821429"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="map_active" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.1303571"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="map_paused" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.1625"/>
 <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="manual_mode" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.1946429"/>
 <Port Color="#ffe4c4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_calibration_done" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.2267857"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="gyro_polarity_valid" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.2589286"/>
 <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="lidar_online" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.2910714"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="scan_active" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.3232143"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="lidar_new_scan" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.3553571"/>
 <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="obstacle_stop" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.3875"/>
 <Port Color="#deb887" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="safe_distance_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.4196429"/>
 <Port Color="#5f9ea0" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="sector_front_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.4517857"/>
 <Port Color="#7fff00" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="sector_front_right_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.4839286"/>
 <Port Color="#d2691e" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="sector_right_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.5160714"/>
 <Port Color="#ff7f50" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="sector_rear_right_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.5482143"/>
 <Port Color="#6495ed" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="sector_rear_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.5803571"/>
 <Port Color="#fff8dc" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="sector_rear_left_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.6125"/>
 <Port Color="#dc143c" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="sector_left_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.6446429"/>
 <Port Color="#00ffff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="sector_front_left_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.6767857"/>
 <Port Color="#00008b" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="pose_x_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.7089286"/>
 <Port Color="#008b8b" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="pose_y_mm" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.7410714"/>
 <Port Color="#b8860b" Connect="" Datasize="10" Datatype="wire" Description="" Height="30" Inout="input" Name="pose_heading" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.7732143"/>
 <Port Color="#a9a9a9" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="field_config_valid" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.8053571"/>
 <Port Color="#006400" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="field_low_x_cell" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.8375"/>
 <Port Color="#bdb76b" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="field_high_x_cell" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.8696429"/>
 <Port Color="#8b008b" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="field_low_y_cell" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.9017857"/>
 <Port Color="#556b2f" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="field_high_y_cell" Parent="onboard_exploration_controller" Side="left" Width="30" X="-0.01875" Y="0.9339286"/>
 <Port Color="#ff8c00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="auto_mode" Parent="onboard_exploration_controller" Side="right" Width="30" X="0.98125" Y="0.1625"/>
 <Port Color="#9932cc" Connect="" Datasize="3" Datatype="reg" Description="" Height="30" Inout="output" Name="auto_cmd" Parent="onboard_exploration_controller" Side="right" Width="30" X="0.98125" Y="0.3875"/>
 <Port Color="#8b0000" Connect="" Datasize="4" Datatype="reg" Description="" Height="30" Inout="output" Name="exploration_state" Parent="onboard_exploration_controller" Side="right" Width="30" X="0.98125" Y="0.6125"/>
 <Port Color="#e9967a" Connect="" Datasize="4" Datatype="reg" Description="" Height="30" Inout="output" Name="stop_reason" Parent="onboard_exploration_controller" Side="right" Width="30" X="0.98125" Y="0.8375"/>
</Module>
