<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam [2:0] ST_IDLE  = 3'd0;&#xa;  localparam [2:0] ST_DELAY = 3'd1;&#xa;  localparam [2:0] ST_ECHO  = 3'd2;&#xa;  localparam [2:0] ST_WAIT  = 3'd3;&#xa;&#xa;  localparam [31:0] RESPONSE_DELAY_CYCLES = 32'd5000;    // 100 us at 50 MHz&#xa;  localparam [31:0] FAR_ECHO_CYCLES       = 32'd174000;  // 60 cm * 2900&#xa;  localparam [31:0] NEAR_ECHO_CYCLES      = 32'd29000;   // 10 cm * 2900&#xa;&#xa;  reg [2:0] state;&#xa;  reg [31:0] cnt;&#xa;  reg [31:0] echo_target_cycles;&#xa;  reg [3:0] trig_count;&#xa;  reg trig_d0;&#xa;  reg trig_d1;&#xa;&#xa;  wire trig_rise;&#xa;&#xa;  assign trig_rise = trig_d0 &amp; ~trig_d1;&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      trig_d0 &lt;= 1'b0;&#xa;      trig_d1 &lt;= 1'b0;&#xa;    end else begin&#xa;      trig_d0 &lt;= trig;&#xa;      trig_d1 &lt;= trig_d0;&#xa;    end&#xa;  end&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      state &lt;= ST_IDLE;&#xa;      cnt &lt;= 32'd0;&#xa;      echo &lt;= 1'b0;&#xa;      echo_target_cycles &lt;= FAR_ECHO_CYCLES;&#xa;      fake_distance_cm &lt;= 16'd60;&#xa;      trig_count &lt;= 4'd0;&#xa;    end else begin&#xa;      case (state)&#xa;        ST_IDLE: begin&#xa;          echo &lt;= 1'b0;&#xa;          cnt &lt;= 32'd0;&#xa;&#xa;          if (trig_rise) begin&#xa;            if (trig_count &lt; 4'd8) begin&#xa;              echo_target_cycles &lt;= FAR_ECHO_CYCLES;&#xa;              fake_distance_cm &lt;= 16'd60;&#xa;              trig_count &lt;= trig_count + 4'd1;&#xa;            end else begin&#xa;              echo_target_cycles &lt;= NEAR_ECHO_CYCLES;&#xa;              fake_distance_cm &lt;= 16'd10;&#xa;            end&#xa;&#xa;            state &lt;= ST_DELAY;&#xa;          end&#xa;        end&#xa;&#xa;        ST_DELAY: begin&#xa;          echo &lt;= 1'b0;&#xa;&#xa;          if (cnt >= RESPONSE_DELAY_CYCLES - 32'd1) begin&#xa;            cnt &lt;= 32'd0;&#xa;            echo &lt;= 1'b1;&#xa;            state &lt;= ST_ECHO;&#xa;          end else begin&#xa;            cnt &lt;= cnt + 32'd1;&#xa;          end&#xa;        end&#xa;&#xa;        ST_ECHO: begin&#xa;          echo &lt;= 1'b1;&#xa;&#xa;          if (cnt >= echo_target_cycles - 32'd1) begin&#xa;            cnt &lt;= 32'd0;&#xa;            echo &lt;= 1'b0;&#xa;            state &lt;= ST_WAIT;&#xa;          end else begin&#xa;            cnt &lt;= cnt + 32'd1;&#xa;          end&#xa;        end&#xa;&#xa;        ST_WAIT: begin&#xa;          echo &lt;= 1'b0;&#xa;&#xa;          if (!trig) begin&#xa;            state &lt;= ST_IDLE;&#xa;            cnt &lt;= 32'd0;&#xa;          end&#xa;        end&#xa;&#xa;        default: begin&#xa;          state &lt;= ST_IDLE;&#xa;          cnt &lt;= 32'd0;&#xa;          echo &lt;= 1'b0;&#xa;        end&#xa;      endcase&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="temp_ultrasonic_echo_source" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="temp_ultrasonic_echo_source" Side="left" Width="30" X="-0.01875" Y="0.236111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="temp_ultrasonic_echo_source" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="trig" Parent="temp_ultrasonic_echo_source" Side="left" Width="30" X="-0.01875" Y="0.736111"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="echo" Parent="temp_ultrasonic_echo_source" Side="right" Width="30" X="0.98125" Y="0.319444"/>
 <Port Color="#f5f5dc" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="fake_distance_cm" Parent="temp_ultrasonic_echo_source" Side="right" Width="30" X="0.98125" Y="0.659259"/>
</Module>
