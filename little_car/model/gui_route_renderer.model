ar_arrow;&#xa;            wire target_marker;&#xa;            wire now_marker;&#xa;          &#xa;            function integer calc_step_pix;&#xa;              input [5:0] steps;&#xa;              begin&#xa;                if (steps &lt;= 4)&#xa;                  calc_step_pix = 58;&#xa;                else if (steps &lt;= 8)&#xa;                  calc_step_pix = 44;&#xa;                else if (steps &lt;= 12)&#xa;                  calc_step_pix = 34;&#xa;                else if (steps &lt;= 18)&#xa;                  calc_step_pix = 26;&#xa;                else if (steps &lt;= 24)&#xa;                  calc_step_pix = 20;&#xa;                else&#xa;                  calc_step_pix = 16;&#xa;              end&#xa;            endfunction&#xa;          &#xa;            function integer clamp_bar_w;&#xa;              input [15:0] value;&#xa;              integer bar_w;&#xa;              begin&#xa;                bar_w = value;&#xa;                if (bar_w &gt; 320)&#xa;                  bar_w = 320;&#xa;                if (bar_w &lt; 0)&#xa;                  bar_w = 0;&#xa;                clamp_bar_w = bar_w;&#xa;              end&#xa;            endfunction&#xa;          &#xa;            function integer scaled_offset;&#xa;              input [7:0] value;&#xa;              input integer pix;&#xa;              integer diff;&#xa;              integer mag;&#xa;              integer scaled;&#xa;              begin&#xa;                if (value &gt;= 8&#x27;d128)&#xa;                  mag = value - 8&#x27;d128;&#xa;                else&#xa;                  mag = 8&#x27;d128 - value;&#xa;          &#xa;                case (pix)&#xa;                  58: scaled = (mag &lt;&lt; 5) + (mag &lt;&lt; 4) + (mag &lt;&lt; 3) + (mag &lt;&lt; 1);&#xa;                  44: scaled = (mag &lt;&lt; 5) + (mag &lt;&lt; 3) + (mag &lt;&lt; 2);&#xa;                  34: scaled = (mag &lt;&lt; 5) + (mag &lt;&lt; 1);&#xa;                  26: scaled = (mag &lt;&lt; 4) + (mag &lt;&lt; 3) + (mag &lt;&lt; 1);&#xa;                  20: scaled = (mag &lt;&lt; 4) + (mag &lt;&lt; 2);&#xa;                  default: scaled = mag &lt;&lt; 4;&#xa;                endcase&#xa;          &#xa;                if (value &gt;= 8&#x27;d128)&#xa;                  diff = scaled;&#xa;                else&#xa;                  diff = 0 - scaled;&#xa;          &#xa;                scaled_offset = diff;&#xa;              end&#xa;            endfunction&#xa;          &#xa;            function segment_hit;&#xa;              input integer sx;&#xa;              input integer sy;&#xa;              input integer ex;&#xa;              input integer ey;&#xa;              input integer width;&#xa;              integer lx;&#xa;              integer hx;&#xa;              integer ly;&#xa;              integer hy;&#xa;              begin&#xa;                if (sx &lt; ex) begin lx = sx; hx = ex; end else begin lx = ex; hx = sx; end&#xa;                if (sy &lt; ey) begin ly = sy; hy = ey; end else begin ly = ey; hy = sy; end&#xa;                segment_hit = (pixel_x &gt;= lx - width) &amp;&amp; (pixel_x &lt;= hx + width) &amp;&amp;&#xa;                              (pixel_y &gt;= ly - width) &amp;&amp; (pixel_y &lt;= hy + width) &amp;&amp;&#xa;                              ((sx == ex) || (sy == ey));&#xa;              end&#xa;            endfunction&#xa;          &#xa;            function glyph5x7_2x_hit;&#xa;              input [7:0] ch;&#xa;              input [11:0] px;&#xa;              input [11:0] py;&#xa;              input integer base_x;&#xa;              input integer base_y;&#xa;              reg [2:0] row;&#xa;              reg [2:0] col;&#xa;              reg [4:0] bits;&#xa;              begin&#xa;                glyph5x7_2x_hit = 1&#x27;b0;&#xa;                bits = 5&#x27;b00000;&#xa;                if ((ch != &quot; &quot;) &amp;&amp;&#xa;                    (px &gt;= base_x) &amp;&amp; (px &lt; base_x + 10) &amp;&amp;&#xa;                    (py &gt;= base_y) &amp;&a