<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam integer CLK_HZ = 50000000;&#xa;  localparam integer DRIVE_CYCLES = CLK_HZ * 2;&#xa;  localparam integer STOP_CYCLES = CLK_HZ;&#xa;  localparam [31:0] TEST_SPEED = 32'd180;&#xa;&#xa;  reg [31:0] counter;&#xa;  reg drive_phase;&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      counter &lt;= 32'd0;&#xa;      drive_phase &lt;= 1'b1;&#xa;      lf_speed &lt;= 11'd0;&#xa;      rf_speed &lt;= 11'd0;&#xa;      lr_speed &lt;= 11'd0;&#xa;      rr_speed &lt;= 11'd0;&#xa;    end else begin&#xa;      if (drive_phase) begin&#xa;        lf_speed &lt;= TEST_SPEED[10:0];&#xa;        rf_speed &lt;= TEST_SPEED[10:0];&#xa;        lr_speed &lt;= TEST_SPEED[10:0];&#xa;        rr_speed &lt;= TEST_SPEED[10:0];&#xa;&#xa;        if (counter &gt;= DRIVE_CYCLES - 1) begin&#xa;          counter &lt;= 32'd0;&#xa;          drive_phase &lt;= 1'b0;&#xa;        end else begin&#xa;          counter &lt;= counter + 32'd1;&#xa;        end&#xa;      end else begin&#xa;        lf_speed &lt;= 11'd0;&#xa;        rf_speed &lt;= 11'd0;&#xa;        lr_speed &lt;= 11'd0;&#xa;        rr_speed &lt;= 11'd0;&#xa;&#xa;        if (counter &gt;= STOP_CYCLES - 1) begin&#xa;          counter &lt;= 32'd0;&#xa;          drive_phase &lt;= 1'b1;&#xa;        end else begin&#xa;          counter &lt;= counter + 32'd1;&#xa;        end&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="c5_motor_test_pattern" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="c5_motor_test_pattern" Side="left" Width="30" X="-0.01875" Y="0.275"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="c5_motor_test_pattern" Side="left" Width="30" X="-0.01875" Y="0.725"/>
 <Port Color="#7fffd4" Connect="" Datasize="11" Datatype="reg" Description="" Height="30" Inout="output" Name="lf_speed" Parent="c5_motor_test_pattern" Side="right" Width="30" X="0.98125" Y="0.1625"/>
 <Port Color="#f0ffff" Connect="" Datasize="11" Datatype="reg" Description="" Height="30" Inout="output" Name="rf_speed" Parent="c5_motor_test_pattern" Side="right" Width="30" X="0.98125" Y="0.3875"/>
 <Port Color="#f5f5dc" Connect="" Datasize="11" Datatype="reg" Description="" Height="30" Inout="output" Name="lr_speed" Parent="c5_motor_test_pattern" Side="right" Width="30" X="0.98125" Y="0.6125"/>
 <Port Color="#ffe4c4" Connect="" Datasize="11" Datatype="reg" Description="" Height="30" Inout="output" Name="rr_speed" Parent="c5_motor_test_pattern" Side="right" Width="30" X="0.98125" Y="0.8375"/>
</Module>
