 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_mid_n" Parent="car_param_controller" Side="left" Width="30" X="-0.01875" Y="0.4678571"/>
 <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_mode_pulse" Parent="car_param_controller" Side="left" Width="30" X="-0.01875" Y="0.5321429"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_next_pulse" Parent="car_param_controller" Side="left" Width="30" X="-0.01875" Y="0.5964286"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_prev_pulse" Parent="car_param_controller" Side="left" Width="30" X="-0.01875" Y="0.6607143"/>
 <Port Color="#a52a2a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_inc_pulse" Parent="car_param_controller" Side="left" Width="30" X="-0.01875" Y="0.725"/>
 <Port Color="#deb887" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_dec_pulse" Parent="car_param_controller" Side="left" Width="30" X="-0.01875" Y="0.7892857"/>
 <Port Color="#5f9ea0" Connect="" Datasize="3" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_select" Parent="car_param_controller" Side="left" Width="30" X="-0.01875" Y="0.8535714"/>
 <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_select_valid" Parent="car_param_controller" Side="left" Width="30" X="-0.01875" Y="0.9178571"/>
 <Port Color="#d2691e" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="route_key_lock" Parent="car_param_controller" Side="right" Width="30" X="0.98125" Y="0.09090909"/>
 <Port Color="#ff7f50" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="setting_mode" Parent="car_param_controller" Side="right" Width="30" X="0.98125" Y="0.1727273"/>
 <Port Color="#6495ed" Connect="" Datasize="3" Datatype="reg" Description="" Height="30" Inout="output" Name="selected_param" Parent="car_param_controller" Side="right" Width="30" X="0.98125" Y="0.2545455"/>
 <Port Color="#fff8dc" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="step_length_set" Parent="car_param_controller" Side="right" Width="30" X="0.98125" Y="0.3363636"/>
 <Port Color="#dc143c" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="output" Name="speed_set" Parent="car_param_controller" Side="right" Width="30" X="0.98125" Y="0.4181818"/>
 <Port Color="#00ffff" Connect="" Datasize="10" Datatype="reg" Description="" Height="30" Inout="output" Name="overall_speed" Parent="car_param_controller" Side="right" Width="30" X="0.98125" Y="0.5"/>
 <Port Color="#00008b" Connect="" Datasize="10" Datatype="reg" Description="" Height="30" Inout="output" Name="lf_default_speed" Parent="car_param_controller" Side="right" Width="30" X="0.98125" Y="0.5818182"/>
