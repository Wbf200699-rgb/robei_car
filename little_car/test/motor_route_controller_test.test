<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="localparam [4:0] STATE_RUN = 5'b00011;&#xa;localparam [1:0] ROUTE_RIGHT = 2'b01;&#xa;localparam [1:0] ROUTE_LEFT = 2'b10;&#xa;localparam [1:0] ROUTE_FORWARD = 2'b11;&#xa;&#xa;  initial&#xa;  begin&#xa;    clk = 1'b0;&#xa;    forever #10 clk = ~clk;&#xa;  end&#xa;&#xa;  task send_ticks;&#xa;    input integer n;&#xa;    integer i;&#xa;    begin&#xa;      for (i = 0; i &lt; n; i = i + 1) begin&#xa;        #40;&#xa;        lf_tick = 1'b1;&#xa;        rf_tick = 1'b1;&#xa;        lr_tick = 1'b1;&#xa;        rr_tick = 1'b1;&#xa;        #20;&#xa;        lf_tick = 1'b0;&#xa;        rf_tick = 1'b0;&#xa;        lr_tick = 1'b0;&#xa;        rr_tick = 1'b0;&#xa;        #80;&#xa;      end&#xa;    end&#xa;  endtask&#xa;&#xa;  initial&#xa;  begin&#xa;    rst_n = 1'b0;&#xa;    motor_enable = 1'b0;&#xa;    state_info = 5'd0;&#xa;    route_info = 64'd0;&#xa;    active_route_steps = 6'd0;&#xa;    lf_tick = 1'b0;&#xa;    rf_tick = 1'b0;&#xa;    lr_tick = 1'b0;&#xa;    rr_tick = 1'b0;&#xa;    forward_ticks = 16'd4;&#xa;    turn_ticks = 16'd3;&#xa;    forward_duty = 8'd120;&#xa;    turn_duty = 8'd90;&#xa;&#xa;    #200;&#xa;    rst_n = 1'b1;&#xa;    #200;&#xa;&#xa;    motor_enable = 1'b1;&#xa;    state_info = STATE_RUN;&#xa;    active_route_steps = 6'd1;&#xa;&#xa;    route_info[1:0] = ROUTE_FORWARD;&#xa;    #500;&#xa;    send_ticks(4);&#xa;    #500;&#xa;&#xa;    route_info[1:0] = ROUTE_LEFT;&#xa;    #500;&#xa;    send_ticks(3);&#xa;    #500;&#xa;&#xa;    route_info[1:0] = ROUTE_RIGHT;&#xa;    #500;&#xa;    send_ticks(3);&#xa;    #500;&#xa;&#xa;    motor_enable = 1'b0;&#xa;    #200;&#xa;    $finish;&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="motor_route_controller_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="motor_route_controller" Code="  // Temporary wheel mapping note from on-board single-wheel test:&#xa;  // code signal `lr` currently drives the physical right-rear wheel,&#xa;  // and the direction observed with this mapping is correct.&#xa;  // code signal `lf` currently drives the physical left-rear wheel,&#xa;  // and the direction observed with this mapping is correct.&#xa;  // code signal `rf` currently drives the physical left-front wheel,&#xa;  // but the forward direction is inverted and must be flipped later.&#xa;  // code signal `rr` currently drives the physical right-front wheel,&#xa;  // but the forward direction is inverted and must be flipped later.&#xa;  //&#xa;  // Finalized physical mapping:&#xa;  //   lf -> left-rear   (normal polarity)&#xa;  //   lr -> right-rear  (normal polarity)&#xa;  //   rf -> left-front  (inverted polarity)&#xa;  //   rr -> right-front (inverted polarity)&#xa;&#xa;  localparam [4:0] STATE_RUN = 5'b00011;&#xa;&#xa;  localparam [1:0] ROUTE_STOP    = 2'b00;&#xa;  localparam [1:0] ROUTE_RIGHT   = 2'b01;&#xa;  localparam [1:0] ROUTE_LEFT    = 2'b10;&#xa;  localparam [1:0] ROUTE_FORWARD = 2'b11;&#xa;&#xa;  localparam [1:0] MOTOR_STOP    = 2'b00;&#xa;  localparam [1:0] MOTOR_FORWARD = 2'b01;&#xa;  localparam [1:0] MOTOR_REVERSE = 2'b10;&#xa;&#xa;  reg [15:0] target_ticks;&#xa;  reg [1:0] start_cmd;&#xa;  reg restart_pending;&#xa;&#xa;  wire in_run;&#xa;  wire motion_done;&#xa;&#xa;  assign in_run = (state_info == STATE_RUN);&#xa;  assign motion_done = motion_busy &amp;&amp;&#xa;                       (lf_count >= target_ticks) &amp;&amp;&#xa;                       (rf_count >= target_ticks) &amp;&amp;&#xa;                       (lr_count >= target_ticks) &amp;&amp;&#xa;                       (rr_count >= target_ticks);&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      run_step_pulse &lt;= 1'b0;&#xa;      lf_dir &lt;= MOTOR_STOP;&#xa;      rf_dir &lt;= MOTOR_STOP;&#xa;      lr_dir &lt;= MOTOR_STOP;&#xa;      rr_dir &lt;= MOTOR_STOP;&#xa;      lf_duty &lt;= 8'd0;&#xa;      rf_duty &lt;= 8'd0;&#xa;      lr_duty &lt;= 8'd0;&#xa;      rr_duty &lt;= 8'd0;&#xa;      motion_busy &lt;= 1'b0;&#xa;      current_cmd &lt;= ROUTE_STOP;&#xa;      lf_count &lt;= 16'd0;&#xa;      rf_count &lt;= 16'd0;&#xa;      lr_count &lt;= 16'd0;&#xa;      rr_count &lt;= 16'd0;&#xa;      target_ticks &lt;= 16'd0;&#xa;      start_cmd &lt;= ROUTE_STOP;&#xa;      restart_pending &lt;= 1'b0;&#xa;    end else begin&#xa;      run_step_pulse &lt;= 1'b0;&#xa;&#xa;      if (!motor_enable || !in_run || active_route_steps == 6'd0) begin&#xa;        lf_dir &lt;= MOTOR_STOP;&#xa;        rf_dir &lt;= MOTOR_STOP;&#xa;        lr_dir &lt;= MOTOR_STOP;&#xa;        rr_dir &lt;= MOTOR_STOP;&#xa;        lf_duty &lt;= 8'd0;&#xa;        rf_duty &lt;= 8'd0;&#xa;        lr_duty &lt;= 8'd0;&#xa;        rr_duty &lt;= 8'd0;&#xa;        motion_busy &lt;= 1'b0;&#xa;        current_cmd &lt;= ROUTE_STOP;&#xa;        lf_count &lt;= 16'd0;&#xa;        rf_count &lt;= 16'd0;&#xa;        lr_count &lt;= 16'd0;&#xa;        rr_count &lt;= 16'd0;&#xa;        target_ticks &lt;= 16'd0;&#xa;        start_cmd &lt;= ROUTE_STOP;&#xa;        restart_pending &lt;= 1'b0;&#xa;      end else if (!motion_busy &amp;&amp; restart_pending) begin&#xa;        restart_pending &lt;= 1'b0;&#xa;      end else if (!motion_busy) begin&#xa;        start_cmd &lt;= route_info[1:0];&#xa;        current_cmd &lt;= route_info[1:0];&#xa;        lf_count &lt;= 16'd0;&#xa;        rf_count &lt;= 16'd0;&#xa;        lr_count &lt;= 16'd0;&#xa;        rr_count &lt;= 16'd0;&#xa;        motion_busy &lt;= 1'b1;&#xa;        restart_pending &lt;= 1'b0;&#xa;&#xa;        case (route_info[1:0])&#xa;          ROUTE_FORWARD: begin&#xa;            lf_dir &lt;= MOTOR_REVERSE;&#xa;            rf_dir &lt;= MOTOR_FORWARD;&#xa;            lr_dir &lt;= MOTOR_REVERSE;&#xa;            rr_dir &lt;= MOTOR_FORWARD;&#xa;            lf_duty &lt;= forward_duty;&#xa;            rf_duty &lt;= forward_duty;&#xa;            lr_duty &lt;= forward_duty;&#xa;            rr_duty &lt;= forward_duty;&#xa;            target_ticks &lt;= forward_ticks;&#xa;          end&#xa;&#xa;          ROUTE_LEFT: begin&#xa;            lf_dir &lt;= MOTOR_FORWARD;&#xa;            rf_dir &lt;= MOTOR_REVERSE;&#xa;            lr_dir &lt;= MOTOR_REVERSE;&#xa;            rr_dir &lt;= MOTOR_FORWARD;&#xa;            lf_duty &lt;= turn_duty;&#xa;            rf_duty &lt;= turn_duty;&#xa;            lr_duty &lt;= turn_duty;&#xa;            rr_duty &lt;= turn_duty;&#xa;            target_ticks &lt;= turn_ticks;&#xa;          end&#xa;&#xa;          ROUTE_RIGHT: begin&#xa;            lf_dir &lt;= MOTOR_REVERSE;&#xa;            rf_dir &lt;= MOTOR_FORWARD;&#xa;            lr_dir &lt;= MOTOR_FORWARD;&#xa;            rr_dir &lt;= MOTOR_REVERSE;&#xa;            lf_duty &lt;= turn_duty;&#xa;            rf_duty &lt;= turn_duty;&#xa;            lr_duty &lt;= turn_duty;&#xa;            rr_duty &lt;= turn_duty;&#xa;            target_ticks &lt;= turn_ticks;&#xa;          end&#xa;&#xa;          default: begin&#xa;            lf_dir &lt;= MOTOR_STOP;&#xa;            rf_dir &lt;= MOTOR_STOP;&#xa;            lr_dir &lt;= MOTOR_STOP;&#xa;            rr_dir &lt;= MOTOR_STOP;&#xa;            lf_duty &lt;= 8'd0;&#xa;            rf_duty &lt;= 8'd0;&#xa;            lr_duty &lt;= 8'd0;&#xa;            rr_duty &lt;= 8'd0;&#xa;            target_ticks &lt;= 16'd1;&#xa;          end&#xa;        endcase&#xa;      end else begin&#xa;        if (lf_tick &amp;&amp; lf_count != 16'hFFFF)&#xa;          lf_count &lt;= lf_count + 16'd1;&#xa;&#xa;        if (rf_tick &amp;&amp; rf_count != 16'hFFFF)&#xa;          rf_count &lt;= rf_count + 16'd1;&#xa;&#xa;        if (lr_tick &amp;&amp; lr_count != 16'hFFFF)&#xa;          lr_count &lt;= lr_count + 16'd1;&#xa;&#xa;        if (rr_tick &amp;&amp; rr_count != 16'hFFFF)&#xa;          rr_count &lt;= rr_count + 16'd1;&#xa;&#xa;        if (motion_done || start_cmd == ROUTE_STOP) begin&#xa;          lf_dir &lt;= MOTOR_STOP;&#xa;          rf_dir &lt;= MOTOR_STOP;&#xa;          lr_dir &lt;= MOTOR_STOP;&#xa;          rr_dir &lt;= MOTOR_STOP;&#xa;          lf_duty &lt;= 8'd0;&#xa;          rf_duty &lt;= 8'd0;&#xa;          lr_duty &lt;= 8'd0;&#xa;          rr_duty &lt;= 8'd0;&#xa;          motion_busy &lt;= 1'b0;&#xa;          run_step_pulse &lt;= 1'b1;&#xa;          restart_pending &lt;= 1'b1;&#xa;        end&#xa;      end&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="220" Name="motor_route_controller0" Parameters="" Parent="motor_route_controller_test" Type="model" Width="200" X="700" Y="430">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="motor_route_controller0" Side="left" Width="30" X="-0.15" Y="0"/>
