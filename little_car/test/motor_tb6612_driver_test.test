<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="localparam [1:0] MOTOR_STOP    = 2'b00;&#xa;localparam [1:0] MOTOR_FORWARD = 2'b01;&#xa;localparam [1:0] MOTOR_REVERSE = 2'b10;&#xa;localparam [1:0] MOTOR_BRAKE   = 2'b11;&#xa;  initial&#xa;  begin&#xa;    clk = 1'b0;&#xa;    forever #10 clk = ~clk;&#xa;  end&#xa;&#xa;  initial&#xa;  begin&#xa;    rst_n = 1'b0;&#xa;    motor_enable = 1'b0;&#xa;    lf_dir = MOTOR_STOP;&#xa;    rf_dir = MOTOR_STOP;&#xa;    lr_dir = MOTOR_STOP;&#xa;    rr_dir = MOTOR_STOP;&#xa;    lf_duty = 8'd0;&#xa;    rf_duty = 8'd0;&#xa;    lr_duty = 8'd0;&#xa;    rr_duty = 8'd0;&#xa;&#xa;    #200;&#xa;    rst_n = 1'b1;&#xa;    #200;&#xa;&#xa;    motor_enable = 1'b1;&#xa;&#xa;    // forward&#xa;    lf_dir = MOTOR_FORWARD; lf_duty = 8'd64;&#xa;    rf_dir = MOTOR_FORWARD; rf_duty = 8'd128;&#xa;    lr_dir = MOTOR_FORWARD; lr_duty = 8'd192;&#xa;    rr_dir = MOTOR_FORWARD; rr_duty = 8'd224;&#xa;    #10000;&#xa;&#xa;    // reverse&#xa;    lf_dir = MOTOR_REVERSE;&#xa;    rf_dir = MOTOR_REVERSE;&#xa;    lr_dir = MOTOR_REVERSE;&#xa;    rr_dir = MOTOR_REVERSE;&#xa;    #10000;&#xa;&#xa;    // brake&#xa;    lf_dir = MOTOR_BRAKE;&#xa;    rf_dir = MOTOR_BRAKE;&#xa;    lr_dir = MOTOR_BRAKE;&#xa;    rr_dir = MOTOR_BRAKE;&#xa;    #5000;&#xa;&#xa;    // stop&#xa;    lf_dir = MOTOR_STOP;&#xa;    rf_dir = MOTOR_STOP;&#xa;    lr_dir = MOTOR_STOP;&#xa;    rr_dir = MOTOR_STOP;&#xa;    #5000;&#xa;&#xa;    motor_enable = 1'b0;&#xa;    #1000;&#xa;    $finish;&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="motor_tb6612_driver_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="motor_tb6612_driver" Code="  localparam [1:0] MOTOR_STOP    = 2'b00;&#xa;  localparam [1:0] MOTOR_FORWARD = 2'b01;&#xa;  localparam [1:0] MOTOR_REVERSE = 2'b10;&#xa;  localparam [1:0] MOTOR_BRAKE   = 2'b11;&#xa;&#xa;  reg [7:0] pwm_cnt;&#xa;&#xa;  assign stby_a = motor_enable;&#xa;  assign stby_b = motor_enable;&#xa;  assign lf_pwm = motor_enable &amp;&amp; (lf_dir != MOTOR_STOP) &amp;&amp; (lf_dir != MOTOR_BRAKE) &amp;&amp; (pwm_cnt &lt; lf_duty);&#xa;  assign rf_pwm = motor_enable &amp;&amp; (rf_dir != MOTOR_STOP) &amp;&amp; (rf_dir != MOTOR_BRAKE) &amp;&amp; (pwm_cnt &lt; rf_duty);&#xa;  assign lr_pwm = motor_enable &amp;&amp; (lr_dir != MOTOR_STOP) &amp;&amp; (lr_dir != MOTOR_BRAKE) &amp;&amp; (pwm_cnt &lt; lr_duty);&#xa;  assign rr_pwm = motor_enable &amp;&amp; (rr_dir != MOTOR_STOP) &amp;&amp; (rr_dir != MOTOR_BRAKE) &amp;&amp; (pwm_cnt &lt; rr_duty);&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n)&#xa;      pwm_cnt &lt;= 8'd0;&#xa;    else&#xa;      pwm_cnt &lt;= pwm_cnt + 8'd1;&#xa;  end&#xa;&#xa;  always @(*) begin&#xa;    lf_in1 = 1'b0;&#xa;    lf_in2 = 1'b0;&#xa;    rf_in1 = 1'b0;&#xa;    rf_in2 = 1'b0;&#xa;    lr_in1 = 1'b0;&#xa;    lr_in2 = 1'b0;&#xa;    rr_in1 = 1'b0;&#xa;    rr_in2 = 1'b0;&#xa;&#xa;    if (motor_enable) begin&#xa;      case (lf_dir)&#xa;        MOTOR_FORWARD: begin lf_in1 = 1'b1; lf_in2 = 1'b0; end&#xa;        MOTOR_REVERSE: begin lf_in1 = 1'b0; lf_in2 = 1'b1; end&#xa;        MOTOR_BRAKE: begin lf_in1 = 1'b1; lf_in2 = 1'b1; end&#xa;        default: begin lf_in1 = 1'b0; lf_in2 = 1'b0; end&#xa;      endcase&#xa;&#xa;      case (rf_dir)&#xa;        MOTOR_FORWARD: begin rf_in1 = 1'b1; rf_in2 = 1'b0; end&#xa;        MOTOR_REVERSE: begin rf_in1 = 1'b0; rf_in2 = 1'b1; end&#xa;        MOTOR_BRAKE: begin rf_in1 = 1'b1; rf_in2 = 1'b1; end&#xa;        default: begin rf_in1 = 1'b0; rf_in2 = 1'b0; end&#xa;      endcase&#xa;&#xa;      case (lr_dir)&#xa;        MOTOR_FORWARD: begin lr_in1 = 1'b1; lr_in2 = 1'b0; end&#xa;        MOTOR_REVERSE: begin lr_in1 = 1'b0; lr_in2 = 1'b1; end&#xa;        MOTOR_BRAKE: begin lr_in1 = 1'b1; lr_in2 = 1'b1; end&#xa;        default: begin lr_in1 = 1'b0; lr_in2 = 1'b0; end&#xa;      endcase&#xa;&#xa;      case (rr_dir)&#xa;        MOTOR_FORWARD: begin rr_in1 = 1'b1; rr_in2 = 1'b0; end&#xa;        MOTOR_REVERSE: begin rr_in1 = 1'b0; rr_in2 = 1'b1; end&#xa;        MOTOR_BRAKE: begin rr_in1 = 1'b1; rr_in2 = 1'b1; end&#xa;        default: begin rr_in1 = 1'b0; rr_in2 = 1'b0; end&#xa;      endcase&#xa;    end&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="220" Name="motor_tb6612_driver0" Parameters="" Parent="motor_tb6612_driver_test" Type="model" Width="200" X="700" Y="430">
