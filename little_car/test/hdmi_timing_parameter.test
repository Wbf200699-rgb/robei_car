<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="&#10;`ifdef PARAM_WAVE&#10;initial begin&#10;  $dumpfile(&quot;tb_hdmi_timing_parameter.vcd&quot;);&#10;  $dumpvars(0, rst_n, hsync, vsync, v_de, pixel_x, pixel_y, hdmi_timing_gen0.h_cnt, hdmi_timing_gen0.v_cnt);&#10;end&#10;`endif&#10;&#10;initial begin&#10;  clk_pix = 1'b0;&#10;  rst_n = 1'b0;&#10;end&#10;&#10;integer errors;&#10;&#10;  always #5 clk_pix = ~clk_pix;&#10;&#10;  &#10;&#10;  task probe;&#10;    input [11:0] h;&#10;    input [11:0] v;&#10;    input expected_de;&#10;    input expected_hsync;&#10;    input expected_vsync;&#10;    begin&#10;      @(negedge clk_pix);&#10;      hdmi_timing_gen0.h_cnt = h;&#10;      hdmi_timing_gen0.v_cnt = v;&#10;      @(posedge clk_pix);&#10;      #1;&#10;      $display(&quot;RESULT probe h=%0d v=%0d de=%0d hs=%0d vs=%0d&quot;, h, v, v_de, hsync, vsync);&#10;      if (v_de !== expected_de || hsync !== expected_hsync ||&#10;          vsync !== expected_vsync)&#10;        errors = errors + 1;&#10;    end&#10;  endtask&#10;&#10;  initial begin&#10;    errors = 0;&#10;    repeat (3) @(posedge clk_pix);&#10;    rst_n = 1'b1;&#10;    probe(12'd0,    12'd0,   1, 0, 0);&#10;    probe(12'd1023, 12'd599, 1, 0, 0);&#10;    probe(12'd1024, 12'd0,   0, 0, 0);&#10;    probe(12'd1063, 12'd0,   0, 0, 0);&#10;    probe(12'd1064, 12'd0,   0, 1, 0);&#10;    probe(12'd1163, 12'd0,   0, 1, 0);&#10;    probe(12'd1164, 12'd0,   0, 0, 0);&#10;    probe(12'd0,    12'd611, 0, 0, 0);&#10;    probe(12'd0,    12'd612, 0, 0, 1);&#10;    probe(12'd0,    12'd621, 0, 0, 1);&#10;    probe(12'd0,    12'd622, 0, 0, 0);&#10;    probe(12'd1323, 12'd644, 0, 0, 0);&#10;    @(posedge clk_pix);&#10;    #1;&#10;    if (!v_de || hdmi_timing_gen0.h_cnt != 12'd1 || hdmi_timing_gen0.v_cnt != 12'd0)&#10;      errors = errors + 1;&#10;&#10;    $display(&quot;RESULT mode=1024x600 h_active=1024 h_fp=40 h_sync=100 h_bp=160 h_total=1324&quot;);&#10;    $display(&quot;RESULT v_active=600 v_fp=12 v_sync=10 v_bp=23 v_total=645&quot;);&#10;    $display(&quot;RESULT pixels_per_frame=853980 active_pixels=614400 blank_pixels=239580&quot;);&#10;    if (errors == 0)&#10;      $display(&quot;RESULT TEST_PASS hdmi_timing_parameter&quot;);&#10;    else&#10;      $display(&quot;RESULT TEST_FAIL hdmi_timing_parameter errors=%0d&quot;, errors);&#10;    $finish;&#10;  end&#10;&#10;  initial begin&#10;    #20000;&#10;    $display(&quot;RESULT TEST_FAIL hdmi_timing_parameter timeout=1&quot;);&#10;    $finish;&#10;  end&#10;" Color="#d3d3d3" Comment="Generated parameter experiment; keep console and CSV output." Height="1080" Name="hdmi_timing_parameter" Parent="0" Timescale="1ns/1ps" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="hdmi_timing_gen" Code="  parameter H_ACTIVE = 12'd1024, H_FP = 12'd40, H_SYNC = 12'd100, H_BP = 12'd160, H_TOTAL = 12'd1324;&#10;  parameter V_ACTIVE = 12'd600,  V_FP = 12'd12, V_SYNC = 12'd10,  V_BP = 12'd23,  V_TOTAL = 12'd645;&#10;  &#10;  reg [11:0] h_cnt, v_cnt;&#10;  &#10;  always @(posedge clk_pix or negedge rst_n) begin&#10;      if (!rst_n) h_cnt &lt;= 0;&#10;      else h_cnt &lt;= (h_cnt == H_TOTAL - 1) ? 0 : h_cnt + 1;&#10;  end&#10;  &#10;  always @(posedge clk_pix or negedge rst_n) begin&#10;      if (!rst_n) v_cnt &lt;= 0;&#10;      else if (h_cnt == H_TOTAL - 1) v_cnt &lt;= (v_cnt == V_TOTAL - 1) ? 0 : v_cnt + 1;&#10;  end&#10;  &#10;  always @(posedge clk_pix or negedge rst_n) begin&#10;      if (!rst_n) begin&#10;          hsync &lt;= 1'b0;&#10;          vsync &lt;= 1'b0;&#10;          v_de &lt;= 1'b0;&#10;      end else begin&#10;          hsync &lt;= (h_cnt &gt;= (H_ACTIVE + H_FP)) &amp;&amp; (h_cnt &lt; (H_ACTIVE + H_FP + H_SYNC));&#10;          vsync &lt;= (v_cnt &gt;= (V_ACTIVE + V_FP)) &amp;&amp; (v_cnt &lt; (V_ACTIVE + V_FP + V_SYNC));&#10;          v_de  &lt;= (h_cnt &lt; H_ACTIVE) &amp;&amp; (v_cnt &lt; V_ACTIVE);&#10;      end&#10;  end&#10;  &#10;  assign pixel_x = v_de ? h_cnt : 12'd0;&#10;  assign pixel_y = v_de ? v_cnt : 12'd0;" Color="#d3d3d3" Comment="" Height="1080" Name="hdmi_timing_gen0" Parameters="" Parent="hdmi_timing_parameter" Type="model" Width="1600" X="650" Y="300">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk_pix" Parent="hdmi_timing_gen0" Side="left" Width="30" X="-0.01875" Y="0.275" />
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="hdmi_timing_gen0" Side="left" Width="30" X="-0.01875" Y="0.725" />
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="hsync" Parent="hdmi_timing_gen0" Side="right" Width="30" X="0.98125" Y="0.14" />
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="vsync" Parent="hdmi_timing_gen0" Side="right" Width="30" X="0.98125" Y="0.32" />
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="v_de" Parent="hdmi_timing_gen0" Side="right" Width="30" X="0.98125" Y="0.5" />
  <Port Color="#ffe4c4" Connect="" Datasize="12" Datatype="wire" Description="" Height="30" Inout="output" Name="pixel_x" Parent="hdmi_timing_gen0" Side="right" Width="30" X="0.98125" Y="0.68" />
  <Port Color="#b8860b" Connect="" Datasize="12" Datatype="wire" Description="" Height="30" Inout="output" Name="pixel_y" Parent="hdmi_timing_gen0" Side="right" Width="30" X="0.98125" Y="0.86" />
 </Module>
