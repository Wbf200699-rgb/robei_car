<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="&#10;`ifdef PARAM_WAVE&#10;initial begin&#10;  $dumpfile(&quot;tb_ultrasonic_parameter.vcd&quot;);&#10;  $dumpvars(0, rst_n, echo, trig, distance_cm, distance_valid, obstacle_stop, echo_timeout, ultrasonic_obstacle_guard0.state);&#10;end&#10;`endif&#10;&#10;initial begin&#10;  clk = 1'b0;&#10;  rst_n = 1'b0;&#10;  echo = 1'b0;&#10;  step_length = 16'd20;&#10;  enable = 1'b1;&#10;end&#10;&#10;integer errors;&#10;  integer trig_cycles;&#10;&#10;  always #10 clk = ~clk;&#10;&#10;  &#10;&#10;  task measure_cm;&#10;    input integer requested_cm;&#10;    input expected_stop;&#10;    integer sample_cycles;&#10;    begin&#10;      @(negedge clk);&#10;      ultrasonic_obstacle_guard0.state = ultrasonic_obstacle_guard0.ST_MEASURE;&#10;      ultrasonic_obstacle_guard0.echo_cycles = 0;&#10;      ultrasonic_obstacle_guard0.cm_cycle_cnt = 0;&#10;      ultrasonic_obstacle_guard0.measured_cm = 0;&#10;      ultrasonic_obstacle_guard0.echo_d0 = 1;&#10;      ultrasonic_obstacle_guard0.echo_d1 = 1;&#10;      ultrasonic_obstacle_guard0.echo_d2 = 1;&#10;      echo = 1;&#10;      sample_cycles = requested_cm * 2900;&#10;      repeat (sample_cycles) @(posedge clk);&#10;      @(negedge clk);&#10;      echo = 0;&#10;      wait (distance_valid);&#10;      #1;&#10;      $display(&quot;RESULT echo_case requested_cm=%0d measured_cm=%0d pulse_cycles=%0d stop=%0d&quot;, requested_cm, distance_cm, sample_cycles, obstacle_stop);&#10;      if (distance_cm &lt; requested_cm - 1 || distance_cm &gt; requested_cm + 1 ||&#10;          obstacle_stop !== expected_stop || echo_timeout)&#10;        errors = errors + 1;&#10;      @(posedge clk);&#10;    end&#10;  endtask&#10;&#10;  initial begin&#10;    errors = 0;&#10;    trig_cycles = 0;&#10;    repeat (3) @(posedge clk);&#10;    rst_n = 1'b1;&#10;    wait (trig);&#10;    while (trig) begin&#10;      @(posedge clk);&#10;      #1;&#10;      trig_cycles = trig_cycles + 1;&#10;    end&#10;    if (trig_cycles &lt; 499 || trig_cycles &gt; 501)&#10;      errors = errors + 1;&#10;&#10;    measure_cm(5,  1'b1);&#10;    measure_cm(19, 1'b1);&#10;    measure_cm(20, 1'b0);&#10;    measure_cm(35, 1'b0);&#10;&#10;    @(negedge clk);&#10;    echo = 0;&#10;    ultrasonic_obstacle_guard0.state = ultrasonic_obstacle_guard0.ST_WAIT_ECHO;&#10;    ultrasonic_obstacle_guard0.cnt = 32'd1499999;&#10;    @(posedge clk);&#10;    #1;&#10;    if (!distance_valid || !echo_timeout || distance_cm != 16'hffff || obstacle_stop)&#10;      errors = errors + 1;&#10;    $display(&quot;RESULT timeout_cycles=1500000 timeout_us=30000 timeout_distance=FFFF&quot;);&#10;    $display(&quot;RESULT trigger_cycles=%0d trigger_us=10 period_cycles=3000000 period_ms=60 cycles_per_cm=2900&quot;, trig_cycles);&#10;    if (errors == 0)&#10;      $display(&quot;RESULT TEST_PASS ultrasonic_parameter&quot;);&#10;    else&#10;      $display(&quot;RESULT TEST_FAIL ultrasonic_parameter errors=%0d&quot;, errors);&#10;    $finish;&#10;  end&#10;&#10;  initial begin&#10;    #10000000;&#10;    $display(&quot;RESULT TEST_FAIL ultrasonic_parameter timeout=1&quot;);&#10;    $finish;&#10;  end&#10;" Color="#d3d3d3" Comment="Generated parameter experiment; keep console and CSV output." Height="1080" Name="ultrasonic_parameter" Parent="0" Timescale="1ns/1ps" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="ultrasonic_obstacle_guard" Code="  localparam [2:0] ST_TRIG      = 3'd0;&#10;  localparam [2:0] ST_WAIT_ECHO = 3'd1;&#10;  localparam [2:0] ST_MEASURE   = 3'd2;&#10;  localparam [2:0] ST_GAP       = 3'd3;&#10;&#10;  localparam [31:0] TRIG_CYCLES     = 32'd500;      // 10 us at 50 MHz&#10;  localparam [31:0] ECHO_TIMEOUT    = 32'd1500000;  // 30 ms at 50 MHz&#10;  localparam [31:0] MEASURE_PERIOD  = 32'd3000000;  // 60 ms at 50 MHz&#10;  localparam [31:0] CYCLES_PER_CM   = 32'd2900;     // 58 us/cm * 50 cycles/us&#10;  localparam [15:0] DEFAULT_STEP_CM = 16'd20;&#10;&#10;  reg [2:0] state;&#10;  reg [31:0] cnt;&#10;  reg [31:0] echo_cycles;&#10;  reg [31:0] cm_cycle_cnt;&#10;  reg [15:0] measured_cm;&#10;  reg echo_d0;&#10;  reg echo_d1;&#10;  reg echo_d2;&#10;  reg [15:0] compare_length;&#10;&#10;  wire echo_sync;&#10;  wire echo_rise;&#10;  wire echo_fall;&#10;&#10;  assign echo_sync = echo_d1;&#10;  assign echo_rise = echo_d1 &amp; ~echo_d2;&#10;  assign echo_fall = ~echo_d1 &amp; echo_d2;&#10;&#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      echo_d0 &lt;= 1'b0;&#10;      echo_d1 &lt;= 1'b0;&#10;      echo_d2 &lt;= 1'b0;&#10;    end else begin&#10;      echo_d0 &lt;= echo;&#10;      echo_d1 &lt;= echo_d0;&#10;      echo_d2 &lt;= echo_d1;&#10;    end&#10;  end&#10;&#10;  always @(posedge clk or negedge rst_n) begin&#10;    if (!rst_n) begin&#10;      state &lt;= ST_TRIG;&#10;      cnt &lt;= 32'd0;&#10;      echo_cycles &lt;= 32'd0;&#10;      cm_cycle_cnt &lt;= 32'd0;&#10;      measured_cm &lt;= 16'd0;&#10;      trig &lt;= 1'b0;&#10;      distance_cm &lt;= 16'd0;&#10;      distance_valid &lt;= 1'b0;&#10;      obstacle_stop &lt;= 1'b0;&#10;      echo_timeout &lt;= 1'b0;&#10;      compare_length &lt;= DEFAULT_STEP_CM;&#10;    end else begin&#10;      distance_valid &lt;= 1'b0;&#10;      obstacle_stop &lt;= 1'b0;&#10;&#10;      if (step_length == 16'd0)&#10;        compare_length &lt;= DEFAULT_STEP_CM;&#10;      else&#10;        compare_length &lt;= step_length;&#10;&#10;      if (!enable) begin&#10;        state &lt;= ST_TRIG;&#10;        cnt &lt;= 32'd0;&#10;        echo_cycles &lt;= 32'd0;&#10;        cm_cycle_cnt &lt;= 32'd0;&#10;        measured_cm &lt;= 16'd0;&#10;        trig &lt;= 1'b0;&#10;        obstacle_stop &lt;= 1'b0;&#10;        echo_timeout &lt;= 1'b0;&#10;      end else begin&#10;        case (state)&#10;        ST_TRIG: begin&#10;          trig &lt;= 1'b1;&#10;          echo_timeout &lt;= 1'b0;&#10;          echo_cycles &lt;= 32'd0;&#10;          cm_cycle_cnt &lt;= 32'd0;&#10;          measured_cm &lt;= 16'd0;&#10;&#10;          if (cnt &gt;= TRIG_CYCLES - 32'd1) begin&#10;            cnt &lt;= 32'd0;&#10;            trig &lt;= 1'b0;&#10;            state &lt;= ST_WAIT_ECHO;&#10;          end else begin&#10;            cnt &lt;= cnt + 32'd1;&#10;          end&#10;        end&#10;&#10;        ST_WAIT_ECHO: begin&#10;          trig &lt;= 1'b0;&#10;&#10;          if (echo_rise || echo_sync) begin&#10;            cnt &lt;= 32'd0;&#10;            echo_cycles &lt;= 32'd0;&#10;            cm_cycle_cnt &lt;= 32'd0;&#10;            measured_cm &lt;= 16'd0;&#10;            state &lt;= ST_MEASURE;&#10;          end else if (cnt &gt;= ECHO_TIMEOUT - 32'd1) begin&#10;            cnt &lt;= 32'd0;&#10;            echo_timeout &lt;= 1'b1;&#10;            distance_cm &lt;= 16'hFFFF;&#10;            distance_valid &lt;= 1'b1;&#10;            obstacle_stop &lt;= 1'b0;&#10;            state &lt;= ST_GAP;&#10;          end else begin&#10;            cnt &lt;= cnt + 32'd1;&#10;          end&#10;        end&#10;&#10;        ST_MEASURE: begin&#10;          trig &lt;= 1'b0;&#10;&#10;          if (echo_fall) begin&#10;            if (measured_cm == 16'd0 &amp;&amp; echo_cycles != 32'd0)&#10;              distance_cm &lt;= 16'd1;&#10;            else&#10;              distance_cm &lt;= measured_cm;&#10;&#10;            distance_valid &lt;= 1'b1;&#10;            echo_timeout &lt;= 1'b0;&#10;&#10;            if (((measured_cm == 16'd0 &amp;&amp; echo_cycles != 32'd0) ? 16'd1 : measured_cm) &lt; compare_length)&#10;              obstacle_stop &lt;= 1'b1;&#10;&#10;            cnt &lt;= 32'd0;&#10;            state &lt;= ST_GAP;&#10;          end else if (echo_cycles &gt;= ECHO_TIMEOUT - 32'd1) begin&#10;            cnt &lt;= 32'd0;&#10;            echo_cycles &lt;= 32'd0;&#10;            cm_cycle_cnt &lt;= 32'd0;&#10;            measured_cm &lt;= 16'd0;&#10;            echo_timeout &lt;= 1'b1;&#10;            distance_cm &lt;= 16'hFFFF;&#10;            distance_valid &lt;= 1'b1;&#10;            obstacle_stop &lt;= 1'b0;&#10;            state &lt;= ST_GAP;&#10;          end else begin&#10;            echo_cycles &lt;= echo_cycles + 32'd1;&#10;            if (cm_cycle_cnt &gt;= CYCLES_PER_CM - 32'd1) begin&#10;              cm_cycle_cnt &lt;= 32'd0;&#10;              if (measured_cm != 16'hFFFF)&#10;                measured_cm &lt;= measured_cm + 16'd1;&#10;            end else begin&#10;              cm_cycle_cnt &lt;= cm_cycle_cnt + 32'd1;&#10;            end&#10;          end&#10;        end&#10;&#10;        ST_GAP: begin&#10;          trig &lt;= 1'b0;&#10;&#10;          if (cnt &gt;= MEASURE_PERIOD - TRIG_CYCLES - 32'd1) begin&#10;            cnt &lt;= 32'd0;&#10;            state &lt;= ST_TRIG;&#10;          end else begin&#10;            cnt &lt;= cnt + 32'd1;&#10;          end&#10;        end&#10;&#10;        default: begin&#10;          state &lt;= ST_TRIG;&#10;          cnt &lt;= 32'd0;&#10;          trig &lt;= 1'b0;&#10;        end&#10;        endcase&#10;      end&#10;    end&#10;  end&#10;" Color="#d3d3d3" Comment="" Height="1080" Name="ultrasonic_obstacle_guard0" Parameters="" Parent="ultrasonic_parameter" Type="model" Width="1600" X="650" Y="300">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="ultrasonic_obstacle_guard0" Side="left" Width="30" X="-0.01875" Y="0.152778" />
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="ultrasonic_obstacle_guard0" Side="left" Width="30" X="-0.01875" Y="0.319444" />
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="echo" Parent="ultrasonic_obstacle_guard0" Side="left" Width="30" X="-0.01875" Y="0.486111" />
  <Port Color="#f0ffff" Connect="" Datasize="16" Datatype="wire" Description="" Height="30" Inout="input" Name="step_length" Parent="ultrasonic_obstacle_guard0" Side="left" Width="30" X="-0.01875" Y="0.652778" />
  <Port Color="#f5f5dc" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="trig" Parent="ultrasonic_obstacle_guard0" Side="right" Width="30" X="0.98125" Y="0.152778" />
  <Port Color="#ffe4c4" Connect="" Datasize="16" Datatype="reg" Description="" Height="30" Inout="output" Name="distance_cm" Parent="ultrasonic_obstacle_guard0" Side="right" Width="30" X="0.98125" Y="0.319444" />
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="distance_valid" Parent="ultrasonic_obstacle_guard0" Side="right" Width="30" X="0.98125" Y="0.486111" />
  <Port Color="#ffebcd" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="obstacle_stop" Parent="ultrasonic_obstacle_guard0" Side="right" Width="30" X="0.98125" Y="0.652778" />
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="echo_timeout" Parent="ultrasonic_obstacle_guard0" Side="right" Width="30" X="0.98125" Y="0.819444" />
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="enable" Parent="ultrasonic_obstacle_guard0" Side="left" Width="30" X="-0.01875" Y="0.819444" />
 </Module>
