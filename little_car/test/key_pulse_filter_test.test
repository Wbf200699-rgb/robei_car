<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  initial&#xa;  begin&#xa;    clk = 1'b0;&#xa;    forever #10 clk = ~clk;&#xa;  end&#xa;&#xa;  initial&#xa;  begin&#xa;    rst_n = 1'b0;&#xa;    key_n = 1'b1;&#xa;&#xa;    #200;&#xa;    rst_n = 1'b1;&#xa;&#xa;    #1000;&#xa;    key_n = 1'b0; #2000;&#xa;    key_n = 1'b1; #2000;&#xa;    key_n = 1'b0; #4000;&#xa;    key_n = 1'b1; #20000;&#xa;&#xa;    key_n = 1'b0;&#xa;    #25000000;&#xa;    key_n = 1'b1;&#xa;    #5000000;&#xa;&#xa;    key_n = 1'b0;&#xa;    #23000000;&#xa;    key_n = 1'b1;&#xa;    #5000000;&#xa;&#xa;    $finish;&#xa;  end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="key_pulse_filter_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="key_pulse_filter" Code="  reg [1:0] key_sync;&#xa;  reg key_level;&#xa;  reg key_level_d;&#xa;  reg [19:0] stable_cnt;&#xa;&#xa;  wire key_pressed;&#xa;&#xa;  assign key_pressed = ~key_sync[1];&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      key_sync    &lt;= 2'b11;&#xa;      key_level   &lt;= 1'b0;&#xa;      key_level_d &lt;= 1'b0;&#xa;      stable_cnt  &lt;= 20'd0;&#xa;      key_pulse   &lt;= 1'b0;&#xa;    end else begin&#xa;      key_sync &lt;= {key_sync[0], key_n};&#xa;&#xa;      if (key_pressed == key_level) begin&#xa;        stable_cnt &lt;= 20'd0;&#xa;      end else if (stable_cnt >= 20'd999999) begin&#xa;        key_level  &lt;= key_pressed;&#xa;        stable_cnt &lt;= 20'd0;&#xa;      end else begin&#xa;        stable_cnt &lt;= stable_cnt + 20'd1;&#xa;      end&#xa;&#xa;      key_level_d &lt;= key_level;&#xa;      key_pulse   &lt;= key_level &amp; ~key_level_d;&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="220" Name="key_pulse_filter0" Parameters="" Parent="key_pulse_filter_test" Type="model" Width="200" X="700" Y="430">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="key_pulse_filter0" Side="left" Width="30" X="-0.15" Y="0.181818"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="key_pulse_filter0" Side="left" Width="30" X="-0.15" Y="0.431818"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="key_n" Parent="key_pulse_filter0" Side="left" Width="30" X="-0.15" Y="0.681818"/>
  <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="key_pulse" Parent="key_pulse_filter0" Side="right" Width="30" X="0.85" Y="0.431818"/>
 </Module>
