 <Wire Datasize="1" Datatype="wire" From="key_pulse_filter_test>rst_n" Name="key_pulse_filter_test_rst_n" Parent="key_pulse_filter_test" To="key_pulse_filter_test#key_pulse_filter0>rst_n"/>
 <Wire Datasize="1" Datatype="wire" From="key_pulse_filter_test>key_n" Name="key_pulse_filter_test_key_n" Parent="key_pulse_filter_test" To="key_pulse_filter_test#key_pulse_filter0>key_n"/>
 <Wire Datasize="1" Datatype="wire" From="key_pulse_filter_test>key_pulse" Name="key_pulse_filter0_key_pulse" Parent="key_pulse_filter_test" To="key_pulse_filter_test#key_pulse_filter0>key_pulse"/>
