<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="localparam [4:0] STATE_MENU   = 5'b00000;&#xa;localparam [4:0] STATE_CHANGE = 5'b00001;&#xa;localparam [4:0] STATE_RUN    = 5'b00011;&#xa;localparam [4:0] STATE_STOP   = 5'b00100;&#xa;&#xa;  initial&#xa;  begin&#xa;    clk = 1'b0;&#xa;    forever #10 clk = ~clk;&#xa;  end&#xa;&#xa;  initial&#xa;  begin&#xa;    rst_n = 1'b0;&#xa;    state_info = STATE_MENU;&#xa;    active_route_steps = 6'd0;&#xa;&#xa;    #200;&#xa;    rst_n = 1'b1;&#xa;&#xa;    #200;&#xa;    active_route_steps = 6'd1;&#xa;    #200;&#xa;    active_route_steps = 6'd2;&#xa;&#xa;    #200;&#xa;    state_info = STATE_CHANGE;&#xa;    #200;&#xa;    state_info = STATE_RUN;&#xa;    #200;&#xa;    state_info = STATE_STOP;&#xa;    #200;&#xa;    state_info = STATE_MENU;&#xa;    #200;&#xa;    active_route_steps = 6'd3;&#xa;&#xa;    #400;&#xa;    $finish;&#xa;  end&#xa;&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="buzzer_event_gen_test" Parent="0" Timescale="" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="buzzer_event_gen" Code="  localparam [4:0] STATE_RUN  = 5'b00011;&#xa;  localparam [4:0] STATE_STOP = 5'b00100;&#xa;&#xa;  reg rst_n_d;&#xa;  reg [4:0] state_info_d;&#xa;  reg [5:0] active_route_steps_d;&#xa;&#xa;  assign power_on_pulse = rst_n &amp; ~rst_n_d;&#xa;  assign route_add_pulse = (active_route_steps > active_route_steps_d);&#xa;  assign run_enter_pulse = (state_info == STATE_RUN) &amp;&amp; (state_info_d != STATE_RUN);&#xa;  assign stop_enter_pulse = (state_info == STATE_STOP) &amp;&amp; (state_info_d != STATE_STOP);&#xa;&#xa;  always @(posedge clk or negedge rst_n) begin&#xa;    if (!rst_n) begin&#xa;      rst_n_d &lt;= 1'b0;&#xa;      state_info_d &lt;= 5'd0;&#xa;      active_route_steps_d &lt;= 6'd0;&#xa;    end else begin&#xa;      rst_n_d &lt;= 1'b1;&#xa;      state_info_d &lt;= state_info;&#xa;      active_route_steps_d &lt;= active_route_steps;&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="220" Name="buzzer_event_gen0" Parameters="" Parent="buzzer_event_gen_test" Type="model" Width="200" X="700" Y="430">
