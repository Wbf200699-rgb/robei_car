  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_select_valid" Parent="car_param_controller0" Side="left" Width="30" X="-0.01875" Y="0.919444"/>
