  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_next_pulse" Parent="car_param_controller0" Side="left" Width="30" X="-0.01875" Y="0.586111"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="bt_cfg_prev_pulse" Parent="car_param_controller0" Side="left" Width="30" X="-0.01875" Y="0.652778"/>
