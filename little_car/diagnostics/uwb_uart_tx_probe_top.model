<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam integer CLKS_PER_BIT = 434;&#xa;  localparam integer SEND_DELAY_CLKS = 50000000;&#xa;  localparam integer MESSAGE_LENGTH = 30;&#xa;&#xa;  function [7:0] message_byte;&#xa;    input [5:0] index;&#xa;    begin&#xa;      case (index)&#xa;        6'd0:  message_byte = &quot;A&quot;;&#xa;        6'd1:  message_byte = &quot;T&quot;;&#xa;        6'd2:  message_byte = &quot;+&quot;;&#xa;        6'd3:  message_byte = &quot;D&quot;;&#xa;        6'd4:  message_byte = &quot;a&quot;;&#xa;        6'd5:  message_byte = &quot;t&quot;;&#xa;        6'd6:  message_byte = &quot;a&quot;;&#xa;        6'd7:  message_byte = &quot;S&quot;;&#xa;        6'd8:  message_byte = &quot;e&quot;;&#xa;        6'd9:  message_byte = &quot;n&quot;;&#xa;        6'd10: message_byte = &quot;d&quot;;&#xa;        6'd11: message_byte = &quot;=&quot;;&#xa;        6'd12: message_byte = 8'h22;&#xa;        6'd13: message_byte = &quot;A&quot;;&#xa;        6'd14: message_byte = &quot;1&quot;;&#xa;        6'd15: message_byte = &quot;0&quot;;&#xa;        6'd16: message_byte = &quot;8&quot;;&#xa;        6'd17: message_byte = &quot;P&quot;;&#xa;        6'd18: message_byte = &quot;0&quot;;&#xa;        6'd19: message_byte = &quot;E&quot;;&#xa;        6'd20: message_byte = &quot;E&quot;;&#xa;        6'd21: message_byte = 8'h22;&#xa;        6'd22: message_byte = &quot;,&quot;;&#xa;        6'd23: message_byte = 8'h22;&#xa;        6'd24: message_byte = &quot;2&quot;;&#xa;        6'd25: message_byte = &quot;5&quot;;&#xa;        6'd26: message_byte = &quot;5&quot;;&#xa;        6'd27: message_byte = 8'h22;&#xa;        6'd28: message_byte = 8'h0D;&#xa;        default: message_byte = 8'h0A;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  reg [7:0] tx_data = 8'd0;&#xa;  reg tx_start = 1'b0;&#xa;  reg tx_busy = 1'b0;&#xa;  reg [8:0] baud_count = 9'd0;&#xa;  reg [3:0] tx_phase = 4'd0;&#xa;  reg [7:0] tx_shift = 8'd0;&#xa;  reg tx_line = 1'b1;&#xa;&#xa;  reg [25:0] delay_count = 26'd0;&#xa;  reg [1:0] repeat_count = 2'd0;&#xa;  reg sending_message = 1'b0;&#xa;  reg [5:0] byte_index = 6'd0;&#xa;&#xa;  assign uwb_n13 = tx_line;&#xa;  assign usb_uart_tx = tx_line;&#xa;&#xa;  always @(posedge clk) begin&#xa;    if (!tx_busy) begin&#xa;      tx_line &lt;= 1'b1;&#xa;      baud_count &lt;= 9'd0;&#xa;      tx_phase &lt;= 4'd0;&#xa;      if (tx_start) begin&#xa;        tx_busy &lt;= 1'b1;&#xa;        tx_shift &lt;= tx_data;&#xa;        tx_line &lt;= 1'b0;&#xa;      end&#xa;    end else if (baud_count &gt;= CLKS_PER_BIT - 1) begin&#xa;      baud_count &lt;= 9'd0;&#xa;      if (tx_phase &lt; 4'd8) begin&#xa;        tx_line &lt;= tx_shift[tx_phase];&#xa;        tx_phase &lt;= tx_phase + 4'd1;&#xa;      end else if (tx_phase == 4'd8) begin&#xa;        tx_line &lt;= 1'b1;&#xa;        tx_phase &lt;= 4'd9;&#xa;      end else begin&#xa;        tx_busy &lt;= 1'b0;&#xa;        tx_line &lt;= 1'b1;&#xa;      end&#xa;    end else begin&#xa;      baud_count &lt;= baud_count + 9'd1;&#xa;    end&#xa;  end&#xa;&#xa;  always @(posedge clk) begin&#xa;    tx_start &lt;= 1'b0;&#xa;    if (!sending_message) begin&#xa;      if (repeat_count &lt; 3) begin&#xa;        if (delay_count &gt;= SEND_DELAY_CLKS - 1) begin&#xa;          delay_count &lt;= 26'd0;&#xa;          byte_index &lt;= 6'd0;&#xa;          sending_message &lt;= 1'b1;&#xa;        end else begin&#xa;          delay_count &lt;= delay_count + 26'd1;&#xa;        end&#xa;      end&#xa;    end else if (!tx_busy &amp;&amp; !tx_start) begin&#xa;      tx_data &lt;= message_byte(byte_index);&#xa;      tx_start &lt;= 1'b1;&#xa;      if (byte_index + 6'd1 &gt;= MESSAGE_LENGTH) begin&#xa;        sending_message &lt;= 1'b0;&#xa;        repeat_count &lt;= repeat_count + 2'd1;&#xa;      end else begin&#xa;        byte_index &lt;= byte_index + 6'd1;&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="uwb_uart_tx_probe_top" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="uwb_uart_tx_probe_top" Side="left" Width="30" X="-0.01875" Y="0.5"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="uwb_n13" Parent="uwb_uart_tx_probe_top" Side="right" Width="30" X="0.98125" Y="0.275"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="usb_uart_tx" Parent="uwb_uart_tx_probe_top" Side="right" Width="30" X="0.98125" Y="0.725"/>
</Module>
