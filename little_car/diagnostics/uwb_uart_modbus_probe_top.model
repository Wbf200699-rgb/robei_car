<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  localparam integer CLKS_PER_BIT = 434;&#xa;  localparam integer SEND_DELAY_CLKS = 50000000;&#xa;  localparam integer MESSAGE_LENGTH = 8;&#xa;&#xa;  function [7:0] message_byte;&#xa;    input [2:0] index;&#xa;    begin&#xa;      case (index)&#xa;        3'd0: message_byte = 8'h01;&#xa;        3'd1: message_byte = 8'h03;&#xa;        3'd2: message_byte = 8'h00;&#xa;        3'd3: message_byte = 8'h00;&#xa;        3'd4: message_byte = 8'h00;&#xa;        3'd5: message_byte = 8'h06;&#xa;        3'd6: message_byte = 8'hC5;&#xa;        default: message_byte = 8'hC8;&#xa;      endcase&#xa;    end&#xa;  endfunction&#xa;&#xa;  reg [7:0] tx_data = 8'd0;&#xa;  reg tx_start = 1'b0;&#xa;  reg tx_busy = 1'b0;&#xa;  reg [8:0] baud_count = 9'd0;&#xa;  reg [3:0] tx_phase = 4'd0;&#xa;  reg [7:0] tx_shift = 8'd0;&#xa;  reg tx_line = 1'b1;&#xa;&#xa;  reg [25:0] delay_count = 26'd0;&#xa;  reg [1:0] repeat_count = 2'd0;&#xa;  reg sending_message = 1'b0;&#xa;  reg [2:0] byte_index = 3'd0;&#xa;&#xa;  assign uwb_n13 = tx_line;&#xa;  assign usb_uart_tx = uwb_n14;&#xa;&#xa;  always @(posedge clk) begin&#xa;    if (!tx_busy) begin&#xa;      tx_line &lt;= 1'b1;&#xa;      baud_count &lt;= 9'd0;&#xa;      tx_phase &lt;= 4'd0;&#xa;      if (tx_start) begin&#xa;        tx_busy &lt;= 1'b1;&#xa;        tx_shift &lt;= tx_data;&#xa;        tx_line &lt;= 1'b0;&#xa;      end&#xa;    end else if (baud_count &gt;= CLKS_PER_BIT - 1) begin&#xa;      baud_count &lt;= 9'd0;&#xa;      if (tx_phase &lt; 4'd8) begin&#xa;        tx_line &lt;= tx_shift[tx_phase];&#xa;        tx_phase &lt;= tx_phase + 4'd1;&#xa;      end else if (tx_phase == 4'd8) begin&#xa;        tx_line &lt;= 1'b1;&#xa;        tx_phase &lt;= 4'd9;&#xa;      end else begin&#xa;        tx_busy &lt;= 1'b0;&#xa;        tx_line &lt;= 1'b1;&#xa;      end&#xa;    end else begin&#xa;      baud_count &lt;= baud_count + 9'd1;&#xa;    end&#xa;  end&#xa;&#xa;  always @(posedge clk) begin&#xa;    tx_start &lt;= 1'b0;&#xa;    if (!sending_message) begin&#xa;      if (repeat_count &lt; 3) begin&#xa;        if (delay_count &gt;= SEND_DELAY_CLKS - 1) begin&#xa;          delay_count &lt;= 26'd0;&#xa;          byte_index &lt;= 3'd0;&#xa;          sending_message &lt;= 1'b1;&#xa;        end else begin&#xa;          delay_count &lt;= delay_count + 26'd1;&#xa;        end&#xa;      end&#xa;    end else if (!tx_busy &amp;&amp; !tx_start) begin&#xa;      tx_data &lt;= message_byte(byte_index);&#xa;      tx_start &lt;= 1'b1;&#xa;      if (byte_index + 3'd1 &gt;= MESSAGE_LENGTH) begin&#xa;        sending_message &lt;= 1'b0;&#xa;        repeat_count &lt;= repeat_count + 2'd1;&#xa;      end else begin&#xa;        byte_index &lt;= byte_index + 3'd1;&#xa;      end&#xa;    end&#xa;  end" Color="#d3d3d3" Comment="" Height="1080" Name="uwb_uart_modbus_probe_top" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="uwb_uart_modbus_probe_top" Side="left" Width="30" X="-0.01875" Y="0.275"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_n14" Parent="uwb_uart_modbus_probe_top" Side="left" Width="30" X="-0.01875" Y="0.725"/>
 <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="uwb_n13" Parent="uwb_uart_modbus_probe_top" Side="right" Width="30" X="0.98125" Y="0.275"/>
 <Port Color="#f0ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="usb_uart_tx" Parent="uwb_uart_modbus_probe_top" Side="right" Width="30" X="0.98125" Y="0.725"/>
</Module>
