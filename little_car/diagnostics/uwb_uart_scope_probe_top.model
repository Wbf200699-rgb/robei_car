 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="uwb_n14" Parent="uwb_uart_scope_probe_top" Side="left" Width="30" X="-0.01875" Y="0.725"/>
